/-!
# Mayer–Vietoris for two charts of a line modulo an ideal

This file gives the commutative algebra behind a Mayer–Vietoris sequence of locally constant
`ZMod ℓ`-valued functions for two charts of a line. The setting is two charts `Spec B`, `Spec C`
over `A` with overlap `Spec D`, where `D = B[1 / t] = C[1 / s]`, `t * s = 1` in `D`, and `D` is
integral over `A[t, s]`. Everything is read modulo an ideal `I` of `A`. Under further hypotheses,
compatible clopens of the charts come from the base, and every locally constant function on the
overlap is a difference of functions from the charts.

## Main definitions and results

* `New.Variety.exists_eq_basicOpen_of_isClopen_of_preimage_eq`: compatible clopens of the charts
  come from `A`, assuming every pair in `B × C` agreeing in `D` comes from `A` (`hA_onto`) and `hI`.
* `New.Variety.exists_eq_locConstSpec_map_sub_map`: under further hypotheses (`A`, `D` domains; `ℓ`
  prime and a unit in `A`; `A`, `B`, `C` absolutely integrally closed; `hI`; `h_cases`), every
  locally constant `ZMod ℓ`-valued function on the overlap is a difference of functions from the
  charts.

Notions from other files:
* `New.Variety.IsAbsIntegrallyClosed`: A is absolutely integrally closed: every monic polynomial
  over A of positive degree has a root in A.
* `New.ThePrime`: `ThePrime ℓ` fixes the prime `ℓ` (it extends `Fact ℓ.Prime`).
* `New.Variety.locConstSpec`: For an abelian group Λ, the functor on commutative rings sending A to
  the group of locally constant functions Spec A → Λ; it sends a ring map to pull-back along the map
  of spectra.

## Relation to the literature

Known; see `Lib.Cohomology.ProperBaseChange.Theorem` for sources.
-/

@[expose] public section

namespace New.Variety

open PrimeSpectrum Polynomial CommRingCat Ideal.Quotient IsLocalization IsLocalRing
  IsAbsIntegrallyClosed Submodule
  Algebra AlgebraMonoidAlgebra Pointwise IsScalarTower Subring Set Filter algebraMap

variable {ι A B C D : Type} [CommRing A] [CommRing B] [CommRing C] [CommRing D] [Algebra A B]
  [Algebra A C] [Algebra A D] [Algebra B D] [Algebra C D] [IsScalarTower A B D]
  (I : Ideal A) [IsScalarTower A C D] (t : B) (s : C) [Away t D] [Away s D]

/-- Approximation by finitely generated subrings: if `z` lies in the `A`-span of a family
`f : ι → D`, then for all large finite `T ⊆ ι` and `S ⊆ A`, `z` lies in the span of `f(T)` over
the subring of `A` generated by `S`. -/
lemma eventually_mem_span_closure (f : ι → D) (z : D) (hz : z ∈ span A (range f)) :
    ∀ᶠ (T : Finset ι) (S : Finset A) in atTop, z ∈ span (Subring.closure (S : Set A)) (f '' T) := by
  classical
  -- Write `z = ∑ a i • f i`; let `T` contain the support of `a` and `S` the values of `a` there.
  obtain ⟨a, rfl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hz
  filter_upwards [mem_atTop a.support] with T hT
  filter_upwards [mem_atTop (a.support.image a)] with S hS
  refine sum_mem fun i hi ↦ ?_
  have h_coeff : a i ∈ closure (S : Set A) := subset_closure (hS (Finset.mem_image_of_mem a hi))
  exact smul_mem _ (⟨a i, h_coeff⟩ : closure (S : Set A)) (subset_span ⟨i, hT hi, rfl⟩)

/-- If `t` is the unit `τ` in `D = B[1 / t]`, then for every `x ∈ D` and all large enough integers
`j`, the element `τ ^ j * x` is the image of an element of `B`. -/
private lemma eventually_zpow_mul_mem_range (τ : Dˣ) (hτ : (t : D) = τ) (x : D) :
    ∀ᶠ j : ℤ in atTop, IsInteger B (((τ ^ j : Dˣ) : D) * x) := by
  -- Some `x * t ^ n` is an `a ∈ B`; for `j = n + m` take `a * t ^ m`.
  obtain ⟨n, a, ha⟩ : ∃ (n : ℕ) (a : B), x * algebraMap B D t ^ n = algebraMap B D a :=
    Away.surj t x
  filter_upwards [mem_atTop (n : ℤ)] with j hj
  obtain ⟨m, rfl⟩ : ∃ m : ℕ, (n : ℤ) + m = j := Int.le.dest hj
  refine ⟨a * t ^ m, ?_⟩
  show algebraMap B D (a * t ^ m) = ((τ ^ ((n : ℤ) + m) : Dˣ) : D) * x
  simp [zpow_add, ← ha, hτ, mul_comm, mul_assoc]

/-- For a unit `τ` of `D`, every element of the algebra `A[τ, τ⁻¹]` is an `A`-combination of
integer powers of `τ`. -/
private lemma mem_span_range_zpowers_of_mem_adjoin (τ : Dˣ) {x : D}
    (hx : x ∈ A[(τ : D), ((τ⁻¹ : Dˣ) : D)]) :
    x ∈ span A (range ((Units.coeHom D).comp (zpowersHom Dˣ τ))) := by
  let F : Multiplicative ℤ →* D := (Units.coeHom D).comp (zpowersHom Dˣ τ)
  -- `τ = F 1` and `τ⁻¹ = F (-1)`, so the monoid generated by `τ` and `τ⁻¹` lies in the range of `F`
  have h_pair : {(τ : D), ((τ⁻¹ : Dˣ) : D)} ⊆ (MonoidHom.mrange F : Set D) :=
    pair_subset ⟨.ofAdd 1, pow_one _⟩ ⟨.ofAdd (-1), pow_one _⟩
  rw [← Subalgebra.mem_toSubmodule, adjoin_eq_span] at hx
  exact span_mono ((MonoidHom.mrange F).closure_le.mpr h_pair) hx

/-- If `D` is integral over a subalgebra `L` and `G ⊆ D` is finite, then there is a finite `S ⊆ D`
such that `1`, the elements of `G` and the products of two elements of `S` lie in the `L`-span
of `S`. -/
private lemma exists_finset_subset_span_of_isIntegral (L : Subalgebra A D)
    (hD : ∀ x : D, IsIntegral L x) (G : Set D) [Finite G] :
    ∃ S : Finset D, insert 1 G ∪ S * S ⊆ ↑(span L (S : Set D)) := by
  classical
  -- `S` generates the finite `L`-algebra `L[G]` as a module
  obtain ⟨S, hS⟩ : (adjoin L G).toSubmodule.FG := fg_adjoin_of_finite G.toFinite fun g _ ↦ hD g
  refine ⟨S, ?_⟩
  grw [hS, span_le.mp hS.le]
  simp [insert_subset]

/-- Let `M a b` be submodules of an `S`-algebra `R`, indexed by pairs of integers, with
`M a b * M c d ≤ M (a + c - k) (b + d + k)` for all `a, b, c, d`, and `1 ∈ M (-k) k`. Then every
power of `M (-k) k` lies in some `M i j`. -/
private lemma exists_pow_le_of_mul_le {S R : Type} [CommRing S] [CommRing R] [Algebra S R]
    (M : ℤ → ℤ → Submodule S R) (k : ℤ) (h_one : (1 : R) ∈ M (-k) k)
    (h_mul : ∀ a b c d : ℤ, M a b * M c d ≤ M (a + c + -k) (b + d + k)) (n : ℕ) :
    ∃ i j : ℤ, M (-k) k ^ n ≤ M i j := by
  induction n with
  | zero => exact ⟨-k, k, one_le.mpr h_one⟩
  | succ n ih =>
    obtain ⟨i, j, h_le⟩ := ih
    exact ⟨i + -k + -k, j + k + k, by grw [pow_succ, h_le, h_mul]⟩

omit [Algebra B D] [Algebra C D] [IsScalarTower A B D] [IsScalarTower A C D] in
/-- Let `F` be a Noetherian `R`-submodule of `D`, for a subring `R` of `A`, let `φ : B × C → D` be
`A`-linear and `ϖ ∈ A`. Then for some `k`, every `z ∈ F` with `ϖ ^ (k + 1) z` in the image of `φ`
has `ϖ ^ k z` in the image of `φ`. -/
private lemma exists_pow_smul_mem_range_of_pow_succ_smul_mem_range (R : Subring A)
    (F : Submodule R D) [IsNoetherian R F] (φ : B × C →ₗ[A] D) (ϖ : A) :
    ∃ k : ℕ, ∀ z : F, ϖ ^ (k + 1) • z.val ∈ φ.range.restrictScalars R →
      ϖ ^ k • z.val ∈ φ.range.restrictScalars R := by
  -- As `F` is Noetherian, the chain `{z ∈ F | ϖ ^ m • z ∈ range φ}` is not strictly increasing.
  let chain (m : ℕ) : Submodule R F := (φ.range.restrictScalars R).comap (ϖ ^ m • F.subtype)
  obtain ⟨k, h_not_lt⟩ : ∃ k : ℕ, ¬chain (k + 1) > chain k := WellFounded.not_rel_apply_succ chain
  -- the chain increases, since the image of `φ` is stable under multiplication by `ϖ`
  have h_mono : chain k ≤ chain (k + 1) := by
    rintro z ⟨v, hv⟩
    exact ⟨ϖ • v, by simp [hv, pow_succ', mul_smul]⟩
  exact ⟨k, not_lt_iff_le_imp_ge.mp h_not_lt h_mono⟩

private lemma Icc_subset_Icc_union_Icc_union_Icc (i j k : ℤ) :
    Icc i j ⊆ Icc k j ∪ Icc i (-k) ∪ Icc (-k) k := by
  grind
/-- Let `D = B[1 / t] = C[1 / s]` with `t * s = 1` (`hts`) be integral over `A[t, s]` (`hD`), and
let `G ⊆ D` be finite. Then there are a subring `R` of `A` and an `R`-submodule `Y` of `D` such
that `Y` contains `1` and `G`, `Y` is Noetherian over `R`, and for each `n` there are
`R`-submodules `P`, `Q`, `M` of `D` with `P` in the image of `B`, `Q` in the image of `C`,
`M` finitely generated, `Y ^ n ≤ M ≤ P ⊔ Q ⊔ Y` (membership in `Icc`) and `P * Q ≤ M`. -/
lemma exists_isNoetherian_pow_le_fg (hts : (t * s : D) = 1)
    (hD : ∀ x : D, IsIntegral A[(t : D), (s : D)] x) (G : Set D) [Finite G] :
    ∃ (R : Subring A) (Y : Submodule R D),
      -- `Y` is a Noetherian `R`-module that contains `1` and `G`
      insert 1 G ⊆ Y ∧
      IsNoetherian R Y ∧
      -- each `Y ^ n` and a product `P * Q`, with `P` from `B` and `Q` from `C`, lie in a
      -- finitely generated `M ≤ P + Q + Y`
      ∀ n : ℕ, ∃ P : Submodule R D, P ≤ (IsScalarTower.toAlgHom R B D).toLinearMap.range ∧
        ∃ Q : Submodule R D, Q ≤ (IsScalarTower.toAlgHom R C D).toLinearMap.range ∧
        ∃ M : Submodule R D, M ∈ Icc (Y ^ n) (P ⊔ Q ⊔ Y) ∧
        M.FG ∧
        P * Q ≤ M := by
  classical
  -- `D` is integral over the Laurent polynomials `L = A[t, s]` in `τ = t`, so `L[G]` is finite over
  -- `L`, with generators `S`. Filter it by the modules `M a b` spanned by `τ ^ j * S`, `a ≤ j ≤ b`:
  -- large exponents come from `B`, very negative ones from `C`, and `Y = M (-k) k` is the middle.
  let τ : Dˣ := Units.mkOfMulEqOne (t : D) (s : D) hts
  let F : Multiplicative ℤ →* D := (Units.coeHom D).comp (zpowersHom Dˣ τ)
  let T : ℤ → D := F
  have hT (a b : Set ℤ) : T '' a * T '' b ⊆ T '' (a + b) := (image_mul F).ge
  let L : Subalgebra A D := A[(t : D), (s : D)]
  -- `S` spans the algebra `L[G]` over `L`, so `1`, `G` and `S * S` are `L`-combinations of `S`
  obtain ⟨S, h_gen⟩ := exists_finset_subset_span_of_isIntegral L hD G
  let X : Set D := insert 1 G ∪ S * S
  have h_comb (x : X) : ∃ r : S → L, ∑ g : S, r g • (g : D) = x :=
    mem_span_finset'.mp (h_gen x.prop)
  choose r hr using h_comb
  -- large powers of `τ` times `S` come from `B`, large powers of `τ⁻¹` times `S` from `C`
  have h_ends : ∀ᶠ k : ℤ in atTop, ∀ j ≥ k, ∀ x ∈ S,
      IsInteger B (((τ ^ j : Dˣ) : D) * x) ∧ IsInteger C (((τ⁻¹ ^ j : Dˣ) : D) * x) :=
    eventually_forall_ge_atTop.mpr (S.eventually_all.mpr fun x _ ↦
      (eventually_zpow_mul_mem_range t τ rfl x).and (eventually_zpow_mul_mem_range s τ⁻¹ rfl x))
  have h_laurent (x : L) : (x : D) ∈ span A (range T) :=
    mem_span_range_zpowers_of_mem_adjoin τ x.prop
  -- the finitely many `r x g ∈ L` involve only exponents in `[-k, k]`, with coefficients in the
  -- subring `R` generated by a large finite set `U`
  have h_coeff : ∀ᶠ (k : ℤ) in atTop, ∀ p : X × S, ∀ᶠ U : Finset A in atTop,
      (r p.fst p.snd : D) ∈ span (closure (U : Set A)) (T '' Finset.Icc (-k) k) :=
    Finset.tendsto_Icc_neg_atTop_atTop (eventually_all.mpr fun p : X × S ↦
      eventually_mem_span_closure T _ (h_laurent (r p.fst p.snd)))
  obtain ⟨k, h_end, h_mid⟩ := (h_ends.and h_coeff).exists
  obtain ⟨U, hU⟩ := (eventually_all.mpr h_mid).exists
  let R : Subring A := closure (U : Set A)
  let M (a b : ℤ) : Submodule R D := span R (T '' Icc a b * S : Set D)
  have hY : X ⊆ M (-k) k := by
    intro x hx
    have h_sum : ∑ g : S, (r ⟨x, hx⟩ g : D) * g ∈ span R (T '' Icc (-k) k) * span R (S : Set D) :=
      sum_mem fun g _ ↦ mul_mem_mul (by simpa using hU (⟨x, hx⟩, g)) (subset_span g.prop)
    have h_eq : ∑ g : S, (r ⟨x, hx⟩ g : D) * g = x := hr ⟨x, hx⟩
    rwa [h_eq, span_mul_span] at h_sum
  -- exponents add, and `S * S ⊆ M (-k) k` widens the range by `k` on each side
  have h_SS : (S * S : Set D) ⊆ M (-k) k := subset_union_right.trans hY
  have h_mul (a b c d : ℤ) : M a b * M c d ≤ M (a + c + -k) (b + d + k) :=
    calc M a b * M c d = span R (T '' Icc a b * T '' Icc c d * (S * S : Set D)) := by
          rw [span_mul_span, mul_mul_mul_comm]
      _ ≤ span R (T '' Icc a b * T '' Icc c d) * M (-k) k := by
          grw [← span_mul_span, h_SS, span_eq]
      _ ≤ M (a + c + -k) (b + d + k) := by
          grw [span_mul_span, ← mul_assoc, hT, hT, Icc_add_Icc_subset, Icc_add_Icc_subset]
  have h_noeth : IsNoetherianRing R := is_noetherian_subring_closure _ U.finite_toSet
  refine ⟨R, M (-k) k, subset_union_left.trans hY, isNoetherian_span_of_finite _ (toFinite _),
    fun n ↦ ?_⟩
  obtain ⟨i, j, h_le⟩ : ∃ i j : ℤ, M (-k) k ^ n ≤ M i j :=
    exists_pow_le_of_mul_le M k (hY (mem_union_left _ (mem_insert 1 G))) h_mul n
  have h_prod : M k j * M i (-k) ≤ M i j := by simpa using h_mul k j i (-k)
  refine ⟨M k j, span_le.mpr ?_, M i (-k), span_le.mpr ?_, M i j, ⟨h_le, ?_⟩,
    fg_span (toFinite _), h_prod⟩
  · -- the generators `τ ^ e * x` of `M k j` have `k ≤ e`
    refine mul_subset_iff.mpr (forall_mem_image.mpr fun e he x hx ↦ ?_)
    exact (h_end e he.left x hx).left
  · -- the generators `τ ^ e * x` of `M i (-k)` have `k ≤ -e`
    refine mul_subset_iff.mpr (forall_mem_image.mpr fun e he x hx ↦ ?_)
    have h_C : IsInteger C (((τ⁻¹ ^ (-e) : Dˣ) : D) * x) :=
      (h_end (-e) (le_neg.mp he.right) x hx).right
    rwa [inv_zpow', neg_neg] at h_C
  · -- `[i, j]` is covered by `[k, j]`, `[i, -k]` and `[-k, k]`
    simp only [M, ← span_union, ← union_mul, ← image_union]
    gcongr
    exact Icc_subset_Icc_union_Icc_union_Icc i j k

/-- Let `D = B[1 / t] = C[1 / s]` with `t * s = 1` be integral over `A[t, s]`, and let `A` map onto
the fibre product `B ×_D C` (`hA`). Let `x ∈ B` and `y ∈ C` have idempotent classes in `B / IB`
and `C / IC`, and let `x (1 - y) = ϖ α` and `y (1 - x) = ϖ β` in `D` for one `ϖ ∈ I`. Then one
`k ∈ A` has the class of `x` in `B / IB` and the class of `y` in `C / IC`. -/
lemma exists_common_lift_of_isIdempotentElem (hts : (t * s : D) = 1)
    (hD : ∀ x : D, IsIntegral A[(t : D), (s : D)] x)
    (hA : ∀ (x : B) (y : C), (x : D) = y → (x, y) ∈ range (algebraMap A (B × C))) {x : B} {y : C}
    (hx : IsIdempotentElem (Ideal.Quotient.mk (I.map (algebraMap A B)) x))
    (hy : IsIdempotentElem (Ideal.Quotient.mk (I.map (algebraMap A C)) y)) {ϖ : A} (hϖ : ϖ ∈ I)
    {α β : D} (hα : (x : D) * (1 - y) = ϖ • α) (hβ : (y : D) * (1 - x) = ϖ • β) :
    ∃ k : A,
      (k : B ⧸ I.map (algebraMap A B)) = Ideal.Quotient.mk (I.map (algebraMap A B)) x ∧
      (k : C ⧸ I.map (algebraMap A C)) = Ideal.Quotient.mk (I.map (algebraMap A C)) y := by
  -- Replace `x`, `y` by `p x`, `p y` with `p z = 1 - (1 - z ^ n) ^ n`: the classes mod `I` stay the
  -- same, and the images in `D` now agree modulo `ϖ ^ n`. For a suitable `n`, the difference is
  -- then removed by changing `p x` and `p y` by multiples of `ϖ`.
  obtain ⟨R, F, hGF, h_noeth, h_pow⟩ :=
    exists_isNoetherian_pow_le_fg t s hts hD {(x : D), (y : D), α, β}
  let φ : B × C →ₗ[A] D := (toAlgHom A B D).toLinearMap.coprod (-(toAlgHom A C D).toLinearMap)
  let N : Submodule R D := φ.range.restrictScalars R
  -- The algebra `E` generated by `F` lies in `B + C + F`, since every power of `F` does.
  have h_pow_le (n : ℕ) : F ^ n ≤ N ⊔ F := by
    obtain ⟨P, hP, Q, hQ, M, ⟨hFM, hM⟩, -⟩ := h_pow n
    simp only [N, φ, LinearMap.range_coprod, LinearMap.range_neg, restrictScalars_sup]
    grw [hFM, hM, hP, hQ]
    rfl
  obtain ⟨E, hFE, hE⟩ : ∃ E : Subalgebra R D, F ≤ E.toSubmodule ∧ E.toSubmodule ≤ N ⊔ F := by
    refine ⟨(DirectSum.coeAlgHom fun n : ℕ ↦ F ^ n).range, ?_⟩
    rw [← iSup_eq_toSubmodule_range]
    exact ⟨le_iSup_of_le 1 (pow_one F).ge, iSup_le h_pow_le⟩
  obtain ⟨hxE, hyE, hαE, hβE⟩ : (x : D) ∈ E ∧ (y : D) ∈ E ∧ α ∈ E ∧ β ∈ E := by
    simpa [subset_def] using hGF.trans hFE
  -- As `F` is Noetherian, the chain `{z ∈ F | ϖ ^ k • z ∈ B + C}` is not strictly increasing.
  obtain ⟨k, hk⟩ := exists_pow_smul_mem_range_of_pow_succ_smul_mem_range R F φ ϖ
  let n : ℕ := k + 1
  let p : B × C := 1 - (1 - (x, y) ^ n) ^ n
  -- `p u * (1 - p v)` is a multiple in `E` of `(u * (1 - v)) ^ n`.
  have h_dvd (u v : E) : u ^ n * (1 - v) ^ n ∣ (1 - (1 - u ^ n) ^ n) * (1 - v ^ n) ^ n :=
    mul_dvd_mul (by simpa using one_sub_dvd_one_sub_pow (1 - u ^ n) n)
      (pow_dvd_pow_of_dvd (one_sub_dvd_one_sub_pow v n) n)
  obtain ⟨i, hi⟩ := h_dvd ⟨(x : D), hxE⟩ ⟨(y : D), hyE⟩
  obtain ⟨j, hj⟩ := h_dvd ⟨(y : D), hyE⟩ ⟨(x : D), hxE⟩
  -- So `p x - p y = p x * (1 - p y) - p y * (1 - p x)` is `ϖ ^ n` times an element of `E`, which is
  -- `φ w + z` with `z ∈ F`.
  let δ : E := i * ⟨α, hαE⟩ ^ n - j * ⟨β, hβE⟩ ^ n
  obtain ⟨w, z, hwz⟩ : ∃ (w : B × C) (z : F), φ w + z = δ := by
    obtain ⟨⟨_, w, rfl⟩, z, hwz⟩ := mem_sup'.mp (hE δ.prop)
    exact ⟨w, z, hwz⟩
  have h_diff : φ (p - ϖ ^ n • w) = ϖ ^ n • z.val := by
    have h_pow_α : ((x : D) * (1 - y)) ^ n = (ϖ • α) ^ n := by rw [hα]
    have h_pow_β : ((y : D) * (1 - x)) ^ n = (ϖ • β) ^ n := by rw [hβ]
    simp [φ, p, δ, mul_pow, Subtype.ext_iff, smul_def', ← IsScalarTower.algebraMap_apply]
      at hi hj hwz h_pow_α h_pow_β ⊢
    linear_combination hi - hj + i.val * h_pow_α - j.val * h_pow_β - (ϖ : D) ^ n * hwz
  obtain ⟨v, hv⟩ : ∃ v : B × C, φ v = ϖ ^ k • z.val := hk z ⟨p - ϖ ^ n • w, h_diff⟩
  -- Thus `p x` and `p y`, changed by multiples of `ϖ`, have the same image in `D`.
  have h_ker : φ (p - ϖ ^ n • w - ϖ • v) = 0 := by
    rw [map_sub, h_diff, map_smul, hv, smul_smul, ← pow_succ', sub_self]
  obtain ⟨k', hk'⟩ : ∃ k' : A, algebraMap A (B × C) k' = p - ϖ ^ n • w - ϖ • v :=
    hA _ _ (eq_of_add_neg_eq_zero h_ker)
  -- Modulo `I`, `ϖ` vanishes and `x ^ n = x`, `y ^ n = y`, so `k'` has the classes of `x` and `y`.
  obtain ⟨h_fst, h_snd⟩ :
      algebraMap A B k' = 1 - (1 - x ^ n) ^ n - ϖ ^ n • w.fst - ϖ • v.fst ∧
      algebraMap A C k' = 1 - (1 - y ^ n) ^ n - ϖ ^ n • w.snd - ϖ • v.snd := by
    simpa [p, Prod.ext_iff] using hk'
  have h_ϖ {E : Type} [CommRing E] (ψ : A →+* E) : mk (I.map ψ) (ψ ϖ) = 0 :=
    eq_zero_iff_mem.mpr (I.mem_map_of_mem ψ hϖ)
  refine ⟨k', ?_, ?_⟩
  · rw [Algebra.cast, ← mk_algebraMap, h_fst]
    simp [hx, n, IsIdempotentElem.pow_succ_eq, smul_def', h_ϖ (algebraMap A B)]
  · rw [Algebra.cast, ← mk_algebraMap, h_snd]
    simp [hy, n, IsIdempotentElem.pow_succ_eq, smul_def', h_ϖ (algebraMap A C)]

/-- Let `D = B[1 / t] = C[1 / s]` with `t * s = 1` be integral over `A[t, s]`, where `A` is an
absolutely integrally closed local domain in which `ℓ` is a unit. Let `ϖ` be a non-unit of `A` and
`w ^ ℓ = 1 + ϖ G` in `D`. Then there are `a ∈ B`, `b ∈ C` and `c ∈ D` such that
`(w (1 + ϖ c)) ^ ℓ = (1 + ϖ a) (1 + ϖ b)` in `D`. -/
lemma exists_pow_eq_mul_of_local (hts : (t * s : D) = 1)
    (hD : ∀ x : D, IsIntegral A[(t : D), (s : D)] x) [IsAbsIntegrallyClosedLocal A] {ℓ : ℕ}
    (hℓ : IsUnit (ℓ : A)) {ϖ : A} (hϖ : ¬IsUnit ϖ) {w G : D} (hw : w ^ ℓ = 1 + ϖ • G) :
    ∃ (a : B) (b : C) (c : D), (w * (1 + ϖ • c)) ^ ℓ = (1 + ϖ • a : B) * (1 + ϖ • b : C) := by
  -- Take `a`, `b` of the form `∑ X k • a k`, `∑ X k • b k` with unknowns `X k`. A suitable `c`
  -- cancels `ϖ • G` to first order; the terms linear in the `X k` must then match the error of
  -- order `ϖ ^ 2`, a system `X = ϖ • p X`, which Hensel's lemma solves in `A`.
  obtain ⟨u, hu⟩ : ∃ u : A, u * -ℓ = 1 := hℓ.neg.exists_left_inv
  -- A module `N` containing `1` and `G`; both `N ^ (ℓ + 1)` and `P * Q` lie in the span of a finite
  -- set `e`, and each `k ∈ e` is `a k + b k + y k` with parts in `P ≤ B`, `Q ≤ C` and `N`.
  obtain ⟨R, N, hGN, -, h_pow⟩ := exists_isNoetherian_pow_le_fg t s hts hD {G}
  obtain ⟨P, hP, Q, hQ, -, ⟨hN, h_span⟩, ⟨e, rfl⟩, hPQ⟩ := h_pow (ℓ + 1)
  have h_parts (k : e) :
      ∃ a : B, (a : D) ∈ P ∧ ∃ b : C, (b : D) ∈ Q ∧ ∃ y ∈ N, (a : D) + b + y = k := by
    rw [← map_comap_eq_self hP, ← map_comap_eq_self hQ] at h_span
    simpa [Submodule.mem_sup] using h_span (subset_span k.prop)
  choose a ha b hb y hy h_parts_sum using h_parts
  -- Work in `D[X]`, with the `A[X]`-submodules `T V` spanned by constants from `V ⊆ D`.
  let κ : D →ₐ[R] MvPolynomial e D := toAlgHom R D (MvPolynomial e D)
  let T (V : Set D) : Submodule (MvPolynomial e A) (MvPolynomial e D) := span _ (κ '' V)
  let L (v : e → D) : MvPolynomial e D := ∑ k, (MvPolynomial.X k : MvPolynomial e A) • κ (v k)
  have hL {V : Set D} {v : e → D} (hv : ∀ k : e, v k ∈ V) : L v ∈ T V :=
    sum_mem fun k _ ↦ smul_mem _ _ (subset_span ⟨v k, hv k, rfl⟩)
  have h_one : 1 ∈ T N := subset_span ⟨1, hGN (by simp), rfl⟩
  have hG : κ G ∈ T N := subset_span ⟨G, hGN (by simp), rfl⟩
  let c : MvPolynomial e D := u • (κ G + L y)
  have hc : c ∈ T N := smul_of_tower_mem _ u (add_mem hG (hL hy))
  -- Binomial expansion to first order in `ϖ`.
  have h_binom (m : ℕ) : ∃ Φ ∈ T N ^ (m + 1),
      (1 + ϖ • c) ^ m * (1 + ϖ • κ G) = 1 + ϖ • (κ G + m • c + ϖ • Φ) := by
    induction m with
    | zero => exact ⟨0, by simp⟩
    | succ m ih =>
      obtain ⟨Φ, hΦ, ih⟩ := ih
      refine ⟨Φ * (1 + ϖ • c) + c * (κ G + m • c), add_mem ?_ ?_, ?_⟩
      · exact mul_mem_mul hΦ (add_mem h_one (smul_of_tower_mem _ ϖ hc))
      · -- `1 ∈ T N ^ m` raises `c * (κ G + m • c) ∈ T N ^ 2` to the degree `m + 2`
        have h_mem : 1 ^ m * c * (κ G + m • c) ∈ T N ^ m * T N * T N :=
          mul_mem_mul (mul_mem_mul (pow_mem_pow _ h_one m) hc) (add_mem hG (nsmul_mem hc m))
        rwa [one_pow, one_mul, ← pow_succ, ← pow_succ] at h_mem
      · simp only [pow_succ', mul_assoc, ih]
        algebra
  obtain ⟨Φ, hΦ, h_expand⟩ := h_binom ℓ
  -- `Φ` and `L a * L b` lie in the spans of `N ^ (ℓ + 1)` and `P * Q`, hence in the span of `e`.
  let Ψ : MvPolynomial e D := Φ - (L fun k : e ↦ a k) * L fun k : e ↦ b k
  obtain ⟨p, hp⟩ : ∃ p : e → MvPolynomial e A, ∑ k : e, p k • κ k = Ψ := by
    have h_mem : Ψ ∈ T N ^ (ℓ + 1) ⊔ T P * T Q := sub_mem_sup hΦ (mul_mem_mul (hL ha) (hL hb))
    have h_le : T N ^ (ℓ + 1) ⊔ T P * T Q ≤ span _ (κ '' (span R (e : Set D) : Set D)) := by
      grw [span_pow, span_mul_span, ← image_mul, ← image_pow, N.pow_subset_pow, P.mul_subset_mul,
        hN, hPQ, sup_idem]
    grw [h_le, ← κ.coe_toLinearMap, image_span_subset_span, span_span_of_tower] at h_mem
    exact (mem_span_image_finset_iff_exists_fun _).mp h_mem
  obtain ⟨x, hx⟩ : ∃ x : e → A, ∀ k : e, x k = MvPolynomial.aeval x ((ϖ • p) k) :=
    IsAbsIntegrallyClosedLocal.multivariate_hensel fun _ _ h ↦ hϖ (isUnit_of_mul_isUnit_left h)
  let ev : MvPolynomial e D →+* D := MvPolynomial.eval (algebraMap A D ∘ x)
  let a₀ : B := ∑ k, x k • a k
  let b₀ : C := ∑ k, x k • b k
  let y₀ : D := ∑ k, x k • y k
  refine ⟨a₀, b₀, ev c, ?_⟩
  -- The three identities at `X = x`: the expansion, the system solved by `x`, the choice of `c`.
  have h_ev_expand : (1 + ϖ * ev c) ^ ℓ * (1 + ϖ * G) = 1 + ϖ * (G + ℓ * ev c + ϖ * ev Φ) := by
    simpa [ev, κ, smul_def'] using congrArg ev h_expand
  have h_ev_p : ϖ * (ev Φ - a₀ * b₀) = a₀ + b₀ + y₀ :=
    calc ϖ * (ev Φ - a₀ * b₀) = ϖ * ev Ψ := by
          simp [Ψ, L, ev, κ, a₀, b₀, smul_def', ← IsScalarTower.algebraMap_apply]
      _ = ∑ k : e, x k • (k : D) := by
          simp [← hp, hx, ev, κ, smul_def', Finset.mul_sum, mul_assoc, ← (p _).eval₂_comp]
      _ = a₀ + b₀ + y₀ := by
          simp [← h_parts_sum, a₀, b₀, y₀, smul_def', mul_add, Finset.sum_add_distrib,
            ← IsScalarTower.algebraMap_apply]
  have h_ev_c : ev c = u * (G + y₀) := by simp [c, L, ev, κ, y₀, smul_def']
  have h_u : algebraMap A D u * -(ℓ : D) = 1 := by simpa using congrArg (algebraMap A D) hu
  simp only [mul_pow, hw, smul_def', map_add, map_one, map_mul, ← IsScalarTower.algebraMap_apply]
  linear_combination h_ev_expand + (ϖ : D) * h_ev_p + (ϖ * ℓ : D) * h_ev_c
    - (ϖ * (G + y₀) : D) * h_u

/-- Let `ℓ` be a unit of `A` and `ζ ∈ A` a root of the `ℓ`-th cyclotomic polynomial. Then the image
of `ζ` under any ring map `ψ` from `A` to a domain is a primitive `ℓ`-th root of unity. -/
private lemma isPrimitiveRoot_map_of_isRoot_cyclotomic {ℓ : ℕ} (hℓ : IsUnit (ℓ : A)) {ζ : A}
    (hζ : (cyclotomic ℓ A).IsRoot ζ) {S : Type} [CommRing S] [IsDomain S] (ψ : A →+* S) :
    IsPrimitiveRoot (ψ ζ) ℓ := by
  have h_neZero : NeZero (ℓ : S) := ⟨by simpa using (hℓ.map ψ).ne_zero⟩
  rw [← isRoot_cyclotomic_iff, ← map_cyclotomic ℓ ψ]
  exact hζ.map ψ

/-- Logarithms of roots of unity on a spectrum. Let `ℓ` be a unit of `A` and `ζ ∈ A` a root of the
`ℓ`-th cyclotomic polynomial. If `y ^ ℓ = 1` in an `A`-algebra `S`, then there is a locally constant
`e : Spec S → ℕ` such that `y - ζ ^ e p` lies in each prime `p` of `S`. -/
private lemma exists_locallyConstant_sub_pow_mem_of_pow_eq_one {ℓ : ℕ} [NeZero ℓ]
    (hℓ : IsUnit (ℓ : A)) {ζ : A} (hζ : (cyclotomic ℓ A).IsRoot ζ) {S : Type} [CommRing S]
    [Algebra A S] {y : S} (hy : y ^ ℓ = 1) :
    ∃ e : LocallyConstant (PrimeSpectrum S) ℕ, ∀ p : PrimeSpectrum S,
      y - algebraMap A S ζ ^ e p ∈ p.asIdeal := by
  -- In the domain `S / p`, the root of unity `y` is a power `ζ ^ i` with `i < ℓ`.
  have h_prim (p : PrimeSpectrum S) : IsPrimitiveRoot (algebraMap A (S ⧸ p.asIdeal) ζ) ℓ :=
    isPrimitiveRoot_map_of_isRoot_cyclotomic hℓ hζ _
  have h_exists (p : PrimeSpectrum S) :
      ∃ i < ℓ, algebraMap A (S ⧸ p.asIdeal) ζ ^ i = Ideal.Quotient.mk p.asIdeal y :=
    (h_prim p).eq_pow_of_pow_eq_one (by rw [← map_pow, hy, map_one])
  choose e h_lt he using h_exists
  refine ⟨⟨e, fun s ↦ ?_⟩, fun p ↦ Ideal.Quotient.eq.mp (he p).symm⟩
  -- The set of `p` with `e p ∈ s` is open: `y - ζ ^ i ∉ p` for all `i < ℓ` outside `s`.
  have h_eq : e ⁻¹' s = ⋂ i ∈ sᶜ ∩ Iio ℓ, (basicOpen (y - algebraMap A S ζ ^ i)).carrier := by
    ext p
    simp only [mem_preimage, mem_iInter, mem_inter_iff, mem_compl_iff, mem_Iio,
      TopologicalSpace.Opens.carrier_eq_coe, SetLike.mem_coe, mem_basicOpen,
      ← mk_eq_mk_iff_sub_mem, ← he, map_pow, Ideal.Quotient.mk_algebraMap]
    grind [(h_prim p).pow_inj (h_lt p)]
  rw [h_eq]
  exact (toFinite _).isOpen_biInter fun i _ ↦ isOpen_basicOpen

/-- Kummer theory. Let `A`, `D` be domains, `A`, `B`, `C` absolutely integrally closed, `ℓ` a prime
invertible in `A`, and `J`, `L`, `K` ideals of `B`, `C`, `D` with `J`, `L` mapping into `K`. If
every `ℓ`-th root of `1` in `D ⧸ K` lifts to some `W` with `W ^ ℓ = a * b`, `a ≡ 1` in `B ⧸ J` and
`b ≡ 1` in `C ⧸ L` (`h_factor`), then every locally constant `ZMod ℓ`-valued function on
`Spec (D ⧸ K)` is a difference of pull-backs from `Spec (B ⧸ J)` and `Spec (C ⧸ L)`. -/
lemma exists_locallyConstant_eq_sub_of_pow_eq_mul [IsDomain A] [IsDomain D] {ℓ : ℕ} [ThePrime ℓ]
    (hℓ : IsUnit (ℓ : A)) [IsAbsIntegrallyClosed A] [IsAbsIntegrallyClosed B]
    [IsAbsIntegrallyClosed C] {J : Ideal B} {L : Ideal C} {K : Ideal D}
    (hJK : J ≤ K.comap (algebraMap B D)) (hLK : L ≤ K.comap (algebraMap C D))
    (h_factor : ∀ w : D ⧸ K, w ^ ℓ = 1 → ∃ (a : B) (b : C) (W : D),
      W ^ ℓ = a * b ∧ mk J a = 1 ∧ mk L b = 1 ∧ w = mk K W)
    (v : (locConstSpec ⟨ZMod ℓ⟩).obj (.of (D ⧸ K))) :
    ∃ (a : (locConstSpec ⟨ZMod ℓ⟩).obj (.of (B ⧸ J)))
      (b : (locConstSpec ⟨ZMod ℓ⟩).obj (.of (C ⧸ L))),
      v = (locConstSpec ⟨ZMod ℓ⟩).map (ofHom (J.quotientMap K (algebraMap B D) hJK)) a -
        (locConstSpec ⟨ZMod ℓ⟩).map (ofHom (L.quotientMap K (algebraMap C D) hLK)) b := by
  -- Fix a primitive `ℓ`-th root of unity `ζ` in `A`. The function `ζ ^ v` is an `ℓ`-th root of `1`
  -- in `D ⧸ K`; lift it to `W = ζ ^ i * x * y` with `x`, `y` roots of `1` modulo `J`, `L`, and
  -- take logarithms to the base `ζ`.
  change LocallyConstant (PrimeSpectrum (D ⧸ K)) (ZMod ℓ) at v
  obtain ⟨ζ, hζ⟩ : ∃ x : A, (cyclotomic ℓ A).IsRoot x :=
    exists_root _ (cyclotomic.monic ℓ A) (by simp [NeZero.pos, natDegree_cyclotomic])
  -- `φ` turns a locally constant `u` with values in `A` into the element of `D ⧸ K` that equals
  -- `u p` in the localisation at each prime `p`.
  obtain ⟨φ, hφ⟩ : ∃ φ : LocallyConstant (PrimeSpectrum (D ⧸ K)) A →+* D ⧸ K,
      ∀ (u : LocallyConstant (PrimeSpectrum (D ⧸ K)) A) (q : PrimeSpectrum (D ⧸ K)),
        algebraMap (D ⧸ K) (Localization.AtPrime q.asIdeal) (φ u) =
          algebraMap A (Localization.AtPrime q.asIdeal) (u q) :=
    exists_ringHom_of_locallyConstant A (D ⧸ K)
  have hζ_pow : ζ ^ ℓ = 1 := (isPrimitiveRoot_map_of_isRoot_cyclotomic hℓ hζ (.id A)).pow_eq_one
  let z : LocallyConstant (PrimeSpectrum (D ⧸ K)) A := v.map fun x : ZMod ℓ ↦ ζ ^ x.val
  have h_root : z ^ ℓ = 1 :=
    LocallyConstant.ext fun p ↦ (pow_right_comm ζ (v p).val ℓ).trans (by simp [hζ_pow])
  obtain ⟨a, b, W, hW : W ^ ℓ = a * b, ha_one : mk J a = 1, hb_one : mk L b = 1,
      h_lift : φ z = mk K W⟩ :=
    h_factor (φ z) (by rw [← map_pow, h_root, map_one])
  obtain ⟨x, rfl⟩ : ∃ x : B, x ^ ℓ = a := exists_pow_eq ℓ a
  obtain ⟨y, rfl⟩ : ∃ y : C, y ^ ℓ = b := exists_pow_eq ℓ b
  -- `W` and `x * y` have the same `ℓ`-th power in the domain `D`.
  have hζ_D : IsPrimitiveRoot (algebraMap A D ζ) ℓ :=
    isPrimitiveRoot_map_of_isRoot_cyclotomic hℓ hζ (algebraMap A D)
  obtain ⟨i, -, rfl⟩ : ∃ i < ℓ, algebraMap A D ζ ^ i * (x * y) = W := by
    simpa [← mul_pow, ← mem_nthRoots, NeZero.pos, hζ_D.nthRoots_eq rfl] using hW
  obtain ⟨ex, hex : ∀ p : PrimeSpectrum (B ⧸ J), mk J x - (ζ : B ⧸ J) ^ ex p ∈ p.asIdeal⟩ :=
    exists_locallyConstant_sub_pow_mem_of_pow_eq_one hℓ hζ (y := mk J x) ha_one
  obtain ⟨ey, hey : ∀ p : PrimeSpectrum (C ⧸ L), mk L y - (ζ : C ⧸ L) ^ ey p ∈ p.asIdeal⟩ :=
    exists_locallyConstant_sub_pow_mem_of_pow_eq_one hℓ hζ (y := mk L y) hb_one
  refine ⟨ex.map fun m : ℕ ↦ (i : ZMod ℓ) + m, -ey.map fun m : ℕ ↦ (m : ZMod ℓ),
    LocallyConstant.ext fun p ↦ ?_⟩
  -- Let `η` be the image of `ζ` in the residue field of `p`. There `h_lift` reads
  -- `η ^ v = η ^ (i + ex + ey)`; as `η` has order `ℓ`, the exponents agree in `ZMod ℓ`.
  let ρ : D ⧸ K →+* p.asIdeal.ResidueField := algebraMap (D ⧸ K) p.asIdeal.ResidueField
  let η : p.asIdeal.ResidueField := ρ (algebraMap A (D ⧸ K) ζ)
  let pB : PrimeSpectrum (B ⧸ J) := p.comap (J.quotientMap K (algebraMap B D) hJK)
  let pC : PrimeSpectrum (C ⧸ L) := p.comap (L.quotientMap K (algebraMap C D) hLK)
  have hη : IsPrimitiveRoot η ℓ :=
    isPrimitiveRoot_map_of_isRoot_cyclotomic hℓ hζ (ρ.comp (algebraMap A (D ⧸ K)))
  -- `x` and `y` are powers of `η` at `p`, by `hex` and `hey` at the primes `pB` and `pC` below `p`
  have hx : ρ (algebraMap B (D ⧸ K) x) = η ^ ex pB := by
    simpa +zetaDelta [← p.asIdeal.algebraMap_residueField_eq_zero, sub_eq_zero,
      ← algebraMap_apply] using hex pB
  have hy : ρ (algebraMap C (D ⧸ K) y) = η ^ ey pC := by
    simpa +zetaDelta [← p.asIdeal.algebraMap_residueField_eq_zero, sub_eq_zero,
      ← algebraMap_apply] using hey pC
  -- `hφ` at `p`, read in the residue field, which is reached through the localisation at `p`
  have hv : ρ (φ z) = η ^ (v p).val := by
    simp only [ρ, η]
    rw [algebraMap_apply (D ⧸ K) (Localization.AtPrime p.asIdeal) _ (φ z), hφ, ← algebraMap_apply,
      ← algebraMap_apply, ← map_pow, LocallyConstant.map_apply, Function.comp_apply]
  have h_pow : η ^ (i + ex pB + ey pC) = η ^ (v p).val := by
    simpa [pow_add, hx, hy, h_lift, mul_assoc] using hv
  have h_sum : (i : ZMod ℓ) + ex pB + ey pC = v p := by
    simpa [(hη.isOfFinOrder NeZero.out).pow_eq_pow_iff_modEq, ← hη.eq_orderOf,
      ← ZMod.natCast_eq_natCast_iff] using h_pow
  exact h_sum.symm.trans (sub_neg_eq_add ((i : ZMod ℓ) + ex pB) (ey pC : ZMod ℓ)).symm

/-- The condition on the chart `R[1 / a]` of a line modulo the ideal `I` of `R`: `a * (a - 1) ∈ I`,
or the equation `ε + r * ε ^ 2 = 1` has a solution `ε ∈ R` for every `r ∈ I`. -/
def IsLineChartCase {R : Type} [CommRing R] (I : Ideal R) (a : R) : Prop :=
  a * (a - 1) ∈ I ∨ ∀ r ∈ I, ∃ ε : R, ε + r * ε ^ 2 = 1

omit [Away s D] in
/-- The case of a chart `B = A[1 / a]` in `exists_eq_locConstSpec_map_sub_map`. Let `1 - t = 1 / a`
in `B` and `s - 1 = 1 / (a - 1)` in `C`, let no element of the ideal `I` be a unit in `D`, and let
`a (a - 1) ∈ I` or `ε + r ε ^ 2 = 1` be solvable in `A` for every `r ∈ I`. If `w ^ ℓ - 1 = ϖ G` in
`D` with `ϖ ∈ I`, then `w ^ ℓ = (1 + ϖ e) (1 + ϖ f)` in `D` for some `e ∈ B` and `f ∈ C`. -/
private lemma exists_pow_eq_mul_of_away {a : A} (ha : algebraMap A B a * (1 - t) = 1)
    (ha_sub : (algebraMap A C a - 1) * (s - 1) = 1) [Away a B] (h_case : IsLineChartCase I a)
    (h_no_unit : ¬∃ i ∈ I, IsUnit (algebraMap A D i)) {ℓ : ℕ} {w G : D} {ϖ : A} (hϖ : ϖ ∈ I)
    (hG : w ^ ℓ - 1 = algebraMap A D ϖ * G) :
    ∃ (e : B) (f : C), w ^ ℓ = (1 + ϖ • e : B) * (1 + ϖ • f : C) := by
  -- `D = A[1 / (a (a - 1))]`, because `a - 1` and `t` differ by the unit `1 - t` of `B = A[1 / a]`.
  have h_assoc : Associated (algebraMap A B (a - 1)) t :=
    ⟨.mkOfMulEqOne (1 - t) (algebraMap A B a) (by rw [mul_comm, ha]), by simp [sub_mul, ha]⟩
  have h_loc : Away (a * (a - 1)) D := .mul_of_associated a (a - 1) t h_assoc
  obtain ⟨m, j, hj⟩ : ∃ (m : ℕ) (j : A), G * algebraMap A D (a * (a - 1)) ^ m = algebraMap A D j :=
    h_loc.surj _ G
  obtain ⟨c, d, hcd⟩ : IsCoprime (a ^ m) ((a - 1) ^ m) := .pow (.sub_one_right_of_dvd dvd_rfl)
  -- `a (a - 1)` is a unit of `D`, so it is not in `I`.
  obtain ⟨ε, hε⟩ : ∃ ε : A, ε + c * d * j * ϖ * ε ^ 2 = 1 :=
    h_case.resolve_left (fun h ↦ h_no_unit ⟨_, h, h_loc.algebraMap_isUnit⟩) _ (I.mul_mem_left _ hϖ)
  refine ⟨ε • j • d • (1 - t) ^ m, ε • j • c • (s - 1) ^ m, ?_⟩
  -- In `D` let `U = (1 - t) ^ m` and `V = (s - 1) ^ m`, the inverses of `a ^ m` and `(a - 1) ^ m`.
  simp only [Algebra.smul_def, map_add, map_one, map_mul, map_pow, map_sub, ← algebraMap_apply]
  set U : D := (1 - (t : D)) ^ m
  set V : D := ((s : D) - 1) ^ m
  have h_U : (a : D) ^ m * U = 1 := by
    simpa [U, ← algebraMap_apply, ← mul_pow] using congrArg (fun x : B ↦ (x : D) ^ m) ha
  have h_V : ((a : D) - 1) ^ m * V = 1 := by
    simpa [V, ← algebraMap_apply, ← mul_pow] using congrArg (fun x : C ↦ (x : D) ^ m) ha_sub
  have h_cd : (c : D) * a ^ m + d * (a - 1) ^ m = 1 := by
    simpa using congrArg (algebraMap A D) hcd
  have h_j : G * (a ^ m * (a - 1) ^ m) = j := by rwa [map_mul, map_sub, map_one, mul_pow] at hj
  have h_ε : (ε : D) + c * d * j * ϖ * ε ^ 2 = 1 := by simpa using congrArg (algebraMap A D) hε
  have h_sum : d * U + c * V = U * V := by
    linear_combination U * V * h_cd - c * V * h_U - d * U * h_V
  have h_G : j * U * V = G := by
    linear_combination G * (a - 1) ^ m * V * h_U + G * h_V - U * V * h_j
  calc w ^ ℓ = 1 + ϖ * (j * U * V) * (ε + c * d * j * ϖ * ε ^ 2) := by
        rw [h_G, h_ε, mul_one, ← hG, add_sub_cancel]
    _ = (1 + ϖ * (ε * (j * (d * U)))) * (1 + ϖ * (ε * (j * (c * V)))) := by
        linear_combination -(ϖ * ε * j) * h_sum

/-- Two charts of a line modulo `I`: clopens of `Spec (B ⧸ J)` and `Spec (C ⧸ L)` with the same
preimage in `Spec (D ⧸ K)` are the basic opens of one element of `A`. Here `D = B[1 / t] = C[1 / s]`
with `t * s = 1` in `D` (`hts`), `D` is integral over `A[t, s]` (`hD`), `A` maps onto the
fibre product `B ×_D C` (`hA_onto`), and every element of an extension of `I` is a multiple of
the image of one element of `I` (`hI`). The ideals `J`, `L`, `K` are the extensions of `I` to
`B`, `C`, `D`. -/
lemma exists_eq_basicOpen_of_isClopen_of_preimage_eq (hts : (t * s : D) = 1)
    (hD : ∀ x : D, IsIntegral A[(t : D), (s : D)] x)
    (hA_onto : ∀ (x : B) (y : C), (x : D) = y → (x, y) ∈ range (algebraMap A (B × C)))
    (hI : ∀ {E : Type} [CommRing E] (ψ : A →+* E), ∀ x ∈ I.map ψ, ∃ i ∈ I, ψ i ∣ x)
    {J : Ideal B} {L : Ideal C} {K : Ideal D} (hJ : I.map (algebraMap A B) = J)
    (hL : I.map (algebraMap A C) = L) (hK : I.map (algebraMap A D) = K)
    (hJK : J ≤ K.comap (algebraMap B D)) (hLK : L ≤ K.comap (algebraMap C D))
    {x : Set (PrimeSpectrum (B ⧸ J))} {y : Set (PrimeSpectrum (C ⧸ L))}
    (hx : IsClopen x) (hy : IsClopen y)
    (h_preimage : PrimeSpectrum.comap (J.quotientMap K (algebraMap B D) hJK) ⁻¹' x =
      PrimeSpectrum.comap (L.quotientMap K (algebraMap C D) hLK) ⁻¹' y) :
    ∃ k : A, x = basicOpen (k : B ⧸ J) ∧ y = basicOpen (k : C ⧸ L) := by
  let r : B ⧸ J →+* D ⧸ K := J.quotientMap K (algebraMap B D) hJK
  let q : C ⧸ L →+* D ⧸ K := L.quotientMap K (algebraMap C D) hLK
  -- Clopens are basic opens of idempotents; lift the idempotents to `u ∈ B` and `v ∈ C`.
  obtain ⟨e, he : IsIdempotentElem e, rfl : x = basicOpen e⟩ := PrimeSpectrum.isClopen_iff.mp hx
  obtain ⟨f, hf : IsIdempotentElem f, rfl : y = basicOpen f⟩ := PrimeSpectrum.isClopen_iff.mp hy
  obtain ⟨u, rfl⟩ : ∃ u : B, mk J u = e := mk_surjective e
  obtain ⟨v, rfl⟩ : ∃ v : C, mk L v = f := mk_surjective f
  -- the images of `u` and `v` in `D / K` are idempotents with the same basic open, so they agree
  have huv : mk K (u : D) = mk K (v : D) :=
    basicOpen_injOn_isIdempotentElem (he.map r) (hf.map q) (SetLike.ext' h_preimage)
  have h_idem : IsIdempotentElem (mk K (v : D)) := hf.map q
  subst hJ hL hK
  -- `hI` for the ring `D × D` gives one `ϖ ∈ I` that divides both elements
  have h_mem : ((u : D) * (1 - v), (v : D) * (1 - u)) ∈
      I.map ((algebraMap A D).prod (algebraMap A D)) := by
    apply (Ideal.ideal_prod_eq _).ge
    rw [Ideal.mem_prod, I.map_map, I.map_map, RingHom.fst_comp_prod, RingHom.snd_comp_prod]
    -- Both products vanish in the quotient since the images are the same idempotent.
    constructor <;> rw [← eq_zero_iff_mem, map_mul, map_sub, map_one, huv,
      h_idem.mul_one_sub_self]
  obtain ⟨ϖ, hϖ, ⟨α, β⟩, h_div⟩ := hI _ _ h_mem
  obtain ⟨hα, hβ⟩ : (u : D) * (1 - v) = ϖ • α ∧ (v : D) * (1 - u) = ϖ • β := by
    simpa [Algebra.smul_def] using h_div
  obtain ⟨k, hku, hkv⟩ : ∃ k : A,
      (k : B ⧸ I.map (algebraMap A B)) = mk (I.map (algebraMap A B)) u ∧
      (k : C ⧸ I.map (algebraMap A C)) = mk (I.map (algebraMap A C)) v :=
    exists_common_lift_of_isIdempotentElem I t s hts hD hA_onto he hf hϖ hα hβ
  exact ⟨k, by rw [hku], by rw [hkv]⟩

/-- Two charts of a line modulo `I`: every locally constant function `Spec (D ⧸ K) → ZMod ℓ` is the
difference of the pull-backs of locally constant functions on `Spec (B ⧸ J)` and `Spec (C ⧸ L)`.
Here `D = B[1 / t] = C[1 / s]` with `t * s = 1` in `D` (`hts`), `D` is integral over `A[t, s]`
(`hD`), `A` and `D` are domains, `A`, `B`, `C` are absolutely integrally closed, and the prime `ℓ`
is a unit of `A`. Either `A` is local (`IsAbsIntegrallyClosedLocal A`: absolutely integrally closed,
and if `a + b = 1` then `a` or `b` is a unit), or `B = A[1 / a]` with `1 - t = 1 / a` in `B`,
`s - 1 = 1 / (a - 1)` in `C`, and `a (a - 1) ∈ I` or `ε + r ε ^ 2 = 1` solvable in `A` for every
`r ∈ I` (`h_cases`, with `IsLineChartCase I a`). Every element of an extension of `I` is a multiple
of the image of one element of `I` (`hI`). The ideals `J`, `L`, `K` are the extensions of `I` to
`B`, `C`, `D`. -/
lemma exists_eq_locConstSpec_map_sub_map (hts : (t * s : D) = 1)
    (hD : ∀ x : D, IsIntegral A[(t : D), (s : D)] x)
    [IsDomain A] [IsDomain D] {ℓ : ℕ} [ThePrime ℓ] (hℓ : IsUnit (ℓ : A))
    [IsAbsIntegrallyClosed A] [IsAbsIntegrallyClosed B] [IsAbsIntegrallyClosed C]
    (h_cases : (∃ a : A, algebraMap A B a * (1 - t) = 1 ∧ (algebraMap A C a - 1) * (s - 1) = 1 ∧
      Away a B ∧ IsLineChartCase I a) ∨ IsAbsIntegrallyClosedLocal A)
    (hI : ∀ {E : Type} [CommRing E] (ψ : A →+* E), ∀ x ∈ I.map ψ, ∃ i ∈ I, ψ i ∣ x)
    {J : Ideal B} {L : Ideal C} {K : Ideal D} (hJ : I.map (algebraMap A B) = J)
    (hL : I.map (algebraMap A C) = L) (hK : I.map (algebraMap A D) = K)
    (hJK : J ≤ K.comap (algebraMap B D)) (hLK : L ≤ K.comap (algebraMap C D))
    (u : (locConstSpec ⟨ZMod ℓ⟩).obj (.of (D ⧸ K))) :
    ∃ (a : (locConstSpec ⟨ZMod ℓ⟩).obj (.of (B ⧸ J)))
      (b : (locConstSpec ⟨ZMod ℓ⟩).obj (.of (C ⧸ L))),
      u = (locConstSpec ⟨ZMod ℓ⟩).map (ofHom (J.quotientMap K (algebraMap B D) hJK)) a -
        (locConstSpec ⟨ZMod ℓ⟩).map (ofHom (L.quotientMap K (algebraMap C D) hLK)) b := by
  -- By Kummer theory it suffices to change each `ℓ`-th root of `1` modulo `K = ID` so that its
  -- `ℓ`-th power is a product of elements of `B` and `C` that are `1` modulo `I`.
  suffices h_factor : ∀ w : D, mk K w ^ ℓ = 1 → ∃ (a : B) (b : C) (W : D),
      W ^ ℓ = a * b ∧ mk J a = 1 ∧ mk L b = 1 ∧ mk K w = mk K W from
    exists_locallyConstant_eq_sub_of_pow_eq_mul hℓ hJK hLK (mk_surjective.forall.mpr h_factor) u
  subst hJ hL hK
  intro w hw
  have h_zero {E : Type} [CommRing E] (ψ : A →+* E) {i : A} (hi : i ∈ I) : mk (I.map ψ) (ψ i) = 0 :=
    eq_zero_iff_mem.mpr (I.mem_map_of_mem ψ hi)
  by_cases h_unit : ∃ i ∈ I, IsUnit (i : D)
  · -- then `D / ID` is the zero ring
    obtain ⟨i, hi, hi_unit⟩ := h_unit
    refine ⟨1, 1, 1, ?_⟩
    simp [← (hi_unit.map (algebraMap D (D ⧸ I.map (algebraMap A D)))).mul_right_inj, h_zero _ hi]
  obtain ⟨ϖ, hϖ : ϖ ∈ I, G, hG : w ^ ℓ - 1 = ϖ * G⟩ := hI _ _ (Ideal.Quotient.eq.mp hw)
  obtain ⟨a, ha, ha_sub, h_away, h_case⟩ | h_local := h_cases
  · obtain ⟨e, f, h_pow_eq⟩ : ∃ (e : B) (f : C), w ^ ℓ = (1 + ϖ • e : B) * (1 + ϖ • f : C) :=
      exists_pow_eq_mul_of_away I t s ha ha_sub h_case h_unit hϖ hG
    exact ⟨1 + ϖ • e, 1 + ϖ • f, w, h_pow_eq, by simp [smul_def', h_zero _ hϖ]⟩
  · have hϖ_nonunit : ¬IsUnit ϖ := fun h ↦ h_unit ⟨ϖ, hϖ, h.map (algebraMap A D)⟩
    obtain ⟨a, b, c, h_pow_eq⟩ : ∃ (a : B) (b : C) (c : D),
        (w * (1 + ϖ • c)) ^ ℓ = (1 + ϖ • a : B) * (1 + ϖ • b : C) :=
      exists_pow_eq_mul_of_local t s hts hD hℓ hϖ_nonunit
        (by rw [Algebra.smul_def, ← hG, add_sub_cancel])
    exact ⟨1 + ϖ • a, 1 + ϖ • b, w * (1 + ϖ • c), h_pow_eq, by simp [smul_def', h_zero _ hϖ]⟩

end New.Variety
end
end

/-!
# Splitting absolutely integrally closed subrings with a Mayer–Vietoris sequence

This file gives a splitting step in an induction over the absolutely integrally closed subrings of
an algebraically closed field `K` that contain the image of `γ : D →+* K`. A subring `B` of this
kind that is not a valuation ring is replaced by the integral closures of `B[t]` and `B[1 / t]`,
as in the cover of a projective line by two charts. These two larger rings fit into a short exact
Mayer–Vietoris sequence of locally constant `ZMod ℓ`-valued functions on the spectra modulo `J`.

## Main definitions and results

* `New.Variety.absIntegrallyClosedSubrings`: the absolutely integrally closed subrings of `K`
  containing the image of `γ`.
* `New.Variety.absIntegrallyClosedSubrings.quotientFunctor`: the functor `B ↦ B / J B` on these
  subrings.
* `New.Variety.absIntegrallyClosedSubrings.exists_isSplitting_isMayerVietorisExact`: the two larger
  rings and a short exact Mayer–Vietoris sequence of locally constant `ZMod ℓ`-valued functions on
  the spectra modulo `J`.

Notions from other files:
* `New.Variety.IsAbsIntegrallyClosed`: A is absolutely integrally closed: every monic polynomial
  over A of positive degree has a root in A.
* `New.ThePrime`: `ThePrime ℓ` fixes the prime `ℓ` (it extends `Fact ℓ.Prime`).
* `New.Variety.locConstSpec`: For an abelian group Λ, the functor on commutative rings sending A to
  the group of locally constant functions Spec A → Λ; it sends a ring map to pull-back along the map
  of spectra.
* `New.Variety.IsLineChartCase` (in `Lib.Cohomology.ProperBaseChange.LineCharts`): the condition on
  the chart `R[1 / a]` of a line modulo an ideal `I` of `R`.

## Relation to the literature

Known; see `Lib.Cohomology.ProperBaseChange.Theorem` for sources.
-/

@[expose] public section

section SubringSplitting

namespace New.Variety

open CategoryTheory CommRingCat Subring Ideal.Quotient IsLocalization Away PrimeSpectrum Fact
  LocallyConstant IsLocalRing Ideal LocalSubring

variable {ℓ : ℕ} {K : Type} [ThePrime ℓ] [Field K] {S T U : Subring K}
  [h : Fact (S ≤ T)] {D : CommRingCat} (J : Ideal D) (γ : D →+* K)

/-- The absolutely integrally closed subrings of `K` that contain the image of `γ`. -/
def absIntegrallyClosedSubrings : Set (Subring K) :=
  {B : Subring K | γ.range ≤ B ∧ IsAbsIntegrallyClosed B}

lemma absIntegrallyClosedSubrings.range_le {γ : D →+* K} (B : absIntegrallyClosedSubrings γ) :
  γ.range ≤ B.val := B.prop.1

lemma absIntegrallyClosedSubrings.isAbsIntegrallyClosed {γ : D →+* K}
    (B : absIntegrallyClosedSubrings γ) : IsAbsIntegrallyClosed B.val := B.prop.2

/-- For `B` in `absIntegrallyClosedSubrings γ`, the map `γ : D → K` with its values in `B`. -/
def absIntegrallyClosedSubrings.toRingHom {γ : D →+* K} (B : absIntegrallyClosedSubrings γ) :
    D →+* B.val :=
  γ.codRestrict B.val fun d ↦ B.prop.1 ⟨d, rfl⟩

/-- The ideal `J B` of `B` generated by the image of the ideal `J` of `D` under `γ`, which lands in
`B`. -/
abbrev absIntegrallyClosedSubrings.extendedIdeal (B : absIntegrallyClosedSubrings γ) :
    Ideal B.val :=
  J.map (γ.codRestrict B.val fun d ↦ B.prop.1 ⟨d, rfl⟩)

/-- The functor `B ↦ B / J B` on `absIntegrallyClosedSubrings γ`, ordered by inclusion. -/
def absIntegrallyClosedSubrings.quotientFunctor : absIntegrallyClosedSubrings γ ⥤ CommRingCat where
  obj B := of (B.val ⧸ extendedIdeal J γ B)
  map {B B'} l :=
    ofHom (quotientMap (extendedIdeal J γ B') (inclusion l.le) (map_le_of_le_comap le_comap_map))

/-- For `B ≤ B'` in `absIntegrallyClosedSubrings γ`, the ideal `J B` extends along the inclusion
`B → B'` to `J B'`. -/
lemma absIntegrallyClosedSubrings.map_extendedIdeal {B B' : absIntegrallyClosedSubrings γ}
    (h_le : B ≤ B') : (extendedIdeal J γ B).map (inclusion h_le) = extendedIdeal J γ B' :=
  J.map_map _ (inclusion h_le)

/-- Let divisibility in `D` be total (`PreValuationRing D`), and let `ψ : B → E` be a ring map. If
`x` lies in the extension of `J B` along `ψ`, then `ψ i` divides `x` for one `i ∈ J B`. -/
lemma absIntegrallyClosedSubrings.exists_mem_extendedIdeal_dvd [PreValuationRing D]
    (B : absIntegrallyClosedSubrings γ) {E : Type} [CommRing E] (ψ : B.val →+* E) (x : E)
    (hx : x ∈ (extendedIdeal J γ B).map ψ) : ∃ i ∈ extendedIdeal J γ B, ψ i ∣ x := by
  -- The extension of `J B` along `ψ` is the extension of `J` along `ψ ∘ ι`, for `ι : D → B`.
  let ι : D →+* B.val := toRingHom B
  obtain ⟨d, hd, hdx⟩ : ∃ d ∈ J, (ψ.comp ι) d ∣ x :=
    exists_map_dvd_of_mem_map ((J.map_map ι ψ).le hx)
  exact ⟨ι d, mem_map_of_mem ι hd, hdx⟩

/-- If `ℓ` is invertible in `D`, then it is invertible in every member of
`absIntegrallyClosedSubrings γ`. -/
lemma absIntegrallyClosedSubrings.isUnit_natCast_of_isUnit {γ : D →+* K} {ℓ : ℕ}
    (hℓ : IsUnit (ℓ : D)) (B : absIntegrallyClosedSubrings γ) : IsUnit (ℓ : B.val) := by
  simpa using hℓ.map (toRingHom B)

/-- For subrings `S ≤ T` of `K` (the instance `Fact (S ≤ T)`), `T` is an `S`-algebra through the
inclusion. -/
instance : Algebra S T := (inclusion h.out).toAlgebra

/-- The inclusions of subrings `S ≤ T ≤ U` of `K` form a scalar tower. -/
instance [Fact (T ≤ U)] [Fact (S ≤ U)] : IsScalarTower S T U := .of_algebraMap_eq' rfl

variable [IsAlgClosed K] in
/-- An absolutely integrally closed subring of `K` is integrally closed in `K`. -/
local instance [a : IsAbsIntegrallyClosed S] : IsIntegrallyClosedIn S K :=
  isIntegrallyClosedIn_iff.mpr ⟨S.subtype_injective, a.mem_range_of_isIntegralElem⟩

/-- Let `S ≤ T` be subrings of `K` with `S` absolutely integrally closed, and let `y ∈ T` be the
inverse of `x ∈ S`. If `T` lies in every absolutely integrally closed subring that contains `S` and
`y`, then `T` is the localisation of `S` away from `x`. Here `T` is an `S`-algebra through the
inclusion. -/
lemma IsAbsIntegrallyClosed.isLocalization_away {S T : Subring K} [h : Fact (S ≤ T)]
    (hS : IsAbsIntegrallyClosed S) (x : S) {y : K} (hy : y ∈ T) (h_inv : (x : K) * y = 1)
    (h_min : ∀ {U : Subring K}, IsAbsIntegrallyClosed U → S ≤ U → y ∈ U → T ≤ U) :
    IsLocalization.Away x T := by
  let φ := Localization.awayLift S.subtype x (.of_mul_eq_one y h_inv)
  have hφ (r : S) : φ (algebraMap S _ r) = r := lift_eq x _ r
  -- Every `z ∈ T` lies in `φ.range`, so `z = r / x ^ n` with `r ∈ S`; and `x` is a unit of `T`.
  refine .mk x (.of_mul_eq_one ⟨y, hy⟩ (Subtype.ext h_inv)) (fun z ↦ ?_)
    fun a b hab ↦ ⟨0, by rw [inclusion_injective h.out hab]⟩
  obtain ⟨u, hu⟩ := h_min ((hS.of_isLocalization (.powers x)).of_surjective
    φ.rangeRestrict_surjective) (fun r hr ↦ ⟨_, hφ ⟨r, hr⟩⟩)
    ⟨invSelf x, mul_left_cancel₀ (left_ne_zero_of_mul_eq_one h_inv)
      (by rw [h_inv, ← hφ x, ← map_mul, mul_invSelf, map_one])⟩ z.prop
  obtain ⟨n, r, hr⟩ := surj x u
  exact ⟨n, r, Subtype.ext (show (z : K) * (x : K) ^ n = r by
    rw [← hu, ← hφ x, ← map_pow, ← map_mul, hr, hφ])⟩

/-- An element `a` of a subring `S` of a field `F` with `a ≠ 0` and `a⁻¹ ∈ S` is a unit of `S`. -/
lemma _root_.Subring.isUnit_of_inv_mem {F : Type*} [Field F] {S : Subring F} (a : S)
    (ha : (a : F) ≠ 0) (h_mem : (a : F)⁻¹ ∈ S) : IsUnit a :=
  .of_mul_eq_one ⟨(a : F)⁻¹, h_mem⟩ (Subtype.ext (mul_inv_cancel₀ ha))

/-- Let `b` be an element of a subring `S` of a field `F` such that neither `b` nor `1 - b` is a
unit of `S`. Then `t = 1 - b⁻¹` satisfies `t ∉ S`, `t⁻¹ ∉ S` and `b * (1 - t) = 1`. -/
lemma _root_.Subring.exists_notMem_and_inv_notMem_of_not_isUnit {F : Type*} [Field F]
    {S : Subring F} (b : S) (hb : ¬IsUnit b) (h_one_sub : ¬IsUnit (1 - b)) :
    ∃ t : F, t ∉ S ∧ t⁻¹ ∉ S ∧ b * (1 - t) = 1 := by
  -- With `t = 1 - b⁻¹`, `1 - t = b⁻¹` and `t⁻¹ = 1 - (1 - b)⁻¹`.
  have hb_ne_zero : (b : F) ≠ 0 := fun h ↦ h_one_sub (by simp [ZeroMemClass.coe_eq_zero.mp h])
  have h_sub_ne_zero : 1 - (b : F) ≠ 0 := fun h ↦
    hb (by simp [show b = 1 from Subtype.ext (sub_eq_zero.mp h).symm])
  refine ⟨1 - (b : F)⁻¹, fun h_mem ↦ hb ?_, fun h_mem ↦ h_one_sub ?_, by simp [hb_ne_zero]⟩
  · exact Subring.isUnit_of_inv_mem b hb_ne_zero (by simpa using S.sub_mem S.one_mem h_mem)
  · have h_inv : (1 - (b : F))⁻¹ = 1 - (1 - (b : F)⁻¹)⁻¹ := by grind
    have h_inv_mem : (1 - (b : F))⁻¹ ∈ S := by
      simpa only [h_inv] using S.sub_mem S.one_mem h_mem
    exact Subring.isUnit_of_inv_mem (1 - b) h_sub_ne_zero h_inv_mem

/-- Let `K` be an algebraically closed field, `S` an absolutely integrally closed subring of `K`
that is not a valuation ring of `K`, and `I` an ideal of `S`. Then there is `t ∈ K` with `t ∉ S` and
`t⁻¹ ∉ S` such that either `1 - t` is the inverse of some `b ∈ S`, and `b * (b - 1) ∈ I` or the
equation `ε + r * ε ^ 2 = 1` has a solution `ε ∈ S` for every `r ∈ I` (`IsLineChartCase I b`); or
`S` is local (`IsAbsIntegrallyClosedLocal S`).

These are the two cases that `exists_eq_locConstSpec_map_sub_map` allows. -/
lemma IsAbsIntegrallyClosed.exists_notMem_and_inv_notMem
    (hS : IsAbsIntegrallyClosed S) (I : Ideal S) (h_not_val : ¬∀ x : K, x ∈ S ∨ x⁻¹ ∈ S) :
    ∃ t : K, t ∉ S ∧ t⁻¹ ∉ S ∧
      ((∃ b : S, b * (1 - t) = 1 ∧ IsLineChartCase I b) ∨ IsAbsIntegrallyClosedLocal S) := by
  -- Suppose that no `t` works. Then `S` is local, and any `t` with `t, t⁻¹ ∉ S`, which exists as
  -- `S` is not a valuation ring, lies in the second case.
  by_contra h_none
  -- If neither `b` nor `1 - b` were a unit, then `t = 1 - b⁻¹` would lie in the first case.
  have isUnit_or_isUnit_one_sub (b : S) (hb : IsLineChartCase I b) : IsUnit b ∨ IsUnit (1 - b) := by
    by_contra! ⟨hb_nonunit, h_one_sub_nonunit⟩
    obtain ⟨t, ht, ht_inv, h_mul⟩ :=
      Subring.exists_notMem_and_inv_notMem_of_not_isUnit b hb_nonunit h_one_sub_nonunit
    exact h_none ⟨t, ht, ht_inv, .inl ⟨b, h_mul, hb⟩⟩
  -- For a root `ρ` of `X ^ 2 - X - r`, one of `ρ`, `1 - ρ` is a unit, and its inverse is an `ε`.
  have h_solve (r : S) (hr : r ∈ I) : ∃ ε : S, ε + r * ε ^ 2 = 1 := by
    obtain ⟨ρ, hρ⟩ : ∃ ρ : S, ρ ^ 2 - 1 * ρ = r := hS.exists_pow_sub_mul_eq 2 1 r
    have h_prod : ρ * (ρ - 1) = r := by linear_combination hρ
    obtain h_unit | h_unit := isUnit_or_isUnit_one_sub ρ (Or.inl (by rwa [h_prod]))
    · obtain ⟨ε, hε⟩ : ∃ ε : S, ρ * ε = 1 := h_unit.exists_right_inv
      exact ⟨ε, by linear_combination (ρ * ε - ε + 1) * hε - ε ^ 2 * h_prod⟩
    · obtain ⟨ε, hε⟩ : ∃ ε : S, (1 - ρ) * ε = 1 := h_unit.exists_right_inv
      exact ⟨ε, by linear_combination (1 - ρ * ε) * hε - ε ^ 2 * h_prod⟩
  -- So `S` is local: if `a + b = 1`, then `a` or `b = 1 - a` is a unit.
  have h_local : IsAbsIntegrallyClosedLocal S :=
    { hS with
      isUnit_or_isUnit_of_add_one {a b : S} (hab : a + b = 1) := by
        rw [eq_sub_of_add_eq' hab]
        exact isUnit_or_isUnit_one_sub a (Or.inr h_solve) }
  obtain ⟨t, ht, ht_inv⟩ : ∃ t : K, t ∉ S ∧ t⁻¹ ∉ S := by simpa using h_not_val
  exact h_none ⟨t, ht, ht_inv, .inr h_local⟩

/-- The integral closure in `K` of the subring `S[s]` generated by `S` and `s`. -/
def integralClosureAdjoin (S : Subring K) (s : K) : Subring K :=
  (integralClosure ↥(S ⊔ closure {s}) K).toSubring

/-- For a subring `U` of `K` that is integrally closed in `K`, the integral closure of `S[s]` lies
in `U` if and only if `S ≤ U` and `s ∈ U`. -/
lemma integralClosureAdjoin_le_iff {s : K} [IsIntegrallyClosedIn U K] :
    integralClosureAdjoin S s ≤ U ↔ S ≤ U ∧ s ∈ U := by
  refine integralClosure_subring_le_iff.trans (sup_le_iff.trans ?_)
  rw [Subring.closure_le, Set.singleton_subset_iff, SetLike.mem_coe]

/-- The integral closure of `S[s]` in the algebraically closed field `K` is absolutely integrally
closed. -/
lemma isAbsIntegrallyClosed_integralClosureAdjoin [IsAlgClosed K] (S : Subring K) (s : K) :
    IsAbsIntegrallyClosed (integralClosureAdjoin S s) := by
  unfold integralClosureAdjoin
  exact .of_isIntegrallyClosedIn K

/-- The integral closure of `S[s]` in `K` contains `S`. -/
lemma le_integralClosureAdjoin [IsAlgClosed K]
    (S : Subring K) (s : K) : S ≤ integralClosureAdjoin S s := by
  -- gives the instance `IsIntegrallyClosedIn` that `integralClosureAdjoin_le_iff` needs
  have := isAbsIntegrallyClosed_integralClosureAdjoin S s
  exact (integralClosureAdjoin_le_iff.mp le_rfl).left

/-- The integral closure of `S[s]` in `K` contains `s`. -/
lemma mem_integralClosureAdjoin [IsAlgClosed K]
    (S : Subring K) (s : K) : s ∈ integralClosureAdjoin S s := by
  -- gives the instance `IsIntegrallyClosedIn` that `integralClosureAdjoin_le_iff` needs
  have := isAbsIntegrallyClosed_integralClosureAdjoin S s
  exact (integralClosureAdjoin_le_iff.mp le_rfl).right

/-- Let `S` be an absolutely integrally closed subring of `K`, and `t ∈ K` with `b * (1 - t) = 1`
for some `b ∈ S`. Then the integral closure of `S[t]` is the localisation of `S` away from `b`; it
is an `S`-algebra through the inclusion. -/
lemma IsAbsIntegrallyClosed.isLocalization_away_integralClosureAdjoin [IsAlgClosed K]
    {S : Subring K}
    (hS : IsAbsIntegrallyClosed S) {t : K} [h : Fact (S ≤ integralClosureAdjoin S t)] (b : S)
    (hb : b * (1 - t) = 1) : IsLocalization.Away b (integralClosureAdjoin S t) := by
  refine hS.isLocalization_away b (sub_mem (one_mem _) (mem_integralClosureAdjoin S t)) hb
    fun {U} _ hU h_mem ↦ integralClosureAdjoin_le_iff.mpr ⟨hU, ?_⟩
  -- `t = 1 - (1 - t)` lies in `U`.
  simpa using sub_mem (one_mem U) h_mem

/-- Let `S ≤ T` be subrings of `K`, so that `T` is an `S`-algebra, and let `s, t ∈ T`. If `T` lies
in the subring generated by the integral closures of `S[s]` and `S[t]`, then every `x ∈ T` is
integral over the `S`-subalgebra `S[s, t]` of `T`. -/
lemma isIntegral_adjoin_pair_of_le_sup {S T : Subring K} [h : Fact (S ≤ T)] (s t : T)
    (hT : T ≤ integralClosureAdjoin S s ⊔ integralClosureAdjoin S t) (x : T) :
    IsIntegral (Algebra.adjoin S {s, t}) x := by
  let L : Subalgebra S T := Algebra.adjoin S {s, t}
  let N : Subalgebra L K := integralClosure L K
  -- For `u ∈ L`, the integral closure of `S[u]` lies in the integral closure `N` of `L` in `K`.
  have hS_le_N : S ≤ N.toSubring := fun b hb ↦ N.algebraMap_mem (algebraMap S L ⟨b, hb⟩)
  have h_le_N (u : T) (hu : u ∈ L) : integralClosureAdjoin S u ≤ N.toSubring :=
    integralClosureAdjoin_le_iff.mpr ⟨hS_le_N, N.algebraMap_mem ⟨u, hu⟩⟩
  have h_sup_le : integralClosureAdjoin S s ⊔ integralClosureAdjoin S t ≤ N.toSubring :=
    sup_le (h_le_N s (Algebra.subset_adjoin (by simp))) (h_le_N t (Algebra.subset_adjoin (by simp)))
  have hx : IsIntegral L (algebraMap T K x) := h_sup_le (hT x.prop)
  exact hx.tower_bot (subtype_injective T)

/-- Let `S ≤ S₁, S₂ ≤ T` be subrings of `K`, each an algebra over the smaller ones through the
inclusion, with `S₁ ⊓ S₂ = S`. If `x ∈ S₁` and `y ∈ S₂` have the same image in `T`, then `(x, y)` is
the image of one element of `S`. -/
lemma mem_range_algebraMap_prod_of_inf_eq {S S₁ S₂ T : Subring K} [Fact (S ≤ S₁)] [Fact (S ≤ S₂)]
    [Fact (S₁ ≤ T)] [Fact (S₂ ≤ T)] (h_inf : S₁ ⊓ S₂ = S) (x : S₁) (y : S₂)
    (hxy : algebraMap S₁ T x = algebraMap S₂ T y) :
    (x, y) ∈ Set.range (algebraMap S (S₁ × S₂)) := by
  have h_val : (x : K) = y := congrArg Subtype.val hxy
  have hx : (x : K) ∈ S := h_inf.le ⟨x.prop, by simp [h_val]⟩
  exact ⟨⟨x, hx⟩, Prod.ext rfl (Subtype.ext h_val)⟩

/-- Let the images of `f₁ : X₁ → X` and `f₂ : X₂ → X` cover `X`. Locally constant functions `x` on
`X₁` and `y` on `X₂` are pull-backs of one locally constant function on `X` if, for each value
`c`, their fibres over `c` are the preimages of one open subset of `X`. -/
lemma exists_locallyConstant_of_fibers {X X₁ X₂ Z : Type*} [TopologicalSpace X]
    [TopologicalSpace X₁] [TopologicalSpace X₂] {f₁ : X₁ → X} {f₂ : X₂ → X}
    (h_cover : ∀ p : X, p ∈ Set.range f₁ ∨ p ∈ Set.range f₂)
    (x : LocallyConstant X₁ Z) (y : LocallyConstant X₂ Z)
    (h_fiber : ∀ c : Z, ∃ W : Set X, IsOpen W ∧ x ⁻¹' {c} = f₁ ⁻¹' W ∧ y ⁻¹' {c} = f₂ ⁻¹' W) :
    ∃ f : LocallyConstant X Z, (∀ p : X₁, f (f₁ p) = x p) ∧ ∀ p : X₂, f (f₂ p) = y p := by
  choose W hW_open hWx hWy using h_fiber
  -- Each point of `X` lies in exactly one of the sets `W c`.
  have exists_value (p : X) : ∃ c : Z, ∀ k : Z, c = k ↔ p ∈ W k := by
    obtain ⟨p₁, rfl⟩ | ⟨p₂, rfl⟩ := h_cover p
    exacts [⟨x p₁, fun k ↦ Set.ext_iff.mp (hWx k) p₁⟩, ⟨y p₂, fun k ↦ Set.ext_iff.mp (hWy k) p₂⟩]
  choose f hf using exists_value
  have h_fiber_eq (c : Z) : f ⁻¹' {c} = W c := Set.ext fun p ↦ hf p c
  have h_lc : IsLocallyConstant f :=
    IsLocallyConstant.iff_isOpen_fiber.mpr fun c ↦ by simpa only [h_fiber_eq] using hW_open c
  exact ⟨⟨f, h_lc⟩, fun p ↦ (hf (f₁ p) (x p)).mpr ((hWx (x p)).subset rfl),
    fun p ↦ (hf (f₂ p) (y p)).mpr ((hWy (y p)).subset rfl)⟩

/-- Let `F` be a functor from a preorder to abelian groups, and `a ≤ b₁ ≤ c`, `a ≤ b₂ ≤ c`. The
property that the sequence `0 → F a → F b₁ × F b₂ → F c → 0` is exact, where the first map is the
pair of the maps induced by `F` and the second is their difference. -/
structure IsMayerVietorisExact {P : Type*} [Preorder P] (F : P ⥤ Ab) {a b₁ b₂ c : P}
    (l₁ : a ≤ b₁) (l₂ : a ≤ b₂) (h₁ : b₁ ≤ c) (h₂ : b₂ ≤ c) : Prop where
  /-- Exactness on the left: an element that vanishes in `F b₁` and in `F b₂` is zero. -/
  eq_zero (f : F.obj a) (hf₁ : F.map l₁.hom f = 0) (hf₂ : F.map l₂.hom f = 0) : f = 0
  /-- Exactness in the middle: two elements with the same image in `F c` come from `F a`. -/
  exists_glue (x : F.obj b₁) (y : F.obj b₂) (hxy : F.map h₁.hom x = F.map h₂.hom y) :
    ∃ f : F.obj a, F.map l₁.hom f = x ∧ F.map l₂.hom f = y
  /-- Exactness on the right: every element of `F c` is a difference. -/
  exists_eq_sub (z : F.obj c) :
    ∃ (x : F.obj b₁) (y : F.obj b₂), z = F.map h₁.hom x - F.map h₂.hom y

/-- For every prime `p` of `B / J B` there is a valuation ring `V` of `K` containing `B` such that,
for every `B' ∈ absIntegrallyClosedSubrings γ` with `B ≤ B' ≤ V`, `p` is the contraction of a prime
of `B' / J B'`. -/
lemma absIntegrallyClosedSubrings.exists_valuationSubring_mem_range_comap
    (B : absIntegrallyClosedSubrings γ) (p : PrimeSpectrum ((quotientFunctor J γ).obj B)) :
    ∃ V : ValuationSubring K, B.val ≤ V.toSubring ∧
      ∀ (B' : absIntegrallyClosedSubrings γ) (l : B ≤ B'), B'.val ≤ V.toSubring →
        p ∈ Set.range (PrimeSpectrum.comap ((quotientFunctor J γ).map l.hom).hom) := by
  let q : PrimeSpectrum B.val := p.comap (mk (extendedIdeal J γ B))
  obtain ⟨V, hV_le⟩ : ∃ V : ValuationSubring K, ofPrime B.val q.asIdeal ≤ V.toLocalSubring :=
    (ofPrime B.val q.asIdeal).exists_le_valuationSubring
  -- `V` dominates the localisation of `B` at `q`, so `q` is the centre of `V` on `B`.
  obtain ⟨hV, hV_local⟩ : ∃ h_le : (ofPrime B.val q.asIdeal).toSubring ≤ V.toSubring,
      IsLocalHom (Subring.inclusion h_le) := LocalSubring.le_def.mp hV_le
  have hBV : B.val ≤ V.toSubring := (le_ofPrime B.val q.asIdeal).trans hV
  have h_centre (a : B.val) : (⟨a, hBV a.prop⟩ : V) ∈ maximalIdeal V ↔ a ∈ q.asIdeal :=
    (map_mem_nonunits_iff (inclusion hV) _).trans (AtPrime.to_map_mem_maximal_iff _ q.asIdeal a)
  refine ⟨V, hBV, fun B' l hB'V ↦ ?_⟩
  -- Take the contraction of the maximal ideal of `V`, which contains `J`.
  have hJ : extendedIdeal J γ B' ≤ (maximalIdeal V).comap (inclusion hB'V) := by
    refine map_le_of_le_comap fun d hd ↦ ?_
    have h_mem_q : absIntegrallyClosedSubrings.toRingHom B d ∈ q.asIdeal :=
      ker_le_comap _ (mk_ker.ge (mem_map_of_mem _ hd))
    exact (h_centre _).mpr h_mem_q
  refine ⟨.comap (quotientMap (maximalIdeal V) (inclusion hB'V) hJ) ⊥, ?_⟩
  -- A class `a` is in either prime iff `a` lies in the centre of `V` on `B`.
  ext ⟨a⟩
  exact eq_zero_iff_mem.trans (h_centre a)

section Splitting

variable {γ} {B B₁ B₂ B₃ : absIntegrallyClosedSubrings γ}

/-- `B` splits into the strictly larger rings `B₁` and `B₂`, which generate `B₃`: every valuation
ring of `K` over `B` contains one of the two. -/
structure absIntegrallyClosedSubrings.IsSplitting (B B₁ B₂ B₃ : absIntegrallyClosedSubrings γ) :
    Prop where
  /-- `B₁` is strictly larger than `B`. -/
  lt_left : B < B₁
  /-- `B₂` is strictly larger than `B`. -/
  lt_right : B < B₂
  /-- `B₃` is the subring of `K` generated by `B₁` and `B₂`. -/
  eq_sup : B₃.val = B₁.val ⊔ B₂.val
  /-- A valuation ring of `K` that contains `B` contains `B₁` or `B₂`. -/
  le_or_le (V : ValuationSubring K) (hV : B.val ≤ V.toSubring) :
    B₁.val ≤ V.toSubring ∨ B₂.val ≤ V.toSubring

lemma absIntegrallyClosedSubrings.IsSplitting.left_le (h_split : IsSplitting B B₁ B₂ B₃) :
    B₁ ≤ B₃ :=
  Subtype.coe_le_coe.mp (le_sup_left.trans h_split.eq_sup.ge)

lemma absIntegrallyClosedSubrings.IsSplitting.right_le (h_split : IsSplitting B B₁ B₂ B₃) :
    B₂ ≤ B₃ :=
  Subtype.coe_le_coe.mp (le_sup_right.trans h_split.eq_sup.ge)

/-- If `B` splits into `B₁` and `B₂` (`IsSplitting`), then `B₁ ⊓ B₂ = B`. -/
lemma absIntegrallyClosedSubrings.IsSplitting.inf_eq
    (h_split : IsSplitting B B₁ B₂ B₃) :
    B₁.val ⊓ B₂.val = B.val := by
  -- `B` is integrally closed, so it is the intersection of the valuation rings that contain it.
  have hB_aic : IsAbsIntegrallyClosed B.val := absIntegrallyClosedSubrings.isAbsIntegrallyClosed B
  refine le_antisymm ?_ (le_inf h_split.lt_left.le h_split.lt_right.le)
  refine (le_iInf fun ⟨V, hBV⟩ ↦ ?_).trans eq_iInf_of_isIntegrallyClosedIn.ge
  exact (h_split.le_or_le V hBV).elim inf_le_of_left_le inf_le_of_right_le

/-- The spectra of `B₁ / J B₁` and `B₂ / J B₂` cover that of `B / J B`. -/
lemma absIntegrallyClosedSubrings.IsSplitting.mem_range_comap_or (h_split : IsSplitting B B₁ B₂ B₃)
    (p : PrimeSpectrum ((quotientFunctor J γ).obj B)) :
    p ∈ Set.range (PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.lt_left.le.hom).hom) ∨
      p ∈ Set.range
        (PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.lt_right.le.hom).hom) := by
  obtain ⟨V, hBV, h_range⟩ := exists_valuationSubring_mem_range_comap J γ B p
  exact (h_split.le_or_le V hBV).imp (h_range B₁ _) (h_range B₂ _)

/-- Let `t ∈ K` with `t ∉ B` and `t⁻¹ ∉ B`. Let `B₁`, `B₂` be the integral closures of `B[t]` and
`B[t⁻¹]`, and `B₃` the subring that they generate. Then `B` splits into `B₁` and `B₂`, generating
`B₃`. -/
lemma absIntegrallyClosedSubrings.isSplitting_of_integralClosureAdjoin [IsAlgClosed K]
    {t : K} (ht : t ∉ B.val) (ht_inv : t⁻¹ ∉ B.val) (hB₁ : B₁.val = integralClosureAdjoin B.val t)
    (hB₂ : B₂.val = integralClosureAdjoin B.val t⁻¹) (hB₃ : B₃.val = B₁.val ⊔ B₂.val) :
    IsSplitting B B₁ B₂ B₃ := by
  have lt_of_notMem {s : K} {B' : absIntegrallyClosedSubrings γ} (hs : s ∉ B.val)
      (hB' : B'.val = integralClosureAdjoin B.val s) : B < B' := by
    rw [← Subtype.coe_lt_coe, hB', IsConcreteLE.lt_iff_le_and_exists]
    exact ⟨le_integralClosureAdjoin B.val s, s, mem_integralClosureAdjoin B.val s, hs⟩
  refine ⟨lt_of_notMem ht hB₁, lt_of_notMem ht_inv hB₂, hB₃, fun V hV ↦ ?_⟩
  -- A valuation ring of `K` contains `t` or `t⁻¹`, and it is integrally closed in `K`.
  have hV_aic : IsAbsIntegrallyClosed V.toSubring :=
    (inferInstance : IsAbsIntegrallyClosedLocal V).toIsAbsIntegrallyClosed
  rw [hB₁, hB₂, integralClosureAdjoin_le_iff, integralClosureAdjoin_le_iff]
  exact (V.mem_or_inv_mem t).imp (And.intro hV) (And.intro hV)

/-- Let `B` split into `B₁` and `B₂`, generating `B₃` (`IsSplitting`). A locally constant
`ZMod ℓ`-valued function on `Spec (B / J B)` that vanishes after pull-back to `Spec (B₁ / J B₁)` and
to `Spec (B₂ / J B₂)` is zero, because these two spectra cover `Spec (B / J B)`. -/
lemma absIntegrallyClosedSubrings.IsSplitting.eq_zero_of_map_eq_zero
    (h_split : IsSplitting B B₁ B₂ B₃) (f : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).obj B)
    (hf₁ : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.lt_left.le.hom f = 0)
    (hf₂ : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.lt_right.le.hom f = 0) :
    f = 0 := by
  refine LocallyConstant.ext fun p ↦ ?_
  obtain ⟨p₁, rfl⟩ | ⟨p₂, rfl⟩ := h_split.mem_range_comap_or J p
  exacts [LocallyConstant.congr_fun hf₁ p₁, LocallyConstant.congr_fun hf₂ p₂]

/-- Let `B` split into `B₁` and `B₂`, generating `B₃` (`IsSplitting`). If compatible clopens of
`Spec (B₁ / J B₁)` and `Spec (B₂ / J B₂)` come from one open of `Spec (B / J B)` (`h_clopen`), then
locally constant `ZMod ℓ`-valued `x` on `Spec (B₁ / J B₁)` and `y` on `Spec (B₂ / J B₂)` with
the same pull-back to `Spec (B₃ / J B₃)` are the pull-backs of one such function on
`Spec (B / J B)`. -/
lemma absIntegrallyClosedSubrings.IsSplitting.exists_map_eq_and_map_eq
    (h_split : IsSplitting B B₁ B₂ B₃)
    (h_clopen : ∀ (X₁ : Set (PrimeSpectrum ((quotientFunctor J γ).obj B₁)))
      (X₂ : Set (PrimeSpectrum ((quotientFunctor J γ).obj B₂))), IsClopen X₁ → IsClopen X₂ →
      PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.left_le.hom).hom ⁻¹' X₁ =
        PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.right_le.hom).hom ⁻¹' X₂ →
      ∃ W : Set (PrimeSpectrum ((quotientFunctor J γ).obj B)), IsOpen W ∧
        X₁ = PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.lt_left.le.hom).hom ⁻¹' W ∧
        X₂ = PrimeSpectrum.comap ((quotientFunctor J γ).map h_split.lt_right.le.hom).hom ⁻¹' W)
    (x : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).obj B₁)
    (y : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).obj B₂)
    (hxy : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.left_le.hom x =
      (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.right_le.hom y) :
    ∃ f : (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).obj B,
      (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.lt_left.le.hom f = x ∧
      (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩).map h_split.lt_right.le.hom f = y := by
  -- The fibres of `x` and `y` over `c` are clopens with the same preimage in `Spec (B₃ / J B₃)`.
  obtain ⟨f, hf₁, hf₂⟩ := exists_locallyConstant_of_fibers (h_split.mem_range_comap_or J) x y
    fun c ↦ h_clopen _ _ (x.isLocallyConstant.isClopen_fiber c)
      (y.isLocallyConstant.isClopen_fiber c)
      (Set.ext fun p ↦ (LocallyConstant.congr_fun hxy p).congr_left)
  exact ⟨f, LocallyConstant.ext hf₁, LocallyConstant.ext hf₂⟩

end Splitting

/-- Let `K` be algebraically closed, `γ : D →+* K` a ring map, `J` an ideal of `D`, `ℓ` a prime
invertible in `D`, and divisibility in `D` total (`PreValuationRing D`). Let `B` be an absolutely
integrally closed subring of `K` containing the image of `γ` (`absIntegrallyClosedSubrings γ`) that
is not a valuation ring of `K`. Then there are such rings `B₁`, `B₂`, strictly larger than `B` and
generating `B₃`, with every valuation ring of `K` over `B` containing one of them (`IsSplitting`),
such that `0 → C B → C B₁ × C B₂ → C B₃ → 0` is exact. Here `C S` is the group of locally constant
functions `Spec (S / J S) → ZMod ℓ`, the first map is the pair of pull-backs and the second is their
difference. -/
lemma absIntegrallyClosedSubrings.exists_isSplitting_isMayerVietorisExact [IsAlgClosed K]
    [PreValuationRing D] (hℓ : IsUnit (ℓ : D)) (B : absIntegrallyClosedSubrings γ)
    (hB : ¬∀ x : K, x ∈ B.val ∨ x⁻¹ ∈ B.val) :
    ∃ (B₁ B₂ B₃ : absIntegrallyClosedSubrings γ) (h_split : IsSplitting B B₁ B₂ B₃),
      IsMayerVietorisExact (quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩)
        h_split.lt_left.le h_split.lt_right.le h_split.left_le h_split.right_le := by
  -- Choose `t` with `t, t⁻¹ ∉ B`, in one of the cases that `exists_eq_locConstSpec_map_sub_map`
  -- allows. Let `B₁`, `B₂` be the integral closures of `B[t]` and `B[t⁻¹]`, and `B₃` the ring they
  -- generate. The spectra of `B₁`, `B₂` modulo `J` cover that of `B`, which gives exactness on the
  -- left; `exists_eq_basicOpen_of_isClopen_of_preimage_eq` gives it in the middle and
  -- `exists_eq_locConstSpec_map_sub_map` on the right.
  have hB_aic : IsAbsIntegrallyClosed B.val := absIntegrallyClosedSubrings.isAbsIntegrallyClosed B
  obtain ⟨t, ht, ht_inv, h_case⟩ : ∃ t : K, t ∉ B.val ∧ t⁻¹ ∉ B.val ∧
      ((∃ b : B.val, b * (1 - t) = 1 ∧ IsLineChartCase (extendedIdeal J γ B) b) ∨
        IsAbsIntegrallyClosedLocal B.val) :=
    hB_aic.exists_notMem_and_inv_notMem (extendedIdeal J γ B) hB
  have ht_ne : t ≠ 0 := (ne_of_mem_of_not_mem (zero_mem B.val) ht).symm
  let S₁ : Subring K := integralClosureAdjoin B.val t
  let S₂ : Subring K := integralClosureAdjoin B.val t⁻¹
  let S₃ : Subring K := S₁ ⊔ S₂
  let t₁ : S₁ := ⟨t, mem_integralClosureAdjoin B.val t⟩
  let t₂ : S₂ := ⟨t⁻¹, mem_integralClosureAdjoin B.val t⁻¹⟩
  have hS₁_aic : IsAbsIntegrallyClosed S₁ := isAbsIntegrallyClosed_integralClosureAdjoin B.val t
  have hS₂_aic : IsAbsIntegrallyClosed S₂ := isAbsIntegrallyClosed_integralClosureAdjoin B.val t⁻¹
  -- The inclusions as algebras; `S₃` is a localisation of each of `S₁`, `S₂`.
  have hB_le₁ : Fact (B.val ≤ S₁) := ⟨le_integralClosureAdjoin B.val t⟩
  have hB_le₂ : Fact (B.val ≤ S₂) := ⟨le_integralClosureAdjoin B.val t⁻¹⟩
  have h_le₁₃ : Fact (S₁ ≤ S₃) := ⟨le_sup_left⟩
  have h_le₂₃ : Fact (S₂ ≤ S₃) := ⟨le_sup_right⟩
  have hB_le₃ : Fact (B.val ≤ S₃) := ⟨hB_le₁.out.trans h_le₁₃.out⟩
  have h_away₁ : Away t₁ S₃ :=
    hS₁_aic.isLocalization_away t₁ (h_le₂₃.out t₂.prop) (mul_inv_cancel₀ ht_ne)
      fun _ hU h_mem ↦ sup_le hU (integralClosureAdjoin_le_iff.mpr ⟨hB_le₁.out.trans hU, h_mem⟩)
  have h_away₂ : Away t₂ S₃ :=
    hS₂_aic.isLocalization_away t₂ (h_le₁₃.out t₁.prop) (inv_mul_cancel₀ ht_ne)
      fun _ hU h_mem ↦ sup_le (integralClosureAdjoin_le_iff.mpr ⟨hB_le₂.out.trans hU, h_mem⟩) hU
  let B₁ : absIntegrallyClosedSubrings γ := ⟨S₁, (range_le B).trans hB_le₁.out, hS₁_aic⟩
  let B₂ : absIntegrallyClosedSubrings γ := ⟨S₂, (range_le B).trans hB_le₂.out, hS₂_aic⟩
  let B₃ : absIntegrallyClosedSubrings γ := ⟨S₃, (range_le B).trans hB_le₃.out,
    hS₁_aic.of_isLocalization (.powers t₁)⟩
  have h_split : IsSplitting B B₁ B₂ B₃ :=
    isSplitting_of_integralClosureAdjoin ht ht_inv rfl rfl rfl
  -- The hypotheses of `exists_eq_basicOpen_of_isClopen_of_preimage_eq` and
  -- `exists_eq_locConstSpec_map_sub_map`.
  have h_mul : algebraMap S₁ S₃ t₁ * algebraMap S₂ S₃ t₂ = 1 := Subtype.ext (mul_inv_cancel₀ ht_ne)
  have h_cases : (∃ b : B.val, algebraMap B.val S₁ b * (1 - t₁) = 1 ∧
        (algebraMap B.val S₂ b - 1) * (t₂ - 1) = 1 ∧ Away b S₁ ∧
        IsLineChartCase (extendedIdeal J γ B) b) ∨
      IsAbsIntegrallyClosedLocal B.val := by
    refine h_case.imp_left fun ⟨b, (hb : b * (1 - t) = 1), hb_case⟩ ↦ ?_
    have hb_sub : (b.val - 1) * (t⁻¹ - 1) = 1 := by
      field_simp
      linear_combination hb
    -- `S₁ = B[1 / b]`, since `b⁻¹ = 1 - t`.
    have h_away : Away b S₁ := hB_aic.isLocalization_away_integralClosureAdjoin (h := hB_le₁) b hb
    exact ⟨b, Subtype.ext hb, Subtype.ext hb_sub, h_away, hb_case⟩
  -- the extensions of `J B` to `S₁`, `S₂`, `S₃` are `J B₁`, `J B₂`, `J B₃`
  have h_ideal₁ : (extendedIdeal J γ B).map (algebraMap B.val S₁) = extendedIdeal J γ B₁ :=
    map_extendedIdeal J γ h_split.lt_left.le
  have h_ideal₂ : (extendedIdeal J γ B).map (algebraMap B.val S₂) = extendedIdeal J γ B₂ :=
    map_extendedIdeal J γ h_split.lt_right.le
  have h_ideal₃ : (extendedIdeal J γ B).map (algebraMap B.val S₃) = extendedIdeal J γ B₃ :=
    map_extendedIdeal J γ (h_split.lt_left.le.trans h_split.left_le)
  -- `J B₁` and `J B₂` map into `J B₃`
  have h_le₁ : extendedIdeal J γ B₁ ≤ (extendedIdeal J γ B₃).comap (algebraMap S₁ S₃) :=
    map_le_of_le_comap le_comap_map
  have h_le₂ : extendedIdeal J γ B₂ ≤ (extendedIdeal J γ B₃).comap (algebraMap S₂ S₃) :=
    map_le_of_le_comap le_comap_map
  -- `S₃` is integral over `B[t, t⁻¹]`
  have h_integral (x : S₃) :
      IsIntegral (Algebra.adjoin B.val {algebraMap S₁ S₃ t₁, algebraMap S₂ S₃ t₂}) x :=
    isIntegral_adjoin_pair_of_le_sup (algebraMap S₁ S₃ t₁) (algebraMap S₂ S₃ t₂) le_rfl x
  -- an element of `K` that lies in `S₁` and in `S₂` lies in `B`
  have h_onto (x : S₁) (y : S₂) (hxy : algebraMap S₁ S₃ x = algebraMap S₂ S₃ y) :
      (x, y) ∈ Set.range (algebraMap B.val (S₁ × S₂)) :=
    mem_range_algebraMap_prod_of_inf_eq h_split.inf_eq x y hxy
  refine ⟨B₁, B₂, B₃, h_split,
    { eq_zero := h_split.eq_zero_of_map_eq_zero J
      exists_glue := h_split.exists_map_eq_and_map_eq J fun X₁ X₂ hX₁ hX₂ h_eq ↦ ?_
      exists_eq_sub := exists_eq_locConstSpec_map_sub_map (extendedIdeal J γ B) t₁ t₂ h_mul
        h_integral (isUnit_natCast_of_isUnit hℓ B) h_cases (exists_mem_extendedIdeal_dvd J γ B)
        h_ideal₁ h_ideal₂ h_ideal₃ h_le₁ h_le₂ }⟩
  -- Compatible clopens of the two charts are the basic opens of one `k ∈ B`.
  obtain ⟨k, hkX₁, hkX₂⟩ : ∃ k : B.val,
      X₁ = (basicOpen (algebraMap B.val (S₁ ⧸ extendedIdeal J γ B₁) k)).carrier ∧
      X₂ = (basicOpen (algebraMap B.val (S₂ ⧸ extendedIdeal J γ B₂) k)).carrier :=
    exists_eq_basicOpen_of_isClopen_of_preimage_eq (extendedIdeal J γ B) t₁ t₂ h_mul h_integral
      h_onto
      (exists_mem_extendedIdeal_dvd J γ B) h_ideal₁ h_ideal₂ h_ideal₃ h_le₁ h_le₂ hX₁ hX₂ h_eq
  exact ⟨(basicOpen (mk (extendedIdeal J γ B) k)).carrier, isOpen_basicOpen, hkX₁, hkX₂⟩

end New.Variety

end SubringSplitting
end
end

/-!
# Proper base change over AIC valuation rings and its consequences for ℤ/ℓ-cohomology

Spaces are functors on rings. A space is proper over `A` (`New.Variety.IsProperOver`) if its
diagonal is cut out by ideals and a valuative criterion holds with one universal point.
`New.Variety.TestOver` A is the category of A-algebras that are test rings (absolutely integrally
closed reduced rings where any two elements are comparable for divisibility after splitting by an
idempotent; `testIncl` includes them in rings), `New.Variety.H` N F n is Extⁿ(N, F) among functors
to abelian groups, and the coefficients are ℤ/ℓ for a prime ℓ invertible in the base. The file
proves proper base change over an absolutely integrally closed local domain that is a valuation ring
and derives three consequences: injectivity of restriction to the residue fibre, invariance of
cohomology under extension of algebraically closed fields, and openness of zero sets of classes.
These results then give detection at points for coefficients that are ℤ/ℓ on the zero locus of a
family of ideals, in the form used to prove that Leray–Hirsch maps are bijective.

## Main definitions and results

* `New.Variety.IsProperOver.proper_base_change`: for `Y` proper over an absolutely integrally closed
  valuation ring `A` in which `ℓ` is invertible, the closed fibre of `Y` has the cohomology of `Y`.
* `New.Variety.IsProperOver.injective_map_residue`: over an absolutely integrally closed local
  domain that is a valuation ring, a class is determined by its restriction to the fibre over the
  residue field.
* `New.Variety.IsProperOver.isTestCohomEquiv_field_extension`: cohomology does not change under an
  extension `S → T` of algebraically closed fields over `R`.
* `New.Variety.IsProperOver.isOpen_zero_set_and_eq_zero`: over a test ring, the primes at which a
  class vanishes form an open set, and a class that vanishes at every prime is zero.
* `New.Variety.IsDetectedAtPoints`: the property of a coefficient F that classes over a test are
  detected at the residue fields of its primes (zero sets are open, and a class that vanishes at
  every prime is zero), and that extending a field test changes nothing; a structure with one field
  for each of these two properties.
* `New.Variety.IdealFamily.isDetectedAtPoints_of_proper`: for X proper over ℤ and I a family of
  ideals on X × Spec A, a coefficient that is ℤ/ℓ on the locus I = 0, this locus being dense, has
  that property. Idea: the locus W = {I = 0} is proper over A, and over a test c the cohomology with
  coefficients F is that of W_c with coefficients ℤ/ℓ.

Notions from other files:
* `New.Variety.IsAbsIntegrallyClosedLocal`: A is an absolutely integrally closed local domain: a
  local domain in which every monic polynomial of positive degree has a root.
* `New.Variety.IsCohomEquiv`: α : N' → N induces bijections Extⁿ(N, F) → Extⁿ(N', F) for all n.
* `New.Variety.locConstCoeff` Λ: the coefficient on test rings given by the locally constant
  functions Spec B → Λ.
* `New.Variety.IsTestCohomEquiv` Λ u: the map u of functors on rings, restricted to test rings,
  induces such bijections for the coefficient `locConstCoeff Λ`.
* `New.Variety.reprBy`: the functor h_A = Hom(A, −) represented by A.
* `New.Variety.IsCohomDense`: U ⊆ Y is dense for F if for every point h_A → Y the inclusion of the
  preimage of U in h_A is such an equivalence.
* `New.Variety.IdealFamily`: For a functor ι from C to commutative rings, ideals I_c of ι(c) such
  that I_b is generated by the image of I_a for every morphism a → b.
* `New.Variety.zeroPoints`: For s: X → h_R and a subset I of R, the subfunctor of points x ∈ X(B)
  whose structure map R → B sends I to 0; `New.Variety.unitPoints`: those whose structure map sends
  every element of I to a unit.

## Relation to the literature

Known result: Proper base change and invariance under extension of algebraically closed fields. Here
the coefficients are constant F_ℓ, the base is an absolutely integrally closed valuation ring, and
properness of a functor (`New.Variety.IsProperOver`) means a closed diagonal and a valuative
criterion. The proof reduces to spaces of places of a field and then uses Zorn's lemma on subrings
with a Mayer–Vietoris splitting, together with Kummer theory. Source: Artin, SGA 4 Exp. XII 5.1,
5.4, 5.5 (1973); Stacks Project Tag 095S; reduction to spaces of places as in Scholze, Étale
cohomology of diamonds (2017), Thm 19.2 and Lemma 19.4, after Huber, Math. Ann. 295 (1993).
-/

@[expose] public section

noncomputable section

/-!
## Proper base change over absolutely integrally closed valuation rings

Proper base change for ℤ/ℓ-cohomology on test rings. The proof works on spaces of places:
* `ResiduePlace.ValuativeLift s ξ`: for a point `ξ ∈ Y(P)`, with `P` absolutely flat with
  algebraically closed residue fields, a lift of `ξ` to the product of the valuation rings of all
  places of `P`.
* `ResiduePlace.placeSpace z`, `ResiduePlace.placeSpaceMap z`: its space of places, mapping to `Y`;
  `placeGraph x` is the ring of pairs `(t, c)` such that the place `x` gives `t ∈ P` the value `c`.
* `ResiduePlace.killingPlaces z q`: the places that give every element of the ideal `q` the value
  `0`; for `q` maximal, `ResiduePlace.placesFiniteOn z J B` are those among them that are finite
  on the subring `B` of the residue field at `q` and whose structure map kills the ideal `J`.
* `IsAcyclicOver σ Λ`: for `σ : T → h_B` on test rings, the locally constant functions on the
  spectrum of `B` give `H⁰(T, Λ)`, and `Hⁿ(T, Λ) = 0` for `n > 0`.
-/

section ProperBaseChange2

open CategoryTheory CommRingCat Subfunctor IsLocalRing Ideal Quotient New.Variety ResiduePlace
  absIntegrallyClosedSubrings Filter Comparison ULift Functor Subring RingHom

/-- Let `γ : D → F` be a ring map to a field, where of any two elements of `D` one divides the
other, and let `c` be a nonempty directed family in `absIntegrallyClosedSubrings γ` (the absolutely
integrally closed subrings of `F` that contain the image of `γ`). Then the union `S` of the family
is again in `absIntegrallyClosedSubrings γ`: there is a cocone `m` over the family with vertex `S`.
Moreover, for an ideal `J` of `D` and an abelian group `Λ`, the locally constant `Λ`-valued
functions on the spectrum of `S / J S` are the colimit of those on the spectra of `B / J B` for the
members `B` of the family. -/
lemma New.Variety.absIntegrallyClosedSubrings.exists_cocone_iSup {Λ : Ab} {F : Type} [Field F]
    {D : CommRingCat} [PreValuationRing D] (J : Ideal D) {γ : D →+* F}
    (c : Set (absIntegrallyClosedSubrings γ)) [hc : IsDirectedOrder c] [hne : Nonempty c] :
    ∃ m : Limits.Cocone (Subtype.mono_coe fun B : absIntegrallyClosedSubrings γ ↦ B ∈ c).functor,
      -- (a) the vertex is the union of the family
      m.pt.val = ⨆ B : c, B.val.val ∧
      -- (b) locally constant functions on the spectrum modulo `J` turn it into a colimit
      IsFilteredColimit ((quotientFunctor J γ ⋙ locConstSpec Λ).mapCocone m) := by
  let φ (B : c) : Subring F := B.val.val
  have h_mem (B : c) : γ.range ≤ φ B ∧ IsAbsIntegrallyClosed (φ B) := B.val.prop
  -- An element of the union lies in all large members, hence so do finitely many elements.
  have h_ev (x : ↥(iSup φ)) : ∀ᶠ B : c in atTop, x.val ∈ φ B := by
    obtain ⟨B, hB⟩ := (mem_iSup_of_directed hc.directed).mp x.prop
    exact eventually_atTop.mpr ⟨B, fun B' hBB' ↦ hBB' hB⟩
  have h_aic : IsAbsIntegrallyClosed ↥(iSup φ) := by
    refine ⟨fun p ↦ ?_⟩
    obtain ⟨B, hB⟩ : ∃ B : c, ∀ y ∈ p.coeffs, (y : F) ∈ φ B :=
      (p.coeffs.eventually_all.mpr fun y _ ↦ h_ev y).exists
    exact (h_mem B).2.exists_root_of_coeffs_subset_range (f := inclusion (le_iSup φ B))
      fun y hy ↦ ⟨⟨y, hB y hy⟩, rfl⟩
  let S : absIntegrallyClosedSubrings γ :=
    ⟨iSup φ, le_iSup_of_le hne.some (h_mem hne.some).1, h_aic⟩
  -- It is enough that `S / J S` is the colimit of the rings `B / J B`; check this on elements.
  refine ⟨⟨S, .mk fun B ↦ ⟨⟨le_iSup φ B⟩⟩⟩, rfl,
    isFilteredColimit_locConstSpec (c := (quotientFunctor J γ).mapCocone _) ?_ ?_⟩
  · rintro ⟨x⟩
    exact (h_ev x).exists.imp fun B hB ↦ ⟨⟦⟨x, hB⟩⟧, rfl⟩
  · -- An element `x` of `B` that lies in `J S` is `γ a * f` with `a ∈ J` and `f ∈ S`, so it lies in
    -- `J B'` for any member `B'` above `B` that contains `f`.
    rintro B ⟨x⟩ hx
    obtain ⟨a, ha, f, hf⟩ := exists_map_dvd_of_mem_map (eq_zero_iff_mem.mp hx)
    have hf_val : (x : F) = γ a * f := congrArg Subtype.val hf
    obtain ⟨B', hfB', hBB'⟩ : ∃ B' : c, f.val ∈ φ B' ∧ B ≤ B' :=
      ((h_ev f).and (eventually_ge_atTop B)).exists
    let f' : φ B' := ⟨f.val, hfB'⟩
    refine ⟨B', hBB'.hom, eq_zero_iff_mem.mpr (mem_of_dvd _ ⟨f', ?_⟩ (mem_map_of_mem _ ha))⟩
    exact Subtype.ext hf_val

section ValueMap

variable {Y : PointFunctor} {D P : CommRingCat} {s : Y ⟶ reprBy D} {ξ : Y.obj P}
  {z : ValuativeLift s ξ} {q : Ideal P} [q.IsMaximal] {J : Ideal D}

/-- For a place `y` with values in `C` that vanishes on the maximal ideal `q` of `P`, the ring map
from `finiteValueSubring z y` to `C` that sends the residue of `t` to the value of `y` at `t`. It
is well defined: a pair `(t, c)` of the graph `placeGraph y` with `t ∈ q` has `c = 0`. -/
private def New.Variety.ResiduePlace.residueValue {C : CommRingCat} (y : killingPlaces z q C) :
    finiteValueSubring z y →+* C :=
  .liftOfSurjective _ (rangeRestrict_surjective _)
    ⟨(snd P C).domRestrict (placeGraph y.val), fun w hw ↦
      placeGraph_unique w.prop
        (y.prop w.val.1 ((ker_algebraMap_residueField q).le
          (congrArg Subtype.val (RingHom.mem_ker.mp hw))))⟩

/-- `residueValue y` sends the residue of `t` to `c` when `(t, c)` lies in the graph of `y`. -/
private lemma New.Variety.ResiduePlace.residueValue_apply {C : CommRingCat}
    {y : killingPlaces z q C} {t : P} {c : C} (h_graph : (t, c) ∈ placeGraph y.val) :
    residueValue y ⟨_, ⟨(t, c), h_graph⟩, rfl⟩ = c :=
  liftOfSurjective_comp_apply ..

/-- For a place `x` that is finite on `B` and kills `J`, the restriction of `residueValue x` to `B`
kills the ideal `J B`. -/
private lemma New.Variety.ResiduePlace.extendedIdeal_le_ker_residueValue_comp
    {B : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom)}
    {C : CommRingCat} (x : (placesFiniteOn z J B.val).toFunctor.obj C) :
    extendedIdeal J ((algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom) B ≤
      RingHom.ker ((residueValue x.val).comp (B.val.inclusion x.prop.right)) :=
  map_le_of_le_comap (K := ker _) fun a ha ↦
    (residueValue_apply (baseRingMap_mem_placeGraph a)).trans (x.prop.left a ha)

/-- The value map. Let `s : Y → h_D`, let `z` be a valuative lift of `ξ ∈ Y(P)`, let `q` be a
maximal ideal of `P`, `J` an ideal of `D`, and `B` a ring in `absIntegrallyClosedSubrings` for the
map from `D` to the residue field at `q`. A place `x` with values in `C` that is finite on `B` and
kills `J` gives a ring map `B / J B → C`, naturally in `C`, which sends the class of the residue
of `t` to the value of `x` at `t` (`ResiduePlace.baseRingMap_valueMap_mk`). -/
@[no_expose]
def New.Variety.ResiduePlace.valueMap {Y : PointFunctor} {D P : CommRingCat} {s : Y ⟶ reprBy D}
    {ξ : Y.obj P} {q : Ideal P} [q.IsMaximal] (z : ValuativeLift s ξ) (J : Ideal D)
    (B : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom)) :
    (placesFiniteOn z J B.val).toFunctor ⟶ reprBy ((quotientFunctor J _).obj B) where
  app C := ↾fun x ↦ ⟨ofHom (lift _ ((residueValue x.val).comp (B.val.inclusion x.prop.right))
    (extendedIdeal_le_ker_residueValue_comp x))⟩
  naturality C C' k := by
    -- A map of rings of values carries the graph of `x` into that of its image.
    ext x
    congrm ⟨?_⟩
    ext ⟨u, ht⟩
    obtain ⟨w, rfl⟩ := x.prop.2 ht
    -- For `w = (t, c)` it remains that `t` with the value of `residueValue x` at its residue lies
    -- in `placeGraph x`: this pair is `w`.
    have h_mem :
        (w.val.1, residueValue x.val ⟨_, ⟨w.val, w.prop⟩, rfl⟩) ∈ placeGraph x.val.val := by
      simpa only [residueValue_apply w.prop] using w.prop
    -- (`y` is given explicitly: found by unification, it costs most of the time of this proof)
    exact residueValue_apply (y := ((placesFiniteOn z J B.val).toFunctor.map k x).val)
      (placeGraph_map h_mem)

/-- The value map sends the class of the residue of `t` to `c` when the place `x` gives `t` the
value `c`. -/
lemma New.Variety.ResiduePlace.baseRingMap_valueMap_mk {Y : PointFunctor} {D P : CommRingCat}
    {s : Y ⟶ reprBy D} {ξ : Y.obj P} {z : ValuativeLift s ξ} {q : Ideal P} [q.IsMaximal]
    {J : Ideal D}
    (B : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom))
    {C : CommRingCat} {x : (placesFiniteOn z J B.val).toFunctor.obj C} {t : P} {c : C}
    (ht : algebraMap P q.ResidueField t ∈ B.val) (h_graph : (t, c) ∈ placeGraph x.val.val) :
    baseRingMap (B := C) (valueMap z J B) x
      (Ideal.Quotient.mk _ ⟨algebraMap P q.ResidueField t, ht⟩) = c :=
  residueValue_apply h_graph

end ValueMap

/-- Let `D` be absolutely integrally closed, with one of any two elements dividing the other. Let
`s : Y → h_D`, let `z` be a valuative lift of `ξ ∈ Y(P)`, let `q` be a maximal ideal of `P` and `J`
a prime ideal of `D`. Places are taken of `P` over `D` via the map `D → P` given by `s` at `ξ`. If
`B` is a valuation ring of the residue field at `q`, the places that are finite on `B` and kill `J`
have the cohomology of the test ring `B / J B`: the map `v` to `h_{B / J B}`, which sends the class
of the residue of `t` to the value of the place at `t` (as `ResiduePlace.valueMap` does), is acyclic
over `Λ`. -/
lemma New.Variety.ResiduePlace.isAcyclicOver_of_mem_or_inv_mem {Λ : Ab} {Y : PointFunctor}
    {D P : CommRingCat}
    [IsAbsIntegrallyClosed D] [PreValuationRing D] {s : Y ⟶ reprBy D} {ξ : Y.obj P}
    {z : ValuativeLift s ξ} {q : Ideal P} [hq : q.IsMaximal] {J : Ideal D} [hJ : J.IsPrime]
    {B : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom)}
    (hB : ∀ x : q.ResidueField, x ∈ B.val ∨ x⁻¹ ∈ B.val)
    {v : (placesFiniteOn z J B.val).toFunctor ⟶ reprBy ((quotientFunctor J _).obj B)}
    (hv : ∀ {C : CommRingCat} {x : (placesFiniteOn z J B.val).toFunctor.obj C} {t : P} {c : C}
      (ht : algebraMap P q.ResidueField t ∈ B.val), (t, c) ∈ placeGraph x.val.val →
        baseRingMap (B := C) v x (Ideal.Quotient.mk _ ⟨algebraMap P q.ResidueField t, ht⟩) = c) :
    IsAcyclicOver (mapOnTests v) Λ := by
  have h_alg : ∀ (q' : Ideal P) [q'.IsPrime], IsAlgClosed _ := z.isAlgClosed_residueField
  let j : ResiduePlace (baseRingMap s ξ) :=
    ⟨⟨q, hq.isPrime⟩, ⟨B.val, hB⟩, fun d ↦ B.prop.1 ⟨d, rfl⟩⟩
  -- `J B` is radical: if `x ^ 2 ∈ J B`, then `x ^ 2` is divisible by the image of some `c ^ 2 ∈ J`,
  -- so `x` is divisible by the image of `c`, and `c ∈ J`.
  have h_rad : (extendedIdeal J _ B).IsRadical := by
    refine (Ideal.isRadical_iff_pow_one_lt 2 .refl).mpr fun x hx ↦ ?_
    obtain ⟨a, ha, hdvd⟩ := exists_map_dvd_of_mem_map hx
    obtain ⟨c, rfl⟩ : ∃ c : D, c ^ 2 = a := IsAbsIntegrallyClosed.exists_pow_eq 2 a
    rw [map_pow] at hdvd
    refine mem_of_dvd _ ?_ (mem_map_of_mem _ (hJ.isRadical ⟨2, ha⟩))
    exact (IsIntegrallyClosed.pow_dvd_pow_iff (R := j.valuationSubring) two_ne_zero).mp hdvd
  -- So `B / J B` is a test ring, and it remains to see that it represents the functor on tests.
  refine .of_bijective ((isTest_of_preValuationRing (A := j.valuationSubring)).quotient h_rad)
    fun {C} ↦ ?_
  let π : CommRingCat.of B.val ⟶ .of (B.val ⧸ extendedIdeal J _ B) := ofHom (Ideal.Quotient.mk _)
  let T : CommRingCat ⥤ Type 1 := (placesFiniteOn z J B.val).toFunctor
  -- The point given by the place `j` and a map `φ` on `B` has the values `φ` on `B`.
  have h_val {C : CommRingCat} {φ : CommRingCat.of j.valuationSubring ⟶ C} {x : T.obj C}
      (hx : x.val.val = ⟨⟦j.projHom ≫ φ⟧⟩) : π ≫ baseRingMap v x = φ := by
    ext ⟨y, hy⟩
    obtain ⟨t, rfl⟩ := q.algebraMap_residueField_surjective y
    refine hv hy ?_
    rw [hx]
    exact j.mem_fractionGraph_projHom t hy
  -- The inverse sends `φ : B / J B ⟶ C` to the image of the universal point `x₀`.
  let x₀ : T.obj (.of (B.val ⧸ extendedIdeal J _ B)) := by
    refine ⟨⟨⟨⟦j.projHom ≫ π⟧⟩, projHom_mem_killingPlaces j π⟩, fun a ha ↦ ?_, ?_⟩
    · -- The value of the place at `a ∈ J` is the class of the image of `a` modulo `J B`, so `0`.
      refine (placeGraph_unique (baseRingMap_mem_placeGraph a) ?_).trans
        (mk_ker.ge (mem_map_of_mem _ ha))
      apply mem_fractionGraph_projHom
    · exact q.algebraMap_residueField_surjective.forall.mpr fun t ht ↦
        ⟨⟨_, j.mem_fractionGraph_projHom t ht⟩, rfl⟩
  refine Function.bijective_iff_has_inverse.mpr
    ⟨fun φ ↦ T.map φ.down x₀, fun x ↦ Subtype.ext (Subtype.ext ?_), fun φ ↦ ?_⟩
  · -- The space of places is separated: compare in each local ring of `C`, where the image `y`
    -- of `x` is given by the place `j` and some `φ`.
    let loc (m : MaximalSpectrum C.obj) :
        CommRingCat.of C.obj ⟶ CommRingCat.of (Localization.AtPrime m.asIdeal) :=
      ofHom (algebraMap C.obj (Localization.AtPrime m.asIdeal))
    refine isProperOver_placeSpace.ext_of_jointly_injective loc
      (fun c hc ↦ eq_zero_of_localization c fun m hm ↦ hc ⟨m, hm⟩) fun m ↦ ?_
    let y := T.map (loc m) x
    obtain ⟨φ, hφ⟩ : ∃ φ, y.val.val = ⟨⟦j.projHom ≫ φ⟧⟩ :=
      exists_eq_projHom_comp_of_le_finiteValueSubring y.val.prop j.valuationSubring j.base_mem
        y.prop.2
    -- The rewrite is done in `hφ` rather than in the goal, where it is slow to elaborate.
    rw [← h_val hφ, baseRingMap_map] at hφ
    exact hφ.symm
  · -- The image of `x₀` under `φ` has the values `π ≫ φ` on `B`, and `π` is surjective.
    have h_comp : π ≫ baseRingMap v (T.map φ.down x₀) = π ≫ φ.down := h_val (φ := π ≫ φ.down) rfl
    exact down_injective (hom_ext (ringHom_ext (congrArg Hom.hom h_comp :)))

section ValueMaps

variable {Λ : Ab} {Y : PointFunctor} {D P : CommRingCat} {s : Y ⟶ reprBy D} {ξ : Y.obj P}
  {z : ValuativeLift s ξ} {q : Ideal P} [q.IsMaximal] {J : Ideal D}

/-- Let `v B`, for every `B` in `absIntegrallyClosedSubrings`, be a map from the places that are
finite on `B` and kill `J` to `h_{B / J B}` that sends the class of the residue of `t` to the value
of the place at `t` (as `ResiduePlace.valueMap` does). Then the comparison maps `locConstClass`
(from the locally constant functions on the spectrum of `B / J B` to the cohomology of the places;
zero in positive degree) of the maps `v B` commute with enlarging `B`. Here
`TestCohomology.antitoneFamily h_anti Λ n` sends `B` to the cohomology in degree `n` of the places
for `B`, and `quotientFunctor J _ ⋙ locConstSpec Λ` sends `B` to the locally constant functions on
the spectrum of `B / J B`. -/
private lemma New.Variety.ResiduePlace.antitoneFamily_map_locConstClass_eq_of_baseRingMap_eq
    {v : ∀ B : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp
      (baseRingMap s ξ).hom),
      (placesFiniteOn z J B.val).toFunctor ⟶ reprBy ((quotientFunctor J _).obj B)}
    (hv : ∀ (B : absIntegrallyClosedSubrings
      ((algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom))
      {C : CommRingCat} {x : (placesFiniteOn z J B.val).toFunctor.obj C} {t : P} {c : C}
      (ht : algebraMap P q.ResidueField t ∈ B.val), (t, c) ∈ placeGraph x.val.val →
        baseRingMap (B := C) (v B) x
          (Ideal.Quotient.mk _ ⟨algebraMap P q.ResidueField t, ht⟩) = c)
    (h_anti : Antitone fun B : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp
      (baseRingMap s ξ).hom) ↦ placesFiniteOn z J B.val)
    (n : ℕ) {B B' : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp
      (baseRingMap s ξ).hom)}
    (l : B ⟶ B') (f : (quotientFunctor J _ ⋙ locConstSpec Λ).obj B) :
    (TestCohomology.antitoneFamily h_anti Λ n).map l (locConstClass (mapOnTests (v B)) n f) =
      locConstClass (mapOnTests (v B')) n ((quotientFunctor J _ ⋙ locConstSpec Λ).map l f) := by
  -- It remains that `v B` and `v B'` agree, at a place `x` for `B'`, on the class of each `y ∈ B`.
  -- Write `y` as the residue of `t` for a pair `w = (t, c)` of the graph of `x`; both value
  -- maps send it to `c`.
  refine map_locConstClass (fun C x ↦ ?_) n
  rw [Functor.comp_map, ← Functor.map_comp_apply]
  congr 3 with ⟨y, hy⟩
  obtain ⟨w, rfl⟩ := x.prop.2 (l.le hy)
  exact (hv B hy w.prop).trans (hv B' _ w.prop).symm

/-- If `B₃` is the ring generated by `B₁` and `B₂`, the places that are finite on `B₃` are those
that are finite on both `B₁` and `B₂`. -/
private lemma New.Variety.ResiduePlace.placesFiniteOn_eq_inf_of_isSplitting
    {B B₁ B₂ B₃ : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp
      (baseRingMap s ξ).hom)}
    (h_split : IsSplitting B B₁ B₂ B₃) :
    placesFiniteOn z J B₃.val = placesFiniteOn z J B₁.val ⊓ placesFiniteOn z J B₂.val := by
  -- After unfolding, both sides say that the place kills `J` and is finite on `B₁` and on `B₂`.
  ext
  simp [placesFiniteOn, h_split.eq_sup, and_assoc, and_left_comm]

/-- If every valuation ring over `B` contains `B₁` or `B₂`, then among the places that are finite on
`B` and kill `J`, those that are finite on `B₁` or on `B₂` are dense (coefficients `Λ`). -/
private lemma New.Variety.ResiduePlace.isCohomDense_placesFiniteOn_sup_of_isSplitting
    {B B₁ B₂ B₃ : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp
      (baseRingMap s ξ).hom)}
    (h_split : IsSplitting B B₁ B₂ B₃) :
    IsCohomDense (locConstCoeff Λ)
      (((placesFiniteOn z J B₁.val ⊔ placesFiniteOn z J B₂.val).preimage
        (placesFiniteOn z J B.val).ι).whisker testIncl) := by
  -- A place on a valuation ring lies in the piece for `B₁` (`true`) or for `B₂` (`false`).
  refine .of_affine_cover
    (V := fun b ↦ (placesFiniteOn z J (cond b B₁.val B₂.val)).preimage (placesFiniteOn z J B.val).ι)
    (fun _ ↦ isRelAffine_placesFiniteOn.preimage _) fun _C x ↦ ?_
  obtain ⟨hx_zero, hx_finite⟩ := x.prop
  obtain hx | hx := h_split.le_or_le ⟨_, finiteValueSubring_mem_or_inv_mem _⟩ hx_finite
  exacts [⟨true, by tauto, hx_zero, hx⟩, ⟨false, by tauto, hx_zero, hx⟩]

/-- The step of the downward induction in `ResiduePlace.exists_isAcyclicOver_placesFiniteOn` at a
ring `B` that splits into `B₁` and `B₂` (`IsSplitting`: both strictly contain `B`, and every
valuation ring containing `B` contains one of them), which generate `B₃`, such that the locally
constant functions on the spectra modulo `J` form an exact Mayer–Vietoris sequence. Let `v` be value
maps as in `ResiduePlace.antitoneFamily_map_locConstClass_eq_of_baseRingMap_eq`, and suppose that
over `B₃` the comparison map `locConstClass` is injective in degree `0` and surjective in every
degree below `n`. Then a class `y` of degree `n` (coefficients `Λ`) over `B` whose restrictions to
`B₁` and `B₂` come from locally constant functions comes from a locally constant function itself. -/
private lemma New.Variety.ResiduePlace.exists_locConstClass_eq_of_isSplitting
    {v : ∀ B : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp
      (baseRingMap s ξ).hom),
      (placesFiniteOn z J B.val).toFunctor ⟶ reprBy ((quotientFunctor J _).obj B)}
    (hv : ∀ (B : absIntegrallyClosedSubrings
      ((algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom))
      {C : CommRingCat} {x : (placesFiniteOn z J B.val).toFunctor.obj C} {t : P} {c : C}
      (ht : algebraMap P q.ResidueField t ∈ B.val), (t, c) ∈ placeGraph x.val.val →
        baseRingMap (B := C) (v B) x
          (Ideal.Quotient.mk _ ⟨algebraMap P q.ResidueField t, ht⟩) = c)
    (h_anti : Antitone fun B : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp
      (baseRingMap s ξ).hom) ↦ placesFiniteOn z J B.val)
    {B B₁ B₂ B₃ : absIntegrallyClosedSubrings ((algebraMap P q.ResidueField).comp
      (baseRingMap s ξ).hom)}
    (h_split : IsSplitting B B₁ B₂ B₃)
    (h_exact : IsMayerVietorisExact (quotientFunctor J _ ⋙ locConstSpec Λ)
      h_split.lt_left.le h_split.lt_right.le h_split.left_le h_split.right_le)
    (n : ℕ) (h_inj₃ : Function.Injective (locConstClass (Λ := Λ) (mapOnTests (v B₃)) 0))
    (h_surj₃ : ∀ m < n, Function.Surjective (locConstClass (Λ := Λ) (mapOnTests (v B₃)) m))
    (y : (TestCohomology.antitoneFamily h_anti Λ n).obj B)
    (h_above₁ : ∃ f₁ : (quotientFunctor J _ ⋙ locConstSpec Λ).obj B₁,
      locConstClass (mapOnTests (v B₁)) n f₁ =
        (TestCohomology.antitoneFamily h_anti Λ n).map h_split.lt_left.le.hom y)
    (h_above₂ : ∃ f₂ : (quotientFunctor J _ ⋙ locConstSpec Λ).obj B₂,
      locConstClass (mapOnTests (v B₂)) n f₂ =
        (TestCohomology.antitoneFamily h_anti Λ n).map h_split.lt_right.le.hom y) :
    ∃ f : (quotientFunctor J _ ⋙ locConstSpec Λ).obj B,
      locConstClass (mapOnTests (v B)) n f = y := by
  -- Find `f` over `B` with the same classes over `B₁` and `B₂` as the restrictions of `y`; then
  -- `y` and the class of `f` are equal by Mayer–Vietoris for the places finite on `B₁`, `B₂`.
  let γ : D →+* q.ResidueField := (algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom
  let LC : absIntegrallyClosedSubrings γ ⥤ Ab := quotientFunctor J γ ⋙ locConstSpec Λ
  -- `σ B'` is the value map `v B'` on test rings.
  let σ (B' : absIntegrallyClosedSubrings γ) := mapOnTests (v B')
  let Coh := TestCohomology.antitoneFamily h_anti Λ
  have h_nat (m : ℕ) {B' B'' : absIntegrallyClosedSubrings γ} (l : B' ⟶ B'') (f : LC.obj B') :
      (Coh m).map l (locConstClass (σ B') m f) = locConstClass (σ B'') m (LC.map l f) :=
    antitoneFamily_map_locConstClass_eq_of_baseRingMap_eq hv h_anti m l f
  obtain ⟨l₁, l₂⟩ : B ≤ B₁ ∧ B ≤ B₂ := ⟨h_split.lt_left.le, h_split.lt_right.le⟩
  obtain ⟨h₁, h₂⟩ : B₁ ≤ B₃ ∧ B₂ ≤ B₃ := ⟨h_split.left_le, h_split.right_le⟩
  obtain ⟨f₁, hf₁⟩ := h_above₁
  obtain ⟨f₂, hf₂⟩ := h_above₂
  -- A function `f` over `B` with the same classes as `f₁`, `f₂`: in degree `0` they agree over `B₃`
  -- by injectivity and glue; in higher degree `locConstClass` is zero.
  obtain ⟨f, hff₁, hff₂⟩ : ∃ f : LC.obj B,
      locConstClass (σ B₁) n (LC.map l₁.hom f) = locConstClass (σ B₁) n f₁ ∧
        locConstClass (σ B₂) n (LC.map l₂.hom f) = locConstClass (σ B₂) n f₂ := by
    cases n
    · -- Both functions have the class of the restriction of `y` to `B₃`.
      have h_agree : LC.map h₁.hom f₁ = LC.map h₂.hom f₂ := by
        apply h_inj₃
        calc locConstClass (σ B₃) 0 (LC.map h₁.hom f₁)
            = (Coh 0).map h₁.hom (locConstClass (σ B₁) 0 f₁) := (h_nat 0 h₁.hom f₁).symm
          _ = (Coh 0).map h₂.hom (locConstClass (σ B₂) 0 f₂) := by
            rw [hf₁, hf₂, ← Functor.map_comp_apply, ← Functor.map_comp_apply]
            rfl
          _ = locConstClass (σ B₃) 0 (LC.map h₂.hom f₂) := h_nat 0 h₂.hom f₂
      exact (h_exact.exists_glue f₁ f₂ h_agree).imp fun f hf ↦
        ⟨congrArg _ hf.left, congrArg _ hf.right⟩
    · exact ⟨0, rfl, rfl⟩
  -- The class of `f` and `y` have the same restrictions, so they are equal by Mayer–Vietoris.
  have h_res₁ : (Coh n).map l₁.hom (locConstClass (σ B) n f) = (Coh n).map l₁.hom y :=
    (h_nat n l₁.hom f).trans (hff₁.trans hf₁)
  have h_res₂ : (Coh n).map l₂.hom (locConstClass (σ B) n f) = (Coh n).map l₂.hom y :=
    (h_nat n l₂.hom f).trans (hff₂.trans hf₂)
  refine ⟨f, TestCohomology.mayer_vietoris_injective (h_anti l₁) (h_anti l₂) ?_ n
    (T := placesFiniteOn z J B₃.val) ?_ ?_ (Prod.ext h_res₁ h_res₂)⟩
  · exact isCohomDense_placesFiniteOn_sup_of_isSplitting h_split
  · exact placesFiniteOn_eq_inf_of_isSplitting h_split
  · -- In lower degrees a class over `B₃` comes from a function, which is a difference.
    refine fun m hm ↦ (h_surj₃ m hm).forall.mpr fun g ↦ ?_
    obtain ⟨g₁, g₂, hg⟩ : ∃ (g₁ : LC.obj B₁) (g₂ : LC.obj B₂),
        g = LC.map h₁.hom g₁ - LC.map h₂.hom g₂ := h_exact.exists_eq_sub g
    refine ⟨locConstClass (σ B₁) m g₁, locConstClass (σ B₂) m g₂, ?_⟩
    rw [hg, _root_.map_sub, ← h_nat, ← h_nat]
    rfl

end ValueMaps

/-- Let `D` be absolutely integrally closed, with one of any two elements dividing the other and the
prime `ℓ` invertible in `D`. Let `s : Y → h_D`, let `z` be a valuative lift of `ξ ∈ Y(P)`, let `q`
be a maximal ideal of `P` and `J` a prime ideal of `D`. For every absolutely integrally closed
subring `B` of the residue field at `q` containing the image of `D`, the places of `P` over `D`
vanishing on `q` that are finite on `B` and kill `J` have the cohomology of `B / J B`. That is,
there is a map `σ` from them to `h_{B / J B}` on test rings that is acyclic over `ZMod ℓ`, so their
cohomology vanishes in positive degrees and in degree `0` consists of the locally constant functions
on the spectrum of `B / J B`. -/
lemma New.Variety.ResiduePlace.exists_isAcyclicOver_placesFiniteOn {ℓ : ℕ} [ThePrime ℓ]
  {Y : PointFunctor}
    {D P : CommRingCat} [IsAbsIntegrallyClosed D] [PreValuationRing D] {s : Y ⟶ reprBy D}
      {ξ : Y.obj P}
    (z : ValuativeLift s ξ) (hℓ : IsUnit (ℓ : D)) {q : Ideal P} [q.IsMaximal] (J : Ideal D)
    [J.IsPrime] (B : absIntegrallyClosedSubrings
      ((algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom)) :
    ∃ σ : ((placesFiniteOn z J B.val).whisker testIncl).toFunctor ⟶
        testIncl ⋙ reprBy ((quotientFunctor J _).obj B),
      IsAcyclicOver σ ⟨ZMod ℓ⟩ := by
  -- Downward induction on `B` by Zorn's lemma: either `B` is a valuation ring, or it splits into
  -- two larger rings `B₁`, `B₂` and Mayer–Vietoris applies.
  have h_alg : ∀ (q : Ideal P) [q.IsPrime], IsAlgClosed q.ResidueField := z.isAlgClosed_residueField
  let γ : D →+* q.ResidueField := (algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom
  let LC : absIntegrallyClosedSubrings γ ⥤ Ab := quotientFunctor J γ ⋙ locConstSpec ⟨ZMod ℓ⟩
  -- `v B` is the value map of `B`, with its values at residues given by `hv`.
  let v (B : absIntegrallyClosedSubrings γ) := valueMap z J B
  have hv : ∀ (B : absIntegrallyClosedSubrings γ) {C : CommRingCat}
    {x : (placesFiniteOn z J B.val).toFunctor.obj C}
      {t : P} {c : C} (ht : algebraMap P q.ResidueField t ∈ B.val), (t, c) ∈ placeGraph x.val.val →
      baseRingMap (B := C) (v B) x (Ideal.Quotient.mk _ ⟨algebraMap P q.ResidueField t, ht⟩) = c :=
    baseRingMap_valueMap_mk
  -- `σ B` is stated on `testIncl ⋙ _`, the form in which `Coh` and the lemmas used below have it;
  -- with the form `(_.whisker testIncl).toFunctor` of the statement, the kernel has to identify the
  -- cohomology groups of the two forms again and again, which is slow.
  let σ (B : absIntegrallyClosedSubrings γ) :
      testIncl ⋙ (placesFiniteOn z J B.val).toFunctor ⟶
        testIncl ⋙ reprBy ((quotientFunctor J γ).obj B) :=
    mapOnTests (v B)
  suffices h_acyclic : IsAcyclicOver (σ B) ⟨ZMod ℓ⟩ from ⟨σ B, h_acyclic⟩
  have h_anti : Antitone fun B : absIntegrallyClosedSubrings γ ↦ placesFiniteOn z J B.val :=
    -- A place that is finite on a ring is finite on every smaller ring.
    antitone_const.inf fun B B' hBB' _C _y hy ↦ (show B.val ≤ B'.val from hBB').trans hy
  -- `Coh n` sends `B` to the cohomology in degree `n` of the places for `B`.
  let Coh := TestCohomology.antitoneFamily h_anti ⟨ZMod ℓ⟩
  have h_nat (n : ℕ) {B B' : absIntegrallyClosedSubrings γ} (l : B ⟶ B') (f : LC.obj B) :
      (Coh n).map l (locConstClass (σ B) n f) = locConstClass (σ B') n (LC.map l f) :=
    antitoneFamily_map_locConstClass_eq_of_baseRingMap_eq hv h_anti n l f
  -- Both sides turn the union of a directed family into a colimit, so by
  -- downward induction (`injective_of_isFilteredColimit_of_map_eq_zero` and
  -- `surjective_of_isFilteredColimit_of_exists_lift`) it is enough to treat an element over `B`
  -- whose images over all strictly larger rings vanish (injectivity) or lift (surjectivity).
  have h_colim (n : ℕ) {c : Set (absIntegrallyClosedSubrings γ)} [IsDirectedOrder c]
    [hne : Nonempty c] :
      ∃ m : Limits.Cocone (Subtype.mono_coe fun B : absIntegrallyClosedSubrings γ ↦ B ∈ c).functor,
        IsFilteredColimit (LC.mapCocone m) ∧ IsFilteredColimit ((Coh n).mapCocone m) := by
    -- The cocone point is the union of `c` (`hm_pt`).
    obtain ⟨m, hm_pt, hm_colim⟩ := exists_cocone_iSup (Λ := ⟨ZMod ℓ⟩) J c
    refine ⟨m, hm_colim, (isProperOver_placeSpace.isCohomContinuous.of_isRelAffine
      (isRelAffine_killingPlaces q)).isFilteredColimit_antitoneFamily h_anti
      (fun _ ↦ isRelAffine_placesFiniteOn) fun hx ↦ ?_⟩
    exact ⟨(hx hne.some).1, hm_pt.trans_le (iSup_le fun B ↦ (hx B).2)⟩
  have h_inj : ∀ B : absIntegrallyClosedSubrings γ,
    Function.Injective (locConstClass (Λ := ⟨ZMod ℓ⟩) (σ B) 0) := by
    -- Stated for abstract groups, so that the kernel need not unfold the group structure of `Ext`.
    have eq_zero_of_injective {M N : Type _} [AddCommGroup M] [AddCommGroup N] {g : M →+ N}
        (hg : Function.Injective g) (x : M) (hx : g x = 0) : x = 0 :=
      (injective_iff_map_eq_zero g).mp hg x hx
    refine injective_of_isFilteredColimit_of_map_eq_zero (h_nat 0) (h_colim 0)
      fun B f hf h_above ↦ ?_
    by_cases hB : ∀ x : q.ResidueField, x ∈ B.val ∨ x⁻¹ ∈ B.val
    · obtain ⟨h_inj_B, -⟩ : IsAcyclicOver (σ B) ⟨ZMod ℓ⟩ :=
        isAcyclicOver_of_mem_or_inv_mem hB (hv B)
      exact eq_zero_of_injective h_inj_B f hf
    · obtain ⟨B₁, B₂, B₃, h_split, h_exact⟩ := exists_isSplitting_isMayerVietorisExact J γ hℓ B hB
      exact h_exact.eq_zero f (h_above B₁ h_split.lt_left) (h_above B₂ h_split.lt_right)
  -- Surjectivity, by strong induction on the degree.
  refine ⟨h_inj B, fun n ↦ ?_⟩
  induction n using Nat.strongRecOn generalizing B with | ind n ih => ?_
  refine surjective_of_isFilteredColimit_of_exists_lift (h_nat n) (h_colim n)
    (fun B y h_above ↦ ?_) B
  by_cases hB : ∀ x : q.ResidueField, x ∈ B.val ∨ x⁻¹ ∈ B.val
  · obtain ⟨-, h_surj_B⟩ : IsAcyclicOver (σ B) ⟨ZMod ℓ⟩ := isAcyclicOver_of_mem_or_inv_mem hB (hv B)
    exact h_surj_B n y
  · obtain ⟨B₁, B₂, B₃, h_split, h_exact⟩ := exists_isSplitting_isMayerVietorisExact J γ hℓ B hB
    exact exists_locConstClass_eq_of_isSplitting hv h_anti h_split h_exact n (h_inj B₃)
      (fun m hm ↦ ih m hm B₃) y (h_above B₁ h_split.lt_left) (h_above B₂ h_split.lt_right)

/-- Proper base change for the places `killingPlaces z q` that vanish on a maximal ideal `q` of `P`.
Let `A` be an absolutely integrally closed local domain in which of any two elements one divides the
other and the prime `ℓ` is invertible; let `s : Y → h_A` and let `z` be a valuative lift of
`ξ ∈ Y(P)`. Then the inclusion into `killingPlaces z q` of those of its places that lie over the
closed fibre of `Y` (the points whose structure map kills the maximal ideal of `A`) induces
isomorphisms on cohomology with coefficients `ZMod ℓ` on test rings. -/
lemma New.Variety.ResiduePlace.isTestCohomEquiv_closedFiber_killingPlaces {ℓ : ℕ} [ThePrime ℓ]
    {A : Type} [CommRing A]
    [IsAbsIntegrallyClosedLocal A] [PreValuationRing A] {Y : PointFunctor} {P : CommRingCat}
    {s : Y ⟶ reprBy ⟨A⟩}
    {ξ : Y.obj P} (z : ValuativeLift s ξ) (hℓ : IsUnit (ℓ : A)) (q : Ideal P) [q.IsMaximal] :
    IsTestCohomEquiv ⟨ZMod ℓ⟩
      ((killingPlaces z q).fromPreimage
        ((zeroPoints s (maximalIdeal A)).preimage (placeSpaceMap z)).ι) := by
  -- Apply `exists_isAcyclicOver_placesFiniteOn` to the image `B` of `A` in the residue field, on
  -- which every place is finite, with `J = ⊥` (all places) and `J` the maximal ideal (the closed
  -- fibre).
  let γ := (algebraMap P q.ResidueField).comp (baseRingMap s ξ).hom
  have h_surj : Function.Surjective γ.rangeRestrict := γ.rangeRestrict_surjective
  let B : absIntegrallyClosedSubrings γ := ⟨γ.range, le_rfl, .of_surjective h_surj⟩
  let T (J : Ideal A) := (placesFiniteOn z J B.val).whisker testIncl
  have h_all (C : CommRingCat) (x : (killingPlaces z q).toFunctor.obj C) :
      x ∈ placesFiniteOn z ⊥ B.val C :=
    ⟨by simp [zeroPoints], fun _ ⟨d, hd⟩ ↦ ⟨⟨_, baseRingMap_mem_placeGraph d⟩, hd⟩⟩
  obtain ⟨σ_bot, h_bot⟩ := exists_isAcyclicOver_placesFiniteOn z hℓ ⊥ B
  obtain ⟨σ_max, h_max⟩ := exists_isAcyclicOver_placesFiniteOn z hℓ (maximalIdeal A) B
  -- Both quotients of `B` are domains, so both functors have the cohomology of a point.
  have h_prime_bot : (extendedIdeal ⊥ γ B).IsPrime := by simp [isPrime_bot]
  have h_prime_max : (extendedIdeal (maximalIdeal A) γ B).IsPrime :=
    map_isPrime_of_surjective h_surj (le_maximalIdeal (ker_ne_top _))
  have h_le : T (maximalIdeal A) ≤ T ⊥ := fun _C x _hx ↦ h_all _ x
  have h_eqv : IsCohomEquiv (locConstCoeff ⟨ZMod ℓ⟩) (freeAb.map (homOfLe h_le)) :=
    h_bot.isCohomEquiv (isDomain _) (isDomain _) _ h_max
  have h_top : IsCohomEquiv (locConstCoeff ⟨ZMod ℓ⟩) (freeAb.map (T ⊥).ι) :=
    IsCohomDense.isCohomEquiv (.of_top_le fun _C x _hx ↦ h_all _ x)
  -- The map in question is injective with image `T (maximalIdeal A)`.
  refine (isCohomEquiv_iff_range (hg := mono_of_app_injective ?_) (U := T (maximalIdeal A)) ?_).mpr
    ?_
  · -- A point of the preimage is a place with a property, so the inclusion is injective.
    rintro _ ⟨⟨_⟩⟩ ⟨⟨_⟩⟩ ⟨⟩
    rfl
  · ext C x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨y.val.prop, (h_all _ _).right⟩
    · rintro ⟨hx_zero, -⟩
      exact ⟨⟨⟨x.val, hx_zero⟩, x.prop⟩, rfl⟩
  · -- The inclusion of `T (maximalIdeal A)` factors through `T ⊥`; both factors are equivalences.
    simpa only [← homOfLe_ι h_le, Functor.map_comp] using h_eqv.comp_iff.mpr h_top

/-- The places that give the value `0` to all elements of an ideal behave like its zero locus. -/
lemma New.Variety.ResiduePlace.isZeroLocusFamily_killingPlaces {Y : PointFunctor}
    {D P : CommRingCat} {s : Y ⟶ reprBy D} {ξ : Y.obj P} (z : ValuativeLift s ξ) :
    IsZeroLocusFamily (killingPlaces z) where
  isRelAffine := isRelAffine_killingPlaces
  mem_sSup_iff {A x c} := by
    -- the elements with the value `0` form an additive submonoid `N`
    let N : AddSubmonoid P := (placeGraph x).toAddSubmonoid.comap (AddMonoidHom.inl P A)
    change (sSup c).toAddSubmonoid ≤ N ↔ ∀ a ∈ c, a.toAddSubmonoid ≤ N
    simp [sSup_eq_iSup, Submodule.iSup_toAddSubmonoid]
  subsingleton_of_mem_top {A x} hx :=
    subsingleton_of_zero_eq_one (placeGraph_unique (hx 1 Submodule.mem_top) (one_mem _))

/-- Proper base change for the space of places of `z`, which is the source of `placeSpaceMap z`. Let
`A` be an absolutely integrally closed local domain in which one of any two elements divides the
other and the prime `ℓ` is a unit; let `s : Y → h_A` and let `z` be a valuative lift of `ξ ∈ Y(P)`.
Then the inclusion of the preimage of the closed fibre of `Y` (the points where the maximal ideal of
`A` maps to `0`) into the space of places induces isomorphisms on cohomology with coefficients
`ZMod ℓ` on test rings. -/
lemma New.Variety.ResiduePlace.isTestCohomEquiv_closedFiber {ℓ : ℕ} [ThePrime ℓ] {A : Type}
    [CommRing A]
    [IsAbsIntegrallyClosedLocal A] [PreValuationRing A] {Y : PointFunctor} {P : CommRingCat}
    {s : Y ⟶ reprBy ⟨A⟩} {ξ : Y.obj P} (z : ValuativeLift s ξ) (hℓ : IsUnit (ℓ : A)) :
    IsTestCohomEquiv ⟨ZMod ℓ⟩ ((zeroPoints s (maximalIdeal A)).preimage (placeSpaceMap z)).ι := by
  have hW : IsProperOver (placeSpaceMap z ≫ s) := isProperOver_placeSpace
  -- The family `killingPlaces z a` behaves like zero loci, which leaves two claims: the pieces for
  -- `e` and `1 - e`, `e` idempotent, are dense together, and the result holds over each proper
  -- ideal `q` that contains `e` or `1 - e` for every such `e`.
  refine IsTestCohomEquiv.of_connected
    (hW.isCohomContinuous.of_isRelAffine ((isRelAffine_zeroPoints s _).preimage _))
    hW.isCohomContinuous _ (isZeroLocusFamily_killingPlaces z) (fun e he ↦ ?_) fun q hq_ne hq ↦ ?_
  · -- A point in a valuation ring is given by a place `j`, whose prime contains `e` or `1 - e`.
    refine .of_affine_cover (V := fun b ↦ killingPlaces z (span {cond b e (1 - e)}))
      (fun _ ↦ isRelAffine_killingPlaces _) fun O x ↦ ?_
    obtain ⟨j, φ, -, hx⟩ := exists_isLocalHom_eq_projHom_comp x
    have hxj : x ∈ killingPlaces z j.prime.asIdeal ⟨O⟩ := by
      rw [hx j.valuationSubring j.base_mem le_rfl]
      exact projHom_mem_killingPlaces j _
    obtain ⟨b, hle⟩ : ∃ b : Bool, span {cond b e (1 - e)} ≤ j.prime.asIdeal := by
      simpa [or_comm] using j.prime.isPrime.mem_or_mem (x := e) (y := 1 - e) (by simp [he])
    refine ⟨b, ?_, fun t ht ↦ hxj t (hle ht)⟩
    -- The piece for `b` is one of the two pieces of the union.
    cases b
    exacts [fun _C _x hx ↦ Or.inr hx, fun _C _x hx ↦ Or.inl hx]
  · -- Such a `q` is maximal: for `t ∉ q` and `y * t * t = t`, the idempotent `y * t` is not in `q`,
    -- so `1 - y * t ∈ q`, and an ideal that contains `q` and `t` contains `1`.
    have hq_max : q.IsMaximal := by
      refine isMaximal_iff.mpr ⟨q.ne_top_iff_one.mp hq_ne, fun J t hqJ htq htJ ↦ ?_⟩
      obtain ⟨y, hy⟩ : ∃ y : P, y * t * t = t := z.absolutely_flat t
      have h_notMem : y * t ∉ q := fun h ↦ htq (by simpa [hy] using q.mul_mem_right t h)
      have h_idem : IsIdempotentElem (y * t) := by grind [IsIdempotentElem]
      have h_compl : 1 - y * t ∈ q := (hq (y * t) h_idem).resolve_left h_notMem
      simpa using J.add_mem (hqJ h_compl) (J.mul_mem_left y htJ)
    exact isTestCohomEquiv_closedFiber_killingPlaces z hℓ q

/-- Proper base change. Let `A` be an absolutely integrally closed local domain that is a valuation
ring (`PreValuationRing`: of any two elements one divides the other) and in which the prime `ℓ` is
invertible, and let `s : Y ⟶ reprBy A` be proper. Then the inclusion of the closed fibre of `Y` (the
points whose structure map kills the maximal ideal of `A`) into `Y` induces isomorphisms on
cohomology with coefficients in `ZMod ℓ` on test rings, in every degree. -/
lemma New.Variety.IsProperOver.proper_base_change {ℓ : ℕ} [ThePrime ℓ] {Y : CommRingCat ⥤ Type 1}
    {A : Type} [CommRing A] [IsAbsIntegrallyClosedLocal A] [PreValuationRing A] {s : Y ⟶ reprBy ⟨A⟩}
    (hs : IsProperOver s) (hℓ : IsUnit (ℓ : A)) :
    IsTestCohomEquiv ⟨ZMod ℓ⟩ (zeroPoints s (maximalIdeal A)).ι := by
  -- Induction on `r` for all proper `Y` at once, by Čech descent along the cover by places.
  -- The comparison map is that of the inclusion of the closed fibre; its type is left to the
  -- elaborator, since unifying the written-out type is slow.
  refine (show IsBijective _ (freeAbMap (Y := _ ⋙ Y) _) from
    allBijective_iff_forall_bijectiveUpTo.mpr fun r ↦ ?_).eqv
  induction r generalizing Y with
  | zero =>
    -- Bijectivity up to degree `0` says nothing: no `n` has `2 * n < 0`.
    exact fun n ↦ ⟨fun h ↦ absurd h (Nat.not_lt_zero _), fun h ↦ absurd h (Nat.not_lt_zero _)⟩
  | succ r ih =>
    -- The space of places of `z` has dense image in `Y`; `bijectiveUpTo_of_cech_pred` needs the
    -- claim for it in all degrees and the induction hypothesis for its fibre powers over `Y`.
    obtain ⟨P, ξ, z, hdense⟩ := hs.exists_valuativeLift_hasCohomDenseImage (Λ := ⟨ZMod ℓ⟩)
    have hW : IsProperOver (placeSpaceMap z ≫ s) := isProperOver_placeSpace
    refine bijectiveUpTo_of_cech_pred (p' := mapOnTests (fromPreimage _ (placeSpaceMap z)))
      (v := mapOnTests (ι _)) rfl hdense.isCohomEquiv
      (hdense.of_preimage_le (mapOnTests (ι _)) ?_).isCohomEquiv ?_ fun m ↦ ?_
    · -- The cover stays dense on the closed fibre.
      rintro _ ⟨_, hy⟩ ⟨x, ⟨⟩⟩
      exact ⟨⟨x, hy⟩, rfl⟩
    · exact (isTestCohomEquiv_closedFiber z hℓ).bij
    -- The fibre powers of the cover are proper, so the induction hypothesis applies to them.
    -- `s'` is the structure map to `h_A` of the `m`-th fibre power of the cover.
    let s' := cech.proj (placeSpaceMap z) m 0 ≫ placeSpaceMap z ≫ s
    have h_proper_pow : IsProperOver s' := by
      induction m with
      | zero => exact hW.of_isPullback hW (.of_vert_isIso (g := 𝟙 _) ⟨rfl⟩) hW (𝟙 _) rfl
      | succ m hm => exact hW.of_isPullback hs isPullback_cech hm (𝟙 _) rfl
    -- The closed fibre of a fibre power is the fibre power of the cover of the closed fibre.
    refine (bijectiveUpTo_congr (p := 𝟙 _)
        (((zeroPoints s' (maximalIdeal A)).whisker testIncl).lift_ι _ ?_) (.of_isIso _)
        (.of_bijective fun C ↦ ?_)).mp ?_
    · rintro _ _ ⟨x, rfl⟩
      exact (x.val 0).prop
    · refine Function.bijective_iff_has_inverse.mpr ⟨fun x ↦
        ⟨fun i ↦ ⟨x.val.val i, ?_⟩, fun i j ↦ Subtype.ext (x.val.prop i j)⟩,
          fun _ ↦ rfl, fun _ ↦ rfl⟩
      -- All coordinates of `x` have the same image in `Y`, and it lies in the closed fibre.
      have h_zero : (placeSpaceMap z).app _ (x.val.val 0) ∈ (zeroPoints s (maximalIdeal A)).obj _ :=
        x.prop
      rwa [x.val.prop 0 i] at h_zero
    · exact ih h_proper_pow

end ProperBaseChange2

namespace New.Variety

/-!
## Cohomology under extension of algebraically closed fields and open zero sets

Consequences of proper base change (`New.Variety.IsProperOver.proper_base_change`) for a functor `W`
proper over `R` (`New.Variety.IsProperOver`), with coefficients `ℤ/ℓ` for a prime `ℓ` invertible in
`R`: over an absolutely integrally closed valuation ring a class is determined by the closed fibre,
cohomology does not change under an extension of algebraically closed fields, and over a test ring
the primes at which a class vanishes form an open set.

Here `New.Variety.baseChangeOf s a` is the base change `W_S` along `a : R ⟶ S`,
`New.Variety.baseChangeTransition` is the map `W_T ⟶ W_S` given by a map `S ⟶ T` over `R`, and
`New.Variety.TestCohomology.map` is pull-back of classes.
-/

section FieldExtension

open CategoryTheory RingHom CommRingCat Ideal TestCohomology Subfunctor IsLocalRing Algebra
  PrimeSpectrum Set

/-- If `v'` factors through `v`, a class with coefficients in `Λ` that pulls back to zero along `v`
pulls back to zero along `v'`. -/
lemma TestCohomology.map_eq_zero_of_factors {n : ℕ} {W : CommRingCat ⥤ Type 1} {Λ : Ab}
    {X Z : PointFunctor} {v : W ⟶ X} {v' : Z ⟶ X}
    {x : H (freeAb.obj (testIncl ⋙ X)) (locConstCoeff Λ) n} {w : Z ⟶ W} (h_fac : w ≫ v = v') :
    map Λ (X := W) (Y := X) v n x = 0 → map Λ (X := Z) (Y := X) v' n x = 0 := by
  intro hx
  rw [← h_fac, map_comp, hx, map_zero]

/-- Pull-back of classes along the identity of `X` is the identity. -/
private lemma TestCohomology.map_id_apply {n : ℕ} {Λ : Ab} {X : PointFunctor}
    (x : H (freeAb.obj (testIncl ⋙ X)) (locConstCoeff Λ) n) : map Λ (𝟙 X) n x = x := by
  simp [TestCohomology.map, mapOnTests]

/-- Let `W` be a functor on rings that is proper over `R` through `s` (`hs`: closed diagonal and a
valuative criterion), `ℓ` a prime invertible in `R` (`hℓ`), and `A` an absolutely integrally closed
local domain (every monic polynomial of positive degree has a root) that is a valuation ring
(`PreValuationRing A`), with a ring map `a : R ⟶ A`. The residue map `A → κ` onto the residue field
of `A` induces a map `W_κ → W_A` of base changes (`baseChangeTransition`), and pull-back along it is
injective on `Hⁿ(–, ℤ/ℓ)`, the cohomology of functors on rings computed on test rings with locally
constant coefficients `ℤ/ℓ`: a class on `W_A` is determined by its restriction to the closed
fibre. -/
lemma IsProperOver.injective_map_residue {ℓ n : ℕ} {W : CommRingCat ⥤ Type 1} [ThePrime ℓ]
    {R : CommRingCat} {s : W ⟶ reprBy R} (hs : IsProperOver s) (hℓ : IsUnit (ℓ : R)) {A : Type}
    [CommRing A] [IsAbsIntegrallyClosedLocal A] [PreValuationRing A] {a : R ⟶ of A} :
    Function.Injective
      (TestCohomology.map ⟨ZMod ℓ⟩ (baseChangeTransition s (ofHom (residue A)) (a := a) rfl)
        n) := by
  -- By proper base change, restriction to the closed fibre `X₀` of `W_A` (the points that kill the
  -- maximal ideal) is injective, and the inclusion of `X₀` factors through `res : W_κ ⟶ W_A`.
  let pr : baseChangeOf s a ⟶ reprBy (of A) := fiberProd.snd s (reprMap a)
  let X₀ : Subfunctor (baseChangeOf s a) := zeroPoints pr (maximalIdeal A)
  let res : baseChangeOf s (a ≫ ofHom (residue A)) ⟶ baseChangeOf s a :=
    baseChangeTransition s (ofHom (residue A)) rfl
  have h_proper : IsProperOver pr := hs.baseChange a
  have hℓ_unit : IsUnit (ℓ : A) := by simpa using hℓ.map a.hom
  have h_equiv : IsTestCohomEquiv ⟨ZMod ℓ⟩ X₀.ι := h_proper.proper_base_change hℓ_unit
  have h_inj : Function.Injective (map ⟨ZMod ℓ⟩ X₀.ι n) := (h_equiv n).injective
  -- The ring map `A → B` of a point of `X₀` kills the maximal ideal, so it factors through `κ`.
  let fromResidue {B : CommRingCat} (y : X₀.toFunctor.obj B) : of (ResidueField A) ⟶ B :=
    ofHom (Ideal.Quotient.lift (maximalIdeal A) (baseRingMap pr y.val).hom y.property)
  -- `w` keeps the point of `W` and replaces the ring map `A → B` by `fromResidue y`.
  let w : X₀.toFunctor ⟶ baseChangeOf s (a ≫ ofHom (residue A)) :=
    { app B := ↾fun y ↦
        ⟨((fiberProd.fst s (reprMap a)).app B y.val, ⟨fromResidue y⟩), y.val.property⟩
      naturality B B' f := by
        -- Both sides have the same point of `W`, and their ring maps agree on each residue class.
        ext y
        exact baseChangeOf.ext rfl (residue_surjective.forall.mpr fun _ ↦ rfl) }
  have h_fac : w ≫ res = X₀.ι := rfl
  refine .of_comp (f := map ⟨ZMod ℓ⟩ w n) fun x y hxy ↦ h_inj ?_
  rwa [← h_fac, map_comp, map_comp]

variable {ℓ n : ℕ} {W : CommRingCat ⥤ Type 1} [ThePrime ℓ] {R S T : CommRingCat} {s : W ⟶ reprBy R}

/-- Invariance under extension of algebraically closed fields. Let `W` be a functor on rings that is
proper over `R` (`hs`: closed diagonal and a valuative criterion over valuation rings of
algebraically closed fields), and `ℓ` a prime invertible in `R` (`hℓ`). Let `S`, `T` be fields that
are absolutely integrally closed, that is, algebraically closed, with ring maps `a : R ⟶ S`,
`b : R ⟶ T` and `φ : S ⟶ T` over `R` (`h_comp`). Then the map `W_T → W_S` of base changes induced by
`φ` is an isomorphism on cohomology with coefficients `ℤ/ℓ` in every degree, where cohomology of
functors on rings is computed on test rings with locally constant coefficients. -/
lemma IsProperOver.isTestCohomEquiv_field_extension (hs : IsProperOver s) (hℓ : IsUnit (ℓ : R))
    {a : R ⟶ S} {b : R ⟶ T} {φ : S ⟶ T} (h_comp : a ≫ φ = b) (hS : IsField S) (hT : IsField T)
    (hS_aic : IsAbsIntegrallyClosed S) (hT_aic : IsAbsIntegrallyClosed T) :
    IsTestCohomEquiv ⟨ZMod ℓ⟩ (baseChangeTransition s φ h_comp) := by
  -- Classes on `W_T`, and their vanishing, come from the finitely generated `S`-subalgebras `A t`
  -- of `T`, and these have `S`-points `β t` by the Nullstellensatz.
  subst h_comp
  intro n
  algebraize [φ.hom]
  let hS_field : Field S := hS.toField
  let hT_field : Field T := hT.toField
  have hS_closed : IsAlgClosed S := hS_aic.isAlgClosed
  have hT_closed : IsAlgClosed T := hT_aic.isAlgClosed
  let A (t : Finset T) : Subalgebra S T := adjoin S t
  let α (t : Finset T) : S ⟶ of (A t) := ofHom (algebraMap S (A t))
  have (t : Finset T) : Algebra.FiniteType S (A t) := .adjoin_of_finite t.finite_toSet
  let β (t : Finset T) : A t →ₐ[S] S := (nullstellensatz_exists_le_ker bot_ne_top).choose
  -- The maps `W_T ⟶ W_(A t) ⟶ W_S`, and the section `W_S ⟶ W_(A t)` given by the point `β t`;
  -- `fib b` is `W_B`.
  let fib {B : CommRingCat} (b : R ⟶ B) : CommRingCat ⥤ Type 1 := Variety.baseChangeOf s b
  let inc (t : Finset T) : fib (a ≫ φ) ⟶ fib (a ≫ α t) :=
    baseChangeTransition s (ofHom (A t).val.toRingHom) rfl
  let prj (t : Finset T) : fib (a ≫ α t) ⟶ fib a := baseChangeTransition s (α t) rfl
  have h_section (t : Finset T) : (a ≫ α t) ≫ ofHom (β t).toRingHom = a :=
    congr(a ≫ ofHom $((β t).comp_algebraMap))
  let sec (t : Finset T) : fib a ⟶ fib (a ≫ α t) :=
    baseChangeTransition s (ofHom (β t).toRingHom) (h_section t)
  -- Base change is a functor: transitions compose, along the composite `k` of the ring maps, and
  -- the transition along an identity is the identity. Equalities of transitions below are reduced
  -- by `h_tri` and `h_one` to equalities of ring maps, which the kernel checks far faster than
  -- pointwise equalities of maps of functors.
  have h_tri {B C E : CommRingCat} {b : R ⟶ B} {c : R ⟶ C} {e : R ⟶ E} {f : B ⟶ C} {g : C ⟶ E}
      {k : B ⟶ E} {hf : b ≫ f = c} {hg : c ≫ g = e} (h : f ≫ g = k) :
      baseChangeTransition s g hg ≫ baseChangeTransition s f hf =
        baseChangeTransition s k (by rw [← h, ← Category.assoc, hf, hg]) := by
    subst h
    exact ((baseChangeFunctor s).map_comp _ _).symm
  have h_one {B : CommRingCat} {b : R ⟶ B} {k : B ⟶ B} {hk : b ≫ k = b} (h : k = 𝟙 B) :
      baseChangeTransition s k hk = 𝟙 _ := by
    subst h
    exact (baseChangeFunctor s).map_id _
  -- Continuity: the cohomology of `W_T` is the filtered colimit of that of the `W_(A t)`: a class
  -- on `W_(A t)` that dies on `W_T` dies at a later stage, and each class comes from some stage.
  obtain ⟨h_dies, h_comes⟩ :=
    (hs.isCohomContinuous (Λ := ⟨ZMod ℓ⟩)).isFilteredColimit_adjoin s T a n
  -- Stated for abstract groups, so that the kernel need not unfold the group structure of `Ext`.
  have injective_of_eq_zero {M N : Type 2} [AddCommGroup M] [AddCommGroup N] (g : M →+ N)
      (hg : ∀ x, g x = 0 → x = 0) : Function.Injective g := (injective_iff_map_eq_zero g).mpr hg
  refine ⟨injective_of_eq_zero _ fun x hx ↦ ?_, fun y ↦ ?_⟩
  · -- A class that dies on `W_T` dies on some `W_(A t)`; pull back along the section.
    have h_inc_prj : inc ∅ ≫ prj ∅ = baseChangeTransition s φ rfl := h_tri rfl
    obtain ⟨t, f, ht⟩ := h_dies ∅ (map _ (prj ∅) n x) ((map_comp (inc ∅) (prj ∅) x).symm.trans
      ((congrArg (fun u ↦ map _ u n x) h_inc_prj).trans hx))
    -- `tr` is the transition `W_(A t) ⟶ W_(A ∅)`; `sec t` is a section of `prj t = tr ≫ prj ∅`.
    let tr : fib (a ≫ α t) ⟶ fib (a ≫ α ∅) :=
      baseChangeTransition s (ofHom (Subalgebra.inclusion (adjoin_mono f.le)).toRingHom) rfl
    have h_tr : tr ≫ prj ∅ = prj t := h_tri rfl
    have h_ret : α t ≫ ofHom (β t).toRingHom = 𝟙 S :=
      CommRingCat.hom_ext (RingHom.ext (β t).commutes)
    have h_sec : sec t ≫ prj t = 𝟙 (fib a) := (h_tri rfl).trans (h_one h_ret)
    rw [← TestCohomology.map_id_apply x]
    exact map_eq_zero_of_factors (w := sec t) (v := tr ≫ prj ∅)
      ((congrArg (sec t ≫ ·) h_tr).trans h_sec) ((map_comp tr (prj ∅) x).trans ht)
  · -- A class on `W_T` comes from some `x` on `W_(A t)`. Take a valuation ring `V ⊇ A t` of `T`
    -- whose maximal ideal contains the kernel of `β t`.
    obtain ⟨t, x, rfl⟩ : ∃ t x, map ⟨ZMod ℓ⟩ (inc t) n x = y := h_comes y
    obtain ⟨V, hV, h_ker⟩ : ∃ V : ValuationSubring T, (A t).toSubring ≤ V.toSubring ∧
        (A t).toSubring.subtype '' RingHom.ker (β t) ⊆ V.nonunits :=
      image_subset_nonunits_valuationSubring _ (RingHom.ker_ne_top (β t))
    let i : of (A t) ⟶ of V := ofHom (Subring.inclusion hV)
    let toA : fib (a ≫ α t ≫ i) ⟶ fib (a ≫ α t) := baseChangeTransition s i rfl
    let toS : fib (a ≫ α t ≫ i) ⟶ fib a := baseChangeTransition s (α t ≫ i) rfl
    -- As `c - β t c` lies in that kernel, `A t → V` and `A t → S → V` agree in the residue field of
    -- `V`. So `x` and its pull-back along the section have the same image on the fibre over that
    -- field, hence on `W_V` by `injective_map_residue`.
    have h_agree : map ⟨ZMod ℓ⟩ toS n (map _ (sec t) n x) = map _ toA n x := by
      apply hs.injective_map_residue hℓ
      simp only [← map_comp]
      congr 2
      -- Both sides are transitions (`h_tri`), along the two ring maps `A t → κ(V)` in question.
      have h_res : ofHom (β t).toRingHom ≫ (α t ≫ i) ≫ ofHom (residue V) = i ≫ ofHom (residue V) :=
        CommRingCat.hom_ext (RingHom.ext fun c ↦ Ideal.Quotient.eq.mpr (V.coe_mem_nonunits_iff.mp
          (h_ker ⟨_, (RingHom.sub_mem_ker_iff _).mpr ((β t).commutes _), rfl⟩)))
      exact ((Category.assoc ..).symm.trans (congrArg (· ≫ sec t) (h_tri rfl))).trans
        ((h_tri h_res).trans (h_tri rfl).symm)
    -- Pull this equality back to the generic fibre `W_T` of `W_V`.
    let gen : fib (a ≫ φ) ⟶ fib (a ≫ α t ≫ i) := baseChangeTransition s (ofHom V.subtype) rfl
    refine ⟨map _ (sec t) n x, ?_⟩
    calc _ = map _ gen n (map _ toS n (map _ (sec t) n x)) := map_comp gen toS _
      _ = map _ gen n (map _ toA n x) := congrArg _ h_agree
      _ = map _ (inc t) n x := (map_comp gen toA x).symm

/-- If every element of `I` divides `b`, then the points at which `b` becomes a unit lie among
the points at which every element of `I` becomes a unit. -/
private lemma unitPoints_singleton_le_of_forall_dvd {X : PointFunctor} {B : CommRingCat}
    (p : X ⟶ reprBy B) {I : Set B} {b : B} (hb : ∀ c ∈ I, c ∣ b) :
    unitPoints p {b} ≤ unitPoints p I :=
  fun _ _ hy c hc ↦ isUnit_of_dvd_unit (map_dvd _ (hb c hc)) (hy b rfl)

/-- If a class vanishes on the points at which every element of `I` becomes a unit, and every
element of `I` divides `d`, then it vanishes on the points at which `d` becomes a unit. -/
private lemma map_unitPoints_ι_eq_zero_of_forall_dvd {Λ : Ab} {X : PointFunctor} {B : CommRingCat}
    {p : X ⟶ reprBy B} {x : H (freeAb.obj (testIncl ⋙ X)) (locConstCoeff Λ) n} {I : Set B} {d : B}
    (hd : ∀ c ∈ I, c ∣ d) (hI : map Λ (unitPoints p I).ι n x = 0) :
    map Λ (unitPoints p {d}).ι n x = 0 :=
  map_eq_zero_of_factors (homOfLe_ι (unitPoints_singleton_le_of_forall_dvd p hd)) hI

/-- Let `T` be a test ring with a ring map `a : R ⟶ T`, and `x` a class in `Hⁿ(W_T, ℤ/ℓ)`. If `x`
vanishes on the points of `W_T` at which `b` becomes a unit and on those at which `c` becomes a
unit, then it vanishes on the points at which `b + c` becomes a unit. -/
private lemma map_unitPoints_ι_add_eq_zero {T : TestRing} {a : R ⟶ of T.obj}
    {x : H (freeAb.obj (testIncl ⋙ baseChangeOf s a)) (locConstCoeff ⟨ZMod ℓ⟩) n} {b c : T.obj}
    (hb : map ⟨ZMod ℓ⟩ (unitPoints (fiberProd.snd s (reprMap a)) {b}).ι n x = 0)
    (hc : map ⟨ZMod ℓ⟩ (unitPoints (fiberProd.snd s (reprMap a)) {c}).ι n x = 0) :
    map ⟨ZMod ℓ⟩ (unitPoints (fiberProd.snd s (reprMap a)) {b + c}).ι n x = 0 := by
  -- An idempotent `e` with `b ∣ e * c` and `c ∣ (1 - e) * b` cuts the points where `b + c` is a
  -- unit into two disjoint pieces, on one of which `c` is a unit and on the other `b`. By
  -- Mayer–Vietoris a class there is determined by its restrictions to the two pieces.
  let U : Set T.obj → Subfunctor (baseChangeOf s a) := unitPoints (fiberProd.snd s (reprMap a))
  obtain ⟨e, he, h_bc, h_cb⟩ : ∃ e : T.obj, IsIdempotentElem e ∧ b ∣ e * c ∧ c ∣ (1 - e) * b :=
    T.property.isComparableRing b c
  -- `P d` is the set of points at which `(1 - d) * (b + c)` is a unit.
  let P (d : T.obj) : Subfunctor (baseChangeOf s a) := U {(1 - d) * (b + c)}
  have h_piece (d : T.obj) : P d ≤ U {b + c} := unitPoints_singleton_le_of_forall_dvd _ (by simp)
  -- On the intersection `(1 - e) * (b + c)` and `e * (b + c)` are units, but their product is zero:
  -- only the zero ring has such points.
  have h_disj (B : CommRingCat) (k : (P e ⊓ P (1 - e)).toFunctor.obj B) : (0 : B) = 1 := by
    obtain ⟨hk_e, hk_one_sub⟩ := k.property
    have h_prod_eq : (1 - e) * (b + c) * ((1 - (1 - e)) * (b + c)) = 0 := by
      have h_e : (1 - e) * e = 0 := by rw [sub_mul, one_mul, he.eq, sub_self]
      rw [sub_sub_cancel, mul_mul_mul_comm, h_e, zero_mul]
    have h_unit := (hk_e _ rfl).mul (hk_one_sub _ rfl)
    rwa [← map_mul, h_prod_eq, map_zero, isUnit_zero_iff] at h_unit
  -- A point of `U {b + c}` that kills `d` lies in `P d`, and the points that kill `e` or `1 - e`
  -- are dense.
  have h_mem_piece {B : CommRingCat} (y : (baseChangeOf s a).obj B) (d : T.obj)
      (hy : IsUnit (baseRingMap (fiberProd.snd s (reprMap a)) y (b + c)))
      (hd : baseRingMap (fiberProd.snd s (reprMap a)) y d = 0) : y ∈ (P d).obj B := by
    rintro _ rfl
    rwa [map_mul, map_sub, map_one, hd, sub_zero, one_mul]
  have h_dense : IsCohomDense (locConstCoeff ⟨ZMod ℓ⟩)
      (((P e ⊔ P (1 - e)).preimage (U {b + c}).ι).whisker testIncl) := by
    -- the structure map `T → B` of a point, as a morphism of test rings
    let toT : testIncl ⋙ (U {b + c}).toFunctor ⟶ reprBy T :=
      .mk fun _ ↦ ↾fun y ↦ ⟨⟨baseRingMap (fiberProd.snd s (reprMap a)) y.val⟩⟩
    refine .of_preimage_le (hasPartitions_locConstCoeff.isCohomDense_partition (A := T) _ he)
      toT fun _ y k ↦ ?_
    exact k.imp (h_mem_piece y.val e (y.property _ rfl))
      (h_mem_piece y.val (1 - e) (y.property _ rfl))
  -- `c` divides `(1 - e) * (b + c)`, and `b` divides `e * (b + c)`
  have h_c_dvd : c ∣ (1 - e) * (b + c) := by simp [h_cb, mul_add, dvd_add]
  have h_b_dvd : b ∣ (1 - (1 - e)) * (b + c) := by simp [h_bc, mul_add, dvd_add]
  -- By Mayer–Vietoris it is enough that the restrictions of the class to both pieces vanish.
  have h_restrict_inj := (mayer_vietoris_bijective (Λ := ⟨ZMod ℓ⟩) (h_piece e) (h_piece (1 - e))
    h_dense n h_disj).injective
  -- Stated for abstract groups, so that the kernel need not unfold the group structure of `Ext`.
  have eq_zero_of_prod {M N₁ N₂ : Type 2} [AddCommGroup M] [AddCommGroup N₁] [AddCommGroup N₂]
      {g₁ : M →+ N₁} {g₂ : M →+ N₂} (hg : Function.Injective (g₁.prod g₂)) {y : M}
      (h₁ : g₁ y = 0) (h₂ : g₂ y = 0) : y = 0 :=
    (map_eq_zero_iff _ hg).mp (Prod.ext h₁ h₂)
  refine eq_zero_of_prod h_restrict_inj ?_ ?_
  · exact (H.map_map ..).trans (map_unitPoints_ι_eq_zero_of_forall_dvd (by simpa using h_c_dvd) hc)
  · exact (H.map_map ..).trans (map_unitPoints_ι_eq_zero_of_forall_dvd (by simpa using h_b_dvd) hb)

/-- For a class `x` on `W_T`, the ideal of the `b ∈ T` such that `x` vanishes on the points of
`W_T` at which `b` becomes a unit. -/
private def unitVanishingIdeal (T : TestRing) (a : R ⟶ of T.obj)
    (x : H (freeAb.obj (testIncl ⋙ baseChangeOf s a)) (locConstCoeff ⟨ZMod ℓ⟩) n) :
    Ideal T.obj where
  carrier := {b : T.obj | map ⟨ZMod ℓ⟩ (unitPoints (fiberProd.snd s (reprMap a)) {b}).ι n x = 0}
  add_mem' hb hc := map_unitPoints_ι_add_eq_zero hb hc
  -- no point makes `0` a unit except over the zero ring
  zero_mem' := hasPartitions_locConstCoeff.eq_zero_of_zero_ring (by simp [unitPoints]) ..
  smul_mem' _ _ hb := map_unitPoints_ι_eq_zero_of_forall_dvd (by simp) hb

/-- Let `W` be proper over `R`, `ℓ` a prime invertible in `R`, `T` a test ring with a ring map
`a : R ⟶ T`, and `x` a class on `W_T` that restricts to zero on the base change to the residue
field at a prime `P` of `T`. Then for some `b ∉ P` the class `x` vanishes on the points of `W_T`
at which `b` becomes a unit. -/
private lemma exists_notMem_map_unitPoints_ι_eq_zero_of_map_residue_eq_zero (hs : IsProperOver s)
    (hℓ : IsUnit (ℓ : R)) {T : TestRing} {a : R ⟶ of T.obj}
    {x : H (freeAb.obj (testIncl ⋙ baseChangeOf s a)) (locConstCoeff ⟨ZMod ℓ⟩) n}
    (P : PrimeSpectrum T.obj)
    (hP : map ⟨ZMod ℓ⟩
      (baseChangeTransition s (ofHom (algebraMap T.obj P.asIdeal.ResidueField)) (a := a) rfl) n
      x = 0) :
    ∃ b ∉ P.asIdeal, map ⟨ZMod ℓ⟩ (unitPoints (fiberProd.snd s (reprMap a)) {b}).ι n x = 0 := by
  -- The class vanishes over the local ring at `P` by `injective_map_residue`, so on `U M` for the
  -- complement `M` of `P`; by continuity it vanishes on `U t` for a finite `t ⊆ M`; take
  -- `b = ∏ t`.
  let U : Set T.obj → Subfunctor (baseChangeOf s a) := unitPoints (fiberProd.snd s (reprMap a))
  let M : Submonoid T.obj := P.asIdeal.primeCompl
  obtain ⟨h_aic_local, h_valuation, -⟩ := T.property.exists_valuationSubring_atPrime P.asIdeal
  let loc : baseChangeOf s (a ≫ ofHom (algebraMap T.obj (Localization M))) ⟶ baseChangeOf s a :=
    baseChangeTransition s (ofHom (algebraMap T.obj (Localization M))) rfl
  -- the residue field of the local ring at `P` is that of `P`
  have h_loc : map ⟨ZMod ℓ⟩ loc n x = 0 := hs.injective_map_residue hℓ (by simpa [← map_comp])
  -- `loc` is the pull-back of the localisation map, whose image holds the points inverting `M`.
  obtain ⟨w, h_fac⟩ : ∃ w, w ≫ loc = (U M).ι := by
    let pr : baseChangeOf s a ⟶ reprBy (of T.obj) := fiberProd.snd s (reprMap a)
    have h_pb : IsPullback (fiberProd.snd ..) loc (reprMap (ofHom (algebraMap ..))) pr :=
      isPullback_fiberProd.of_bot rfl isPullback_fiberProd
    let toImage := fromPreimage _ pr ≫ homOfLe (unitPoints_le_range_reprMap (Localization M) M)
    exact ⟨_, h_pb.lift_snd _ (U M).ι
      ((Category.assoc ..).trans
        (toImage ≫= IsIso.inv_hom_id_assoc (toRange (uliftCoyoneda.map _)) (ι _)))⟩
  have h_rep (I : Set T.obj) : IsRelAffine (U I).ι :=
    isRelAffine_ι_of_forall_map_mem_iff fun y ↦
      ⟨∅, baseRingMap (fiberProd.snd s (reprMap a)) y '' I, by simp [U, unitPoints]⟩
  have h_anti_U : Antitone U := fun _I _I' h_le _C _y hy c hc ↦ hy c (h_le hc)
  -- `U M` is the intersection of the `U t`, so its cohomology is the filtered colimit of theirs
  have h_cont := ((hs.baseChange a).isCohomContinuous
    (Λ := ⟨ZMod ℓ⟩)).isFilteredColimit_antitoneFamily h_anti_U h_rep
    (D := (monotone_image.comp (@Finset.coeEmb M).monotone).functor)
    (m := ⟨M, .mk fun _ ↦ ⟨⟨image_val_subset⟩⟩⟩) (fun hy c hc ↦ hy {⟨c, hc⟩} c (by simp)) (n := n)
  have h_M : map ⟨ZMod ℓ⟩ (U M).ι n x = 0 := map_eq_zero_of_factors h_fac h_loc
  obtain ⟨t, _, ht⟩ := h_cont.1 ∅ (map _ (ι _) n x) ((map_comp ..).symm.trans h_M)
  have h_fin : map ⟨ZMod ℓ⟩ (U (Subtype.val '' (t : Set M))).ι n x = 0 :=
    ((map_comp _ (ι _) x).trans ht :)
  have h_dvd_prod : ∀ d ∈ Subtype.val '' (t : Set M), d ∣ ∏ c ∈ t, (c : T.obj) :=
    forall_mem_image.mpr fun _ ↦ t.dvd_prod_of_mem _
  exact ⟨∏ c ∈ t, (c : T.obj), M.prod_mem fun c _ ↦ c.property,
    map_unitPoints_ι_eq_zero_of_forall_dvd h_dvd_prod h_fin⟩

/-- Let `W` be proper over `R` (`hs`), `ℓ` a prime invertible in `R` (`hℓ`), `T` a test ring
(absolutely integrally closed and reduced, with any two elements comparable for divisibility after
a splitting by an idempotent) with a ring map `a : R ⟶ T`, and `x` a class in
`Hⁿ(W_T, ℤ/ℓ)`. Let `z` be the set of primes `P` of `T` such that `x` restricts to zero on the
base change to the residue field `κ(P)`. Then `z` is open in `Spec T`, and if `z` is all of
`Spec T`, then `x = 0`. -/
lemma IsProperOver.isOpen_zero_set_and_eq_zero (hs : IsProperOver s) (hℓ : IsUnit (ℓ : R))
    (T : TestRing) {a : R ⟶ of T.obj}
    {x : H (freeAb.obj (testIncl ⋙ baseChangeOf s a)) (locConstCoeff ⟨ZMod ℓ⟩) n} :
    let z := {P : PrimeSpectrum T.obj | TestCohomology.map ⟨ZMod ℓ⟩
      (baseChangeTransition s (ofHom (algebraMap T.obj P.asIdeal.ResidueField)) (a := a) rfl) n
        x = 0}
    IsOpen z ∧ (z = univ → x = 0) := by
  -- The `b` such that `x` vanishes where `b` is invertible form an ideal `J` of `T`, and `z` is the
  -- complement of the zero locus of `J`.
  intro z
  let J : Ideal T.obj := unitVanishingIdeal T a x
  have hz : z = (zeroLocus J)ᶜ := by
    ext P
    rw [mem_compl_iff, mem_zeroLocus, not_subset]
    constructor
    · intro hP
      obtain ⟨b, hbP, hb⟩ :=
        exists_notMem_map_unitPoints_ι_eq_zero_of_map_residue_eq_zero hs hℓ P hP
      exact ⟨b, hb, hbP⟩
    · -- If `b ∉ P` then `b` is a unit in the residue field, so at every point of the fibre.
      rintro ⟨b, hb, hbP⟩
      have hb_unit : IsUnit (algebraMap T.obj P.asIdeal.ResidueField b) :=
        Ne.isUnit (algebraMap_residueField_eq_zero.not.mpr hbP)
      refine map_eq_zero_of_factors (lift_ι _ ?_) hb
      rintro _ _ ⟨y, rfl⟩ _ rfl
      -- the point `y` comes with a ring map out of the residue field, which keeps `b` a unit
      exact hb_unit.map y.val.snd.down.hom
  refine ⟨by simpa only [hz] using (isClosed_zeroLocus _).isOpen_compl, fun h_univ ↦ ?_⟩
  -- If `x` vanishes at every prime, the zero locus of `J` is empty, so `1 ∈ J`; and `1` is a
  -- unit at every point.
  have h_empty : zeroLocus (J : Set T.obj) = ∅ := compl_univ_iff.mp (hz.symm.trans h_univ)
  have h_one : map ⟨ZMod ℓ⟩ (unitPoints (fiberProd.snd s (reprMap a)) {1}).ι n x = 0 :=
    (eq_top_iff_one J).mp (zeroLocus_empty_iff_eq_top.mp h_empty)
  rw [← TestCohomology.map_id_apply x]
  exact map_eq_zero_of_factors (lift_ι (𝟙 _) fun _ _ ↦ by simp [unitPoints]) h_one

end FieldExtension

/-! ## Powers of the projective line; proper base change for coefficients on a zero locus -/

section ProperBaseChange

open CategoryTheory MonoidalCategory CommRingCat Function projLine Ideal AddEquiv Functor
  InvertsPrime

variable {ℓ : ℕ} {A : Type} [CommRing A] {X : CommRingCat ⥤ Type 1} {D : Type _} [Category D]
  (g : D ⥤ TestOver A) (I : IdealFamily (elementsProj (X ⊗ reprBy (CommRingCat.of A))))
  (c : TestOver A)

/-- For every index type `ι`, the power `(ℙ¹)^ι` of the projective line (`projLinePow ι`) is
proper over `ℤ`, through its unique map to the terminal functor `reprBy ℤ`. -/
lemma isProperOver_projLinePow (ι : Type) :
    IsProperOver ((zIsInitial.op.isTerminalObj uliftCoyoneda (Opposite.op (CommRingCat.of ℤ))).from
      (projLinePow ι)) := by
  -- The universal point is the family `(1 + u_i v_i : v_i)` over `ℤ[u_i, v_i]`.
  refine
    { diagonal_closed := fun B x y ↦ ?_
      valuative_cover := ⟨of (FreeCommRing (ι ⊕ ι)), fun i ↦ ⟨⟦(.of (.inl i), .of (.inr i))⟧⟩,
        fun {K} _ _ O x _ ↦ ?_⟩ }
  · -- Separated: two families agree exactly where the determinants of their rows vanish.
    refine ⟨⨆ i, span {(unimodularRow (x i)).1 * (unimodularRow (y i)).2 -
      (unimodularRow (x i)).2 * (unimodularRow (y i)).1}, fun B' f ↦ ?_⟩
    rw [iSup_le_iff]
    refine funext_iff.trans (forall_congr' fun i ↦ ULift.up_inj.trans ?_)
    rw [← (x i).down.out_eq, ← (y i).down.out_eq]
    simp [Quotient.eq, projLineSetoid, unimodularRow, sub_eq_zero]
  · -- Valuative criterion: each point of the line over `K` is `(1 + u v : v)` with `u, v` in `O`,
    -- since one of its two homogeneous coordinates is a multiple of the other by an element of `O`.
    have h_point (a : K × K) : ∃ u v : O, (⟦(u, v)⟧ : Quotient (projLineSetoid K)) = ⟦a⟧ := by
      rcases le_total (O.valuation a.2) (O.valuation (1 + a.1 * a.2)) with h_le | h_le
      · obtain ⟨c, hc⟩ : ∃ c : O, (c : K) * (1 + a.1 * a.2) = a.2 :=
          (O.valuation_le_iff _ _).mp h_le
        exact ⟨0, c, by simp [Quotient.eq, projLineSetoid, hc]⟩
      · obtain ⟨c, hc⟩ : ∃ c : O, (c : K) * a.2 = 1 + a.1 * a.2 := (O.valuation_le_iff _ _).mp h_le
        exact ⟨c - 1, 1, by simp [Quotient.eq, projLineSetoid, hc]⟩
    choose u v huv using fun i : ι ↦ h_point (x i).down.out
    refine ⟨ofHom (FreeCommRing.lift (Sum.elim u v)), funext fun i ↦ congrArg ULift.up ?_⟩
    simpa using huv i

/-- For a test `c` over `A` and a prime `P` of `c`, the residue field of `c` at `P` as a test over
`A`, together with the canonical map from `c` to it. -/
def residueTest (P : PrimeSpectrum c.obj) : Under c :=
  -- the residue field at `P` is a test, being that of an absolutely integrally closed local domain
  have := (c.property.exists_valuationSubring_atPrime P).1
  Under.mk (Y := ⟨CommAlgCat.of A P.asIdeal.ResidueField, isTest_of_preValuationRing⟩)
    ⟨CommAlg.homOfRingHom (algebraMap ..) (by tauto)⟩

/-- Classes are detected at points, for a functor `g` from `D` to tests over `A` and a coefficient
`F` on `D`. For a test `c` over `A` the groups in question are `Extⁿ(ℤ[Hom(c, g –)], F)`, and a
class vanishes at a prime `P` of `c` if it restricts to zero over the residue field of `c` at
`P` (`residueTest c P`). -/
structure IsDetectedAtPoints (F : AbFunctor D) : Prop where
  /-- For a class `x` over a test `c`, the set `z` of primes of `c` at which `x` vanishes is open,
  and if `z` is all of `Spec c`, then `x = 0`. -/
  isOpen_zero_set_and_eq_zero (c : TestOver A) (n : ℕ)
    (x : H (freeAb.obj (g ⋙ reprFunctor.obj (Opposite.op c))) F n) :
    let z := {P : PrimeSpectrum c.obj |
      H.map F (freeAb.map (g.whiskerLeft (reprMap (residueTest c P).hom))) n x = 0}
    IsOpen z ∧ (z = Set.univ → x = 0)
  /-- A map `φ : V ⟶ k` of tests over `A` that are fields induces bijections on these groups. -/
  isCohomEquiv_map_of_isField (V k : TestOver A) (φ : V ⟶ k) (hV : IsField V.obj)
    (hk : IsField k.obj) :
    IsCohomEquiv F (freeAb.map (g.whiskerLeft (reprMap φ)))

/-- The family I on the points of X × Spec A, pulled back to tests: to a test B over A and x ∈ X(B)
it assigns the ideal of I at the point (x, A → B). -/
def IdealFamily.pullToTests : IdealFamily (ringOf (testOfPoint A X)) :=
  -- `a` is a test over `A` with a point `a.2` of `X`; its structure map is a point of
  -- `reprBy (of A)`, and a morphism `f` respects both.
  I.whisker
    (sectionLift (ringOf (testOfPoint A X))
      ⟨fun a ↦ (a.val, ⟨ofHom (algebraMap A a.obj.obj)⟩), fun f ↦
        congr(⟨$(f.map_val), ⟨ofHom $(f.hom.hom.hom'.comp_algebraMap)⟩⟩)⟩)

/-- For a family `I` of ideals on the points of `X × Spec A` and `p : X ⟶ reprBy ℤ`, the subfunctor
of the base change `X_A` of the points at which `I` is zero. -/
private def botLocusBaseChange (p : X ⟶ reprBy (CommRingCat.of ℤ)) :
    Subfunctor (baseChangeOf p (zIsInitial.to (of A))) :=
  ⟨fun C ↦ {x : (baseChangeOf p (zIsInitial.to (CommRingCat.of A))).obj C | I.ideal
    (Functor.elementsMk _ C x.val) = ⊥},
    fun {C C'} f x ↦ @I.botLocus.map (Functor.elementsMk _ C x.val)
      (Functor.elementsMk _ C' ((baseChangeOf p (zIsInitial.to (of A))).map f x).val) ⟨f, rfl⟩ ⟨⟩⟩

/-- If `X` is proper over `ℤ`, the locus `botLocusBaseChange I p` in `X_A` where the family of
ideals `I` is zero is proper over `A`: a universal point `a` of `X_A`, taken modulo the ideal of
`I` at `a`, is a universal point of the locus. -/
private lemma isProperOver_botLocusBaseChange {p : X ⟶ reprBy (CommRingCat.of ℤ)}
    (hX : IsProperOver p) :
    IsProperOver ((botLocusBaseChange I p).ι ≫
      fiberProd.snd p (reprMap (zIsInitial.to (of A)))) := by
  let XA : CommRingCat ⥤ Type 1 := baseChangeOf p (zIsInitial.to (of A))
  let W : Subfunctor XA := botLocusBaseChange I p
  obtain ⟨h_sep, T, a, ha⟩ := hX.baseChange (zIsInitial.to (of A))
  let J : Ideal T := I.ideal (Functor.elementsMk _ T a.val)
  -- The image under `f` of the universal point `a` lies in `W` exactly when `f` kills `J`.
  have h_mem {C : CommRingCat} (f : T ⟶ C) : XA.map f a ∈ W.obj C ↔ J ≤ RingHom.ker f.hom := by
    have h_map : J.map f.hom = I.ideal (Functor.elementsMk _ C (XA.map f a).val) :=
      I.map_eq (a := Functor.elementsMk _ T a.val)
        (b := Functor.elementsMk _ C (XA.map f a).val) ⟨f, rfl⟩
    exact h_map.symm.congr_left.trans (map_eq_bot_iff_le_ker _)
  -- So `a` modulo `J` is a universal point of `W`.
  refine
    { diagonal_closed := fun C x y ↦ ?_
      valuative_cover := ⟨of (T ⧸ J), ⟨_, (h_mem _).mpr mk_ker.ge⟩, fun O z hz ↦ ?_⟩ }
  · exact (h_sep C x.val y.val).imp fun _ h_iff C' f ↦ Subtype.ext_iff.trans (h_iff C' f)
  · obtain ⟨f, hf⟩ : ∃ f : T ⟶ of O, XA.map (f ≫ ofHom O.subtype) a = z.val := ha O z.val hz
    have h_ker : J ≤ RingHom.ker (f ≫ ofHom O.subtype).hom :=
      (h_mem _).mp (by simpa only [hf] using z.property)
    exact ⟨ofHom (Ideal.Quotient.lift J f.hom fun _ hb ↦ Subtype.ext (h_ker hb)),
      Subtype.ext ((Functor.map_comp_apply ..).symm.trans hf)⟩

/-- Proper base change for a coefficient that is `ℤ/ℓ` on the zero locus of a family of ideals.
`InvertsPrime A ℓ`: `A` is an absolutely integrally closed local domain in which the prime `ℓ` is
invertible. Let `X` be proper over `ℤ` (`hX`), and `I` a family of ideals on the points of
`X × Spec A`, pulled back by `I.pullToTests` to pairs `(B, x)` of a test `B` over `A` (an
`A`-algebra whose ring is a test ring) and `x ∈ X(B)`. Let `F` be a functor from these pairs to
abelian groups, and `β` a map to `F` from the locally constant functions `Spec B → ℤ/ℓ` that is
bijective where `I = 0` (`hβ`). If the locus `I = 0` is dense for `F` (`h_dense`: over every
representable point its inclusion is an equivalence for `F`), then `F` is detected at points: for
every test `c` over `A`, a class in `Extⁿ(ℤ[Hom(c, testOfPoint –)], F)` that restricts to zero over
every residue field of `c` is zero. -/
lemma IdealFamily.isDetectedAtPoints_of_proper [InvertsPrime A ℓ]
    {p : X ⟶ reprBy (CommRingCat.of ℤ)} (hX : IsProperOver p)
    {F : (ringOf (𝟭 (TestOver A)) ⋙ X).Elements ⥤ AddCommGrpCat}
    (β : locConstAlong (testOfPoint A X) ⟶ F)
    (hβ : ∀ a : (ringOf (𝟭 (TestOver A)) ⋙ X).Elements, I.pullToTests.ideal a = ⊥ → Bijective (β a))
    (h_dense : IsCohomDense F I.pullToTests.botLocus) :
    IsDetectedAtPoints (testOfPoint A X) F := by
  -- The locus `W = {I = 0}` in `X_A` is proper over `A`. For a test `c` over `A`, the cohomology of
  -- `h_c` with coefficients `F` is that of `W_c` with coefficients `ℤ/ℓ`, naturally in `c`; both
  -- claims then come from `IsProperOver.isOpen_zero_set_and_eq_zero` and
  -- `IsProperOver.isTestCohomEquiv_field_extension`.
  let W : Subfunctor (baseChangeOf p (zIsInitial.to (of A))) := botLocusBaseChange I p
  let s : W.toFunctor ⟶ reprBy (of A) := W.ι ≫ fiberProd.snd p (reprMap (zIsInitial.to (of A)))
  have hs : IsProperOver s := isProperOver_botLocusBaseChange I hX
  -- `κ` compares `ℤ/ℓ` on all tests with `F` through `β`; `Wc c = W_c`, and `U c` is the part of
  -- `h_c` where `I = 0`.
  let κ : Comparison (locConstCoeff ⟨ZMod ℓ⟩) F := ⟨testOfPoint A X ⋙ TestOver.toTest A, β⟩
  let Wc (c : TestOver A) : CommRingCat ⥤ Type 1 := baseChangeOf s (ofHom (algebraMap A c.obj))
  let U (c : TestOver A) : Subfunctor (testOfPoint A X ⋙ reprBy c) :=
    I.pullToTests.botLocus.preimage (toUnit (testOfPoint A X ⋙ reprBy c))
  -- A map `c ⟶ d` with a point of `X(d)` where `I = 0` is a point of `W_c`.
  let u (c : TestOver A) : (U c).toFunctor ⟶ κ.functor ⋙ testIncl ⋙ Wc c :=
    { app d := ↾fun x ↦
        ⟨(⟨⟨(d.2, ⟨ofHom (algebraMap A d.1.1)⟩), congr(⟨$(zIsInitial.hom_ext ..)⟩)⟩, x.2⟩,
          ⟨ofHom x.1.1.1.1.1⟩), congr(⟨ofHom $(x.1.1.1.1.comp_algebraMap.symm)⟩)⟩
      naturality _ _ f := .symm congr(↾fun _ ↦ ⟨(⟨$(baseChangeOf.ext f.2 f.1.1.1.2), _⟩, _), _⟩) }
  -- `u c` is bijective on cohomology, because `β` is bijective where `I = 0`.
  have hu (c : TestOver A) : κ.IsBijective (freeAbMap (u c)) := by
    -- A point of `W_c(T)` is `x ∈ X(T)`, an `A`-algebra structure `α` on `T` with `I = 0` at
    -- `(x, α)`, and an `A`-algebra map `γ : c → T`; this point is its own universal point.
    refine Comparison.HasUniversalPoints.isBijective fun T ⟨⟨⟨⟨⟨x, ⟨α⟩⟩, _⟩, hI⟩, ⟨γ⟩⟩, hγ⟩ ↦ ?_
    let hT_algebra : Algebra A T.obj := α.hom.toAlgebra
    let B : (ringOf (𝟭 (TestOver A)) ⋙ X).Elements :=
      Functor.elementsMk _ ⟨.of A T.obj, T.property⟩ x
    let γA : c ⟶ B.obj := ⟨CommAlgCat.ofHom ⟨γ.hom, fun a ↦ congr($(hγ.symm).down.hom' a)⟩⟩
    refine ⟨B, ⟨⟨γA⟩, hI⟩, 𝟙 T, ((baseChangeOf ..).map_id_apply ..).symm, fun D z f hf ↦ ?_,
      .comp (hβ B hI) bijective_id⟩
    -- The components of `hf` say that `f` is `A`-linear, sends `x` to the point of `D`, and
    -- carries `γ` to `z`.
    let fA : B.1 ⟶ D.1 := ⟨CommAlgCat.ofHom ⟨f.1.hom, fun a ↦ congr($hf.1.1.1.1.2.1.1 a).symm⟩⟩
    refine ⟨⟨fA, congr($hf.1.1.1.1.1).symm⟩, ⟨?_, rfl⟩, ?_⟩
    · exact congr(⟨⟨⟨CommAlgCat.ofHom ⟨$(hf.symm).val.2.down.hom', _⟩⟩⟩, _⟩)
    · -- Uniqueness: a map `y` with `κ.functor.map y = f` is `fA`.
      rintro y ⟨-, rfl⟩
      rfl
  -- `I = 0` is dense for `F`, so `h_c` and `U c` have the same cohomology, which by `hu` is that of
  -- `W_c`.
  let e {c : TestOver A} {n : ℕ} :
      H (freeAb.obj (testOfPoint A X ⋙ reprBy c)) F n ≃+
        H (freeAb.obj (testIncl ⋙ Wc c)) (locConstCoeff ⟨ZMod ℓ⟩) n :=
    (ofBijective _ ((h_dense.preimage _).isCohomEquiv n)).trans (ofBijective _ (hu c n)).symm
  -- `e` is natural in `c`.
  have he {c k : TestOver A} (φ : c ⟶ k) (n : ℕ)
      (x : H (freeAb.obj (testOfPoint A X ⋙ reprBy c)) F n) :
      TestCohomology.map _
          (baseChangeTransition s ((ringOf (𝟭 _)).map φ) (hom_ext φ.1.1.comp_algebraMap)) n (e x) =
        e (H.map F (freeAb.map ((testOfPoint A X).whiskerLeft (reprMap φ))) n x) := by
    refine (hu k n).injective (.trans (κ.map_pull_eq_pull_map (a := freeAbMap (u c))
      (a' := freeAb.map (Subfunctor.fromPreimage _ (Functor.whiskerLeft _ (reprMap φ))))
      (by exact freeAb.hom_ext fun _ _ ↦ rfl) n _).symm ?_)
    -- `κ.pull (u d)` undoes the second half of `e`, so both sides pull `x` back along one map
    have h_pull_e {d : TestOver A} (y : H (freeAb.obj (testOfPoint A X ⋙ reprBy d)) F n) :
        κ.pull (freeAbMap (u d)) n (e y) = H.map F (freeAb.map (U d).ι) n y :=
      (ofBijective _ (hu d n)).apply_symm_apply _
    refine (congrArg _ (h_pull_e x)).trans (Eq.trans ?_ (h_pull_e _).symm)
    rw [H.map_map, H.map_map]
    rfl
  refine ⟨fun c n x ↦ ?_, fun V k φ hV hk n ↦ ?_⟩
  · intro z
    -- Stated for abstract groups: applied to the groups `H`, it lets the kernel match the zero
    -- elements without unfolding the group structure of `Ext` (which made this step slow).
    have zero_iff {M N : Type 2} [AddCommGroup M] [AddCommGroup N] (e : M ≃+ N) (x : M) :
        e x = 0 ↔ x = 0 := e.map_eq_zero_iff
    -- It suffices to prove the two claims for `e x` and a set `z'` with the same elements as `z`.
    have h_transfer {z' : Set (PrimeSpectrum c.obj)}
        (h : IsOpen z' ∧ (z' = Set.univ → e x = 0)) (hz : ∀ P, P ∈ z ↔ P ∈ z') :
        IsOpen z ∧ (z = Set.univ → x = 0) := by
      obtain rfl : z' = z := (Set.ext hz).symm
      exact ⟨h.1, fun h_univ ↦ (zero_iff e x).mp (h.2 h_univ)⟩
    refine h_transfer (hs.isOpen_zero_set_and_eq_zero isUnit_prime ⟨of _, c.property⟩) fun P ↦ ?_
    -- `Iff.rfl`: the residue map of `residueTest c P` and the algebra map to the residue field at
    -- `P` agree only after unfolding definitions.
    exact (zero_iff e _).symm.trans ((Eq.congr_left (he (residueTest c P).hom n x).symm).trans
      Iff.rfl)
  · exact (Comparison.bijective_iff_of_comm_sq (he φ n) e.bijective e.bijective).mpr
      (hs.isTestCohomEquiv_field_extension isUnit_prime _ hV hk V.property.toIsAbsIntegrallyClosed
        k.property.toIsAbsIntegrallyClosed n)

end ProperBaseChange

