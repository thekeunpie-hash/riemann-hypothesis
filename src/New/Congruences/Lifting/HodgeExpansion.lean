/-!
# Lattices with prescribed orders, depth steps and the depth lemma

This file studies lattices with prescribed orders in W(C^♭) ⊗ L, for a lattice datum L over a
Kummer chart k with ring S = Λ⟦z⟧ ⊆ A_inf, coordinate z, p_a = φ^a(E), δ = zτ and Galois group Γ'.
Here τ = `tau` is the element [ε^{1/p}] − 1 of A_inf, `valueAt a μ` is μ ∘ φ^{−a} with values in
B_dR, and `hodgeFil n` is tⁿB_dR^+. `L.withOrders i c` consists of the x in the A_inf-span
`L.kisinLocAinf` at the letter i with `valueAt a μ x ∈ hodgeFil (c a u)` for all a, all u in
`L.jumpSet (i.stepBack a)` and all forms μ of type u at the letter `i.stepBack a`; such x are said
to have orders c at i. An element x of the Kisin module `L.kisinLoc` (all φ^a E inverted) has
depth n at p_a for a form μ if `valueAt a μ x` is a constant modulo `hodgeFil n`. If gx − x has
orders o at i for every g in Γ', then such an x at the letter i has depth o a u at p_a for all a,
all u in `L.jumpSet (i.stepBack a)` and all forms of type u at `i.stepBack a`
(`New.Lift.KummerChart.JumpLattice.exists_valueAt_sub_mem_hodgeFil_of_mem_invariantsMod`). The
depth lemma gives an
operator p^c + υ ∑ (t_l − 1)/δ, with t_l in Γ', that sends elements of depth n to elements whose
value is a constant modulo `hodgeFil (n + 1)`.

## Main definitions and results

* `New.Lift.KummerChart.JumpLattice.withOrders`: the elements with orders at least c(a, u) at p_a
  on the jumps u.
* `New.Lift.KummerChart.JumpLattice.valueAt_mem_of_hodgeFil_le`: the gap rule, bounds for forms
  whose type need not be a jump.
* `New.Lift.KummerChart.JumpLattice.invariantsMod`: the x with gx − x in Q for all g in Γ'.
* `New.Lift.KummerChart.JumpLattice.mem_withOrders_improvedOrders`: an element with orders lo
  that is invariant modulo the elements with orders hi has the orders
  `New.Lift.KummerChart.JumpLattice.improvedOrders lo hi`.
* `New.Lift.KummerChart.JumpLattice.exists_valueAt_sub_mem_hodgeFil_succ`: the depth lemma, with c =
  `k.cost a n`.

Notions from other files:
* `New.Lift.KummerChart.galMonoid`: the group Γ' as a submonoid of `FrobGroup Γ` = ℤ × Γ, whose
  first factor is generated by the Frobenius `φ`.
* `New.Lift.thetaPhiInv`: the ring map θ ∘ φ^{−a} from A_inf to O_C, with kernel generated by p_a.
* `New.Lift.KummerChart.JumpLattice.kisinLocAinf`, `New.Lift.KummerChart.JumpLattice.kisinLoc`: the
  A_inf-module A_inf·𝒩 and the S-module 𝒩 in `L.Ambient` = W(C^♭) ⊗ L, where 𝒩 is the Kisin module
  with all p_a inverted (`New.Lift.KummerChart.JumpLattice.span_kisinLoc` shows that the first,
  defined as a saturation, is the span of the second).
* `New.Lift.KummerChart.JumpLattice.formsOfType`: the A_inf-linear maps `L.Ambient → B_dR` that are
  Γ'-equivariant on 1 ⊗ L and send its projection to the letter i into t^{−u}B_dR^+.
* `New.Lift.KummerChart.valueField`: the subfield `𝒦_a` of `B_dR` generated over
  `localFieldOf k.subgroup` by the images of `S_B = k.bicommutant ⊆ B⁺` and of `φ^{-a} S`.
* `New.Lift.KummerChart.Letter`: the units of the field with p^f elements. The letter `i.stepBack a`
  is the one whose p^a-th power is i, `L.letterPart i` is the part of `L.Ambient` on which the root
  of unity ζ of the coefficient ring acts as the Teichmüller lift of i, and `L.jumpSet i` is a
  finite set of integers, called the jumps at i, that contains the Hodge–Tate jumps of L above i.

## Relation to the literature

See `New.Congruences.Lifting.SafeMoves` for related work. See
`Lib.PadicHodge.Kisin.PeriodMatrixFrame` for sources.
-/

@[expose] public section

noncomputable section

section ExponentLattices

namespace New.Lift.KummerChart

open Period MulAction Pointwise Submodule Set FrobGroup NeZero MulSemiringAction Polynomial Finset
  Algebra LinearMap

variable {p : ℕ} [P : ThePrime p] [Γ : GroupOverGp p] [k : KummerChart Γ]
  {O : Coeffs} {L : JumpLattice O} (a : ℕ) (i : Letter) (c : ℕ → ℤ → ℤ) {l : ℕ} {n u : ℤ}

/-! ### Steps in the Galois group of the chart and their costs -/

/-- The cost c_a(n) of the step n at p_a = φ^a(E): c_a(n) = v_p(n) + d + 3a, with v_p(0) = 0. Here
d = `k.differentBound` is 0 if the ramification index e of the chart is 1, and v_p(e) + 1
otherwise. -/
def cost (a : ℕ) (n : ℤ) : ℕ := padicValInt p n + (k.differentBound + 3 * a)

/-- For a unit `ω` and an integer `n`, the elements `ω ^ |n| - 1` and `ω ^ n - 1` are associated:
for negative `n` they differ by the unit `-ω ^ n`. -/
lemma associated_pow_natAbs_sub_one {R : Type*} [CommRing R] (ω : Rˣ) (n : ℤ) :
    Associated (ω.val ^ n.natAbs - 1) ((ω ^ n).val - 1) := by
  cases n with
  | ofNat m => simp
  | negSucc m => exact ⟨-ω⁻¹ ^ (m + 1), by simp [sub_mul, ← mul_pow]⟩

/-- If `g` in the Galois group `Γ'` of the chart multiplies `E` by `ω`, then `ω - 1` is divisible
by the product `k.zTau` of the coordinate `z` with the element `τ = [ε^{1/p}] - 1` of `A_inf`. -/
lemma zTau_dvd_sub_one_of_mul_eq_smul_E {g : k.subgroup} {ω : Ainf}
    (hω : k.E.val * ω = toGp g.val • k.E.val) : k.zTau ∣ ω - 1 := by
  have h_dvd : k.zTau * k.E.val ∣ toGp g.val • k.E.val - k.E.val :=
    zTau_mul_E_dvd_smul_sub ⟨inr g.val, g, rfl⟩ k.E
  rwa [← hω, ← mul_sub_one, mul_comm, mul_dvd_mul_iff_left k.E_ne_zero] at h_dvd

/-- Let `g` in the Galois group `Γ'` of the Kummer chart multiply the coordinate `z` by
`[ε] ^ p ^ a` and `E` by `ω`. Then `θ (ω - 1)` divides `p ^ (d + a) θ(δ)` in `O_C`. Here `θ` is
Fontaine's map `A_inf → O_C`, `δ = k.zTau` is the product of `z` with the element
`τ = [ε^{1/p}] - 1` of `A_inf`, and `d = differentBound` bounds the different of the chart. -/
lemma theta_sub_one_dvd_pow_mul_theta_zTau {g : k.subgroup} {ω : Ainf}
    (hz : toGp g.val • k.z.val = WittVector.teichmuller p epsTilt ^ p ^ a * k.z.val)
    (hω : k.E.val * ω = toGp g.val • k.E.val) :
    theta (ω - 1) ∣ p ^ (k.differentBound + a) * theta k.zTau := by
  -- Apply Taylor's formula at `z` to a polynomial `F` with `F(z) = E G` and
  -- `θ F'(z) ∣ p ^ differentBound`, divide by `E` and apply `θ`.
  obtain ⟨F, ⟨G, hG : aeval k.z F = k.E * G⟩, hF'⟩ := k.exists_derivative_dvd_p_pow
  obtain ⟨u, hu⟩ : ∃ u : Ainfˣ, k.E.val * tau * u = mu := k.associated_E_mul_tau_mu
  let w : Ainf :=
    tau * u * (∑ j ∈ Finset.range (p ^ a), WittVector.teichmuller p epsTilt ^ j) * k.z.val
  have h_diff : toGp g.val • k.z.val - k.z.val = k.E.val * w := by
    rw [hz, ← sub_one_mul, ← mul_geom_sum, ← mu_eq, ← hu]
    ring
  have h_theta_w : theta w = theta tau * theta u * p ^ a * theta k.z := by simp [w]
  have h_aeval : aeval (toGp g.val • k.z.val) F = toGp g.val • aeval k.z.val F :=
    aeval_algHom_apply (AlgHom.mk (toRingHom (Gp p) Ainf (toGp g.val)) (fixes g).1) k.z.val F
  obtain ⟨r, h_taylor⟩ : ∃ r : Ainf, aeval (k.z.val + k.E.val * w) F =
      aeval k.z.val F + aeval k.z.val F.derivative * (k.E.val * w) + r * (k.E.val * w) ^ 2 := by
    obtain ⟨r, hr⟩ := (F.map (algebraMap (WittFq k.f) Ainf)).binomExpansion k.z.val (k.E.val * w)
    exact ⟨r, by simpa only [derivative_map, eval_map_algebraMap] using hr⟩
  have h_div : ω * toGp g.val • G.val =
      G.val + (aeval k.z F.derivative).val * w + k.E.val * (r * w ^ 2) := by
    rw [add_eq_of_eq_sub' h_diff.symm, h_aeval] at h_taylor
    have hFz : aeval k.z.val F = k.E.val * G.val := by simp [hG]
    simp only [hFz, aeval_subalgebra_coe, smul_mul', ← hω] at h_taylor ⊢
    apply mul_left_cancel₀ k.E_ne_zero
    linear_combination h_taylor
  -- `θ` kills `E`, and `g` fixes `θ G`
  have h_theta : theta (ω - 1) * theta G = theta (aeval k.z F.derivative).val * theta w := by
    simpa [k.theta_E, k.smul_theta_of_fixesThetaZ (fixes g), sub_mul, sub_eq_iff_eq_add'] using
      congrArg theta h_div
  calc theta (ω - 1) ∣ theta (aeval k.z F.derivative).val * theta w := Dvd.intro _ h_theta
    _ ∣ p ^ k.differentBound * theta w := mul_dvd_mul_right hF' _
    _ = p ^ (k.differentBound + a) * theta k.zTau * theta u := by
      rw [h_theta_w, zTau, map_mul]
      ring
    _ ∣ p ^ (k.differentBound + a) * theta k.zTau := (u.isUnit.map theta).mul_right_dvd.2 dvd_rfl

/-- Let `r` in `A_inf` be divisible by `k.zTau`, the product of the coordinate `z` of the Kummer
chart with the element `τ = [ε^{1/p}] - 1` of `A_inf`. Then `p θ(r) θ(z)` divides `θ(r) ^ p` in
`O_C`, for Fontaine's map `θ : A_inf → O_C`. -/
lemma p_mul_theta_mul_theta_z_dvd_pow {r : Ainf} (hr : k.zTau ∣ r) :
    p * theta r * theta k.z ∣ theta r ^ p := by
  -- For `r = τ z d`: `p θτ ∣ θτ ^ p` as `(θτ + 1) ^ p = 1`, and `θz ^ 2 ∣ θz ^ p`, `θd ∣ θd ^ p`.
  obtain ⟨d, rfl⟩ := hr
  have h_root : (theta tau + 1) ^ p = 1 := by
    simp [tau, ← map_pow, show PreTilt.untilt (epsRoot ^ p) = 1 from untilt_epsTilt]
  obtain ⟨t, ht⟩ := exists_add_pow_prime_eq P.out (theta tau) 1
  have h_tau : p * theta tau ∣ theta tau ^ p := ⟨-t, by linear_combination h_root - ht⟩
  calc p * theta (k.zTau * d) * theta k.z
      = p * theta tau * theta k.z ^ 2 * theta d := by
        rw [zTau, map_mul, map_mul]
        ring
    _ ∣ theta tau ^ p * theta k.z ^ p * theta d ^ p :=
        mul_dvd_mul (mul_dvd_mul h_tau (pow_dvd_pow _ P.out.two_le))
          (dvd_pow_self _ P.out.ne_zero)
    _ = theta (k.zTau * d) ^ p := by rw [zTau, map_mul, map_mul, mul_pow, mul_pow]

/-- For the product `k.zTau` of the coordinate `z` of the chart with `τ = [ε^{1/p}] - 1` in `A_inf`,
the image under `θ` divides `p ^ (2 a)` times the image under `thetaPhiInv a = θ ∘ φ^{-a}`. -/
lemma theta_zTau_dvd_pow_mul_thetaPhiInv :
    theta k.zTau ∣ p ^ (2 * a) * thetaPhiInv a k.zTau := by
  cases a with
  | zero => simp [thetaPhiInv]
  | succ a =>
    have h_sq : theta k.zTau ∣ p ^ 2 := by
      grw [zTau, map_mul, k.theta_z_dvd_p, tau_dvd_xi_sub_p]
      simp [sq]
    exact (h_sq.trans (pow_dvd_pow _ (by lia))).mul_right _

/-- The data for the step n ≠ 0 of the depth lemma at p_a = φ^a(E) (`k.frobE a`): an element g of
the Galois group Γ' of the chart (`k.galMonoid`) that multiplies p_a by a unit ω and acts trivially
on the ring S of the chart modulo p_a, the quotient X of ω^n − 1 by δ = zτ (`k.zTau`), and an
inverse υ of X modulo p_a up to the factor p^c, c = `cost a n`. -/
structure IsDepthStep (a : ℕ) (n : ℤ) (g : k.galMonoid) (ω : Ainfˣ) (υ X : Ainf) : Prop where
  /-- g multiplies p_a by ω. -/
  smul_frobE : g • (k.frobE a).val = ω.val * (k.frobE a).val
  /-- g acts trivially on S modulo p_a. -/
  frobE_dvd_smul_sub : ∀ s : k.S, (k.frobE a).val ∣ g • s.val - s.val
  /-- υX ≡ p^c modulo p_a. -/
  frobE_dvd_mul_sub_pow : (k.frobE a).val ∣ υ * X - p ^ cost a n
  /-- δX = ω^n − 1. -/
  zTau_mul_eq_pow_sub_one : k.zTau * X = (ω ^ n).val - 1

/-- For an integer n ≠ 0 there are g in the Galois group Γ' of the Kummer chart (`k.galMonoid`), a
unit ω of A_inf and υ, X in A_inf that form a depth step at p_a = φ^a(E): g p_a = ω p_a, g acts
trivially on the ring S = Λ⟦z⟧ of the chart modulo p_a, υX ≡ p^c modulo p_a, and δX = ω^n − 1. Here
δ = `k.zTau` is the product of the coordinate z with the element τ = [ε^{1/p}] − 1 of A_inf. The
exponent c = `cost a n` is v_p(n) + d + 3a, where d = `k.differentBound` is 0 if the ramification
index e of the chart is 1, and v_p(e) + 1 otherwise. -/
lemma exists_isDepthStep (a : ℕ) {n : ℤ} (hn : n ≠ 0) :
    ∃ (g : k.galMonoid) (ω : Ainfˣ) (υ X : Ainf), IsDepthStep a n g ω υ X := by
  -- Take `g` with `g z = [ε] ^ p ^ a z` and `g E = E ω`; the unit asked for is `φ ^ a ω`. Taylor's
  -- formula bounds `θ ω - 1`, `lifting_the_exponent` bounds `θ (ω ^ n - 1)`, and cancelling
  -- `θ φ⁻ᵃ zTau ≠ 0` shows that `θ φ⁻ᵃ X` divides `p ^ cost`; `υ` lifts the quotient.
  obtain ⟨g, hz⟩ : ∃ g : k.subgroup,
      toGp g.val • k.z.val = WittVector.teichmuller p epsTilt ^ p ^ a * k.z.val :=
    k.exists_smul_z (p ^ a)
  obtain ⟨ω, hω⟩ : ∃ ω : Ainfˣ, k.E.val * ω = toGp g.val • k.E.val :=
    k.associated_smul_E (toGp g.val)
  have h_dvd : k.zTau ∣ ω - 1 := zTau_dvd_sub_one_of_mul_eq_smul_E hω
  have h_assoc := associated_pow_natAbs_sub_one ω n
  obtain ⟨X, hX⟩ : k.zTau ∣ φ ^ a • ((ω ^ n).val - 1) := by
    have h_dvd_zpow : k.zTau ∣ (ω ^ n).val - 1 :=
      (h_dvd.trans (sub_one_dvd_pow_sub_one ω.val n.natAbs)).trans h_assoc.dvd
    exact (k.zTau_dvd_phi_pow_smul a).trans
      (_root_.map_dvd (toRingHom (FrobGroup Γ) Ainf (φ ^ a)) h_dvd_zpow)
  have h_lte : theta (ω ^ n.natAbs - 1) ∣ p ^ padicValNat p n.natAbs * theta (ω - 1) :=
    lifting_the_exponent theta_surjective ω k.z k.not_isUnit_z (dvd_of_mul_left_dvd h_dvd)
      (p_mul_theta_mul_theta_z_dvd_pow h_dvd) (Int.natAbs_ne_zero.2 hn)
  have hX_dvd : thetaPhiInv a X ∣ p ^ cost a n := by
    have h_ne : thetaPhiInv a k.zTau ≠ 0 := mt frobE_dvd_iff.2 (not_frobE_dvd_zTau a)
    rw [← mul_dvd_mul_iff_left h_ne]
    calc thetaPhiInv a k.zTau * thetaPhiInv a X
        = theta ((ω ^ n).val - 1) := by rw [← map_mul, ← hX, thetaPhiInv_phi_pow]
      _ ∣ p ^ padicValNat p n.natAbs *
          (p ^ (k.differentBound + a) * (p ^ (2 * a) * thetaPhiInv a k.zTau)) := by
        grw [h_assoc.dvd', h_lte, theta_sub_one_dvd_pow_mul_theta_zTau a hz hω,
          theta_zTau_dvd_pow_mul_thetaPhiInv a]
      _ = thetaPhiInv a k.zTau * p ^ cost a n := by
        rw [cost, padicValInt, Nat.padicValNat_def]
        ring
  obtain ⟨υ, hυ⟩ : ∃ υ : Ainf, (p : OC) ^ cost a n = thetaPhiInv a X * theta υ :=
    theta_surjective.exists.1 hX_dvd
  let g' : k.galMonoid := ⟨inr g.val, g, rfl⟩
  have hg' (r : Ainf) : g' • r = toGp g.val • r := JumpLattice.inr_smul g.val
  let ω' : Ainfˣ := Units.map (toRingHom (FrobGroup Γ) Ainf (φ ^ a)).toMonoidHom ω
  refine ⟨g', ω', φ ^ a • υ, X, ?_, fun s ↦ ?_, ?_, ?_⟩
  · rw [val_frobE, smul_phi_pow_comm, hg', ← hω]
    simp [ω', mul_comm]
  · -- it is enough that `g z ≡ z`, and `[ε] ^ p ^ a = φ ^ a [ε] ≡ 1` modulo `p_a`
    have hz_dvd : (k.frobE a).val ∣ toGp g.val • k.z.val - k.z.val := by
      simp [hz, frobE_dvd_iff, ← iterate_frobEnd_teichmuller, ← phi_pow_smul]
    rw [hg']
    exact k.dvd_smul_sub_of_fixesLambda hz_dvd (fixes g).1 s
  · simp [frobE_dvd_iff, hυ, mul_comm]
  · simp [ω', ← hX, smul_sub, ← map_zpow]

/-- The statement of `exists_isDepthStep` with the four fields of `IsDepthStep` written out: for
n ≠ 0 there are g in Γ' (`k.galMonoid`), a unit ω and υ, X in A_inf such that g p_a = ω p_a, g acts
trivially on the ring S of the chart modulo p_a = φ^a(E) (`k.frobE a`), υX ≡ p^c modulo p_a, and
zτX = ω^n − 1, where τ = [ε^{1/p}] − 1. The exponent c = `cost a n` is v_p(n) + d + 3a, where
d = `k.differentBound` is 0 if the ramification index e of the chart is 1, and v_p(e) + 1
otherwise. -/
lemma exists_smul_frobE_eq_mul_and_zTau_mul_eq (a : ℕ) {n : ℤ} (hn : n ≠ 0) :
    ∃ (g : k.galMonoid) (ω : Ainfˣ) (υ X : Ainf),
      g • (k.frobE a).val = ω.val * (k.frobE a).val ∧
      (∀ s : k.S, (k.frobE a).val ∣ g • s.val - s.val) ∧
      (k.frobE a).val ∣ υ * X - p ^ cost a n ∧
      k.zTau * X = (ω ^ n).val - 1 :=
  let ⟨g, ω, υ, X, h⟩ := exists_isDepthStep a hn
  ⟨g, ω, υ, X, h.smul_frobE, h.frobE_dvd_smul_sub, h.frobE_dvd_mul_sub_pow,
    h.zTau_mul_eq_pow_sub_one⟩

omit [KummerChart Γ] in
/-- The image under `thetaPhiInv a = θ ∘ φ^{-a}` of the Teichmüller lift `[ε]` of
`epsTilt = (1, ζ_p, ζ_{p²}, …)` is a primitive `p ^ a`-th root of unity. -/
lemma isPrimitiveRoot_thetaPhiInv_teichmuller_epsTilt :
    IsPrimitiveRoot (thetaPhiInv a (WittVector.teichmuller p epsTilt)) (p ^ a) := by
  let s : Multiplicative ℚ := .ofAdd ((p : ℚ) ^ a)⁻¹
  have h_image : (epsPow s).untilt = thetaPhiInv a (WittVector.teichmuller p epsTilt) := by
    simp [s, ← theta_teichmuller, ← thetaPhiInv_phi_pow a, phi_pow_smul, ne, ← map_pow,
      ← ofAdd_nsmul]
  have h_den : s.toAdd.den = p ^ a := by simp [s, ne]
  simpa only [h_image, h_den] using isPrimitiveRoot_untilt_epsPow s

/-- If `ζ` is a primitive `q`-th root of unity in a domain, `q ∣ N` and `q ∤ m`, then the sum of
`(ζ ^ m) ^ l` over `l < N` vanishes. -/
lemma sum_pow_eq_zero_of_isPrimitiveRoot {R : Type*} [CommRing R] [IsDomain R] {ζ : R}
    {q N m : ℕ} (hζ : IsPrimitiveRoot ζ q) (hN : q ∣ N) (hm : ¬q ∣ m) :
    ∑ l : Fin N, (ζ ^ m) ^ l.val = 0 := by
  apply mul_left_cancel₀ (sub_ne_zero.2 (mt (hζ.pow_eq_one_iff_dvd m).1 hm) : ζ ^ m - 1 ≠ 0)
  rw [← sum_range, mul_geom_sum, pow_right_comm, (hζ.pow_eq_one_iff_dvd N).2 hN]
  simp

/-- The Galois elements for the step n = 0 of the depth lemma. There are p^c elements t_l of the
Galois group Γ' of the chart (`k.galMonoid`) such that for every s in the ring S of the chart and
every g in Γ' one has g(∑_l t_l s) ≡ ∑_l t_l s modulo p_a = φ^a(E) (`k.frobE a`). The exponent
c = `cost a 0` is d + 3a, where d = `k.differentBound` is 0 if the ramification index e of the chart
is 1, and v_p(e) + 1 otherwise. -/
lemma exists_frobE_dvd_smul_sum_sub_sum (a : ℕ) :
    ∃ t : Fin (p ^ cost a 0) → k.galMonoid, ∀ (g : k.galMonoid) (s : k.S),
      (k.frobE a).val ∣
        g • ∑ l : Fin (p ^ cost a 0), t l • s.val - ∑ l : Fin (p ^ cost a 0), t l • s.val := by
  -- Modulo `k.frobE a`, that is after `thetaPhiInv a`, write `s` as a polynomial `∑ w m • z ^ m`.
  -- The element `t l` multiplies `z` by `ζ ^ l`, with `ζ` a primitive `p ^ a`-th root of unity,
  -- so the sum over `l` keeps only the `m` divisible by `p ^ a`; `k.galMonoid` fixes these terms.
  obtain ⟨t, ht⟩ : ∃ t : ℕ → k.subgroup, ∀ l : ℕ,
      toGp (t l).val • k.z.val = WittVector.teichmuller p epsTilt ^ l * k.z.val :=
    Classical.skolem.1 k.exists_smul_z
  refine ⟨fun l ↦ ⟨_, t l, rfl⟩, ?_⟩
  rintro ⟨_, g, rfl⟩ s
  obtain ⟨w, hw⟩ : ∃ w : Fin (p ^ a * k.e) → WittFq k.f,
      thetaPhiInv a s = ∑ m : Fin (p ^ a * k.e), thetaPhiInv a (w m • k.z.val ^ m.val) := by
    simpa [frobE_dvd_iff, k.dvd_iff_coe_dvd, sub_eq_zero] using k.exists_dvd_sub_sum_z_pow a rfl s
  let avg (y : OC) : OC := ∑ l : Fin (p ^ cost a 0), toGp (t l).val • y
  let term (m : Fin (p ^ a * k.e)) : OC := thetaPhiInv a (w m • k.z.val ^ m.val)
  suffices h_term : ∀ m : Fin (p ^ a * k.e), toGp g.val • avg (term m) = avg (term m) by
    have h_avg : avg (thetaPhiInv a s) = ∑ m : Fin (p ^ a * k.e), avg (term m) := by
      simpa only [avg, hw, smul_sum] using sum_comm
    have h_fix : toGp g.val • avg (thetaPhiInv a s) = avg (thetaPhiInv a s) := by
      simp only [h_avg, smul_sum, h_term]
    simpa [avg, frobE_dvd_iff, sub_eq_zero] using h_fix
  intro m
  by_cases h_dvd : p ^ a ∣ m
  · -- `z ^ p ^ a = φ ^ a z` has image `θ z`, which all of `k.galMonoid` fixes
    obtain ⟨n, hn⟩ := h_dvd
    simp only [avg, term, hn, pow_mul, ← phi_pow_smul_z]
    simp [smul_def', ← thetaPhiInv_smul, fixes]
  · -- `ζ ^ m ≠ 1` and `a ≤ cost a 0`, so the geometric sum vanishes, and both sides with it
    let ζ : OC := thetaPhiInv a (WittVector.teichmuller p epsTilt)
    have h_geom : ∑ l : Fin (p ^ cost a 0), (ζ ^ m.val) ^ l.val = 0 :=
      sum_pow_eq_zero_of_isPrimitiveRoot (isPrimitiveRoot_thetaPhiInv_teichmuller_epsTilt a)
        (pow_dvd_pow p (by simp +arith [cost])) h_dvd
    have h_eigen (l : ℕ) : toGp (t l).val • term m = (ζ ^ m.val) ^ l * term m := by
      simp [ht, ζ, term, pow_right_comm _ _ m.val, ← thetaPhiInv_smul, mul_pow, smul_def', fixes,
        mul_left_comm]
    simp [avg, h_eigen, ← sum_mul, h_geom]

namespace JumpLattice

/-! ### Lattices with given orders -/

/-- The submodule of the x in A_inf·𝒩 (`L.kisinLocAinf`, for 𝒩 the Kisin module with all φ^a E
inverted) at the letter i with μ(φ^{−a}x) ∈ t^{c(a,u)}B_dR^+ for all a, all jumps u at the letter
`i.stepBack a` and all forms μ of type u at that letter. Such x are said to have orders c at i.
A letter is a unit of the field with p^f elements, and `i.stepBack a` is the letter whose p^a-th
power is i. The jumps at a letter j are the elements of `L.jumpSet j`, a finite set of integers that
contains the Hodge–Tate jumps of L above j. -/
def withOrders : Submodule Ainf L.Ambient :=
  L.kisinLocAinf ⊓ L.letterPart i ⊓
    { carrier :=
        {x : L.Ambient |
          ∀ a : ℕ, ∀ u ∈ L.jumpSet (i.stepBack a), ∀ μ ∈ L.formsOfType (i.stepBack a) u,
            L.valueAt a μ x ∈ hodgeFil (c a u)}
      add_mem' := fun hx hy a u hu μ hμ ↦ by simpa using add_mem (hx a u hu μ hμ) (hy a u hu μ hμ)
      zero_mem' := fun a u _ μ _ ↦ by simp
      smul_mem' := fun r x hx a u hu μ hμ ↦ by
        have hr : phiInvToBdR a r ∈ hodgeFil 0 := algebraMap_mem_hodgeFil_zero
        simpa using mul_mem_hodgeFil hr (hx a u hu μ hμ) }

/-- The elements of `L.kisinLoc`, the Kisin module with all `φ^a E` inverted, that lie at the letter
`i` and have the orders `stdOrders l`, which are `0` at `p_a = φ^a E` for `a < l` and `-u` on
the jump `u` for `a ≥ l`. -/
abbrev stdOrdersPart (l : ℕ) (i : Letter) : Submodule k.S L.Ambient :=
  L.kisinLoc ⊓ (L.withOrders i (stdOrders l)).restrictScalars k.S

variable {a i c} {L' : JumpLattice O} {c' : ℕ → ℤ → ℤ} {μ : L.Functional} {x : L.Ambient}
  {g : k.galMonoid}

lemma valueAt_def : L.valueAt a μ x = μ ((φ ^ a)⁻¹ • x) := rfl

@[simp]
lemma valueAt_zero : L.valueAt 0 μ x = μ x := by simp [valueAt]

/-- If `r` divides `k.frobE a` = φ^a E and `r • x` lies in `L.kisinLocAinf`, then so does `x`. So a
divisor of φ^a E can be cancelled in `L.kisinLocAinf`, where φ^a E is inverted. -/
lemma mem_kisinLocAinf_of_smul_of_dvd_frobE {r : Ainf} (hr : r ∣ (k.frobE a).val)
    (hrx : r • x ∈ L.kisinLocAinf) : x ∈ L.kisinLocAinf :=
  mem_saturateBy_of_smul hr (Submonoid.subset_closure (mem_range_self a)) hrx

/-- `(k.frobE a).val • x` lies in `L.kisinLocAinf` if and only if `x` does. So the element
`k.frobE a` = φ^a E can be cancelled in `L.kisinLocAinf`, where it is inverted. -/
lemma frobE_smul_mem_kisinLocAinf_iff :
    (k.frobE a).val • x ∈ L.kisinLocAinf ↔ x ∈ L.kisinLocAinf :=
  ⟨mem_kisinLocAinf_of_smul_of_dvd_frobE dvd_rfl, smul_mem _ _⟩

lemma mem_kisinLocAinf_of_mem_kisinLoc (hx : x ∈ L.kisinLoc) : x ∈ L.kisinLocAinf := hx.1

lemma kisinModule_le_kisinLoc : L.kisinModule ≤ L.kisinLoc :=
  fun _ ⟨h_span, h_val⟩ ↦ ⟨mem_saturateBy_of_mem h_span, h_val⟩

/-- Induction on `L.kisinLoc`, the Kisin module with all `p_a = φ^a E` inverted: a property that
holds on the Kisin module `L.kisinModule` and passes from `p_a • y` to `y` holds on `L.kisinLoc`. -/
lemma kisinLoc_induction {C : L.Ambient → Prop} (hx : x ∈ L.kisinLoc)
    (h_base : ∀ y ∈ L.kisinModule, C y)
    (h_step : ∀ a : ℕ, ∀ y ∈ L.kisinLoc, C ((k.frobE a).val • y) → C y) : C x :=
  saturateBy_induction (C := fun y ↦ y ∈ L.kisinLoc → C y)
    (mem_kisinLocAinf_of_mem_kisinLoc hx)
    (fun z hz_span ⟨_, hz_val⟩ ↦ h_base z ⟨hz_span, hz_val⟩)
    (fun a z ih hz ↦ h_step a z hz (ih (smul_mem _ (k.frobE a) hz))) hx

/-- The Kisin module `L.kisinLoc` with all `φ^a E` inverted is stable under multiplication and
division by the integer powers of `k.frobEUnit a`, which is `φ^a E` as a unit of `W(C^♭)`. -/
lemma frobEUnit_zpow_smul_mem_kisinLoc_iff :
    k.frobEUnit a ^ n • x ∈ L.kisinLoc ↔ x ∈ L.kisinLoc := by
  -- `k.frobEUnit a` stabilises `L.kisinLoc`, hence so do its integer powers.
  have h_stab (y : L.Ambient) : k.frobEUnit a • y ∈ L.kisinLoc ↔ y ∈ L.kisinLoc := by
    refine ⟨fun ⟨h_span, h_val⟩ ↦
      ⟨frobE_smul_mem_kisinLocAinf_iff.1 h_span, fun μ hμ ↦ ?_⟩, smul_mem _ (k.frobE a)⟩
    simpa [phiInvToBdR, smul_def'] using
      div_mem (h_val μ hμ) (phiInvToBdR_mem_valueField (k.frobE a))
  exact mem_stabilizer_set.1 (zpow_mem (mem_stabilizer_set.2 h_stab) n) x

/-- The scalar extension `F.wittMap` to W(C^♭) of a map F: L → L′ of lattice data sends
`L.kisinLocAinf`, the A_inf-span of the Kisin module with all φ^a E inverted, into
`L'.kisinLocAinf`. -/
lemma Hom.wittMap_mem_kisinLocAinf {L' : JumpLattice O} {x : L.Ambient} (F : L.Hom L')
    (hx : x ∈ L.kisinLocAinf) : F.wittMap x ∈ L'.kisinLocAinf :=
  let ⟨s, hs, hsx⟩ := hx
  ⟨s, hs, by simpa using F.wittMap_mem_kisinAinf hsx⟩

/-- The scalar extension `F.wittMap` to W(C^♭) of a map F: L → L′ of lattice data sends
`L.kisinLoc`, the Kisin module with all φ^a E inverted, into `L'.kisinLoc`. -/
lemma Hom.wittMap_mem_kisinLoc {L' : JumpLattice O} {x : L.Ambient} (F : L.Hom L')
    (hx : x ∈ L.kisinLoc) : F.wittMap x ∈ L'.kisinLoc := by
  -- `F.wittMap` respects the Kisin modules, and `φ^a E` can be cancelled in `L'.kisinLoc`.
  refine kisinLoc_induction (C := fun y : L.Ambient ↦ F.wittMap y ∈ L'.kisinLoc) hx
    (fun y hy ↦ kisinModule_le_kisinLoc (F.wittMap_mem_kisinModule hy)) fun a y _ h_smul ↦ ?_
  have h_unit : k.frobEUnit a ^ (1 : ℤ) • F.wittMap y ∈ L'.kisinLoc := by
    simpa [smul_def'] using h_smul
  exact frobEUnit_zpow_smul_mem_kisinLoc_iff.mp h_unit

/-- The A_inf-span `L.kisinAinf` of the Kisin module is stable under the Galois group Γ' of the
chart (`k.galMonoid`). -/
lemma galMonoid_smul_mem_kisinAinf (hx : x ∈ L.kisinAinf) : g • x ∈ L.kisinAinf := by
  obtain ⟨_, γ, rfl⟩ := g
  exact smul_mem_kisinAinf (fun h hh ↦ mul_mem (mul_mem γ.prop hh) (inv_mem γ.prop)) hx

lemma galMonoid_smul_frobE_dvd_frobE (g : k.galMonoid) : g • (k.frobE a).val ∣ (k.frobE a).val := by
  obtain ⟨_, γ, rfl⟩ := g
  change toGp γ.val • (k.frobE a).val ∣ (k.frobE a).val
  exact (associated_smul_of_dvd (toGp γ.val) fun σ ↦ by
    simp [frobE_dvd_iff, frobE_dvd_iff.1 dvd_rfl]).dvd

/-- The A_inf-span `L.kisinLocAinf` of the Kisin module with all φ^a E inverted is stable under the
Galois group Γ' of the chart (`k.galMonoid`). -/
lemma galMonoid_smul_mem_kisinLocAinf (hx : x ∈ L.kisinLocAinf) : g • x ∈ L.kisinLocAinf := by
  have h_step (a : ℕ) (y : L.Ambient) (hy : g • (k.frobE a).val • y ∈ L.kisinLocAinf) :
      g • y ∈ L.kisinLocAinf := by
    rw [smul_distrib_smul] at hy
    exact mem_kisinLocAinf_of_smul_of_dvd_frobE (galMonoid_smul_frobE_dvd_frobE g) hy
  -- the base case is the stability of `L.kisinAinf`
  exact saturateBy_induction hx (fun y hy ↦ mem_saturateBy_of_mem (galMonoid_smul_mem_kisinAinf hy))
    h_step

/-- `x` has orders `c` at the letter `i` if and only if it lies in `L.kisinLocAinf` and in the
part at `i`, and `L.valueAt a μ x` lies in `hodgeFil (c a u)` for all `a`, all jumps `u` at the
letter `i.stepBack a` and all forms `μ` of type `u` at that letter. -/
lemma mem_withOrders_iff :
    x ∈ L.withOrders i c ↔
      x ∈ L.kisinLocAinf ∧ x ∈ L.letterPart i ∧ ∀ a : ℕ, ∀ u ∈ L.jumpSet (i.stepBack a),
        ∀ μ ∈ L.formsOfType (i.stepBack a) u, L.valueAt a μ x ∈ hodgeFil (c a u) :=
  and_assoc

lemma withOrders_le_kisinLocAinf : L.withOrders i c ≤ L.kisinLocAinf :=
  inf_le_left.trans inf_le_left

lemma withOrders_le_letterPart : L.withOrders i c ≤ L.letterPart i :=
  inf_le_left.trans inf_le_right

/-- If `x` has orders `c` at the letter `i`, `u` is a jump at the letter `i.stepBack a` and `μ`
is a form of type `u` at that letter, then `L.valueAt a μ x` lies in `hodgeFil (c a u)`. -/
lemma valueAt_mem_hodgeFil_of_mem_withOrders (hx : x ∈ L.withOrders i c)
    (hu : u ∈ L.jumpSet (i.stepBack a)) (hμ : μ ∈ L.formsOfType (i.stepBack a) u) :
    L.valueAt a μ x ∈ hodgeFil (c a u) :=
  (mem_withOrders_iff.1 hx).right.right a u hu μ hμ

/-- To raise orders it is enough to check the values where they go up. Let L be a lattice with
Galois action over the Kummer chart, and let i be a letter. Let x in `L.Ambient` = W(C^♭) ⊗ L have
orders c at i. This means three things. First, x lies in `L.kisinLocAinf`, the A_inf-span of the
Kisin module with all φ^a E inverted. Second, x lies in the part at i. Third,
`valueAt a μ x` = μ(φ^{−a}x) lies in t^{c(a,u)}B_dR^+ for all a, all jumps u at the letter
j = `i.stepBack a` and all forms μ of type u at j. Suppose μ(φ^{−a}x) lies in t^{c'(a,u)}B_dR^+ for
all such a, u and μ with c(a, u) < c'(a, u). Then x has orders c' at i. -/
lemma mem_withOrders_of_mem_hodgeFil {i : Letter} {c c' : ℕ → ℤ → ℤ} {x : L.Ambient}
    (hx : x ∈ L.withOrders i c)
    (h_raise : ∀ a : ℕ, ∀ u ∈ L.jumpSet (i.stepBack a), c a u < c' a u →
      ∀ μ ∈ L.formsOfType (i.stepBack a) u, L.valueAt a μ x ∈ hodgeFil (c' a u)) :
    x ∈ L.withOrders i c' := by
  obtain ⟨h_span, h_letter, h_exp⟩ := mem_withOrders_iff.1 hx
  refine mem_withOrders_iff.2 ⟨h_span, h_letter, fun a u hu μ hμ ↦ ?_⟩
  obtain h_lt | h_ge := lt_or_ge (c a u) (c' a u)
  exacts [h_raise a u hu h_lt μ hμ, hodgeFil_anti h_ge (h_exp a u hu μ hμ)]

/-- An element with orders `c` also has all smaller orders `c'`; only the values at the
jumps are compared. -/
lemma mem_withOrders_of_le {i : Letter} {c c' : ℕ → ℤ → ℤ} {x : L.Ambient}
    (hx : x ∈ L.withOrders i c)
    (h_le : ∀ a : ℕ, ∀ u ∈ L.jumpSet (i.stepBack a), c' a u ≤ c a u) : x ∈ L.withOrders i c' :=
  mem_withOrders_of_mem_hodgeFil hx fun a u hu h_lt ↦ absurd h_lt (h_le a u hu).not_gt

/-- Let x lie in the A_inf-span `L.ainfLattice` of 1 ⊗ L, at the letter i, and let μ be a form of
type u at the letter `i.stepBack a`, a steps before i. Then μ(φ^{−a}x) lies in t^{−u}B_dR^+. -/
lemma valueAt_mem_hodgeFil_of_mem_ainfLattice (hμ : μ ∈ L.formsOfType (i.stepBack a) u)
    (hx : x ∈ L.ainfLattice) (hi : x ∈ L.letterPart i) : L.valueAt a μ x ∈ hodgeFil (-u) := by
  -- The bound on `μ ∘ letterProj` extends from the generators of `L.ainfLattice` to all of it, and
  -- `(φ ^ a)⁻¹ • x` is its own projection.
  have h_span : L.ainfLattice ≤
      ((hodgeFil (-u)).restrictScalars Ainf).comap (μ ∘ₗ L.letterProj (i.stepBack a)) :=
    span_le.2 (range_subset_iff.2 hμ.2)
  have h_letter : L.letterProj (i.stepBack a) ((φ ^ a)⁻¹ • x) = (φ ^ a)⁻¹ • x :=
    mem_letterPart_iff_letterProj.1 (phi_pow_smul_mem_letterPart_iff.1 (by simpa))
  rw [valueAt_def, ← h_letter]
  exact h_span (smul_mem_ainfLattice (φ ^ a)⁻¹ hx)

/-- Let F: L → L' be an equivariant map of lattice data, and let the jump set `L'.jumpSet j` lie in
`L.jumpSet j` for every letter j. Then the scalar extension `F.wittMap` of F to W(C^♭) sends
elements with orders c at the letter i to elements with orders c at i. -/
lemma Hom.wittMap_mem_withOrders {i : Letter} {c : ℕ → ℤ → ℤ} {L' : JumpLattice O} {x : L.Ambient}
    (F : L.Hom L') (hU : L'.jumpSet ≤ L.jumpSet) (hx : x ∈ L.withOrders i c) :
    F.wittMap x ∈ L'.withOrders i c := by
  obtain ⟨h_span, h_letter, h_exp⟩ := mem_withOrders_iff.1 hx
  refine mem_withOrders_iff.2 ⟨F.wittMap_mem_kisinLocAinf h_span, ?_, fun a u hu μ hμ ↦ ?_⟩
  · rw [mem_letterPart_iff_letterProj] at h_letter ⊢
    rw [← wittMap_letterProj, h_letter]
  · -- The pull-back of `μ` along `F` is a form on `L` of the same type.
    have h_pull : μ ∘ₗ F.wittMap ∈ L.formsOfType (i.stepBack a) u :=
      ⟨F.comp_wittMap_mem_forms hμ.1, fun t ↦ by simpa using hμ.2 _⟩
    simpa [← valueAt_comp_wittMap] using h_exp a u (hU _ hu) _ h_pull

/-- Saturation: let r in A_inf be divisible by no φ^a E, and let x lie in `L.kisinLocAinf`, the
A_inf-span of the Kisin module with all φ^a E inverted. If rx has orders c at the letter i, then
so does x. -/
lemma mem_withOrders_of_smul {r : Ainf} (hr : ∀ a : ℕ, ¬(k.frobE a).val ∣ r)
    (hx : x ∈ L.kisinLocAinf) (hrx : r • x ∈ L.withOrders i c) :
    x ∈ L.withOrders i c := by
  obtain ⟨-, h_letter, h_exp⟩ := mem_withOrders_iff.1 hrx
  refine mem_withOrders_iff.2 ⟨hx, ?_, fun a u hu μ hμ ↦ ?_⟩
  · simpa [mem_letterPart_iff_letterProj, show r ≠ 0 from fun h ↦ hr 0 (by simp [h])]
      using h_letter
  · have h_mul : phiInvToBdR a r * L.valueAt a μ x ∈ hodgeFil (c a u) := by
      simpa using h_exp a u hu μ hμ
    rwa [← mul_mem_hodgeFil_iff_of_not_frobE_dvd (hr a) 1, zpow_one]

/-- Let i be a letter and let x in `L.Ambient` = W(C^♭) ⊗ L have orders c at i: x lies in the
A_inf-span `L.kisinLocAinf` of the Kisin module `L.kisinLoc` with all φ^a E inverted, and in the
part at i, and its values μ(φ^{−a}x) lie in t^{c(a,u)}B_dR^+ for all a, all jumps u at the letter
`i.stepBack a` and all forms μ of type u there. Let p_b = φ^b E, as the unit `k.frobEUnit b` of
W(C^♭). Then p_b^m x has at i the orders c raised by m at p_b, that is, for a = b, and unchanged for
a ≠ b. -/
lemma frobEUnit_zpow_smul_mem_withOrders_add {i : Letter} {c : ℕ → ℤ → ℤ} {x : L.Ambient}
    (b : ℕ) (m : ℤ) (hx : x ∈ L.withOrders i c) :
    k.frobEUnit b ^ m • x ∈
      L.withOrders i fun (a : ℕ) (u : ℤ) ↦ c a u + if b = a then m else 0 := by
  obtain ⟨h_span, h_letter, h_exp⟩ := mem_withOrders_iff.1 hx
  refine mem_withOrders_iff.2 ⟨?_, ?_, fun a u hu μ hμ ↦ ?_⟩
  · have h_stab : ∀ y : L.Ambient, k.frobEUnit b • y ∈ L.kisinLocAinf ↔ y ∈ L.kisinLocAinf :=
      fun _ ↦ frobE_smul_mem_kisinLocAinf_iff (a := b)
    exact (mem_stabilizer_set.1 (zpow_mem (mem_stabilizer_set.2 h_stab) m) x).2 h_span
  · rw [mem_letterPart_iff_letterProj] at h_letter ⊢
    simp [h_letter]
  · rw [valueAt_frobEUnit_zpow_smul]
    obtain rfl | hba := eq_or_ne b a
    · simpa [add_comm] using mul_mem_hodgeFil (phiInvToBdR_frobE_zpow_mem_hodgeFil b m)
        (h_exp b u hu μ hμ)
    · -- Otherwise `p_b` is prime to `p_a`, so its powers do not change the order.
      simpa [hba, mul_mem_hodgeFil_iff_of_not_frobE_dvd (not_frobE_dvd_frobE_of_ne hba.symm)]
        using h_exp a u hu μ hμ

/-- Let `x` have orders `c` at the letter `i`, and let `p_b = φ^b E` be the unit `k.frobEUnit b`.
Then `p_b ^ m • x` has orders `c'` if, at the jumps `u`, `c' b u ≤ c b u + m` and
`c' a u ≤ c a u` for `a ≠ b`. -/
lemma frobEUnit_zpow_smul_mem_withOrders (b : ℕ) (m : ℤ) (hx : x ∈ L.withOrders i c)
    (h_le : ∀ a : ℕ, ∀ u ∈ L.jumpSet (i.stepBack a), c' a u ≤ c a u + if b = a then m else 0) :
    k.frobEUnit b ^ m • x ∈ L.withOrders i c' :=
  mem_withOrders_of_le (frobEUnit_zpow_smul_mem_withOrders_add b m hx) h_le

/-- Every element of `L.kisinLocAinf` has a multiple by a non-zero element of A_inf in the
A_inf-span of 1 ⊗ L, that is, lies in `L.fracSpan`. -/
lemma kisinLocAinf_le_fracSpan : L.kisinLocAinf ≤ L.fracSpan :=
  fun _ hx ↦ saturateBy_induction hx kisinAinf_le_fracSpan
    fun _ _ hy ↦ mem_saturateBy_of_smul dvd_rfl (by simp) hy

/-- For x in `L.kisinLocAinf`, a form μ (Γ'-equivariant on 1 ⊗ L) and g in Γ', the map
`L.valueAt a μ` = μ ∘ φ^{−a} sends gx − x to gv − v, where v is its value on x. -/
lemma valueAt_smul_sub {a : ℕ} {μ : L.Functional} {x : L.Ambient} {g : k.galMonoid}
    (hx : x ∈ L.kisinLocAinf) (hμ : μ ∈ L.forms) :
    L.valueAt a μ (g • x - x) = g • L.valueAt a μ x - L.valueAt a μ x := by
  have h_comm : (φ ^ a)⁻¹ • g • x = g • (φ ^ a)⁻¹ • x := by
    simp [inv_smul_eq_iff, ← smul_phi_pow_comm]
  rw [map_sub, valueAt_def, valueAt_def, h_comm,
    form_gal_smul g hμ (smul_mem_fracSpan _ (kisinLocAinf_le_fracSpan hx))]

/-- If x has orders c at the letter i and g lies in the Galois group Γ' of the chart, then gx − x
has orders c at i. -/
lemma smul_sub_mem_withOrders (hx : x ∈ L.withOrders i c) (g : k.galMonoid) :
    g • x - x ∈ L.withOrders i c := by
  obtain ⟨h_span, h_letter, h_exp⟩ := mem_withOrders_iff.1 hx
  refine mem_withOrders_iff.2 ⟨sub_mem (galMonoid_smul_mem_kisinLocAinf h_span) h_span,
    sub_mem ((gal_smul_mem_letterPart g).2 h_letter) h_letter, fun a u hu μ hμ ↦ ?_⟩
  have h_mem := h_exp a u hu μ hμ
  simpa only [valueAt_smul_sub h_span hμ.1] using sub_mem (galMonoid_smul_mem_hodgeFil g h_mem)
      h_mem

/-! ### Divisibility of `g x - x` by `zTau` -/

/-- An element `g` of `k.galMonoid` (the image of `Γ'` under `inr`) that comes from
`γ` in `Γ'` acts on `B_dR` through the image of `γ` in `G_p`. -/
lemma galMonoid_smul_eq_toGp_smul {g : k.galMonoid} {γ : k.subgroup} (hγ : inr γ.val = g.val)
    (y : BdR) : g • y = toGp γ.val • y := by
  rw [show g = ⟨inr γ.val, γ, rfl⟩ from Subtype.ext hγ.symm]
  rfl

/-- Let `x` in `L.Ambient = W(C^♭) ⊗ L` lie in the Kisin module `L.kisinModule` of the Galois
lattice `L`, and let `g` be an element of the Galois group `Γ'` of the Kummer chart `k`. Then
`g x - x` is `δ = k.zTau` times a vector of `L.kisinAinf`, the `A_inf`-span of the Kisin module. -/
lemma exists_zTau_smul_eq_smul_sub {x : L.Ambient} (g : k.galMonoid) (hx : x ∈ L.kisinModule) :
    ∃ y ∈ L.kisinAinf, k.zTau • y = g • x - x := by
  -- Divisibility by `zTau` is tested with crystalline forms. Their values on `x` lie in
  -- `bicommutant` up to a power `E ^ n`, so `g` moves them, times `E ^ (2 * n)`, by multiples of
  -- `zTau`.
  obtain ⟨-, n, h_values⟩ := mem_kisinModule_iff_crysForms.mp hx
  obtain ⟨γ, hγ⟩ : ∃ γ : k.subgroup, inr γ.val = g.val := g.prop
  have h_cancel {m : ℕ} {r : Ainf}
      (h_dvd : Chart.ainfToBPlus k.zTau ∣ Chart.ainfToBPlus (k.E.val ^ m * r)) : k.zTau ∣ r := by
    rw [zTau, ← pow_one k.z.val] at h_dvd ⊢
    exact k.chart.tau_mul_z_pow_dvd_of_dvd_E_pow_mul h_dvd
  rw [← mem_smul_pointwise_iff_exists]
  refine mem_smul_kisinAinf_of_crysForms h_cancel
    (sub_mem (galMonoid_smul_mem_kisinAinf hx.1) hx.1) (n := 2 * n) fun μ hμ ↦ ?_
  -- the forms are equivariant: `μ (g x) = γ (μ x)`
  rw [map_sub, form_gal_smul g hμ.1 (kisinAinf_le_fracSpan hx.1), galMonoid_smul_eq_toGp_smul hγ]
  exact pow_smul_gal_sub_mem_span_of_dvd (k.tau_mul_z_dvd_smul_sub (fixes γ)) (h_values μ hμ)

/-- Let L be a Galois lattice over the Kummer chart k, inside `L.Ambient` = W(C^♭) ⊗ L, let x lie in
its Kisin module `L.kisinLoc`, in which φ^a E is inverted for every a ≥ 0, and let g lie in the
Galois group Γ' of k. Then (zτ)^{−1}(gx − x) lies in `L.kisinLocAinf`, the A_inf-span of
`L.kisinLoc`.

This is a form of the known triviality of the Galois action on Kisin modules modulo the variable. -/
lemma zTauUnit_inv_smul_sub_mem_kisinLocAinf {x : L.Ambient} (g : k.galMonoid)
    (hx : x ∈ L.kisinLoc) :
    k.zTauUnit⁻¹ • (g • x - x) ∈ L.kisinLocAinf := by
  refine kisinLoc_induction (C := fun y ↦ k.zTauUnit⁻¹ • (g • y - y) ∈ L.kisinLocAinf) hx
    (fun y hy ↦ ?_) fun a y hy ih ↦ ?_
  · -- For `y ∈ L.kisinModule` the quotient lies in `L.kisinAinf`.
    obtain ⟨w, hw, h_eq⟩ := exists_zTau_smul_eq_smul_sub g hy
    rw [← h_eq, ← zTauUnit_smul, inv_smul_smul]
    exact mem_saturateBy_of_mem hw
  · -- With `g p_a = p_a + zTau E r`, the quotient for `p_a y` is `p_a` times the quotient for `y`
    -- plus `E r g y`, which lies in `L.kisinLocAinf`.
    obtain ⟨r, hr⟩ : ∃ r : Ainf, g • (k.frobE a).val - k.frobE a = k.zTau * k.E * r :=
      zTau_mul_E_dvd_smul_sub g (k.frobE a)
    have h_expand : g • (k.frobE a).val • y - (k.frobE a).val • y =
        (k.frobE a).val • (g • y - y) + k.zTau • (k.E * r) • g • y := by
      rw [smul_distrib_smul, eq_add_of_sub_eq' hr, add_smul, mul_assoc, mul_smul k.zTau, smul_sub,
        add_sub_right_comm]
    have h_split : k.zTauUnit⁻¹ • (g • (k.frobE a).val • y - (k.frobE a).val • y) =
        (k.frobE a).val • k.zTauUnit⁻¹ • (g • y - y) + (k.E * r) • g • y := by
      rw [h_expand, smul_add, ← zTauUnit_smul, inv_smul_smul, smul_comm]
    have h_error : (k.E * r) • g • y ∈ L.kisinLocAinf :=
      smul_mem _ _ (galMonoid_smul_mem_kisinLocAinf (mem_kisinLocAinf_of_mem_kisinLoc hy))
    rwa [← frobE_smul_mem_kisinLocAinf_iff (a := a), ← add_mem_cancel_right h_error, ← h_split]

/-! ### Frobenius, values and retractions -/

/-- The map `E ^ h • φ` preserves the Kisin module `L.kisinModule`. Here `h = L.jumpBound` is the
least natural number with all Hodge–Tate jumps of `L` over `Γ'` in `[-h, h]`, and `k.frobEUnit 0` is
`E` as a unit of `W(C^♭)`. This is a part of `frame_theorem`. -/
lemma frobEUnit_pow_smul_phi_smul_mem_kisinModule {x : L.Ambient} (hx : x ∈ L.kisinModule) :
    k.frobEUnit 0 ^ L.jumpBound • φ • x ∈ L.kisinModule :=
  L.frame_theorem.frobEUnit_pow_smul_phi_smul_mem_kisinModule x hx

/-- Frobenius φ maps `L.kisinLoc`, the Kisin module of L with all φ^a E inverted, into itself. -/
lemma phi_smul_mem_kisinLoc {x : L.Ambient} (hx : x ∈ L.kisinLoc) : φ • x ∈ L.kisinLoc := by
  refine kisinLoc_induction (C := fun y ↦ φ • y ∈ L.kisinLoc) hx (fun y hy ↦ ?_) fun a y _ ih ↦ ?_
  · rw [← frobEUnit_zpow_smul_mem_kisinLoc_iff (a := 0) (n := L.jumpBound), zpow_natCast]
    exact kisinModule_le_kisinLoc (frobEUnit_pow_smul_phi_smul_mem_kisinModule hy)
  · -- `φ (p_a • y) = p_(a+1) • φ y`, and `p_(a+1)` can be cancelled
    rw [← frobEUnit_zpow_smul_mem_kisinLoc_iff (a := a + 1) (n := 1)]
    simpa [val_frobE, pow_succ', mul_smul, frobGroup_smul_smul] using ih

/-- Every power φ^l of Frobenius maps `L.kisinLoc`, the Kisin module of L with all φ^a E inverted,
into itself. -/
lemma phi_pow_smul_mem_kisinLoc {x : L.Ambient} (hx : x ∈ L.kisinLoc) : φ ^ l • x ∈ L.kisinLoc := by
  induction l with
  | zero => simpa using hx
  | succ l ih => simpa only [pow_succ', mul_smul] using phi_smul_mem_kisinLoc ih

/-- The A_inf-span of the Kisin module `L.kisinLoc` with all φ^a E inverted is `L.kisinLocAinf`,
which is defined as the set of x that some product of the φ^a E sends into `L.kisinAinf`, the
A_inf-span of the Kisin module `L.kisinModule`. -/
lemma span_kisinLoc : span Ainf (L.kisinLoc : Set L.Ambient) = L.kisinLocAinf := by
  have h_base : L.kisinAinf ≤ span Ainf (L.kisinLoc : Set L.Ambient) :=
    kisinAinf_eq_span_kisinModule.le.trans (span_mono kisinModule_le_kisinLoc)
  have h_step (a : ℕ) (y : L.Ambient)
      (hy : (k.frobE a).val • y ∈ span Ainf (L.kisinLoc : Set L.Ambient)) :
      y ∈ span Ainf (L.kisinLoc : Set L.Ambient) := by
    -- `p_a⁻¹` maps `L.kisinLoc`, hence its span, into itself
    let f : L.Ambient →ₗ[Ainf] L.Ambient := k.frobEUnit a ^ (-1 : ℤ) • LinearMap.id
    have h_maps : MapsTo f L.kisinLoc L.kisinLoc :=
      fun z hz ↦ frobEUnit_zpow_smul_mem_kisinLoc_iff.2 hz
    simpa [f, ← frobEUnit_smul] using mapsTo_span h_maps hy
  exact span_eq_of_le _ (fun x ↦ mem_kisinLocAinf_of_mem_kisinLoc)
    fun x hx ↦ saturateBy_induction hx h_base h_step

/-- An S-linear map f: A_inf → S preserves linear relations among elements v_i of `L.fracSpan` on
which all Γ'-equivariant forms take values in the field 𝒦₀ = `valueField 0`. This is a part of
`frame_theorem`. -/
lemma sum_map_smul_eq_zero_of_mem_valueFieldPoints (f : Ainf →ₗ[k.S] k.S) {ι : Type} [Fintype ι]
    {v : ι → L.Ambient} {b : ι → Ainf} (hv : ∀ i : ι, v i ∈ L.valueFieldPoints L.fracSpan)
    (h_zero : ∑ i : ι, b i • v i = 0) : ∑ i : ι, f (b i) • v i = 0 :=
  L.frame_theorem.sum_map_smul_eq_zero f v b hv h_zero

/-- An S-linear map f: A_inf → S preserves linear relations among elements v_i of `L.kisinLoc`, the
Kisin module with all φ^a E inverted: if ∑ b_i v_i = 0 with b_i in A_inf, then ∑ f(b_i) v_i = 0. -/
lemma sum_map_smul_eq_zero_of_mem_kisinLoc (f : Ainf →ₗ[k.S] k.S) {ι : Type} [Fintype ι]
    {v : ι → L.Ambient} {b : ι → Ainf} (hv : ∀ i : ι, v i ∈ L.kisinLoc)
    (h_zero : ∑ i : ι, b i • v i = 0) : ∑ i : ι, f (b i) • v i = 0 := by
  refine sum_map_smul_eq_zero_of_mem_valueFieldPoints f (fun i ↦ ?_) h_zero
  exact ⟨kisinLocAinf_le_fracSpan (hv i).1, (hv i).2⟩

/-- Let L be a Galois lattice over the Kummer chart and a ≥ 0. Let μ be a form, that is, an
A_inf-linear map `L.Ambient` = W(C^♭) ⊗ L → B_dR that is Γ'-equivariant on 1 ⊗ L, and let x lie in
the Kisin module `L.kisinLoc` with all φ^b E inverted. Then the value `valueAt a μ x` = μ(φ^{−a}x)
lies in `valueField a`, the subfield of B_dR generated over the fixed field of Γ' by the images of
the ring `k.bicommutant` and of φ^{−a}S. -/
lemma valueAt_mem_valueField {a : ℕ} {μ : L.Functional} {x : L.Ambient} (hμ : μ ∈ L.forms)
    (hx : x ∈ L.kisinLoc) : valueAt a μ x ∈ valueField a := by
  -- Some `ρ = φ ^ a (τ ^ jumpBound r) ≠ 0` has `ρ x = ∑ (φ ^ a t l) (φ ^ a v l)` with
  -- `v l ∈ L.kisinLoc`. A coordinate `f` with `f ρ ≠ 0` turns this into a relation over `k.S`, to
  -- be solved for `valueAt a μ x` in the field `valueField a`.
  obtain ⟨r, hr, hrx⟩ : ∃ r ∈ nonZeroDivisors Ainf, r • (φ ^ a)⁻¹ • x ∈ L.ainfLattice :=
    smul_mem_fracSpan (φ ^ a)⁻¹ (kisinLocAinf_le_fracSpan (mem_kisinLocAinf_of_mem_kisinLoc hx))
  obtain ⟨n, t, v, hv⟩ : ∃ (n : ℕ) (t : Fin n → Ainf) (v : Fin n → L.kisinLoc),
      ∑ l : Fin n, t l • (v l).val = tau ^ L.jumpBound • r • (φ ^ a)⁻¹ • x :=
    mem_span_set'.1 (span_kisinLoc.ge
      (mem_saturateBy_of_mem (tau_pow_jumpBound_smul_mem_kisinAinf_of_mem_ainfLattice hrx)))
  let ρ : Ainf := φ ^ a • (tau ^ L.jumpBound * r)
  have hρx : ρ • x = ∑ l : Fin n, (φ ^ a • t l) • φ ^ a • (v l).val := by
    simpa [ρ, smul_sum, frobGroup_smul_smul, smul_smul] using
      congrArg (fun y : L.Ambient ↦ φ ^ a • y) hv.symm
  obtain ⟨f, hf⟩ : ∃ f : Ainf →ₗ[k.S] k.S, f ρ ≠ 0 := by
    have hρ_ne : ρ ≠ 0 := by simp [ρ, smul_eq_zero_iff_eq, nonZeroDivisors.ne_zero hr]
    exact (not_forall.1 (mt k.adicBasis.eq_zero_of_coord hρ_ne)).elim fun j hj ↦ ⟨_, hj⟩
  have h_rel : f ρ • x = ∑ l : Fin n, f (φ ^ a • t l) • φ ^ a • (v l).val := by
    -- the relation `-ρ x + ∑ (φ ^ a t l) (φ ^ a v l) = 0`, indexed by `Option (Fin n)`
    let w : Option (Fin n) → L.Ambient := fun l ↦ l.elim x fun l ↦ φ ^ a • (v l).val
    let b : Option (Fin n) → Ainf := fun l ↦ l.elim (-ρ) fun l ↦ φ ^ a • t l
    have hw : ∀ l : Option (Fin n), w l ∈ L.kisinLoc :=
      Option.forall.2 ⟨hx, fun l ↦ phi_pow_smul_mem_kisinLoc (v l).prop⟩
    have h_zero : ∑ l, b l • w l = 0 := by simpa [b, w, neg_add_eq_zero] using hρx
    simpa [b, w, neg_add_eq_zero] using sum_map_smul_eq_zero_of_mem_kisinLoc f hw h_zero
  have h_val : valueAt a μ x =
      (phiInvToBdR a (f ρ))⁻¹ * ∑ l : Fin n, phiInvToBdR a (f (φ ^ a • t l)) * μ (v l) := by
    have h_phi (y : L.Ambient) : valueAt a μ (φ ^ a • y) = μ y := by simp [valueAt]
    rw [eq_inv_mul_iff_mul_eq₀ (by simpa using hf)]
    simpa [smul_eq_val_smul, h_phi] using congrArg (valueAt a μ) h_rel
  have h_field (l : Fin n) : μ (v l) ∈ valueField a := by
    obtain ⟨-, h_values⟩ := (v l).prop
    exact valueField_zero_le (h_values μ hμ)
  rw [h_val]
  exact mul_mem (inv_mem (phiInvToBdR_mem_valueField _))
    (sum_mem fun l _ ↦ mul_mem (phiInvToBdR_mem_valueField _) (h_field l))

/-- The chart comes with a chosen topological S-basis of A_inf, and λ₀ = `k.coord₀`: A_inf → S is
the coordinate in this basis that restricts to the identity on S. For a Galois lattice L there is an
S-linear map r from `L.kisinLocAinf`, the A_inf-span in W(C^♭) ⊗ L of the Kisin module `L.kisinLoc`,
to `L.kisinLoc` with r(ax) = λ₀(a)x for a in A_inf and x in `L.kisinLoc`. -/
lemma exists_coordRetract :
    ∃ r : L.kisinLocAinf →ₗ[k.S] L.kisinLoc, ∀ a : Ainf, ∀ x ∈ L.kisinLoc,
      ∀ hax : a • x ∈ L.kisinLocAinf, (r ⟨a • x, hax⟩).val = k.coord₀ a • x := by
  -- `Ainf ⊗_S L.kisinLoc` maps onto the span of `L.kisinLoc` by `π (a ⊗ x) = a • x`, and to
  -- `L.kisinLoc` by `ℓ (a ⊗ x) = coord₀ a • x`. As `coord₀` keeps linear relations, `ℓ` kills the
  -- kernel of `π`, so it factors through `π`.
  rw [← span_kisinLoc]
  let π : TensorProduct k.S Ainf L.kisinLoc →ₗ[k.S] span Ainf (L.kisinLoc : Set L.Ambient) :=
    (tensorToSpan Ainf L.kisinLoc).restrictScalars k.S
  let ℓ : TensorProduct k.S Ainf L.kisinLoc →ₗ[k.S] L.kisinLoc :=
    TensorProduct.lift (LinearMap.lsmul k.S L.kisinLoc ∘ₗ k.coord₀)
  have h_ker : LinearMap.ker π ≤ LinearMap.ker ℓ := fun s hs ↦ by
    obtain ⟨n, a, v, rfl⟩ := s.exists_sum_tmul_eq
    have h_rel : ∑ j : Fin n, a j • (v j).val = 0 := by simpa [π, Subtype.ext_iff] using hs
    simpa [ℓ, Subtype.ext_iff] using
      sum_map_smul_eq_zero_of_mem_kisinLoc k.coord₀ (fun j ↦ (v j).prop) h_rel
  have hπ : Function.Surjective π := surjective_tensorToSpan _ _
  refine ⟨π.liftOfSurjective hπ ⟨ℓ, h_ker⟩, fun a x hx hax ↦ ?_⟩
  have h_tmul : π (a ⊗ₜ ⟨x, hx⟩) = ⟨a • x, hax⟩ := by simp [π, Subtype.ext_iff]
  simp [← h_tmul, ℓ]

/-- A chosen S-linear map from the A_inf-span `L.kisinLocAinf` to `L.kisinLoc` sending a·x to
λ₀(a)·x for a in A_inf and x in `L.kisinLoc`. Here λ₀ = `k.coord₀`: A_inf → S is the coordinate that
is the identity on S. This property is `coordRetract_smul`. -/
def coordRetract : L.kisinLocAinf →ₗ[k.S] L.kisinLoc := L.exists_coordRetract.choose

/-- The retraction `coordRetract` sends a·x to λ₀(a)·x for a in A_inf and x in `L.kisinLoc`, where
λ₀ = `k.coord₀`: A_inf → S is the coordinate that is the identity on S. -/
lemma coordRetract_smul (a : Ainf) {x : L.Ambient} (hx : x ∈ L.kisinLoc)
    (hax : a • x ∈ L.kisinLocAinf) : (coordRetract ⟨a • x, hax⟩).val = k.coord₀ a • x :=
  L.exists_coordRetract.choose_spec a x hx hax

/-- Let v_i be finitely many elements of `L.kisinLoc` and a_i elements of A_inf, and let
y = ∑ a_i v_i in the A_inf-span `L.kisinLocAinf`. Then the retraction `coordRetract` sends y to
∑ λ₀(a_i) v_i, where λ₀ = `k.coord₀`: A_inf → S is the coordinate that is the identity on S. -/
lemma coordRetract_sum {ι : Type*} [Fintype ι] {a : ι → Ainf} {v : ι → L.Ambient}
    (hv : ∀ i : ι, v i ∈ L.kisinLoc) {y : L.kisinLocAinf} (hy : ∑ i : ι, a i • v i = y.val) :
    (coordRetract y).val = ∑ i : ι, k.coord₀ (a i) • v i := by
  have h_mem (i : ι) : a i • v i ∈ L.kisinLocAinf :=
    smul_mem _ (a i) (mem_kisinLocAinf_of_mem_kisinLoc (hv i))
  obtain rfl : y = ∑ i : ι, ⟨a i • v i, h_mem i⟩ := Subtype.ext (by simp [← hy])
  simp [coordRetract_smul _ (hv _)]

/-- The retraction `coordRetract` from the A_inf-span `L.kisinLocAinf` to `L.kisinLoc` is the
identity on `L.kisinLoc`. -/
lemma coordRetract_of_mem_kisinLoc {x : L.Ambient} (hx : x ∈ L.kisinLoc)
    (hx_span : x ∈ L.kisinLocAinf) : (coordRetract ⟨x, hx_span⟩).val = x := by
  simpa using coordRetract_smul 1 hx (smul_mem _ 1 hx_span)

/-- The retractions `coordRetract` commute with a map F: L → L′ of lattice data: if the scalar
extension `F.wittMap` of F to W(C^♭) sends y to y′, then it sends the retraction of y to the
retraction of y′. -/
lemma Hom.wittMap_coordRetract {L' : JumpLattice O} (F : L.Hom L') (y : L.kisinLocAinf)
    (y' : L'.kisinLocAinf) (hyy' : F.wittMap y = y') :
    F.wittMap (coordRetract y) = coordRetract y' := by
  -- Both sides are computed on an expansion of `y` in elements of `L.kisinLoc` and on its image.
  obtain ⟨n, a, v, hy⟩ : ∃ (n : ℕ) (a : Fin n → Ainf) (v : Fin n → L.kisinLoc),
      ∑ i : Fin n, a i • (v i).val = y.val := mem_span_set'.1 (span_kisinLoc.ge y.prop)
  have hy' : ∑ i : Fin n, a i • F.wittMap (v i) = y' := by simp [← hyy', ← hy]
  simp [coordRetract_sum (fun i ↦ (v i).prop) hy,
    coordRetract_sum (fun i ↦ F.wittMap_mem_kisinLoc (v i).prop) hy']

/-! ### The gap rule and depth -/

/-- The gap rule. Let `i` be a letter, let `j = i.stepBack a` be the letter with `j ^ p ^ a = i`,
and let `c : ℕ → ℤ → ℤ`. Let `x` have orders `c` at `i`: it lies in `L.kisinLocAinf` and in the part
at `i`, and for every `b` and every jump `v` at `i.stepBack b` the forms of type `v` there send
`φ^{-b} x` into `hodgeFil (c b v) = t^(c b v)B_dR⁺`. A form of type `u` at `j` is an `A_inf`-linear
map `μ` to `B_dR` that is `Γ'`-equivariant on `1 ⊗ L` and maps the projection of `1 ⊗ L` to `j` into
`hodgeFil (-u)`. If `W` contains `hodgeFil (c a v)` for every jump `v ≤ u` at `j`, then
`valueAt a μ x = μ (φ^{-a} x)` lies in `W` for each such form `μ`. -/
lemma valueAt_mem_of_hodgeFil_le {a : ℕ} {i : Letter} {c : ℕ → ℤ → ℤ} {u : ℤ}
    {μ : L.Functional} {x : L.Ambient} (W : Submodule BdRPlus BdR)
    (hx : x ∈ L.withOrders i c) (hμ : μ ∈ L.formsOfType (i.stepBack a) u)
    (h_le : ∀ v ∈ L.jumpSet (i.stepBack a), v ≤ u → hodgeFil (c a v) ≤ W) :
    L.valueAt a μ x ∈ W := by
  by_contra h_not
  -- Then `μ` has every type `v ≤ u`: a jump on the way down would put the value in `W`.
  have h_type : ∀ v ≤ u, μ ∈ L.formsOfType (i.stepBack a) v :=
    Int.leInductionDown hμ fun v hv hμv ↦ formsOfType_subset_pred_of_notMem (fun h_jump ↦
      h_not (h_le v h_jump hv (valueAt_mem_hodgeFil_of_mem_withOrders hx h_jump hμv))) hμv
  -- So the value on a multiple `r • x ∈ L.ainfLattice` lies in every step of the filtration,
  -- hence is 0.
  obtain ⟨r, hr, hrx⟩ : ∃ r ∈ nonZeroDivisors Ainf, r • x ∈ L.ainfLattice :=
    kisinLocAinf_le_fracSpan (withOrders_le_kisinLocAinf hx)
  have h_all (m : ℤ) : valueAt a μ (r • x) ∈ hodgeFil m :=
    hodgeFil_anti (by lia : m ≤ -(u ⊓ -m)) (valueAt_mem_hodgeFil_of_mem_ainfLattice
      (h_type _ inf_le_left) hrx (smul_mem _ r (withOrders_le_letterPart hx)))
  obtain ⟨y, hy⟩ : ∃ y : BdRPlus, algebraMap BdRPlus BdR y = valueAt a μ (r • x) := by
    simpa using mem_hodgeFil.1 (h_all 0)
  obtain rfl : y = 0 := Adic.eq_zero_of_forall_pow_dvd fun n ↦
    algebraMap_mem_hodgeFil_iff_xi_pow_dvd.1 (by simpa only [← hy] using h_all n)
  -- Since `r ≠ 0`, the value on `x` is 0 as well, and `0 ∈ W`.
  have h_zero : L.valueAt a μ x = 0 := by simpa [nonZeroDivisors.ne_zero hr] using hy.symm
  simp [h_zero] at h_not

/-- Let x lie in the Kisin module `L.kisinLoc` (all φ^a E inverted) and g in the Galois group Γ' of
the chart. If gx − x has orders c at the letter i (`L.withOrders i c`), then so does
(gx − x)/(zτ). -/
lemma zTauUnit_inv_smul_sub_mem_withOrders {x : L.Ambient} {g : k.galMonoid}
    (hx : x ∈ L.kisinLoc) (h_orders : g • x - x ∈ L.withOrders i c) :
    k.zTauUnit⁻¹ • (g • x - x) ∈ L.withOrders i c := by
  refine mem_withOrders_of_smul not_frobE_dvd_zTau (zTauUnit_inv_smul_sub_mem_kisinLocAinf g hx)
    ?_
  rwa [← zTauUnit_smul, smul_inv_smul]

end JumpLattice

end New.Lift.KummerChart

end ExponentLattices

/-! ## Invariants modulo a submodule and the depth lemma -/

namespace New.Lift.KummerChart.JumpLattice

open Period Submodule DistribSMul algebraMap

variable {p : ℕ} [ThePrime p] [Γ : GroupOverGp p]
  {k : KummerChart Γ} {O : Coeffs} {L : JumpLattice O} {a : ℕ} {i : Letter} {n : ℤ} {x : L.Ambient}
  (Q : Submodule Ainf L.Ambient)

/-- For an A_inf-submodule Q of W(C^♭)⊗L, the Z_p-submodule of
`New.Lift.KummerChart.JumpLattice.kisinLoc` of the elements that lie in Q. -/
abbrev locKisinPart : Submodule ℤ_[p] L.kisinLoc :=
  (Q.restrictScalars ℤ_[p]).comap (L.kisinLoc.subtype.restrictScalars ℤ_[p])

/-- The Z_p-module of the x in W(C^♭) ⊗ L that are invariant modulo Q: gx − x lies in Q for all g in
Γ'. Take Q = `L.withOrders i o` and x in `L.kisinLocAinf`. Then for every a, every jump u at
`i.stepBack a` and every form μ of type u there, `valueAt a μ x` is a constant in
`localFieldOf k.subgroup` modulo `hodgeFil (o a u)`: x has the depth of the module header
(`exists_valueAt_sub_mem_hodgeFil_of_mem_invariantsMod`). (The module is the
intersection of the preimages of Q under the maps g − 1; `copy` only makes membership unfold to the
displayed condition.) -/
def invariantsMod : Submodule ℤ_[p] L.Ambient :=
  (⨅ g : k.galMonoid, (Q.restrictScalars ℤ_[p]).comap (toLinearMap ℤ_[p] L.Ambient g - 1)).copy
    {x : L.Ambient | ∀ g : k.galMonoid, g • x - x ∈ Q} (by aesop)

/-- Let the Kummer chart be unramified: `E = z + p` and the ramification index is `1`, so that the
number `d = k.differentBound` is `0`. Then the cost `k.cost a n = v_p(n) + d + 3a` is at most `3a`
if `n = 0` or `p` does not divide `n`. -/
lemma cost_le_of_isUnramified (hk : k.IsUnramified) (hn : (p : ℤ) ∣ n → n = 0) :
    k.cost a n ≤ 3 * a := by
  obtain ⟨-, -, h_different⟩ := hk
  have h_val : padicValInt p n = 0 := by grind [padicValInt.eq_zero_iff]
  simp [cost, h_val, h_different]

/-- The order `hi a u` where `0 < lo a u` and `min (hi a u) 0` elsewhere. An element with
orders `lo` that is invariant modulo the elements with orders `hi` has these orders
(`mem_withOrders_improvedOrders`). -/
@[simp]
abbrev improvedOrders (lo hi : ℕ → ℤ → ℤ) (a : ℕ) (u : ℤ) : ℤ :=
  min (hi a u) (if 0 < lo a u then hi a u else 0)

lemma improvedOrders_le {lo hi : ℕ → ℤ → ℤ} {u : ℤ} : improvedOrders lo hi a u ≤ hi a u :=
  min_le_left _ _

lemma min_pos_of_improvedOrders_pos {lo hi : ℕ → ℤ → ℤ} {u : ℤ}
    (h_pos : 0 < improvedOrders lo hi a u) : 0 < min (lo a u) (hi a u) := by
  grind

/-- If `y` in `B_dR` is fixed modulo `hodgeFil n` by the Galois group `k.galMonoid` of the chart,
then `y` is congruent modulo `hodgeFil n` to a constant in the fixed field of `Γ'`. -/
lemma exists_const_sub_mem_hodgeFil_of_smul_sub_mem {y : BdR}
    (h_fix : ∀ g : k.galMonoid, g • y - y ∈ hodgeFil n) :
    ∃ c : localFieldOf k.subgroup, y - c ∈ hodgeFil n :=
  BdR.exists_sub_mem_of_smul_sub_mem k.subgroup (hodgeFil n) fun γ ↦
    h_fix ⟨FrobGroup.inr γ.val, γ, rfl⟩

/-- Let `x` lie in `L.kisinLocAinf` and let `μ` be a `Γ'`-equivariant form. If the value
`valueAt a μ` on `g • x - x` lies in `hodgeFil n` for all `g` in `k.galMonoid`, then the value on
`x` is congruent modulo `hodgeFil n` to a constant in the fixed field of `Γ'`. -/
lemma exists_valueAt_sub_mem_hodgeFil {μ : L.Functional} (hx : x ∈ L.kisinLocAinf)
    (hμ : μ ∈ L.forms) (h_smul_sub : ∀ g : k.galMonoid, valueAt a μ (g • x - x) ∈ hodgeFil n) :
    ∃ c : localFieldOf k.subgroup, valueAt a μ x - c ∈ hodgeFil n :=
  exists_const_sub_mem_hodgeFil_of_smul_sub_mem fun g ↦ by
    simpa only [valueAt_smul_sub hx hμ] using h_smul_sub g

/-- The Galois group `k.galMonoid` of the chart fixes the image in `B_dR` of its fixed field
`localFieldOf k.subgroup`. -/
lemma galMonoid_smul_localFieldOf (c : localFieldOf k.subgroup) (g : k.galMonoid) :
    g • (c : BdR) = c := by
  obtain ⟨γ, hγ⟩ : ∃ γ : k.subgroup, FrobGroup.inr γ.val = g.val := g.prop
  have h_fix : toGp γ.val (c : PadicAlgCl p) = c := mem_localFieldOf.1 c.prop γ
  change g • ((c : PadicAlgCl p) : BdR) = ((c : PadicAlgCl p) : BdR)
  rw [galMonoid_smul_eq_toGp_smul hγ, BdR.smul_algebraMap_padicAlgCl, h_fix]

/-- Let `x` lie in `L.kisinLocAinf` and let `μ` be a `Γ'`-equivariant form. If the value
`valueAt a μ x` is congruent modulo `hodgeFil n` to a constant `c` in the fixed field of `Γ'`, then
the value on `g • x - x` lies in `hodgeFil n` for every `g` in `k.galMonoid`. -/
lemma valueAt_smul_sub_mem_hodgeFil_of_sub_const_mem {μ : L.Functional}
    {c : localFieldOf k.subgroup}
    (hx : x ∈ L.kisinLocAinf) (hμ : μ ∈ L.forms) (h_close : valueAt a μ x - c ∈ hodgeFil n)
    (g : k.galMonoid) : valueAt a μ (g • x - x) ∈ hodgeFil n := by
  -- `g` fixes `c`, so the value is `g • (v - c) - (v - c)` for `v = valueAt a μ x`.
  simpa only [valueAt_smul_sub hx hμ, smul_sub, galMonoid_smul_localFieldOf,
    sub_sub_sub_cancel_right] using sub_mem (galMonoid_smul_mem_hodgeFil g h_close) h_close

/-- Let `i` be a letter and let `x` lie in `L.kisinLocAinf`, the `A_inf`-span of the Kisin module
`L.kisinLoc` (all `φ^a E` inverted) in `W(C^♭) ⊗ L`. Suppose that `x` is in
`invariantsMod (L.withOrders i o)`, that is, `g x - x` has orders `o` at `i` for every `g` in the
Galois group `Γ'` of the chart. Then the following holds for every `a`, every `u` in the finite set
`L.jumpSet j` of jumps at the letter `j = i.stepBack a` (the one with `j ^ p ^ a = i`) and every
form `μ` of type `u` at `j` (a linear map to `B_dR`, `Γ'`-equivariant on `1 ⊗ L`, sending its
projection to `j` into `hodgeFil (-u)`): the value `valueAt a μ x = μ (φ^{-a} x)` is congruent
modulo `hodgeFil (o a u) = t^(o a u)B_dR⁺` to a constant in the fixed field of `Γ'`. -/
lemma exists_valueAt_sub_mem_hodgeFil_of_mem_invariantsMod {i : Letter} {x : L.Ambient}
    {o : ℕ → ℤ → ℤ} (h_span : x ∈ L.kisinLocAinf) (h_inv : x ∈ invariantsMod (L.withOrders i o))
    (a : ℕ) {u : ℤ} (hu : u ∈ L.jumpSet (i.stepBack a)) {μ : L.Functional}
    (hμ : μ ∈ L.formsOfType (i.stepBack a) u) :
    ∃ c : localFieldOf k.subgroup, valueAt a μ x - c ∈ hodgeFil (o a u) :=
  exists_valueAt_sub_mem_hodgeFil h_span hμ.1 fun g ↦
    valueAt_mem_hodgeFil_of_mem_withOrders (h_inv g) hu hμ

/-- Let `i` be a letter and `x` an element of `L.Ambient = W(C^♭) ⊗ L` with orders `lo` at `i`: it
lies in `L.kisinLocAinf` and in the part at `i`, and for all natural numbers `a`, all jumps `u` at
the letter `i.stepBack a` and all forms `μ` of type `u` there, `μ (φ^{-a} x)` lies in
`t^(lo a u)B_dR⁺`. Let `x` be invariant modulo the elements with orders `hi`: `g • x - x` has orders
`hi` at `i` for all `g` in the Galois group `Γ'` of the chart. Then `x` has the orders
`improvedOrders lo hi`. -/
lemma mem_withOrders_improvedOrders {i : Letter} {x : L.Ambient} {lo hi : ℕ → ℤ → ℤ}
    (hx : x ∈ L.withOrders i lo) (h_inv : x ∈ invariantsMod (L.withOrders i hi)) :
    x ∈ L.withOrders i (improvedOrders lo hi) := by
  obtain ⟨h_span, h_letter, h_exp⟩ := mem_withOrders_iff.1 hx
  refine mem_withOrders_iff.2 ⟨h_span, h_letter, fun a u hu μ hμ ↦ ?_⟩
  -- The value is a constant `y` modulo `hodgeFil (hi a u)`.
  obtain ⟨y, h_close⟩ : ∃ y : localFieldOf k.subgroup, valueAt a μ x - y ∈ hodgeFil (hi a u) :=
    exists_valueAt_sub_mem_hodgeFil_of_mem_invariantsMod h_span h_inv a hu hμ
  -- The constant lies in the step `min (lo a u) (hi a u)`, so it is zero if both are positive.
  have h_min : (y : BdR) ∈ hodgeFil (min (lo a u) (hi a u)) :=
    (sub_mem_iff_right _ (hodgeFil_anti (min_le_left _ _) (h_exp a u hu μ hμ))).1
      (hodgeFil_anti (min_le_right _ _) h_close)
  have h_const : (y : BdR) ∈ hodgeFil (improvedOrders lo hi a u) :=
    coe_mem_hodgeFil_iff.2 fun h_pos ↦
      coe_mem_hodgeFil_iff.1 h_min (min_pos_of_improvedOrders_pos h_pos)
  exact (sub_mem_iff_left _ h_const).1 (hodgeFil_anti improvedOrders_le h_close)

/-- If `t` in `k.galMonoid` (an element of `Γ'`) acts trivially on the ring `S` of the chart modulo
`p_a = k.frobE a`, then it fixes modulo `hodgeFil 1` every `y` of `hodgeFil 0 = B_dR⁺` in the
subfield `valueField a`. -/
lemma smul_sub_mem_hodgeFil_one_of_mem_valueField {t : k.galMonoid} {y : BdR}
    (ht : ∀ s : k.S, (k.frobE a).val ∣ t • s.val - s.val)
    (hy_field : y ∈ k.valueField a) (hy_int : y ∈ hodgeFil 0) : t • y - y ∈ hodgeFil 1 := by
  -- the case of the one-element family `![1]`
  simpa using smul_sub_mem_hodgeFil_of_valueField t ![1] hy_field hy_int (by simpa using ht)

/-- Let `t` in the Galois group `Γ'` multiply `p_a = k.frobE a = φ^a E` by a unit `ω` and act
trivially modulo `p_a` on the ring `k.S = Λ⟦z⟧ ⊆ A_inf` of the Kummer chart. Let `y` lie in the
step `hodgeFil n = Filⁿ B_dR` and in `k.valueField a`, the subfield of `B_dR` generated over the
fixed field of `Γ'` by the images of `k.bicommutant` and of `φ^{-a} S`. Then `t • y` is congruent
modulo `hodgeFil (n + 1)` to `y` times the image `phiInvToBdR a (ω ^ n)` of `φ^{-a} (ω ^ n)`. -/
lemma smul_sub_phiInvToBdR_mul_mem_hodgeFil_succ {a : ℕ} {n : ℤ} {t : k.galMonoid} {ω : Ainfˣ}
    {y : BdR} (hω : t • (k.frobE a).val = ω.val * (k.frobE a).val)
    (ht : ∀ s : k.S, (k.frobE a).val ∣ t • s.val - s.val)
    (hy_field : y ∈ k.valueField a) (hy_fil : y ∈ hodgeFil n) :
    t • y - phiInvToBdR a (ω ^ n).val * y ∈ hodgeFil (n + 1) := by
  -- With `π` the image of `p_a`, the element `w = π ^ (-n) * y` lies in `hodgeFil 0`, so `t` fixes
  -- it modulo `hodgeFil 1`. Multiply by `t π ^ n = ω ^ n π ^ n`.
  let π : BdR := phiInvToBdR a (k.frobE a)
  let w : BdR := π ^ (-n) * y
  have hw : π ^ n * w = y := by simp [w, π, zpow_ne_zero]
  have hw_int : w ∈ hodgeFil 0 := by
    simpa [w, π] using mul_mem_hodgeFil (phiInvToBdR_frobE_zpow_mem_hodgeFil a (-n)) hy_fil
  have h_fix : t • w - w ∈ hodgeFil 1 := smul_sub_mem_hodgeFil_one_of_mem_valueField ht
    (mul_mem (zpow_mem (phiInvToBdR_mem_valueField _) _) hy_field) hw_int
  have h_smul : t • π = phiInvToBdR a ω.val * π := by simp [π, hω]
  have h_unit : phiInvToBdR a (ω ^ n).val = phiInvToBdR a ω.val ^ n :=
    map_zpow ((phiInvToBdR a : Ainf →* BdR).comp (Units.coeHom Ainf)) ω n
  have h_smul_zpow : t • π ^ n = phiInvToBdR a (ω ^ n).val * π ^ n := by
    rw [h_unit, ← mul_zpow, ← h_smul]
    exact map_zpow₀ (MulSemiringAction.toRingHom k.galMonoid BdR t) π n
  have h_scale : t • π ^ n * (t • w - w) = t • y - phiInvToBdR a (ω ^ n).val * y := by
    rw [mul_sub, ← smul_mul', h_smul_zpow, mul_assoc, hw]
  rw [← h_scale]
  exact mul_mem_hodgeFil (galMonoid_smul_mem_hodgeFil t (phiInvToBdR_frobE_zpow_mem_hodgeFil a n))
    h_fix

variable (L) in
/-- The operator `p ^ e + υ ∑ l, (t l - 1) / (τ z)` on `L.Ambient = W(C^♭) ⊗ L`, for `υ` in `A_inf`
and finitely many elements `t l` of the Galois group `Γ'` of the chart. Here `k.zTauUnit` is `τ z`
as a unit of `W(C^♭)`. -/
def depthStepOperator (e : ℕ) (υ : Ainf) {m : ℕ} (t : Fin m → k.galMonoid) (x : L.Ambient) :
    L.Ambient :=
  p ^ e • x + ∑ l : Fin m, υ • k.zTauUnit⁻¹ • (t l • x - x)

lemma depthStepOperator_apply (e : ℕ) (υ : Ainf) {m : ℕ} (t : Fin m → k.galMonoid) (x : L.Ambient) :
    L.depthStepOperator e υ t x = p ^ e • x + ∑ l : Fin m, υ • k.zTauUnit⁻¹ • (t l • x - x) :=
  rfl

lemma depthStepOperator_singleton (e : ℕ) (υ : Ainf) (t : k.galMonoid) (x : L.Ambient) :
    L.depthStepOperator e υ ![t] x = p ^ e • x + υ • k.zTauUnit⁻¹ • (t • x - x) := by
  simp [depthStepOperator_apply]

/-- One step of depth at `p_a = φ^a E` for `n ≠ 0`. There are `t` in the Galois group `Γ'` of the
Kummer chart and `υ` in `A_inf` such that the operator
`L.depthStepOperator e υ ![t] = p ^ e + υ (t - 1) / δ` on `W(C^♭) ⊗ L` has the property below. Here
`δ = k.zTau` is the product of the coordinate `z` of the chart with `τ = [ε^{1/p}] - 1`, and
`e = cost a n = v_p(n) + d + 3a`, where `d = k.differentBound` is `0` or `v_p(e_k) + 1` as the
ramification index `e_k` of the chart is `1` or not. Let `x` lie in the Kisin module `L.kisinLoc`
with all `φ^b E` inverted, and let `μ` in `L.forms` be an `A_inf`-linear map from `W(C^♭) ⊗ L` to
`B_dR` that is `Γ'`-equivariant on `1 ⊗ L`. If its value `valueAt a μ x = μ (φ^{-a} x)` is congruent
modulo `hodgeFil n = Filⁿ B_dR` to a constant `c` in the fixed field `localFieldOf k.subgroup`,
then its value on the image of `x` is congruent to `p ^ e • c` modulo `hodgeFil (n + 1)`. -/
lemma exists_valueAt_depthStepOperator_sub_smul_mem {n : ℤ} (a : ℕ) (hn : n ≠ 0) :
    ∃ (t : k.galMonoid) (υ : Ainf), ∀ x ∈ L.kisinLoc, ∀ μ ∈ L.forms, ∀ c : localFieldOf k.subgroup,
      valueAt a μ x - c ∈ hodgeFil n →
      valueAt a μ (L.depthStepOperator (cost a n) υ ![t] x) - p ^ cost a n • (c : BdR) ∈
        hodgeFil (n + 1) := by
  -- Put `y = valueAt a μ x - c` and `w = (t x - x) / zTau`. Then `t` acts on `y` by `ω ^ n` to
  -- first order, so `valueAt a μ w ≡ X y`, and `υ X ≡ p ^ cost` cancels `p ^ cost * y`.
  obtain ⟨t, ω, υ, X, hω, ht, h_cost, hX⟩ := exists_isDepthStep (k := k) a hn
  refine ⟨t, -υ, fun x hx μ hμ c h_close ↦ ?_⟩
  set y : BdR := valueAt a μ x - c with hy
  set w : L.Ambient := k.zTauUnit⁻¹ • (t • x - x) with hw
  have hy_field : y ∈ valueField a := sub_mem (valueAt_mem_valueField hμ hx) (by simp)
  have h_eigen : t • y - phiInvToBdR a (ω ^ n).val * y ∈ hodgeFil (n + 1) :=
    smul_sub_phiInvToBdR_mul_mem_hodgeFil_succ hω ht hy_field h_close
  -- Since `zTau w = t x - x`, `t` fixes `c` and `zTau X = ω ^ n - 1`, cancelling `zTau` gives
  -- `valueAt a μ w ≡ X y`.
  have h_cancel : valueAt a μ w - phiInvToBdR a X * y ∈ hodgeFil (n + 1) := by
    have h_zTau_w : phiInvToBdR a k.zTau * valueAt a μ w = t • y - y :=
      calc _ = valueAt a μ (k.zTau • w) := by simp
        _ = valueAt a μ (t • x - x) := by rw [hw, ← zTauUnit_smul, smul_inv_smul]
        _ = t • y - y := by
          rw [valueAt_smul_sub (mem_kisinLocAinf_of_mem_kisinLoc hx) hμ, hy, smul_sub,
            galMonoid_smul_localFieldOf, sub_sub_sub_cancel_right]
    have h_zTau_X : phiInvToBdR a k.zTau * phiInvToBdR a X = phiInvToBdR a (ω ^ n).val - 1 := by
      rw [← map_mul, hX, map_sub, map_one]
    have h_mul : phiInvToBdR a k.zTau * (valueAt a μ w - phiInvToBdR a X * y) =
        t • y - phiInvToBdR a (ω ^ n).val * y := by linear_combination h_zTau_w - y * h_zTau_X
    rwa [← mul_mem_hodgeFil_iff_of_not_frobE_dvd (not_frobE_dvd_zTau a) 1, zpow_one, h_mul]
  -- The claim is about `p ^ cost * y - υ * valueAt a μ w`, and `υ X ≡ p ^ cost` modulo `p_a`.
  have h_value : valueAt a μ (p ^ cost a n • x + -υ • w) - p ^ cost a n • (c : BdR) =
      -(phiInvToBdR a υ * (valueAt a μ w - phiInvToBdR a X * y) +
        y * phiInvToBdR a (υ * X - p ^ cost a n)) := by
    simp [hy]
    ring
  have hυ : phiInvToBdR a υ ∈ hodgeFil 0 := algebraMap_mem_hodgeFil_zero
  rw [depthStepOperator_singleton, ← hw, h_value, neg_mem_iff]
  exact add_mem (by simpa only [zero_add] using mul_mem_hodgeFil hυ h_cancel)
    (mul_mem_hodgeFil h_close (phiInvToBdR_mem_hodgeFil_one_iff.2 h_cost))

/-- Raising depth by one step at `p_a = φ^a E`. There are finitely many elements `t l` of the Galois
group `Γ'` of the Kummer chart and `υ` in `A_inf` such that the operator `L.depthStepOperator e υ
t = p ^ e + υ ∑ l, (t l - 1) / δ` on `W(C^♭) ⊗ L` has the property below. Here `δ = k.zTau` is the
product of the coordinate `z` of the chart with `τ = [ε^{1/p}] - 1`, and
`e = cost a n = v_p(n) + d + 3a`, where `d = k.differentBound` is `0` or `v_p(e_k) + 1` as the
ramification index `e_k` of the chart is `1` or not. Let `x` lie in the Kisin module `L.kisinLoc`
with all `φ^b E` inverted, and let `μ` in `L.forms` be an `A_inf`-linear map from `W(C^♭) ⊗ L` to
`B_dR` that is `Γ'`-equivariant on `1 ⊗ L`. Suppose `valueAt a μ x = μ (φ^{-a} x)` is a constant (in
the fixed field of `Γ'`) modulo `hodgeFil n = Filⁿ B_dR`. Then
`valueAt a μ (L.depthStepOperator e υ t x)` is a constant modulo `hodgeFil (n + 1)`. -/
lemma exists_valueAt_sub_mem_hodgeFil_succ (a : ℕ) (n : ℤ) :
    ∃ (m : ℕ) (t : Fin m → k.galMonoid) (υ : Ainf), ∀ x ∈ L.kisinLoc, ∀ μ ∈ L.forms,
      (∃ c : localFieldOf k.subgroup, valueAt a μ x - c ∈ hodgeFil n) →
      ∃ c : localFieldOf k.subgroup,
        valueAt a μ (L.depthStepOperator (cost a n) υ t x) - c ∈ hodgeFil (n + 1) := by
  obtain hn | rfl := ne_or_eq n 0
  · -- For `n ≠ 0` one element `t` is enough, and the new constant is `p ^ cost a n • c`.
    obtain ⟨t, υ, h_raise⟩ := exists_valueAt_depthStepOperator_sub_smul_mem (L := L) a hn
    exact ⟨1, ![t], υ, fun x hx μ hμ ⟨c, h_close⟩ ↦
      ⟨p ^ cost a n • c, by simpa using h_raise x hx μ hμ c h_close⟩⟩
  · -- For `n = 0` take `υ = zTau`. The image of `x` is `∑ l, t l • x`, for `p ^ cost a 0` elements
    -- `t l` whose sum is invariant on `S` modulo `k.frobE a`. So its value is invariant modulo
    -- `hodgeFil 1`.
    obtain ⟨t, ht⟩ : ∃ t : Fin (p ^ cost a 0) → k.galMonoid, ∀ (g : k.galMonoid) (s : k.S),
        (k.frobE a).val ∣ g • ∑ l, t l • s.val - ∑ l, t l • s.val :=
          exists_frobE_dvd_smul_sum_sub_sum a
    refine ⟨p ^ cost a 0, t, k.zTau, fun x hx μ hμ ⟨c, h_close⟩ ↦ ?_⟩
    have h_int : valueAt a μ x ∈ hodgeFil 0 :=
      (sub_mem_iff_left _ algebraMap_mem_hodgeFil_zero).1 h_close
    have h_value : valueAt a μ (L.depthStepOperator (cost a 0) k.zTau t x) =
        ∑ l, t l • valueAt a μ x := by
      have h_gal (g : k.galMonoid) : valueAt a μ (g • x) = g • valueAt a μ x := by
        simpa using valueAt_smul_sub (g := g) (mem_kisinLocAinf_of_mem_kisinLoc hx) hμ
      simp [depthStepOperator_apply, ← zTauUnit_smul, h_gal]
    have h_fix (g : k.galMonoid) :
        g • ∑ l, t l • valueAt a μ x - ∑ l, t l • valueAt a μ x ∈ hodgeFil 1 :=
      smul_sub_mem_hodgeFil_of_valueField g t (valueAt_mem_valueField hμ hx) h_int (ht g)
    simpa only [h_value, zero_add] using exists_const_sub_mem_hodgeFil_of_smul_sub_mem h_fix

end New.Lift.KummerChart.JumpLattice

end
end
end

/-!
# Exponents of lattice elements in a Hodge basis and the length of one step on a line

Let `L` be a crystalline lattice over a Kummer chart `k` with prime `p` and residue degree
`f = k.f`. A letter is a unit of the field with `p ^ f` elements; it singles out some of the
embeddings of the coefficients into `ℂ_p`, and `i.stepBack a` is the letter `j` with `j^(p^a) = i`.
Take an element `x` of `L.kisinLocAinf` lying in the letter `i`. Then `x ∈ L.withOrders i c` says
the following: for every level `a : ℕ` and every form `μ` of a type `u ∈ L.jumpSet j` at the letter
`j = i.stepBack a`, the value `valueAt a μ x = μ (φ^(-a) x)` lies in `t^(c a u) B_dR⁺`. The file
shows how exponents behave under coordinates and Frobenius. It then shows that among sufficiently
many elements with given exponents some primitive `ℤ_[p]`-combination gains a step: it splits into
parts with raised exponents. The line `u` of a system `c` of exponents is the family `a ↦ c a u`.

## Main definitions and results

* `New.Lift.KummerChart.JumpLattice.mem_withOrders_stdOrders_iff`: the standard exponents
  `New.Lift.KummerChart.stdOrders l` cut out, at the letter, the span
  `New.Lift.KummerChart.JumpLattice.frobKisinAinf l`, the image of `L.kisinAinf` under `φ^l`.
  On the line `u` these exponents are `0` below level `l` and `-u` from level `l` on.
* `New.Lift.KummerChart.JumpLattice.wittPairing_mem_withOrders`: exponents add under an
  equivariant bilinear map of lattices.
* `New.Lift.KummerChart.JumpLattice.raiseOrder`, `New.Lift.KummerChart.JumpLattice.raiseOrdersAt`:
  the system of exponents `o` with the single value `o a u`, or all values at the level `a`, raised
  by one.
* `New.Lift.KummerChart.JumpLattice.exists_sum_smul_mem_locKisinPart_sup`: let the chart be
  unramified and the jump `u` of multiplicity at most `n` at the letter `b` steps before `l`. Let
  `o b u < o b v` on the lines `v < u` in `L.jumpSet (l.stepBack b)`. Then any `k.f * n + 1`
  elements of `L.kisinLoc` with exponents `o` at the letter `l` have a `ℤ_[p]`-combination with one
  coefficient `1` that is the sum of two elements of `L.kisinLoc`: one with all exponents at level
  `0` raised by one, and one with the exponent at level `b` on the line `u` raised by one.

Notions from other files:
* `JumpLattice O`: a finite free `O`-module `L` with a crystalline action and, for each letter `i`,
  a finite set `L.jumpSet i` that holds its jumps. `L.Ambient` is `W(C^♭) ⊗ L`, and `L.Functional`
  is the type of `A_inf`-linear maps `L.Ambient → B_dR`.
* `L.forms`, `L.formsOfType i u`: the functionals that are `Γ'`-equivariant on `1 ⊗ L`, and those
  among them that send the letter-`i` projection of `1 ⊗ L` into `t^(-u) B_dR⁺`.
* `L.ainfLattice` is the `A_inf`-span of `1 ⊗ L`. `L.kisinAinf` consists of the `x` in
  `A_inf[1/τ] ⊗ L` with `μ (φ^n x) ∈ B_dR⁺` for all forms `μ` and all `n ≥ 1`, and
  `L.kisinLocAinf` is its saturation by the elements `k.frobE a = φ^a(E)`.
* `saturateBy M P`: the elements that some member of the submonoid `M` multiplies into `P`.

## Relation to the literature

See `New.Congruences.Lifting.SafeMoves` and `New.Congruences.Lifting.CupOrthogonalityBounds` for
related work. For sources see `Lib.PadicHodge.Kisin.PeriodMatrixFrame`.
-/

@[expose] public section

noncomputable section

namespace New.Lift.KummerChart.JumpLattice

/-! ## Standard exponents, Frobenius on exponents, and additivity of exponents -/

section HodgeExpansion

open Period Submodule Set FrobGroup Module Matrix

variable {p : ℕ} [ThePrime p] [Γ : GroupOverGp p] {k : KummerChart Γ} {O : Coeffs}
  {L A C : JumpLattice O}

section StandardExponents

variable {l a : ℕ} {i : k.Letter} {n : ℤ} {μ : L.Functional} {c : ℕ → ℤ → ℤ}
  {x : L.Ambient} {b : A.Carrier →ₗ[O] L.Carrier →ₗ[O] C.Carrier}

variable (b) in
/-- The `W(C^♭)`-bilinear extension `(W(C^♭) ⊗ A) × (W(C^♭) ⊗ L) → W(C^♭) ⊗ C` of an `O`-bilinear
map `b : A × L → C` of lattices. The tensor products are over `ℤ_p`. -/
abbrev wittPairing : A.Ambient →ₗ[WittCFlat] L.Ambient →ₗ[WittCFlat] C.Ambient :=
  DiagTensor.pair (b.restrictScalars₁₂ ℤ_[p] ℤ_[p])

variable (b) in
/-- The `O`-bilinear map `b : A × L → C` of lattices is equivariant: `b (g y, g x) = g b (y, x)` for
all `g` in `Γ`. -/
def IsEquivariantPairing : Prop :=
  ∀ (g : GroupOverGp.G) (y : A.Carrier) (x : L.Carrier), b (A.ρ g y) (L.ρ g x) = C.ρ g (b y x)

/-- The `W(C^♭)`-bilinear extension of an `O`-bilinear map `b` moves the projector `e_i` onto the
letter `i` from the first argument to the value: `b (e_i y, x) = e_i b (y, x)`. -/
lemma wittPairing_letterProj_left (x : L.Ambient) (y : A.Ambient) :
    wittPairing b (A.letterProj i y) x = C.letterProj i (wittPairing b y x) := by
  induction x using DiagTensor.induction with
  | h_add x x' hx hx' => simp [hx, hx']
  | h_mk a t =>
    induction y using DiagTensor.induction with
    | h_mk a' t' => simp [letterProj]
    | h_add y y' hy hy' => simp [hy, hy']

/-- If the pairing `wittPairing b` maps `s × t` into `Q`, it maps the saturations of `s` and `t` by
the submonoid `T` into the saturation of `Q` by `T`. -/
lemma wittPairing_mem_saturateBy {y : A.Ambient} {T : Submonoid Ainf}
    {s : Submodule Ainf A.Ambient} {t : Submodule Ainf L.Ambient} {Q : Submodule Ainf C.Ambient}
    (hy : y ∈ saturateBy T s) (hx : x ∈ saturateBy T t)
    (h_pair : ∀ {y' : A.Ambient} {x' : L.Ambient}, y' ∈ s → x' ∈ t → wittPairing b y' x' ∈ Q) :
    wittPairing b y x ∈ saturateBy T Q := by
  -- if `r • y ∈ s` and `r' • x ∈ t`, then `r * r'` multiplies the pairing into `Q`
  obtain ⟨r, hr, hry⟩ := hy
  obtain ⟨r', hr', hrx⟩ := hx
  exact ⟨r * r', mul_mem hr hr', by simpa [mul_smul] using h_pair hry hrx⟩

/-- The family of exponents `c` shifted by `l` levels: the value at `(a, u)` is `n` for `a < l` and
`c (a - l) u` for `a ≥ l`. -/
@[simp]
abbrev shiftedOrders (l : ℕ) (n : ℤ) (c : ℕ → ℤ → ℤ) (a : ℕ) (u : ℤ) : ℤ :=
  if a < l then n else c (a - l) u

/-- A `B_dR`-linear map `D` from functionals to `B_dR` shifts the Hodge filtration by `κ`:
`D μ ∈ t^(m + κ) B_dR⁺` whenever `μ (1 ⊗ L) ⊆ t^m B_dR⁺`. -/
abbrev ShiftsHodgeFil (D : L.Functional →ₗ[BdR] BdR) (κ : ℤ) : Prop :=
  ∀ (μ : L.Functional) (m : ℤ),
    (∀ t : Rep.of (overZp L.ρ), μ (DiagTensor.mk 1 t) ∈ hodgeFil m) → D μ ∈ hodgeFil (m + κ)

/-- A `B_dR`-linear map `D` from functionals to `B_dR` respects the action of `Γ'`:
`D μ₂ = g • D μ₁` whenever `μ₂ (1 ⊗ g t) = g • μ₁ (1 ⊗ t)` for all `t` in `L`. -/
abbrev RespectsGaloisAction (D : L.Functional →ₗ[BdR] BdR) : Prop :=
  ∀ (μ₁ μ₂ : L.Functional) (g : k.subgroup),
    (∀ t : L.Carrier, μ₂ (DiagTensor.mk 1 (L.ρ g t)) = toGp g • μ₁ (DiagTensor.mk 1 t)) →
      D μ₂ = toGp g • D μ₁

/-- Let `x` lie in `L.fracSpan` and let `μ` be any `A_inf`-linear functional `W(C^♭) ⊗ L → B_dR`. A
form of type `κ` at the letter `i` is a functional that is equivariant for `Γ' = k.subgroup` on
`1 ⊗ L` and sends the projection of `1 ⊗ L` to the letter `i` into `t^(-κ) B_dR⁺`. Then `μ x` lies
in `hodgeFil n = tⁿ B_dR⁺` provided `D μ * ν x` does for every integer `κ`, every form `ν` of type
`κ` at `i`, and every `B_dR`-linear map `D` from functionals to `B_dR` that shifts the Hodge
filtration by `κ` and respects the action of `Γ'`. -/
lemma apply_mem_hodgeFil_of_forall_formsOfType (hx : x ∈ L.fracSpan)
    (h_terms : ∀ κ : ℤ, ∀ ν ∈ L.formsOfType i κ, ∀ D : L.Functional →ₗ[BdR] BdR,
      ShiftsHodgeFil D κ → RespectsGaloisAction D → D μ * ν x ∈ hodgeFil n) :
    μ x ∈ hodgeFil n := by
  -- Take an invariant Hodge basis `hodgeUnit = P * diag (t ^ κ)` and dual forms `ν m`.
  obtain ⟨κ, -, -, -, -, P, h_inv⟩ :=
    L.inClass.isPotentiallyCrystalline.exists_hodge_basis (finBasis ℤ_[p] L.Carrier)
  let hodgeUnit : (Matrix _ _ BdR)ˣ := P.map (algebraMap BdRPlus BdR).mapMatrix.toMonoidHom *
    (MulEquiv.piUnits.symm fun m ↦ tUnit ^ κ m).map (diagonalRingHom _ BdR).toMonoidHom
  choose ν hν using fun m ↦ L.exists_functional_extend
    ((finBasis ℤ_[p] (Rep.of (overZp L.ρ))).constr ℕ (hodgeUnit.inv m))
  have h_row m : basisValues (ν m) = hodgeUnit.inv m := funext (by simp [basisValues, hν])
  let D m : L.Functional →ₗ[BdR] BdR := .proj m ∘ₗ hodgeUnit.val.vecMulLinear ∘ₗ basisValues
  -- Expand `μ x = ∑ m, D m μ * ν m x` and apply the hypothesis to each term.
  rw [show μ x = ∑ m, D m μ * ν m x by
    simpa [D] using apply_eq_of_mem_fracSpan μ (∑ m, (basisValues μ ᵥ* hodgeUnit) m • ν m)
      (by simp [h_row, ← vecMul_eq_sum]) hx]
  refine sum_mem fun m _ ↦ h_terms (κ m) (ν m) ⟨?_, ?_⟩ (D m) ?_ ?_
  · refine fun t g ↦ (equivariant_iff_basisValues hodgeUnit.isUnit (h_inv g)).2 ?_ t
    simp [funext_iff, h_row, ← mul_apply_eq_vecMul, Matrix.one_apply]
  · have h_fil : L.ainfLattice ≤ ((hodgeFil (-κ m)).restrictScalars Ainf).comap (ν m) := by
      simp [ainfLattice_eq_span_basis, span_le, range_subset_iff, hν, hodgeUnit, mem_hodgeFil,
        mul_comm]
    exact fun t ↦ h_fil (letterProj_mk_mem_ainfLattice t)
  · intro μ' j hμ'
    change ∑ s, basisValues μ' s * hodgeUnit.val s m ∈ hodgeFil (j + κ m)
    exact sum_mem fun s _ ↦ mul_mem_hodgeFil (hμ' _)
      (mem_hodgeFil.2 ⟨P.val s m, by simp [hodgeUnit]⟩)
  · exact fun μ₁ μ₂ g hg ↦
      congrFun ((equivariant_iff_basisValues hodgeUnit.isUnit (h_inv g)).1 hg) m

/-- Let `μ` be a form, that is, a functional equivariant on `1 ⊗ L` for the subgroup
`Γ' = k.subgroup`. Let `y` lie in `L.kisinLocAinf`: some product of the `φ^j(E)` multiplies it into
`L.kisinAinf`. Let `v` lie in `valueField a`, the subfield of `B_dR` generated over the fixed field
of `Γ'` by the products of constants in `k.bicommutant` and images of `φ^(-a) S`, for `S = k.S`. If
the value `valueAt a μ y = μ (φ^(-a) y)` is congruent to `v` modulo `hodgeFil n = tⁿ B_dR⁺`, then so
is the value at `coordRetract y`. -/
lemma valueAt_coordRetract_sub_mem_hodgeFil (hμ : μ ∈ L.forms) (y : L.kisinLocAinf) {v : BdR}
    (hv : v ∈ valueField a) (hy : valueAt a μ y - v ∈ hodgeFil n) :
    valueAt a μ (coordRetract y) - v ∈ hodgeFil n := by
  -- Write `y = ∑ rᵢ wᵢ` with `wᵢ` in `L.kisinLoc`; then `coordRetract y = ∑ k.coord₀ rᵢ • wᵢ`. Both
  -- differences are sums over `Option` with the values `-v`, `valueAt a μ wᵢ` in `valueField a`:
  -- the first has the coefficients `1`, `rᵢ`, the second their images under `k.coord₀`. So
  -- `sum_phiInvToBdR_map_mul_mem_of_mem_valueField` applies.
  obtain ⟨m, r, w, hw⟩ : ∃ (m : ℕ) (r : Fin m → Ainf) (w : Fin m → L.kisinLoc),
      ∑ s, r s • (w s : L.Ambient) = y := mem_span_set'.1 (span_kisinLoc.ge y.property)
  let coeff : Option (Fin m) → Ainf := fun s ↦ s.elim 1 r
  let value : Option (Fin m) → BdR := fun s ↦ s.elim (-v) fun s ↦ valueAt a μ (w s)
  have h_value : ∀ s, value s ∈ valueField a :=
    Option.forall.2 ⟨neg_mem hv, fun s ↦ valueAt_mem_valueField hμ (w s).property⟩
  have h_sum : ∑ s, phiInvToBdR a (coeff s) * value s ∈ hodgeFil n := by
    simpa [coeff, value, ← hw, sub_eq_neg_add] using hy
  have h_sum_coord : ∑ s, phiInvToBdR a (k.coord₀ (coeff s)) * value s ∈ hodgeFil n :=
    sum_phiInvToBdR_map_mul_mem_of_mem_valueField k.coord₀ value coeff h_value h_sum
  rw [coordRetract_sum (fun s ↦ (w s).property) hw]
  simpa [coeff, value, smul_eq_val_smul, sub_eq_neg_add] using h_sum_coord

/-- If `μ` is a form and the value `valueAt a μ y = μ (φ^(-a) y)` at an element `y` of
`L.kisinLocAinf` lies in `hodgeFil n = tⁿ B_dR⁺`, so does the value at `coordRetract y`. -/
lemma valueAt_coordRetract_mem_hodgeFil (hμ : μ ∈ L.forms) (y : L.kisinLocAinf)
    (hy : valueAt a μ y ∈ hodgeFil n) : valueAt a μ (coordRetract y) ∈ hodgeFil n := by
  simpa using valueAt_coordRetract_sub_mem_hodgeFil (v := 0) hμ y (zero_mem _) (by simpa using hy)

/-- If `y` in `L.kisinLocAinf` has exponents `c` at the letter `i`, so does its image under the
coordinate retraction `coordRetract`, which sends `r • w` to `k.coord₀ r • w` for `r` in `A_inf` and
`w` in `L.kisinLoc`. -/
lemma coordRetract_mem_withOrders (y : L.kisinLocAinf) (hy : y.val ∈ L.withOrders i c) :
    (coordRetract y).val ∈ L.withOrders i c := by
  obtain ⟨⟨-, hy_letter⟩, hy_value⟩ := hy
  refine ⟨⟨(coordRetract y).property.1, mem_letterPart_iff_mulZeta.2 ?_⟩, fun a u hu μ hμ ↦ ?_⟩
  · -- `coordRetract` commutes with ζ, which acts on `y` as the scalar `k.letterTeich i`.
    simpa using mulZeta.wittMap_coordRetract y (k.letterTeich i • y)
      (mem_letterPart_iff_mulZeta.1 hy_letter)
  · exact valueAt_coordRetract_mem_hodgeFil hμ.1 y (hy_value a u hu μ hμ)

/-- Let `μ` be a form. Let `x` lie in `L.kisinLocAinf`, that is, a product of elements `φ^j(E)`
multiplies it into `L.kisinAinf`, the module of the `z` in `A_inf[1/τ] ⊗ L` with `ν (φ^j z) ∈ B_dR⁺`
for all forms `ν` and all `j ≥ 1`. Then `μ (φ ^ (m + 1) • x)` lies in `hodgeFil 0 = B_dR⁺`. -/
lemma apply_phi_pow_succ_smul_mem_hodgeFil_zero (hμ : μ ∈ L.forms) (hx : x ∈ L.kisinLocAinf)
    (m : ℕ) : μ (φ ^ (m + 1) • x) ∈ hodgeFil 0 := by
  -- True on `L.kisinAinf` by definition; it remains to cancel a factor `k.frobE j`.
  refine saturateBy_induction hx (fun y ⟨_, hy_int⟩ ↦ hy_int m μ hμ) fun j y hy ↦ ?_
  -- Frobenius turns the factor into `k.frobE (m + 1 + j)`, which `k.frobE 0` does not divide.
  have h_not_dvd : ¬(k.frobE 0 : Ainf) ∣ k.frobE (m + 1 + j) := not_frobE_dvd_frobE_of_ne (by lia)
  have h_factor : φ ^ (m + 1) • (k.frobE j).val • y =
      (k.frobE (m + 1 + j)).val • φ ^ (m + 1) • y := by
    simp [val_frobE, pow_add, mul_smul, frobGroup_smul_smul]
  have h_mul : phiInvToBdR 0 (k.frobE (m + 1 + j)).val * μ (φ ^ (m + 1) • y) ∈ hodgeFil 0 := by
    rwa [h_factor, ← valueAt_zero, map_smulₛₗ, valueAt_zero] at hy
  exact (mul_mem_hodgeFil_iff_of_not_frobE_dvd h_not_dvd 1).1 (by rwa [zpow_one])

/-- Frobenius shifts exponents. If `x` has exponents `c` at `i.stepBack l`, then `φ ^ l • x` has the
following exponents at `i`: `0` at levels `a < l`, and `c (a - l)` at levels `a ≥ l`. -/
lemma phi_pow_smul_mem_withOrders (hx : x ∈ L.withOrders (i.stepBack l) c) :
    φ ^ l • x ∈ L.withOrders i (shiftedOrders l 0 c) := by
  obtain ⟨⟨hx_loc, hx_letter⟩, hx_value⟩ := hx
  refine ⟨⟨span_kisinLoc.le <| mapsTo_span (f := semilinearAct (φ ^ l))
    (fun _ ↦ phi_pow_smul_mem_kisinLoc) (span_kisinLoc.ge hx_loc),
    phi_pow_smul_mem_letterPart_iff.2 hx_letter⟩, fun a u hu μ hμ ↦ ?_⟩
  -- The value of φ^l x at level a is μ(φ^{l-a} x).
  obtain ⟨m, rfl | rfl⟩ : ∃ m : ℕ, l = a + m + 1 ∨ a = l + m := ⟨max (l - a - 1) (a - l), by lia⟩
  · -- The value is μ(φ^{m+1} x), and the exponent is 0.
    simpa [valueAt, pow_add, mul_smul, Nat.lt_succ_iff] using
      apply_phi_pow_succ_smul_mem_hodgeFil_zero hμ.1 hx_loc m
  · -- The value is that of x at level m.
    rw [show i.stepBack (l + m) = (i.stepBack l).stepBack m by simp [pow_add]] at hu hμ
    simpa [valueAt, pow_add, mul_smul] using hx_value m u hu μ hμ

/-! ### The standard exponents -/

/-- Let `x` have the standard exponents `stdOrders l` at the letter `i`. Let `l ≤ a` and let `r` lie
in `A_inf`. If `r φ^a(E) x` lies in `L.ainfLattice`, the `A_inf`-span of `1 ⊗ L`, so does `r x`.
Here `E = k.E` is the distinguished element of the chart and `k.frobE a = φ^a(E)`. -/
lemma smul_mem_ainfLattice_of_frobE_smul_mem (hx : x ∈ L.withOrders i (stdOrders l))
    (hla : l ≤ a) {r : Ainf} (hr : r • (k.frobE a).val • x ∈ L.ainfLattice) :
    r • x ∈ L.ainfLattice := by
  -- Show that φ^a(E) divides every coordinate `coord s` of r φ^a(E) x in a basis `e` of `L`.
  let e := finBasis ℤ_[p] (Rep.of (overZp L.ρ))
  let ι : Type := Fin (finrank ℤ_[p] (Rep.of (overZp L.ρ)))
  have h_mem {z : L.Ambient} :
      z ∈ L.ainfLattice ↔ ∃ coord : ι → Ainf, ∑ s, coord s • DiagTensor.mk 1 (e s) = z := by
    simp [ainfLattice_eq_span_basis, mem_span_range_iff_exists_fun, e, ι]
  obtain ⟨coord, h_coord⟩ := h_mem.1 (by rwa [smul_comm] at hr)
  -- `μ s` extends the s-th coordinate functional of the basis.
  have h_extend (s : ι) : ∃ μ : L.Functional, ∀ t, μ (DiagTensor.mk 1 t) =
      algebraMap ℤ_[p] BdR (e.coord s t) := L.exists_functional_extend (Algebra.linearMap _ _ ∘ₗ _)
  choose μ hμ using h_extend
  have hx_frac : (φ ^ a)⁻¹ • x ∈ L.fracSpan :=
    smul_mem_fracSpan _ (kisinLocAinf_le_fracSpan (withOrders_le_kisinLocAinf hx))
  -- In a Hodge basis, a term of jump κ is a coefficient of order ≥ κ times a value of order ≥ -κ.
  have h_int (s : ι) : valueAt a (μ s) x ∈ hodgeFil 0 := by
    refine apply_mem_hodgeFil_of_forall_formsOfType (i := i.stepBack a) hx_frac fun κ ν hν D hD _ ↦
      ?_
    have h_coeff : D (μ s) ∈ hodgeFil (0 + κ) :=
      hD (μ s) 0 fun t ↦ by rw [hμ]; exact algebraMap_mem_hodgeFil_zero
    have h_val : ν ((φ ^ a)⁻¹ • x) ∈ hodgeFil (-κ) := valueAt_mem_of_hodgeFil_le _ hx hν
      fun v _ hv ↦ hodgeFil_anti (by simpa [stdOrders, hla.not_gt] using hv)
    simpa using mul_mem_hodgeFil h_coeff h_val
  -- So φ^{-a}(`coord s`) is φ^{-a}(φ^a(E) r) times an integral element; it lies in `hodgeFil 1`,
  -- which means divisibility by φ^a(E).
  have h_dvd (s : ι) : ∃ w : Ainf, coord s = (k.frobE a).val * w := by
    have h_eq : phiInvToBdR a (coord s) = phiInvToBdR a (k.frobE a * r) * valueAt a (μ s) x := by
      simpa [valueAt, hμ, smul_smul, Finsupp.single_apply] using
        congrArg (valueAt a (μ s)) h_coord
    have hE : phiInvToBdR a (k.frobE a * r) ∈ hodgeFil 1 :=
      phiInvToBdR_mem_hodgeFil_one_iff.2 ⟨r, rfl⟩
    exact phiInvToBdR_mem_hodgeFil_one_iff.1 (by simpa [h_eq] using mul_mem_hodgeFil hE (h_int s))
  choose w hw using h_dvd
  -- cancel φ^a(E) in `h_coord`
  exact h_mem.2 ⟨w, by simpa [hw, mul_smul, ← Finset.smul_sum] using h_coord⟩

/-- Let `x` have the standard exponents `stdOrders l` at the letter `i`, a unit of the field with
`p ^ k.f` elements. Then some power of `φ^l(τ)` multiplies `x` into `L.ainfLattice`, the
`A_inf`-span of `1 ⊗ L`. Here `τ = [ε^(1/p)] - 1`. -/
lemma mem_saturateBy_powers_of_mem_withOrders (hx : x ∈ L.withOrders i (stdOrders l)) :
    x ∈ saturateBy (Submonoid.powers (φ ^ l • tau)) L.ainfLattice := by
  -- Induct on the number of factors φ^a(E) that bring x into `L.kisinAinf`.
  have hx_loc : x ∈ L.kisinLocAinf := withOrders_le_kisinLocAinf hx
  revert hx
  refine saturateBy_induction hx_loc ?_ fun a y ih hy ↦ ?_
  · -- No factor: τⁿ x lies in `L.ainfLattice`, and τ divides φ^l(τ).
    rintro x ⟨⟨r, ⟨n, rfl⟩, hn⟩, -⟩ -
    refine mem_saturateBy_of_smul (pow_dvd_pow_of_dvd ?_ n) ⟨n, rfl⟩ (mem_saturateBy_of_mem hn)
    simp [phi_pow_smul, tau, sub_one_dvd_pow_sub_one]
  · -- One more factor: by induction, some power r of φ^l(τ) has r φ^a(E) y in `L.ainfLattice`.
    obtain ⟨r, hr, hry⟩ := ih (smul_mem _ _ hy)
    obtain h_lt | h_ge := lt_or_ge a l
    · -- For a < l, φ^a(E) divides φ^l(τ).
      exact mem_saturateBy_of_smul (frobE_dvd_phi_pow_tau h_lt) (by simp) ⟨r, hr, hry⟩
    · exact ⟨r, hr, smul_mem_ainfLattice_of_frobE_smul_mem hy h_ge hry⟩

/-- An element `x` has the standard exponents `stdOrders l` at the letter `i` if and only if it lies
in `L.letterPart i`, where `ζ` acts by the Teichmüller lift of `i`, and in `L.frobKisinAinf l`, the
image under `φ ^ l` of `L.kisinAinf`. -/
lemma mem_withOrders_stdOrders_iff :
    x ∈ L.withOrders i (stdOrders l) ↔ x ∈ L.frobKisinAinf l ∧ x ∈ L.letterPart i := by
  -- Write the element as φ^l x so the right side becomes `x ∈ L.kisinAinf` and `i.stepBack l`.
  obtain ⟨x, rfl⟩ := MulAction.surjective (φ ^ l) x
  suffices φ ^ l • x ∈ L.withOrders i (stdOrders l) ↔
      x ∈ L.kisinAinf ∧ x ∈ L.letterPart (i.stepBack l) by
    simpa [frobKisinAinf, phi_pow_smul_mem_letterPart_iff]
  refine ⟨fun hx ↦ ⟨⟨?_, fun n μ hμ ↦ ?_⟩,
      phi_pow_smul_mem_letterPart_iff.1 (withOrders_le_letterPart hx)⟩,
    fun ⟨hx_kisin, hx_letter⟩ ↦ ?_⟩
  · -- Forward, denominator: apply φ^{-l} to φ^l(τ)ⁿ φ^l x ∈ `L.ainfLattice`.
    obtain ⟨_, ⟨n, rfl⟩, hn⟩ := mem_saturateBy_powers_of_mem_withOrders hx
    exact ⟨tau ^ n, ⟨n, rfl⟩,
      by simpa [frobGroup_smul_smul] using smul_mem_ainfLattice (φ ^ l)⁻¹ hn⟩
  · -- Forward, integrality: φ^{n+1} φ^l x has orders 0 at level l.
    have h_shift : φ ^ (n + 1) • φ ^ l • x ∈
        L.withOrders ((k.letterFrob ^ (n + 1)) i) (shiftedOrders (n + 1) 0 (stdOrders l)) :=
      phi_pow_smul_mem_withOrders (by simpa using hx)
    have h_int : valueAt l μ (φ ^ (n + 1) • φ ^ l • x) ∈ hodgeFil 0 := by
      refine apply_mem_hodgeFil_of_forall_formsOfType
        (i := ((k.letterFrob ^ (n + 1)) i).stepBack l)
        (smul_mem_fracSpan _ (kisinLocAinf_le_fracSpan (withOrders_le_kisinLocAinf h_shift)))
        fun κ ν hν D _ hD ↦ ?_
      simpa [valueAt] using mul_mem_hodgeFil
        (mem_hodgeFil_zero_and_mem_valueField_zero_of_fixed fun g ↦ hD μ μ g fun t ↦ hμ t g).1
        (valueAt_mem_of_hodgeFil_le _ h_shift hν (by grind [hodgeFil_anti.imp]))
    simpa [valueAt, smul_smul, pow_mul_comm] using h_int
  · -- Conversely, x has exponents -u since τⁿ x ∈ `L.ainfLattice` and τ is prime to φ^a(E).
    refine phi_pow_smul_mem_withOrders (c := fun _ u ↦ -u)
      ⟨⟨mem_saturateBy_of_mem hx_kisin, hx_letter⟩, fun a u _ μ hμ ↦ ?_⟩
    obtain ⟨_, ⟨n, rfl⟩, hn⟩ := hx_kisin.1
    refine (mul_mem_hodgeFil_iff_of_not_frobE_dvd
      (fun h_dvd ↦ not_frobE_dvd_zTau a (h_dvd.mul_right _)) n).1 ?_
    simpa using valueAt_mem_hodgeFil_of_mem_ainfLattice hμ hn (smul_mem _ _ hx_letter)

/-- If an element `x` lies in `L.stdOrdersPart l i`, that is, in `L.kisinLoc` with the standard
exponents `stdOrders l` at the letter `i`, then it lies in the letter `i` and in
`L.frobKisinAinf l`, the image of `L.kisinAinf` under `φ ^ l`, and all forms take values in the
field `valueField 0` on it. -/
lemma mem_valueFieldPoints_and_letterPart_of_mem_stdOrdersPart (hx : x ∈ L.stdOrdersPart l i) :
    x ∈ L.valueFieldPoints (L.frobKisinAinf l) ∧ x ∈ L.letterPart i := by
  obtain ⟨⟨_, h_value⟩, h_std⟩ := hx
  obtain ⟨h_frob, h_letter⟩ := mem_withOrders_stdOrders_iff.1 h_std
  exact ⟨⟨h_frob, h_value⟩, h_letter⟩

/-- The projection to the letter `i` of an element of `L.frobKisinAinf l` has the standard
exponents `stdOrders l` at `i`. -/
lemma letterProj_mem_withOrders (hx : x ∈ L.frobKisinAinf l) :
    L.letterProj i x ∈ L.withOrders i (stdOrders l) := by
  -- `letterProj i x` is a multiple of a sum of powers of `letterOp i` applied to `x`, and ζ
  -- preserves `frobKisinAinf l`
  have h_iter (n : ℕ) : L.mulZeta.wittMap^[n] x ∈ L.frobKisinAinf l :=
    MapsTo.iterate (fun _ ↦ mulZeta.wittMap_mem_frobKisinAinf) n hx
  refine mem_withOrders_stdOrders_iff.2 ⟨?_, letterProj_mem_letterPart⟩
  simp [letterProj, letterOp, smul_pow, pow_apply_eq_iterate, sum_mem, smul_of_tower_mem,
    smul_of_tower_mem _ _ (h_iter _)]

/-- Let `x` lie in `L.frobKisinAinf l`, and let all forms take values in the subfield
`valueField 0` of `B_dR` on `x` (this is membership in `L.valueFieldPoints _`). Then the projection
of `x` to the letter `i` lies in `L.stdOrdersPart l i`: it lies in `L.kisinLoc` and has the
standard exponents `stdOrders l` at `i`. -/
lemma letterProj_mem_stdOrdersPart (hx : x ∈ L.valueFieldPoints (L.frobKisinAinf l)) :
    L.letterProj i x ∈ L.stdOrdersPart l i := by
  obtain ⟨hx_mem, hx_value⟩ := hx
  have h_std : L.letterProj i x ∈ L.withOrders i (stdOrders l) :=
    letterProj_mem_withOrders hx_mem
  exact ⟨⟨withOrders_le_kisinLocAinf h_std,
    fun μ hμ ↦ hx_value _ (comp_letterProj_mem_forms hμ)⟩, h_std⟩

end StandardExponents

/-! ### Exponents add -/

/-- Let `b : A × L → C` be an equivariant bilinear map of lattices, `y` any element of `W(C^♭) ⊗ A`,
and `x` an element of `W(C^♭) ⊗ L` that a non-zero element of `A_inf` multiplies into the span of
`1 ⊗ L`. A form is an `A_inf`-linear functional to `B_dR` that is `Γ'`-equivariant on the lattice;
it has type `κ` at the letter `j` if it sends the projection of the lattice to `j` into
`t^(-κ) B_dR⁺`. Let `η` be a form on `C`, `n` an integer and `m` in `FrobGroup Γ = ℤ × Γ`. Then
`η (m • b(y, x))` lies in `hodgeFil n = tⁿ B_dR⁺` if the products `σ (m • y) * ν (m • x)` do, for
every integer `κ`, every form `ν` on `L` of type `κ` at `j`, and every form `σ` on `A` that has type
`u - κ` at `j` in case `η` has type `u` at `j`. -/
lemma apply_smul_wittPairing_mem_hodgeFil {n : ℤ} {x : L.Ambient}
    {b : A.Carrier →ₗ[O] L.Carrier →ₗ[O] C.Carrier} {y : A.Ambient}
    (hb : IsEquivariantPairing b) {η : C.Functional}
    (hη : η ∈ C.forms) (hx : x ∈ L.fracSpan) (m : FrobGroup Γ) (j : k.Letter) (u : ℤ)
    (h_terms : ∀ κ : ℤ, ∀ ν ∈ L.formsOfType j κ, ∀ σ ∈ A.forms,
      (η ∈ C.formsOfType j u → σ ∈ A.formsOfType j (u - κ)) →
      σ (m • y) * ν (m • x) ∈ hodgeFil n) :
    η (m • wittPairing b y x) ∈ hodgeFil n := by
  -- Expand the second variable in a Hodge basis of `L`; a coefficient map `D` of the expansion
  -- gives the form `σ = D ∘ β` on `A`, where `β y x = η (b(y, x))`.
  have h_smul : wittPairing b (m • y) (m • x) = m • wittPairing b y x :=
    baseChangePairing_map _ (hb (FrobGroup.snd m)) y x (smul_mul' m)
  rw [← h_smul]
  let β : A.Ambient →ₗ[Ainf] L.Functional :=
    ((wittPairing b).restrictScalars₁₂ Ainf Ainf).compr₂ η
  refine apply_mem_hodgeFil_of_forall_formsOfType (i := j) (μ := β (m • y)) (smul_mem_fracSpan m hx)
    ?_
  intro κ ν hν D (h_fil : ShiftsHodgeFil D κ) (h_inv : RespectsGaloisAction D)
  let σ : A.Functional := D.restrictScalars Ainf ∘ₗ β
  have hσ : σ ∈ A.forms := by
    intro t g
    -- `b` and `η` are equivariant, so `β (1 ⊗ g t) (1 ⊗ g t') = g • β (1 ⊗ t) (1 ⊗ t')`
    have hβ (t' : L.Carrier) : β (.mk 1 (A.ρ g t)) (.mk 1 (L.ρ g t')) =
        toGp g.val • β (.mk 1 t) (.mk 1 t') := by
      simpa [β, hb g t t'] using hη (b t t') g
    exact h_inv (β (.mk 1 t)) (β (.mk 1 (A.ρ g t))) g hβ
  have hσ_type (hu : η ∈ C.formsOfType j u) : σ ∈ A.formsOfType j (u - κ) := by
    refine ⟨hσ, fun t ↦ ?_⟩
    -- `β (e_j (1 ⊗ t)) (1 ⊗ t') = η (e_j (1 ⊗ b (t, t')))`, and `η` has type `u`
    have hβ (t' : Rep.of (overZp L.ρ)) :
        β (A.letterProj j (.mk 1 t)) (.mk 1 t') ∈ hodgeFil (-u) := by
      simpa [β, wittPairing_letterProj_left] using hu.2 (b t t')
    exact hodgeFil_anti (by omega) (h_fil (β (A.letterProj j (.mk 1 t))) (-u) hβ)
  exact h_terms κ ν hν σ hσ hσ_type

/-- The extension `wittPairing b` of a bilinear map `b` of lattices maps
`A.ainfLattice × L.ainfLattice` into `C.ainfLattice`. -/
lemma wittPairing_mem_ainfLattice {x : L.Ambient}
    {b : A.Carrier →ₗ[O] L.Carrier →ₗ[O] C.Carrier} {y : A.Ambient}
    (hy : y ∈ A.ainfLattice) (hx : x ∈ L.ainfLattice) :
    wittPairing b y x ∈ C.ainfLattice :=
  LinearMap.BilinMap.apply_apply_mem_of_mem_span C.ainfLattice _ _
    ((wittPairing b).restrictScalars₁₂ Ainf Ainf) (by simp [mk_one_mem_ainfLattice]) y x hy hx

/-- The extension of an equivariant bilinear map `b` of lattices maps `A.kisinAinf × L.kisinAinf`
into `C.kisinAinf`. -/
lemma wittPairing_mem_kisinAinf {x : L.Ambient}
    {b : A.Carrier →ₗ[O] L.Carrier →ₗ[O] C.Carrier} {y : A.Ambient}
    (hb : IsEquivariantPairing b) (hy : y ∈ A.kisinAinf) (hx : x ∈ L.kisinAinf) :
    wittPairing b y x ∈ C.kisinAinf := by
  have hx_frac : x ∈ L.fracSpan := kisinAinf_le_fracSpan hx
  obtain ⟨hy_sat, hy_int⟩ := hy
  obtain ⟨hx_sat, hx_int⟩ := hx
  have h_sat : wittPairing b y x ∈ saturateBy (Submonoid.powers tau) C.ainfLattice :=
    wittPairing_mem_saturateBy hy_sat hx_sat wittPairing_mem_ainfLattice
  refine ⟨h_sat, fun n μ hμ ↦ ?_⟩
  show μ (φ ^ (n + 1) • wittPairing b y x) ∈ hodgeFil 0
  -- Products of values of forms are integral; letter and type play no role, any choice will do.
  refine apply_smul_wittPairing_mem_hodgeFil hb hμ hx_frac (φ ^ (n + 1))
    (Classical.arbitrary Letter) 0 fun κ ν hν σ hσ _ ↦ ?_
  simpa using mul_mem_hodgeFil (hy_int n σ hσ) (hx_int n ν hν.1)

/-- Let `b : A × L → C` be an `O`-bilinear equivariant map of crystalline lattices and
`wittPairing b` its `W(C^♭)`-bilinear extension. An element `x` of `L.kisinLocAinf` in the
eigenspace of the letter `i` has exponents `c` if `μ (φ^(-a) x) ∈ t^(c a u) B_dR⁺` for all levels
`a` and all forms `μ` of a type `u ∈ L.jumpSet j` at `j = i.stepBack a`, the letter whose `p^a`-th
power is `i`. If `y`, `x` have exponents `c'`, `c` at `i`, then `wittPairing b y x` has exponents
`c''` at `i`, provided `c'' a v ≤ c a u' + c' a u` for all `a` and all `u ∈ A.jumpSet j`,
`u' ∈ L.jumpSet j`, `v ∈ C.jumpSet j` with `u + u' ≤ v`. -/
lemma wittPairing_mem_withOrders {i : k.Letter} {c : ℕ → ℤ → ℤ} {x : L.Ambient}
    {b : A.Carrier →ₗ[O] L.Carrier →ₗ[O] C.Carrier} {y : A.Ambient} (hb : IsEquivariantPairing b)
    {c' c'' : ℕ → ℤ → ℤ} (hy : y ∈ A.withOrders i c') (hx : x ∈ L.withOrders i c)
    (h_exps : ∀ a : ℕ, ∀ u ∈ A.jumpSet (i.stepBack a), ∀ u' ∈ L.jumpSet (i.stepBack a),
      ∀ v ∈ C.jumpSet (i.stepBack a), u + u' ≤ v → c'' a v ≤ c a u' + c' a u) :
    wittPairing b y x ∈ C.withOrders i c'' := by
  have h_loc : wittPairing b y x ∈ C.kisinLocAinf :=
    wittPairing_mem_saturateBy (withOrders_le_kisinLocAinf hy) (withOrders_le_kisinLocAinf hx)
      (wittPairing_mem_kisinAinf hb)
  have h_letter : wittPairing b y x ∈ C.letterPart i := by
    rw [mem_letterPart_iff_letterProj, ← wittPairing_letterProj_left,
      mem_letterPart_iff_letterProj.1 (withOrders_le_letterPart hy)]
  refine ⟨⟨h_loc, h_letter⟩, fun a u hu μ hμ ↦ ?_⟩
  -- It suffices to bound products of values of forms whose types add up to `u`.
  refine apply_smul_wittPairing_mem_hodgeFil hb hμ.1
    (kisinLocAinf_le_fracSpan (withOrders_le_kisinLocAinf hx)) (φ ^ a)⁻¹
    (i.stepBack a) u fun κ ν (hν : ν ∈ L.formsOfType (i.stepBack a) κ) σ _ hσ_of ↦ ?_
  have hσ : σ ∈ A.formsOfType (i.stepBack a) (u - κ) := hσ_of hμ
  change valueAt a σ y * valueAt a ν x ∈ hodgeFil (c'' a u)
  -- `valueAt_mem_of_hodgeFil_le` replaces the first factor by any `z` of order `c' a w` with
  -- `w ≤ u - κ`, then the second by any `z'` of order `c a v` with `v ≤ κ`.
  have h_right (w : ℤ) (hw : w ∈ A.jumpSet (i.stepBack a)) (hw_le : w ≤ u - κ) (z : BdR)
      (hz : z ∈ hodgeFil (c' a w)) : z * valueAt a ν x ∈ hodgeFil (c'' a u) := by
    refine valueAt_mem_of_hodgeFil_le ((hodgeFil (c'' a u)).comap (.mulLeft BdRPlus z)) hx hν
      fun v hv hv_le z' hz' ↦ ?_
    have h_exp : c'' a u ≤ c a v + c' a w := h_exps a w hw v hv u hu (by omega)
    exact hodgeFil_anti (by omega) (mul_mem_hodgeFil hz hz')
  exact valueAt_mem_of_hodgeFil_le
    ((hodgeFil (c'' a u)).comap (.mulRight BdRPlus (valueAt a ν x))) hy hσ h_right

end HodgeExpansion

/-!
## The length of one step on one line of exponents

`New.Lift.KummerChart.JumpLattice.withOrders l o` is the module of elements at the letter `l`
with exponent at least `o a v` at every level `a` on every line `v`.
-/

section OneStepGain

open Period Submodule FrobGroup Module Finset IsDiscreteValuationRing Algebra

variable {p : ℕ} [ThePrime p] [Γ : GroupOverGp p]
  {k : KummerChart Γ} {O : Coeffs} {L : JumpLattice O}

/-- The system of exponents obtained from `o` by raising the single value `o a u` by 1. -/
@[grind]
def raiseOrder (o : ℕ → ℤ → ℤ) (a : ℕ) (u : ℤ) (b : ℕ) (v : ℤ) : ℤ :=
  o b v + if b = a ∧ v = u then 1 else 0

/-- The system of exponents obtained from `o` by raising all values `o a v` at level `a` by 1. -/
@[grind]
def raiseOrdersAt (o : ℕ → ℤ → ℤ) (a : ℕ) (b : ℕ) (v : ℤ) : ℤ :=
  o b v + if b = a then 1 else 0

omit [GroupOverGp p] in
/-- Let `t` be an `N × r` matrix over `B_dR⁺`. There are `d ≤ r` rows `s i` such that, modulo the
kernel of `θ : B_dR⁺ → ℂ_p`, every row of `t` is an `A_inf`-combination of the rows `s i`. -/
lemma exists_thetaBdR_sub_sum_smul_eq_zero {N r : ℕ} (t : Fin N → Fin r → BdRPlus) :
    ∃ d ≤ r, ∃ (s : Fin d → Fin N) (A : Fin N → Fin d → Ainf),
      ∀ (j : Fin N) (m : Fin r), thetaBdR (t j m - ∑ i : Fin d, A j i • t (s i) m) = 0 := by
  -- Auerbach's lemma for the column space `U` of the matrix `θ(t)`: a basis `z` with integral
  -- entries, whose coordinates are the entries at the rows `s i`
  let U : Submodule ℂ_[p] (Fin N → ℂ_[p]) := (Matrix.of fun j m ↦ thetaBdR (t j m)).toLin'.range
  let d : ℕ := finrank ℂ_[p] U
  let entry (j : Fin N) : Dual ℂ_[p] U := .proj j ∘ₗ U.subtype
  obtain ⟨s, z, h_coord, h_int⟩ : ∃ (s : Fin d → Fin N) (z : Basis (Fin d) ℂ_[p] U),
      (∀ i, z.coord i = entry (s i)) ∧ ∀ (j : Fin N) (i : Fin d), ‖(z i).val j‖ ≤ 1 :=
    exists_auerbach (finBasis ℂ_[p] U) entry (fun _ hv ↦ Subtype.ext (funext hv)) (RingHom.id ℂ_[p])
      fun _ ↦ continuous_of_discreteTopology
  have h_lift (j : Fin N) (i : Fin d) : ∃ a : Ainf, (theta a : ℂ_[p]) = (z i).val j :=
    (theta_surjective ⟨(z i).val j, by simpa using h_int j i⟩).imp fun a ha ↦ by rw [ha]
  choose A hA using h_lift
  have h_rank : finrank ℂ_[p] U ≤ r := by grw [LinearMap.finrank_range_le, finrank_fin_fun]
  refine ⟨d, h_rank, s, A, fun j m ↦ ?_⟩
  -- expand column `m` in the basis `z` and read the entry in row `j`
  let col : U := ⟨fun i ↦ thetaBdR (t i m), Pi.single m 1, by ext; simp⟩
  have h_expand : col.val j = (∑ i, z.repr col i • z i : U).val j := by rw [z.sum_repr]
  simpa [smul_def', ← z.coord_apply, mul_comm, h_coord, entry, hA, sub_eq_zero, col] using h_expand

/-- Let `o` be a system of exponents. Let `i = l.stepBack b` and assume `o b u < o b v` for all
`v < u` in `L.jumpSet i`. Among points `x j` with exponents `o` at `l` there are `d` points
`x (s m)`, with `d` at most the multiplicity `L.jumpMultiplicity i u` of the jump `u` at `i`. Every
`x j` is an `A_inf`-combination of them modulo an element with exponents `raiseOrder o b u`. -/
lemma exists_sub_sum_smul_mem_withOrders_raiseOrder (o : ℕ → ℤ → ℤ) {u : ℤ} {b N : ℕ} {l : k.Letter}
    (h_lt_lower : ∀ v ∈ L.jumpSet (l.stepBack b), v < u → o b u < o b v) (x : Fin N → L.Ambient)
    (hx : ∀ j : Fin N, x j ∈ L.withOrders l o) :
    ∃ d ≤ L.jumpMultiplicity (l.stepBack b) u, ∃ (s : Fin d → Fin N) (A : Fin N → Fin d → Ainf),
      ∀ j : Fin N, x j - ∑ m : Fin d, A j m • x (s m) ∈
        L.withOrders l (raiseOrder o b u) := by
  -- Modulo type `u - 1` the forms of type `u` are spanned by forms `ν m`. The leading terms of
  -- their values at all `x j` are integral combinations of those at a few points `x (s m)`.
  obtain ⟨r, hr, ν, h_red⟩ := exists_span_formsOfType_mod_pred (L := L) (l.stepBack b) u
  have h_jump_le : ∀ v ∈ L.jumpSet (l.stepBack b), v ≤ u → hodgeFil (o b v) ≤ hodgeFil (o b u) := by
    grind [hodgeFil_anti.imp]
  have h_lead (j : Fin N) (m : Fin r) :
      ∃ t : BdRPlus, algebraMap BdRPlus BdR t * (tUnit ^ o b u).val = valueAt b (ν m).val (x j) :=
    mem_hodgeFil.1 (valueAt_mem_of_hodgeFil_le _ (hx j) (ν m).property h_jump_le)
  choose t ht using h_lead
  obtain ⟨d, hd, s, A, (h_theta : ∀ j m, thetaBdR (t j m - ∑ i, A j i • t (s i) m) = 0)⟩ :=
    exists_thetaBdR_sub_sum_smul_eq_zero t
  refine ⟨d, hd.trans hr, s, fun j m ↦ φ ^ b • A j m, fun j ↦ ?_⟩
  let x' : L.Ambient := x j - ∑ m : Fin d, (φ ^ b • A j m) • x (s m)
  have hx' : x' ∈ L.withOrders l o := sub_mem (hx j) (sum_smul_mem _ _ fun m _ ↦ hx (s m))
  refine mem_withOrders_of_mem_hodgeFil hx' fun a v _ h_lt μ hμ ↦ ?_
  obtain ⟨rfl, rfl⟩ : b = a ∧ u = v := by simpa [raiseOrder, eq_comm] using h_lt.ne
  rw [show raiseOrder o b u b u = 1 + o b u by simp [raiseOrder, add_comm]]
  -- the leading terms of the `ν m` cancel on `x'`
  have h_coeff (a : Ainf) (y : BdR) : phiInvToBdR b (φ ^ b • a) * y = a • y := by
    simp [phiInvToBdR, Algebra.smul_def]
  have h_gen (m : Fin r) : valueAt b (ν m).val x' ∈ hodgeFil (1 + o b u) := by
    have h_eq : valueAt b (ν m).val x' = algebraMap BdRPlus BdR
        (t j m - ∑ i : Fin d, A j i • t (s i) m) * (tUnit ^ o b u).val := by
      simp [x', ← ht, algebraMap.smul, sub_mul, sum_mul, h_coeff, -Units.val_zpow_eq_zpow_val]
    rw [h_eq]
    exact mul_mem_hodgeFil (algebraMap_mem_hodgeFil_one_iff.2 (h_theta j m)) (subset_span rfl)
  -- forms of type `u - 1` have larger exponents, so the `ν m` suffice
  obtain ⟨κ, hκ⟩ : ∃ κ : Fin r → PadicAlgCl p,
      μ - ∑ m : Fin r, κ m • (ν m).val ∈ L.formsOfType (l.stepBack b) (u - 1) := h_red μ hμ
  have h_lower : ∀ v ∈ L.jumpSet (l.stepBack b), v ≤ u - 1 →
      hodgeFil (o b v) ≤ hodgeFil (1 + o b u) := by
    grind [hodgeFil_anti.imp]
  have h_rest : valueAt b μ x' - ∑ m : Fin r, κ m • valueAt b (ν m).val x' ∈
      hodgeFil (1 + o b u) := by
    simpa [valueAt] using valueAt_mem_of_hodgeFil_le _ hx' hκ h_lower
  have h_sum : ∑ m : Fin r, κ m • valueAt b (ν m).val x' ∈ hodgeFil (1 + o b u) :=
    sum_mem fun m _ ↦ smul_of_tower_mem _ (κ m) (h_gen m)
  exact (sub_mem_iff_left _ h_sum).1 h_rest

/-- Let `WittFq k.f = W(𝔽_q)`, `q = p ^ k.f`, be the ring of constants of the chart `k`; it has rank
`k.f` over `ℤ_p`. For `d ≤ n`, any `k.f * n + 1` vectors in `W(𝔽_q)^d` satisfy a `ℤ_p`-linear
relation in which one coefficient is `1`. -/
lemma exists_eq_one_and_sum_smul_eq_zero {d n : ℕ} (hd : d ≤ n)
    (w : Fin (k.f * n + 1) → Fin d → WittFq k.f) :
    ∃ (c : Fin (k.f * n + 1) → ℤ_[p]) (j₀ : Fin (k.f * n + 1)),
      c j₀ = 1 ∧ ∀ m : Fin d, ∑ j : Fin (k.f * n + 1), c j • w j m = 0 := by
  have h_dep : ¬LinearIndependent ℤ_[p] w := fun h_indep ↦ by
    have h_card : k.f * n + 1 ≤ d * k.f := by
      simpa [finrank_wittFq, finrank_pi_fintype] using h_indep.fintype_card_le_finrank
    nlinarith
  obtain ⟨a, h_rel, j₁, hj₁⟩ := Fintype.not_linearIndependent_iff.1 h_dep
  -- divide the relation by its coefficient `a j₀` of least valuation
  obtain ⟨j₀, h_dvd⟩ : ∃ j₀, ∀ j, ∃ c : ℤ_[p], a j = a j₀ * c := by
    simpa [addVal_le_iff_dvd, dvd_def] using Finite.exists_min (addVal ℤ_[p] ∘ a)
  choose c hc using h_dvd
  have ha₀ : a j₀ ≠ 0 := fun h_zero ↦ hj₁ (by rw [hc j₁, h_zero, zero_mul])
  refine ⟨c, j₀, by simpa [ha₀] using hc j₀, fun m ↦ ?_⟩
  have h_smul : a j₀ • ∑ j, c j • w j m = 0 := by
    simpa [smul_sum, ← mul_smul, ← hc] using congrFun h_rel m
  simpa [ha₀] using h_smul

/-- If the Kummer chart `k` is unramified (`h_unram`), every `r` in `k.S` is congruent modulo `k.E`
to a constant: there are `w` in `WittFq k.f` and `y` in `k.S` with `r - w • 1 = k.E * y`. -/
lemma exists_sub_smul_one_eq_E_mul (h_unram : k.IsUnramified) (r : k.S) :
    ∃ (w : WittFq k.f) (y : k.S), r - w • 1 = k.E * y := by
  obtain ⟨-, h_e, -⟩ := h_unram
  obtain ⟨w, y, hy⟩ : ∃ w : Fin 1 → WittFq k.f, k.frobE 0 ∣ r - ∑ i, w i • k.z ^ i.val :=
    k.exists_dvd_sub_sum_z_pow 0 (by simp [h_e]) r
  exact ⟨w 0, y, by simpa [Chart.frobE] using hy⟩

/-- Let `L` be a lattice over an unramified Kummer chart `k` with constants `W(𝔽_q)`, `q = p ^ k.f`.
Let `i = l.stepBack b` have at most `n` Hodge–Tate jumps equal to `u`, counted with multiplicity,
and let `o b u < o b v` for all `v < u` in `L.jumpSet i`, the finite set that contains the jumps at
`i`. Among `k.f * n + 1` points of `L.kisinLoc` (the Kisin module with all `φ^a E` inverted) with
exponents `o` at `l`, some combination over `ℤ_p` with one coefficient equal to `1` is the sum of
two points of `L.kisinLoc`: one with all exponents `o 0 v` at level `0` raised by one
(`raiseOrdersAt o 0`), and one with `o b u` raised by one (`raiseOrder o b u`). -/
lemma exists_sum_smul_mem_locKisinPart_sup (o : ℕ → ℤ → ℤ) (h_unram : k.IsUnramified) {u : ℤ}
    {n : ℕ} (b : ℕ) (l : k.Letter) (hn : L.jumpMultiplicity (l.stepBack b) u ≤ n)
    (h_lt_lower : ∀ v ∈ L.jumpSet (l.stepBack b), v < u → o b u < o b v)
    (x : Fin (k.f * n + 1) → L.kisinLoc)
    (hx : ∀ j : Fin (k.f * n + 1), (x j : L.Ambient) ∈ L.withOrders l o) :
    ∃ (c : Fin (k.f * n + 1) → ℤ_[p]) (j₀ : Fin (k.f * n + 1)),
      -- (a) the combination is primitive: one coefficient is `1`
      c j₀ = 1 ∧
      -- (b) it gains a step, partly on all lines at level `0`, partly on line `u` at level `b`
      ∑ j : Fin (k.f * n + 1), c j • x j ∈
        locKisinPart (L.withOrders l (raiseOrdersAt o 0)) ⊔
          locKisinPart (L.withOrders l (raiseOrder o b u)) := by
  -- Up to a raised exponent, each `x j` is a combination of `d ≤ n` points `x (s m)`. Modulo `E`
  -- the coefficients lie in `WittFq k.f`, of rank `f` over `ℤ_p`, so the `f n + 1` coefficient
  -- vectors satisfy a relation, which gives `c`.
  obtain ⟨d, hd, s, A, (h_up : ∀ j : Fin (k.f * n + 1),
      (x j : L.Ambient) - ∑ m : Fin d, A j m • (x (s m) : L.Ambient) ∈
        L.withOrders l (raiseOrder o b u))⟩ :=
    exists_sub_sum_smul_mem_withOrders_raiseOrder o h_lt_lower (fun j ↦ x j) hx
  -- division of the coefficients by `E`, with remainders `w j m`
  have h_rem (j : Fin (k.f * n + 1)) (m : Fin d) :
      ∃ (w : WittFq k.f) (y : k.S), k.coord₀ (A j m) - w • 1 = k.E * y :=
    exists_sub_smul_one_eq_E_mul h_unram (k.coord₀ (A j m))
  choose w y hw using h_rem
  obtain ⟨c, j₀, hc_one, (hc_rel : ∀ m : Fin d, ∑ j, c j • w j m = 0)⟩ :=
    exists_eq_one_and_sum_smul_eq_zero (hd.trans hn) w
  refine ⟨c, j₀, hc_one, ?_⟩
  have h_comb (a : Fin d → Ainf) : ∑ m, a m • (x (s m) : L.Ambient) ∈ L.withOrders l o :=
    sum_smul_mem _ a fun m _ ↦ hx (s m)
  let point (j : Fin (k.f * n + 1)) : L.kisinLocAinf :=
    ⟨x j, withOrders_le_kisinLocAinf (hx j)⟩
  let comb (a : Fin d → Ainf) : L.kisinLocAinf :=
    ⟨∑ m, a m • x (s m), withOrders_le_kisinLocAinf (h_comb a)⟩
  have h_point (j : Fin (k.f * n + 1)) : coordRetract (point j) = x j := by
    ext; simp [point, coordRetract_of_mem_kisinLoc]
  have h_ret (a : Fin d → Ainf) : coordRetract (comb a) = ∑ m, k.coord₀ (a m) • x (s m) :=
    Subtype.ext (by simpa using coordRetract_sum (fun m ↦ (x (s m)).property) rfl)
  -- `x j` is `E • ∑ m, y j m • x (s m)`, plus the image under `coordRetract` of the element of
  -- `h_up`, plus `∑ m, w j m • x (s m)`; the last terms cancel in the combination by `hc_rel`
  have h_term (j : Fin (k.f * n + 1)) :
      k.E • ∑ m, y j m • x (s m) + coordRetract (point j - comb (A j)) =
        x j - ∑ m, (w j m • (1 : k.S)) • x (s m) := by
    simp only [map_sub, h_point, h_ret, smul_sum, smul_smul, ← hw, sub_smul, sum_sub_distrib]
    abel
  have h_cancel : ∑ j, c j • ∑ m, (w j m • (1 : k.S)) • x (s m) = 0 := by
    calc
      _ = ∑ m, ((∑ j, c j • w j m) • (1 : k.S)) • x (s m) := by
        simp only [smul_sum, sum_smul, ← smul_assoc]
        exact sum_comm
      _ = 0 := by simp [hc_rel]
  have h_sum : ∑ j, c j • x j =
      ∑ j, c j • (k.E • ∑ m, y j m • x (s m) + coordRetract (point j - comb (A j))) := by
    simp only [h_term, smul_sub, sum_sub_distrib, h_cancel, sub_zero]
  rw [h_sum]
  refine sum_smul_mem _ c fun j _ ↦
    add_mem_sup ?_ (coordRetract_mem_withOrders (point j - comb (A j)) (h_up j))
  -- multiplication by `E` raises all exponents at level `0`
  have h_E : k.frobEUnit 0 ^ (1 : ℤ) • ∑ m, (y j m : Ainf) • (x (s m) : L.Ambient) ∈
      L.withOrders l (raiseOrdersAt o 0) :=
    frobEUnit_zpow_smul_mem_withOrders 0 1 (h_comb _) fun a v _ ↦ by simp [raiseOrdersAt, eq_comm]
  simpa [smul_eq_val_smul, Chart.frobE] using h_E

end OneStepGain

end New.Lift.KummerChart.JumpLattice

