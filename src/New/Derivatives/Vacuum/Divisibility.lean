/-!
# Integrality of jets of theta products and stability of standard data

This file proves two facts. Let `μ_i` be linear forms that are `d` times integral forms, and let `y`
be the parameter described below. Then the derivatives at `0` of a product of series `θ(μ_i z)`,
times an integral series in the `y(μ_i z)`, are integral.
Standard data of level `δ` are stable under the Heisenberg operators of finite points that `δ`
makes integral above `p`, and under the Weil operators of finite points that are integral above
`p`. An element of `ℂ_[p]` is integral if its norm is at most `1`.

* `New.jet`: the pairing `(Q(∂) F)(0)` of a polynomial `Q` with a power series `F`.
* `New.taylorVia ιₚ C.θ`: the Taylor series at `0` of the function `θ` of the CM lattice `C`, with
  coefficients sent to `ℂ_[p]` by `ιₚ`; and `New.linearSeries c`, the linear form `∑ c_x z_x`.
* `New.CMLattice.multiSeriesRing`: the integral power series in the `y(μ_i z)`, where the parameter
  `y` is the Taylor series of `C.translatedY`.
* `New.Parameters.integralAfter δ S`: the finite adelic vectors `x` with `δ x` integral at the
  places in `S`.
* `New.Parameters.standardData V δ`: the module over `New.embValRing` spanned by the translates of
  the integral vacuum by the points that `δ` makes integral above `p`.

## Main definitions and results

* `New.CMLattice.jetRing`: the ring generated by the integral series in the `y(μ_i z)` and by the
  `θ(μ_i z)` and `(-log θ)'(μ_i z)`.
* `New.Parameters.finHeisenbergOp_mem_standardData`: standard data of level `δ` are stable under the
  Heisenberg operators of finite points that `δ` makes integral above `p`.
* `New.Parameters.omega_mem_standardData`: they are stable under the Weil operators of finite
  points integral above `p`.
-/

@[expose] public section

/-!
## Integrality of the derivatives of products of copies of `θ`

The series of `New.CMLattice.norm_jet_thetaProd_pow_mul_le_one` lies in the ring
`New.CMLattice.jetRing`.
-/

section ProductJetIntegrality

open MvPowerSeries

namespace New

/-- Let `S` be a ring of power series that is preserved by partial derivatives and whose elements
have integral constant terms, and let `φ : R →+* ℂ_[p]` have integral values. Then the jet
`(φ(Q)(∂) F)(0)` is integral for `F` in `S` and every polynomial `Q` over `R`. -/
lemma norm_jet_le_one_of_pderiv_mem {p : ℕ} [Fact p.Prime] {X : Type}
    {S : Subring (MvPowerSeries X ℂ_[p])} (h_const : ∀ F ∈ S, ‖constantCoeff F‖ ≤ 1)
    (h_deriv : ∀ F ∈ S, ∀ x : X, pderiv x F ∈ S)
    {R : Type} [CommRing R] {φ : R →+* ℂ_[p]} (hφ : ∀ a : R, ‖φ a‖ ≤ 1) (Q : MvPolynomial X R)
    {F : MvPowerSeries X ℂ_[p]} (hF : F ∈ S) : ‖jet ℂ_[p] (Q.map φ) F‖ ≤ 1 := by
  induction Q using MvPolynomial.induction_on generalizing F with
  | C a =>
    simpa [← MvPolynomial.monomial_zero', jet_monomial] using
      (mul_le_of_le_one_left (norm_nonneg _) (hφ a)).trans (h_const F hF)
  | add Q Q' hQ hQ' =>
    rw [map_add, map_add, LinearMap.add_apply]
    exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (hQ hF) (hQ' hF))
  | mul_X Q x hQ =>
    rw [map_mul, MvPolynomial.map_X, jet_mul_X]
    exact hQ (h_deriv F hF x)

namespace CMLattice

variable {p : ℕ} [Fact p.Prime] {I X : Type} [Fintype I] [Fintype X]
  {d : ℕ} (C : CMLattice d) [PadicPlace p]

/-- Let `C` be a CM lattice for a prime `d ≡ 7` modulo `8`, with `2`-torsion point `t`, and fix a
`p`-adic place `ιₚ` of `ℂ`. Let `θ` be the twisted translate of the sigma function of `C` by `t`,
normalised to `θ(0) = 1`, and let `g = -log θ` (`negLogTheta`), a power series over `ℂ_[p]`. Let `y`
be the Taylor series at `0`, read in `ℂ_[p]` through `ιₚ`, of the function `C.translatedY`. Then
`d g''` lies in `integralSeriesRing`, the ring of power series in `y` with coefficients of norm at
most `1`. -/
lemma smul_derivative_derivative_negLogTheta_mem [PrimeSevenModEight d] :
    (d : ℂ_[p]) • PowerSeries.derivative (PowerSeries.derivative C.negLogTheta) ∈
      C.integralSeriesRing := by
  -- Multiplication by `√-d` maps the lattice to itself, so `√-d` is integral.
  have h_sqrt : ‖ιₚ (.I * √d)‖ ≤ 1 :=
    C.norm_le_one_of_mapsTo_lattice (C.mul_mem_of_quadInt (I_mul_sqrt_mem_quadInt d))
  have hd : (d : ℂ_[p]) = -ιₚ (.I * √d) * ιₚ (.I * √d) := by
    rw [neg_mul, ← sq, map_I_mul_sqrt_sq, neg_neg]
  have h_const : ‖(d : ℂ_[p]) * (2 * PowerSeries.coeff 2 C.negLogTheta)‖ ≤ 1 := by
    rw [hd, mul_assoc, norm_mul, norm_neg]
    exact (mul_le_of_le_one_left (norm_nonneg _) h_sqrt).trans
      C.norm_sqrt_mul_coeff_two_negLogTheta_le_one
  have h_eq : (d : ℂ_[p]) •
      PowerSeries.derivative (PowerSeries.derivative C.negLogTheta) =
        ((d : ℂ_[p]) * (2 * PowerSeries.coeff 2 C.negLogTheta)) • (1 : PowerSeries ℂ_[p]) +
          (d : ℂ_[p]) • taylorVia ιₚ C.translatedX := by
    simp [derivative_derivative_negLogTheta, PowerSeries.smul_eq_C_mul]
  rw [h_eq]
  exact add_mem (C.isSeriesGenerator_translatedY.smul_mem h_const (one_mem _))
    (C.isSeriesGenerator_translatedY.smul_mem (IsUltrametricDist.norm_natCast_le_one _ d)
      C.taylorVia_translatedX_mem_integralSeriesRing)

/-- For a family of linear forms `μ_i`, the ring generated by `multiSeriesRing`, the integral power
series in the `y(μ_i z)`, and by the `θ(μ_i z)` and `g'(μ_i z)`, where `g = -log θ`. Here `y` is the
Taylor series of `C.translatedY`, the function `(℘'(z + t) - a₁ (℘(z + t) - ℘(t))) / 2` for the
`2`-torsion point `t` of `C` and the square root `a₁` of `12 ℘(t)`. -/
noncomputable def jetRing (μ : I → X → ℂ_[p]) : Subring (MvPowerSeries X ℂ_[p]) :=
  .closure (C.multiSeriesRing μ ∪
    (Set.range fun i : I ↦ (taylorVia ιₚ C.θ).subst (linearSeries (μ i))) ∪
    Set.range fun i : I ↦ (PowerSeries.derivative C.negLogTheta).subst (linearSeries (μ i)))

section Generators

variable {μ : I → X → ℂ_[p]} {F : MvPowerSeries X ℂ_[p]}

/-- The integral series in the `y(μ_i z)` lie in `jetRing`. -/
lemma mem_jetRing_of_mem_multiSeriesRing (hF : F ∈ C.multiSeriesRing μ) : F ∈ C.jetRing μ :=
  Subring.subset_closure (.inl (.inl hF))

/-- The series `θ(μ_i z)` lies in `jetRing`. -/
lemma theta_mem_jetRing (i : I) :
    (taylorVia ιₚ C.θ).subst (linearSeries (μ i)) ∈ C.jetRing μ :=
  Subring.subset_closure (.inl (.inr ⟨i, rfl⟩))

/-- The series `g'(μ_i z)`, where `g = -log θ`, lies in `jetRing`. -/
lemma derivative_negLogTheta_mem_jetRing (i : I) :
    (PowerSeries.derivative C.negLogTheta).subst (linearSeries (μ i)) ∈ C.jetRing μ :=
  Subring.subset_closure (.inr ⟨i, rfl⟩)

/-- The ring `jetRing` is stable under multiplication by integral constants. -/
lemma smul_mem_jetRing {c : ℂ_[p]} (hc : ‖c‖ ≤ 1) (hF : F ∈ C.jetRing μ) :
    c • F ∈ C.jetRing μ := by
  rw [smul_eq_C_mul]
  exact mul_mem (C.mem_jetRing_of_mem_multiSeriesRing (C.C_mem_multiSeriesRing hc)) hF

/-- The product `∏ θ(μ_i z) ^ m i` lies in `jetRing`. -/
lemma thetaProd_mem_jetRing (m : I → ℕ) : C.thetaProd μ m ∈ C.jetRing μ :=
  prod_mem fun i _ ↦ pow_mem (C.theta_mem_jetRing i) (m i)

end Generators

/-- Let `C` be a CM lattice, and let `θ` and `y` be the Taylor series at `0` of `C.θ` and of
`C.translatedY`, read in `ℂ_[p]` through `ιₚ`. Let `μ_i z = ∑ μ i x * z_x` be linear forms, for
`i : I` and `x : X`. The ring `C.jetRing μ` is generated by the integral power series in the
`y(μ_i z)` and by the `θ(μ_i z)` and `(-log θ)'(μ_i z)`. Its elements have constant term of norm at
most `1`, because `y(0) = 0`, `θ(0) = 1` and `(-log θ)'(0) = 0`. -/
lemma norm_constantCoeff_le_of_mem_jetRing {μ : I → X → ℂ_[p]} {F : MvPowerSeries X ℂ_[p]}
    (hF : F ∈ C.jetRing μ) : ‖constantCoeff F‖ ≤ 1 := by
  suffices h_le : C.jetRing μ ≤ (valRingCp p).comap constantCoeff from h_le hF
  rw [jetRing, Subring.closure_le]
  rintro G ((hG | ⟨i, rfl⟩) | ⟨i, rfl⟩)
  · exact C.norm_constantCoeff_le_of_mem_multiSeriesRing hG
  · simp [PowerSeries.constantCoeff_subst_of_constantCoeff_zero, constantCoeff_linearSeries]
  · -- The constant term of `g'` is the coefficient of `z` in `g`, which vanishes.
    simp [PowerSeries.constantCoeff_subst_of_constantCoeff_zero, constantCoeff_linearSeries,
      PowerSeries.coeff_derivative,
      ← PowerSeries.coeff_zero_eq_constantCoeff_apply, coeff_one_negLogTheta]

variable [PrimeSevenModEight d]

/-- Let `C` be a CM lattice for a prime `d ≡ 7` modulo `8`, with `2`-torsion point `t`. Let the
linear forms `μ_i = d ν_i` be `d` times forms `ν_i` with coefficients of norm at most `1`. If `F`
lies in `jetRing`, then so does each partial derivative `pderiv x F`. -/
lemma pderiv_mem_jetRing {F : MvPowerSeries X ℂ_[p]} {ν : I → X → ℂ_[p]}
    (hν : ∀ (i : I) (x : X), ‖ν i x‖ ≤ 1) (hF : F ∈ C.jetRing ((d : ℂ_[p]) • ν)) (x : X) :
    pderiv x F ∈ C.jetRing ((d : ℂ_[p]) • ν) := by
  set μ : I → X → ℂ_[p] := (d : ℂ_[p]) • ν
  have hμ (i : I) (x : X) : μ i x = ν i x * d := mul_comm _ _
  have h_int (i : I) (x : X) : ‖μ i x‖ ≤ 1 := by
    simpa [hμ] using (mul_le_of_le_one_left (norm_nonneg _) (hν i x)).trans
      (IsUltrametricDist.norm_natCast_le_one ℂ_[p] d)
  induction hF using Subring.closure_induction with
  | mem G hG =>
    obtain (hG | ⟨i, rfl⟩) | ⟨i, rfl⟩ := hG
    · exact C.mem_jetRing_of_mem_multiSeriesRing (C.pderiv_mem_multiSeriesRing h_int hG x)
    · -- With `g = -log θ` one has `θ' = -θ g'`.
      have h_eq : pderiv x ((taylorVia ιₚ C.θ).subst (linearSeries (μ i))) =
          μ i x • -((taylorVia ιₚ C.θ).subst (linearSeries (μ i)) *
            (PowerSeries.derivative C.negLogTheta).subst (linearSeries (μ i))) := by
        rw [pderiv_subst_linearSeries, derivative_taylorVia_theta,
          ← PowerSeries.coe_substAlgHom (hasSubst_linearSeries _), map_neg, map_mul]
      rw [h_eq]
      exact C.smul_mem_jetRing (h_int i x)
        (neg_mem (mul_mem (C.theta_mem_jetRing i) (C.derivative_negLogTheta_mem_jetRing i)))
    · -- The derivative is `ν_i x` times `(d g'')(μ_i z)`: the factor `d` of the linear form clears
      -- the denominator of `g''`.
      rw [pderiv_subst_linearSeries, hμ i x, mul_smul,
        ← PowerSeries.subst_smul (hasSubst_linearSeries _)]
      exact C.smul_mem_jetRing (hν i x) (C.mem_jetRing_of_mem_multiSeriesRing
        (subst_mem_multiSeriesRing μ C.smul_derivative_derivative_negLogTheta_mem i))
  | zero => simp
  | one => simp
  | add G G' _ _ hG hG' => simpa using add_mem hG hG'
  | neg G _ hG => simpa using neg_mem hG
  | mul G G' hG_mem hG'_mem hG hG' =>
    rw [Derivation.leibniz]
    exact add_mem (mul_mem hG_mem hG') (mul_mem hG'_mem hG)

/-- Let `C` be a CM lattice for a prime `d ≡ 7` modulo `8`, with `2`-torsion point `t`. Let `θ` and
`y` be the Taylor series at `0`, read in `ℂ_[p]` through `ιₚ`, of `C.θ` and of `C.translatedY`. Let
the linear forms `μ_i = d ν_i` be `d` times forms `ν_i` with integral coefficients, and let `H` be
an integral series in the `y(μ_i z)`. If `φ : R →+* ℂ_[p]` has integral values, then the jet
`(φ(Q)(∂) F)(0)` of `F = (∏ θ(μ_i z) ^ m i) ^ N * H` is integral for every polynomial `Q` over
`R`. -/
lemma norm_jet_thetaProd_pow_mul_le_one {ν : I → X → ℂ_[p]}
    (hν : ∀ (i : I) (x : X), ‖ν i x‖ ≤ 1) (m : I → ℕ) (N : ℕ)
    {H : MvPowerSeries X ℂ_[p]} (hH : H ∈ C.multiSeriesRing ((d : ℂ_[p]) • ν))
    {R : Type} [CommRing R] {φ : R →+* ℂ_[p]} (hφ : ∀ a : R, ‖φ a‖ ≤ 1) (Q : MvPolynomial X R) :
    ‖jet ℂ_[p] (Q.map φ) (C.thetaProd ((d : ℂ_[p]) • ν) m ^ N * H)‖ ≤ 1 :=
  norm_jet_le_one_of_pderiv_mem (fun _ ↦ C.norm_constantCoeff_le_of_mem_jetRing)
    (fun _ ↦ C.pderiv_mem_jetRing hν) hφ Q
    (mul_mem (pow_mem (C.thetaProd_mem_jetRing m) N) (C.mem_jetRing_of_mem_multiSeriesRing hH))

end CMLattice

end New

end ProductJetIntegrality

/-! ## Stability of standard data -/

namespace New.Parameters

open Finset Complex Matrix Space Submodule NumberField

variable {P : Parameters} {s : ℕ} {n : Type} {δ : 𝓞 P.K}

/-- The standard lattice `Ôⁿ` is contained in `integralAfter δ S`: its vectors stay integral at the
places of `S` after multiplication by the integer `δ`. -/
lemma integralAfter.stdLattice_le {S : FinPlace (P.E s) → Prop} :
    stdLattice (P.E s) n ≤ integralAfter δ S := by
  intro x hx i w _
  exact mem_Ô.1 (mul_mem (coe_mem_Ô (algebraMap (𝓞 P.K) (𝓞 (P.E s)) δ)) (hx i)) w

variable [Fintype n] [DecidableEq n] {ε : n → ℤˣ} {V : Space (P.E s) n ε} {p : ℕ} [Fact p.Prime]
  [PadicPlace p] {f : 𝒮 V}

/-- Standard data are a submodule of the space `𝒮 V` of the Weil representation of the hermitian
space `V` over `embValRing`, the ring of complex numbers whose image under `ιₚ` has norm at most
`1`. So they are stable under multiplication by such numbers. -/
lemma smul_mem_standardData_of_norm_le_one {c : ℂ} (hc : ‖ιₚ c‖ ≤ 1)
    (hf : f ∈ standardData V δ) : c • f ∈ standardData V δ :=
  smul_mem _ (⟨c, hc⟩ : embValRing) hf

/-- Let `V` be a hermitian space over the cyclotomic extension `P.E s` of the imaginary quadratic
field `P.K`, and let `δ` be an integer of `P.K`. The integral vacuum `intVacuum V` is the vacuum
vector of `𝒮 V` times the power `vacuumScale ^ card n` of a fixed nonzero scalar. Its translate by
the Heisenberg operator of a finite adelic vector `x` with `δ x` integral above `p` is one of the
generators of the standard data of level `δ`. -/
lemma finHeisenbergOp_intVacuum_mem_standardData {x : n → 𝔸f (P.E s)}
    (hx : x ∈ integralAfter δ fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal) :
    V.finHeisenbergOp x (intVacuum V) ∈ standardData V δ :=
  subset_span ⟨x, hx, rfl⟩

/-- The standard data `standardData V δ` are the span of the translates of the integral vacuum by
the points that `δ` makes integral above `p`. The integral vacuum is the vacuum of `𝒮 V` times
`vacuumScale ^ card n`. These data are stable under the Heisenberg operator `V.finHeisenbergOp x` of
a finite adelic vector `x` such that `δ x` is integral at the places above `p`. -/
lemma finHeisenbergOp_mem_standardData {x : n → 𝔸f (P.E s)}
    (hx : x ∈ integralAfter δ fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal)
    (hf : f ∈ standardData V δ) : V.finHeisenbergOp x f ∈ standardData V δ := by
  induction hf using span_induction with
  | mem _ h_gen =>
    -- The operators of `x` and `y` compose to that of `x + y` up to a root of unity.
    obtain ⟨y, hy, rfl⟩ := h_gen
    rw [finHeisenbergOp_finHeisenbergOp]
    exact smul_mem_standardData_of_norm_le_one (norm_map_selfDualAddChar ιₚ _).le
      (finHeisenbergOp_intVacuum_mem_standardData (add_mem hx hy))
  | zero => simp
  | add f f' _ _ hf hf' => simpa using add_mem hf hf'
  | smul c f _ hf => simpa using smul_mem _ c hf

omit [Fact p.Prime] [PadicPlace p] in
/-- Let `g` be a finite unitary point in `integralAbove n p`, that is, integral at the places above
`p`. If `δ x` is integral above `p`, then so is `δ g x`. -/
lemma mulVec_mem_integralAfter {g : Gf (P.E s) n} (hg : g ∈ integralAbove n p)
    {x : n → 𝔸f (P.E s)} (hx : x ∈ integralAfter δ fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal) :
    (g : Matrix n n (𝔸f (P.E s))) *ᵥ x ∈
      integralAfter δ fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal := by
  intro i w hw
  -- At the place `w`, the vector `δ g x` is the integral matrix `g` applied to `δ x`.
  let a : 𝔸f (P.E s) := algebraMap (P.E s) (𝔸f (P.E s)) (algebraMap P.K (P.E s) δ)
  have h_eq : evalAt w (a * ((g : Matrix n n (𝔸f (P.E s))) *ᵥ x) i) =
      ((Gf.atPlace w g).val *ᵥ fun j : n ↦ evalAt w (a * x j)) i := by
    have h_entry (j : n) :
        (Gf.atPlace w g).val i j = evalAt w ((g : Matrix n n (𝔸f (P.E s))) i j) := rfl
    simp [mulVec, dotProduct, mul_sum, mul_left_comm a, h_entry]
  rw [h_eq]
  exact (mulVec_mem_intVectors_iff (hg w hw)).2 (fun j ↦ hx j w hw) i

/-- The Weil operator `ω(1, g)` takes the translate by `x` of the integral vacuum `intVacuum V` to
`(finMultiplier g⁻¹)⁻¹` times the translate by `g x` of the sum of the translates of the integral
vacuum by the `g y`, where `y` runs over integral vectors modulo those that `g` keeps integral. Here
`finMultiplier` is the finite part of the scalar factor `weilMultiplier` in the definition of the
Weil operators. -/
lemma omega_finHeisenbergOp_intVacuum (g : Gf (P.E s) n) (x : n → 𝔸f (P.E s)) :
    let L : AddSubgroup (n → 𝔸f (P.E s)) := stdLattice (P.E s) n
    let M : Matrix n n (𝔸f (P.E s)) := g
    V.ω (1, g) (V.finHeisenbergOp x (intVacuum V)) =
      (finMultiplier g⁻¹)⁻¹ • V.finHeisenbergOp (M *ᵥ x)
        (∑ᶠ y : L ⧸ (L.comap M.mulVecLin).addSubgroupOf L,
          V.finHeisenbergOp (M *ᵥ y.out.val) (intVacuum V)) := by
  have h_coeff : finMultiplier g / (‖finMultiplier g‖ : ℂ) ^ 2 = (finMultiplier g⁻¹)⁻¹ := by
    rw [finMultiplier_inv, ← mul_conj', div_mul_cancel_left₀ (finMultiplier_ne_zero g)]
  simp [← h_coeff, intVacuum, omega_vacElem_sum, ← smul_finsum,
    smul_comm (P.vacuumScale s ^ Fintype.card n)]

/-- Standard data of level `δ` are stable under the Weil operator `ω(1, g)` of a finite unitary
point `g` in `integralAbove n p`. -/
lemma omega_mem_standardData {g : Gf (P.E s) n} (hg : g ∈ integralAbove n p)
    (hf : f ∈ standardData V δ) : V.ω (1, g) f ∈ standardData V δ := by
  induction hf using span_induction with
  | mem _ h_gen =>
    obtain ⟨x, hx, rfl⟩ := h_gen
    -- The image is a multiple of the translate by `g x` of a sum of translates of the vacuum by the
    -- `g y`, with `y` integral. The factor is a unit, as `g⁻¹` is integral above `p` too.
    have h_unit : ‖ιₚ (finMultiplier g⁻¹)⁻¹‖ = 1 := by
      simp [norm_finMultiplier_eq_one (inv_mem hg)]
    rw [omega_finHeisenbergOp_intVacuum]
    refine smul_mem_standardData_of_norm_le_one h_unit.le
      (finHeisenbergOp_mem_standardData (mulVec_mem_integralAfter hg hx) ?_)
    exact finsum_induction (· ∈ standardData V δ) (zero_mem _) (fun _ _ ↦ add_mem) fun y ↦
      finHeisenbergOp_intVacuum_mem_standardData
        (mulVec_mem_integralAfter hg (integralAfter.stdLattice_le y.out.property))
  | zero => simp
  | add f f' _ _ hf hf' => simpa using add_mem hf hf'
  | smul c f _ hf => simpa using smul_mem _ c hf

end New.Parameters
end
end

section
/-!
# Standard data as products of theta functions of the curve

* `New.IsTightFrame.isResolution`: a tight frame of length `b²` gives a resolution of the identity
  on `Eⁿ`.
* `New.CMLattice.exists_prod_twistedTranslate_eq_thetaProd_mul`: a product of translates of `θ` by
  `δ`-division points, taken at `δ̄ z`, is a power of a product of copies of `θ` times an integral
  series.
* `New.Parameters.exists_isVacuumExpansion`: the integral vacuum is an integral combination of
  translates of a vector whose theta function is a product of copies of `θ` along a tight frame;
  `New.Parameters.IsVacuumExpansion` collects the properties of this expansion.
* `New.Parameters.exists_jetSeries_map_eq_thetaProd_pow_mul`: the theta function of standard data of
  level `δ ≠ 0`, taken at `δ̄ (√(2π / √d) / Ω₀) z` with `d` and `Ω₀` as below, is the power `δ δ̄`
  of the product of `θ` along a resolution of the identity times an integral series in the
  parameters of these copies.

Standard data are integral combinations of translates of the integral vacuum. The proof has three
steps. Fourier inversion writes the integral vacuum through the translates of one product of copies
of `θ`, with a denominator prime to `p`. A translate of this product is a product of translates.
Each translated factor falls under the integrality principle on one curve.

Notions from other files:
* `finiteImage x` is the finite adelic vector `α⁻¹ x` of a rational vector `x`, where `α` is the
  idele of the Weil data of `E`; its coordinates lie in `Ô E` exactly when those of `x` lie in the
  lattice `𝔞₀ = E ∩ α Ô`.
* `V.ϱ (finVec x)` is the Heisenberg translation of `𝒮 V` by the finite adelic vector `α x`, called
  the translation by `x` below, and `V.finHeisenbergOp x` is this translation times a root of unity.
* `intVacuum V`, the integral vacuum, is the vacuum `V.vacElem` (a Gaussian times the signed
  indicator of the standard lattice) times a fixed power of the vacuum scale of the parameters.
* `daggerForms u` are the linear forms `u_j† z` read in `ℂ_p`, and `C.thetaProd μ m` is the product
  `∏ θ(μ_j z) ^ m j` of copies of the theta function of the curve `C`.
* `V.jetSeries c f` is the Taylor series of the theta function of `f` in Fock's coordinates, taken
  at `c z`. Here `P.areaScale` is the number `√(2π / √d)`, where `K = ℚ(√-d)`, and `P.cmPeriod` is
  the fixed period `Ω₀` of `K`: the lattice of the curve `P.cmCurve` is `Ω₀ 𝓞_K`. The factor
  `P.areaScale / P.cmPeriod` passes from Fock's coordinates to those of the curve
  `ℂ / cmPeriod 𝓞_K`.
* `finiteImage id a ∈ Ô E` says that the element `a` of `E` lies in `𝔞₀`; `Φ τ` is the complex
  embedding of the infinite place `τ` in the CM type.
* `IsTightFrame w m M` says that the `w i` lie in `𝔞₀` and that the matrix
  `(∑ m i τ(w i) conj σ(w i))`, indexed by infinite places `τ` and `σ`, is `M` times the identity.
  The number `M` is called the length of the frame.
* `V : Space E n ε` is a hermitian space of rank `n` with signs `ε` at the infinite places, together
  with an adelic point, `𝒮 V` is its Weil model, `V.θ` the theta functional on it, and
  `V.finitePart` the span of the images of the vacuum under the operators `V.finHeisenbergOp x`.
* `taylorVia ιₚ f` is the Taylor series of `f` at `0` read in `ℂ_p`, and `linearSeries μ` the linear
  form `μ` as a power series. `C.twistedTranslate k a f` is the translate of `f`, of weight `k`, by
  `a` times the factor that keeps it a theta function.
-/

@[expose] public section

open NumberField ComplexConjugate

namespace New

section Frames
variable {E I n : Type} [DecidableEq n] [Field E] [CMType E]

/-- The vectors `w i / ν`, placed in each copy of `E` in `Eⁿ`: the vector of index `(i, c)` has
`w i / ν` in the coordinate `c` and `0` elsewhere. -/
noncomputable def resolutionVectors (w : I → E) (ν : ℕ) (j : I × n) : n → E :=
  Pi.single j.2 (w j.1 / ν)

/-- The linear form `u† z` of the vector `u` of index `(i, c)` in `resolutionVectors w ν` involves
only the coordinate `c`, with coefficient `conj (τ (w i)) / ν` at the infinite place `τ`. -/
lemma dagger_resolutionVectors (w : I → E) (ν : ℕ) (j : I × n) (x : InfinitePlace E × n) :
    dagger (resolutionVectors w ν j) x = if x.2 = j.2 then conj (Φ x.1 (w j.1)) / ν else 0 := by
  simp [dagger, resolutionVectors, Pi.single_apply, apply_ite (Φ x.1), apply_ite conj]

/-- Let `w` be a tight frame with all multiplicities one and frame bound `b * b ≠ 0`: the matrix
`(∑ Φ τ (w i) * conj (Φ σ (w i)))`, indexed by infinite places `τ` and `σ`, is `b * b` times the
identity. For `k ≠ 0` this gives a resolution of the identity `z = ∑ k² (u† z) u` on `Eⁿ`. Here `u`
runs over the vectors `w i / (b k)` (`resolutionVectors w (b * k)`), placed in each copy of `E`. -/
lemma IsTightFrame.isResolution [WeilData E] [Fintype I] [Fintype n] {w : I → E} {b k : ℕ}
    (hw : IsTightFrame w 1 (b * b)) (hb : b ≠ 0) (hk : k ≠ 0) :
    IsResolution (resolutionVectors (n := n) w (b * k)) fun _ : I × n ↦ k * k := by
  rintro ⟨σ, c⟩ ⟨τ, c'⟩
  have h_tight : ∑ i : I, Φ σ (w i) * conj (Φ τ (w i)) = if σ = τ then (b * b : ℂ) else 0 := by
    simpa using hw.sum_mul_conj σ τ
  have h_term (j : I × n) : (k * k : ℕ) * (Φ σ (resolutionVectors w (b * k) j c) *
      dagger (resolutionVectors w (b * k) j) (τ, c')) =
      if c = j.2 ∧ c = c' then Φ σ (w j.1) * conj (Φ τ (w j.1)) / (b * b) else 0 := by
    rw [dagger_resolutionVectors]
    by_cases hc : c = j.2 <;> by_cases hc' : c' = j.2 <;>
      simp [resolutionVectors, hc, hc', eq_comm (a := j.2), field]
  simp_rw [h_term, Fintype.sum_prod_type]
  by_cases hc : c = c' <;> simp [hc, ← Finset.sum_div, h_tight, apply_ite (· / (b * b : ℂ)), hb]

end Frames

/-- Let `d` be a prime congruent to `7` modulo `8`, `C` a lattice with complex multiplication by the
integers of `ℚ(√-d)`, and `δ ≠ 0` such an integer, of norm `N`. Write `T_y` for the twisted
translation `C.twistedTranslate 1 y`, whose degree `1` is that of the theta function `θ` of `C`. If
`δ y_i` is a period of `C` for every `i`, the product of the `(T_{y_i} θ)(δ̄ z_i)` along linear
forms `z_i = μ_i z` is `∏ θ(z_i) ^ N` times an integral series in the parameters at the `z_i`, an
element of `C.multiSeriesRing μ`. -/
lemma CMLattice.exists_prod_twistedTranslate_eq_thetaProd_mul {d : ℕ} [PrimeSevenModEight d]
    (C : CMLattice d) {p : ℕ} [Fact p.Prime] [PadicPlace p] {I X : Type} [Fintype I] [Fintype X]
    (μ : I → X → ℂ_[p])
    {δ : ℂ} {N : ℕ} (hδ : δ ∈ quadInt d) (hδ_ne : δ ≠ 0) (hN : δ * conj δ = N) {y : I → ℂ}
    (hy : ∀ i : I, δ * y i ∈ C.Λ) :
    ∃ H ∈ C.multiSeriesRing μ,
      ∏ i : I, (taylorVia ιₚ (C.twistedTranslate 1 (y i) C.θ)).subst
        (linearSeries (ιₚ (conj δ) • μ i)) = C.thetaProd μ (fun _ : I ↦ N) * H := by
  have h_isogeny : C.IsIsogeny C.periodPair (conj δ) N :=
    ⟨fun _ hx ↦ C.mul_mem_of_quadInt (conj_mem_quadInt hδ) hx, by simp [← hN, mul_comm]⟩
  -- On one curve the `i`-th factor, as a series in `z_i`, is `θ ^ N` times an integral series.
  choose u hu h_factor using fun i : I ↦ C.exists_rescale_twistedTranslate_eq_theta_pow_mul (p := p)
    h_isogeny hδ_ne (hy i)
  refine ⟨∏ i : I, (u i).subst (linearSeries (μ i)),
    prod_mem fun i _ ↦ subst_mem_multiSeriesRing μ (hu i) i, ?_⟩
  rw [CMLattice.thetaProd, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun i _ ↦ ?_
  have h_smul : linearSeries (ιₚ (conj δ) • μ i) = ιₚ (conj δ) • linearSeries (μ i) := by
    simp [linearSeries, Finset.smul_sum, mul_smul]
  rw [h_smul, ← subst_rescale_eq_subst_smul _ (hasSubst_linearSeries _), h_factor,
    PowerSeries.subst_mul (hasSubst_linearSeries _),
    PowerSeries.subst_pow (hasSubst_linearSeries _)]

namespace Parameters
open Space Fintype QuadField CMLattice

section RationalTranslates
variable {P : Parameters} {s : ℕ} {n : Type} {p : ℕ} [Fact p.Prime]

lemma ne_zero_of_prime_coprime {k : ℕ} (hk : p.Coprime k) : k ≠ 0 := by
  rintro rfl
  simp [(Fact.out : p.Prime).ne_one] at hk

omit [Fact p.Prime] in
/-- Let `ν` be prime to `p` and `ν y` lie in the standard lattice `Ô E ^ n`, where `E = P.E s`. For
every integer `δ` of `K` the vector `y` lies in `integralAfter δ` of the places above `p`, that is,
the coordinates of `δ y` are integral at these places. -/
lemma mem_integralAfter_of_nsmul_mem {δ : 𝓞 P.K} {ν : ℕ} (hν : p.Coprime ν) {y : n → 𝔸f (P.E s)}
    (hy : ν • y ∈ stdLattice (P.E s) n) :
    y ∈ integralAfter δ fun u : FinPlace (P.E s) ↦ ↑p ∈ u.asIdeal := by
  intro c u hu
  have h_unit : Valued.v (ν : LocField u) = 1 := by
    simpa using v_algebraMap_eq_one (u.isPrime.notMem_of_isCoprime_of_mem hν.cast hu)
  have h_int : ν • y ∈ integralAfter δ fun u : FinPlace (P.E s) ↦ ↑p ∈ u.asIdeal :=
    integralAfter.stdLattice_le hy
  simpa [h_unit] using h_int c u hu

/-- If the `w i` lie in the lattice `𝔞₀` (their finite images are integral) and `ν` is prime to
`p`, the finite images of the vectors `w i / ν` of `Eⁿ` are integral at all places above `p`. -/
lemma finiteImage_resolutionVectors_mem [DecidableEq n] {I : Type} {w : I → P.E s}
    (hw : ∀ i : I, finiteImage w i ∈ Ô (P.E s)) {ν : ℕ} (hν : p.Coprime ν) (j : I × n) :
    finiteImage (resolutionVectors w ν j) ∈
      integralAfter (1 : 𝓞 P.K) fun u : FinPlace (P.E s) ↦ ↑p ∈ u.asIdeal := by
  refine mem_integralAfter_of_nsmul_mem hν fun c ↦ ?_
  have h_mul : ν • resolutionVectors w ν j = Pi.single j.2 (w j.1) := by
    simp [resolutionVectors, ← Pi.single_smul', mul_div_cancel₀, ne_zero_of_prime_coprime hν]
  rw [← map_nsmul, h_mul]
  by_cases hc : c = j.2
  · simpa [finiteImage, hc] using hw j.1
  · simp [finiteImage, hc]

variable [Fintype n]

/-- A finite adelic vector that is integral at the places above `p` becomes integral everywhere
when it is multiplied by a suitable number prime to `p`. -/
lemma exists_coprime_mul_mem_of_mem_integralAfter {x : n → 𝔸f (P.E s)}
    (hx : x ∈ integralAfter (1 : 𝓞 P.K) fun u : FinPlace (P.E s) ↦ ↑p ∈ u.asIdeal) :
    ∃ m : ℕ, p.Coprime m ∧ ∀ c : n, m * x c ∈ Ô (P.E s) := by
  have hp : p.Prime := Fact.out
  obtain ⟨m₀, hm₀, h_clear⟩ := exists_forall_mul_mem_Ô x
  obtain ⟨e, m, hm, rfl⟩ : ∃ e m : ℕ, ¬p ∣ m ∧ m₀ = p ^ e * m :=
    WfDvdMonoid.max_power_factor hm₀ hp
  refine ⟨m, hp.coprime_iff_not_dvd.2 hm, fun c ↦ mem_Ô.2 fun u ↦ ?_⟩
  by_cases hu : ↑p ∈ u.asIdeal
  · simpa using nsmul_mem hx m c u hu
  · have h_unit : Valued.v (p : LocField u) = 1 := by simpa using v_algebraMap_eq_one hu
    simpa [h_unit] using mem_Ô.1 (h_clear c) u

/-- Let `V` be a standard space over `E = P.E s` (its signs `ε` are `+1` and its point is the
identity), and let `F` lie in the finite part of its Weil model `𝒮 V`, the span of the translates of
the vacuum by finite adelic vectors. Here `V.ϱ (finVec x)` is the Heisenberg translation by the
adelic vector with finite part `α x` and real part zero. If `δ x` is integral above `p`, it acts on
`F` as the translation by a rational vector `γ` with `δ γ` in `𝔞₀ⁿ ⊗ ℤ_(p)`: for a number `m` prime
to `p`, the vector `m δ γ` lies in the lattice `𝔞₀ⁿ` (its finite image is integral). -/
lemma exists_rho_finiteImage_eq_and_coprime_mul_mem [DecidableEq n]
    {ε : n → ℤˣ} {V : Space (E P s) n ε} {F : 𝒮 V} (hF : F ∈ V.finitePart) {δ : 𝓞 P.K}
    {x : n → 𝔸f (P.E s)} (hx : x ∈ integralAfter δ fun u : FinPlace (P.E s) ↦ ↑p ∈ u.asIdeal) :
    ∃ (γ : n → P.E s) (m : ℕ),
      V.ϱ (finVec (finiteImage γ)) F = V.ϱ (finVec x) F ∧
      p.Coprime m ∧
      ∀ c : n, finiteImage id (m * (algebraMap P.K (P.E s) δ * γ c)) ∈ Ô (P.E s) := by
  -- Approximate `x` by a rational `γ` with `finiteImage γ - x` in the standard lattice, chosen so
  -- that the translate of `F` is unchanged.
  obtain ⟨γ, hγ, h_translate⟩ := exists_finiteImage_approx hF x
  have h_int : finiteImage γ ∈ integralAfter δ fun u ↦ ↑p ∈ u.asIdeal := by
    simpa only [sub_add_cancel] using add_mem (integralAfter.stdLattice_le hγ) hx
  have h_scaled : finiteImage (fun c ↦ algebraMap P.K (P.E s) δ * γ c) ∈
      integralAfter (1 : 𝓞 P.K) fun u ↦ ↑p ∈ u.asIdeal := fun c u hu ↦ by
    simpa [finiteImage, mul_left_comm, mul_assoc] using h_int c u hu
  obtain ⟨m, hm, h_clear⟩ := exists_coprime_mul_mem_of_mem_integralAfter h_scaled
  exact ⟨γ, m, h_translate, hm, fun c ↦ by simpa [finiteImage, mul_left_comm] using h_clear c⟩

end RationalTranslates

/-- There is a tight frame in the CM field `P.E s`, with all multiplicities one, whose length is
the square of a number `b` prime to `p`. It repeats `b` times each vector of a tight frame of
length `b`: that of the powers of `ζ` if `p` does not divide `q₁`, and otherwise that of a length
prime to `q₁`. -/
lemma exists_coprime_isTightFrame_sq (P : Parameters) (s p : ℕ) [Fact p.Prime] :
    ∃ b : ℕ, p.Coprime b ∧
      ∃ (I : Type) (_ : Fintype I) (w : I → P.E s), IsTightFrame w 1 (b * b) := by
  suffices h_frame : ∃ b : ℕ, p.Coprime b ∧
      ∃ (I : Type) (_ : Fintype I) (v : I → P.E s), IsTightFrame v 1 b by
    obtain ⟨b, hb, I, _, v, hv⟩ := h_frame
    exact ⟨b, hb, Σ _ : I, Fin (b * 1), inferInstance, fun x ↦ v x.1,
      (hv.mul_left b).repeat_vectors⟩
  by_cases hp : p ∣ P.q₁ s
  · obtain ⟨len, I, _, v, hv, -, h_coprime, -⟩ := P.exists_isTightFrame_coprime s
    exact ⟨len, (h_coprime.coprime_dvd_right hp).symm, I, inferInstance, v, hv⟩
  · exact ⟨P.q₁ s, (Fact.out : p.Prime).coprime_iff_not_dvd.2 hp, Fin (P.q₁ s), inferInstance,
      fun i ↦ P.ζ s ^ i.val, isTightFrame_pow isPrimitiveRoot_zeta⟩

/-- Let `w` and `m δ γ` have finite images in `Ô (P.E s)`, where `δ` is an integer of the imaginary
quadratic field `P.K`. If `m * b` divides `k`, then multiplying by `k δ` sends the point
`-(cmPeriod / b) ∑ Φ τ γ * conj (Φ τ w)`, summed over the infinite places `τ`, into the lattice
`P.cmCurve.Λ`, which is `cmPeriod 𝓞_K`. -/
lemma mul_neg_sum_mul_conj_mem_cmCurve_lattice {P : Parameters} {s : ℕ} {δ : 𝓞 P.K} {m b k : ℕ}
    {γ w : P.E s} (hγ : finiteImage id (m * (algebraMap P.K (P.E s) δ * γ)) ∈ Ô (P.E s))
    (hw : finiteImage id w ∈ Ô (P.E s)) (hb : b ≠ 0) (h_dvd : m * b ∣ k) :
    (k * δ : ℂ) * -(P.cmPeriod / b * ∑ τ : InfinitePlace (P.E s), Φ τ γ * conj (Φ τ w)) ∈
      P.cmCurve.Λ := by
  obtain ⟨l, rfl⟩ := h_dvd
  -- The lattice `𝔞₀` is self-dual over `𝓞_K`, so `t = w† (m δ γ)` is an integer of `K`.
  let t : ℂ := ∑ τ : InfinitePlace (P.E s), Φ τ (m * (algebraMap P.K (P.E s) δ * γ)) * conj (Φ τ w)
  have ht : t * P.cmPeriod ∈ P.cmCurve.Λ :=
    P.cmCurve.mul_mem_of_quadInt (sum_mul_conj_mem_quadInt hγ hw) cmPeriod_mem_cmCurve_lattice
  have h_eq : ((m * b * l : ℕ) * δ : ℂ) *
      -(P.cmPeriod / b * ∑ τ : InfinitePlace (P.E s), Φ τ γ * conj (Φ τ w)) =
        -(l • (t * P.cmPeriod)) := by
    simp [t, ← Finset.mul_sum, mul_assoc, field]
  simpa only [h_eq] using neg_mem (nsmul_mem ht l)

section VacuumExpansion
variable {P : Parameters} {s : ℕ} {n : Type} {p : ℕ} [Fact p.Prime] [Fintype n] [DecidableEq n]
  {ε : n → ℤˣ}

/-- A vector of `𝒮 V` is evaluated as its theta function, here at `finVec (x i)`. If
`∑ c i * V.vacElem (finVec (x i)) = M ≠ 0`, then `intVacuum V` is the sum of the `(M⁻¹ * intVacuum V
(finVec (x i))) • c i • V.vacElem`. -/
lemma intVacuum_eq_sum_smul_vacElem {V : Space (E P s) n ε} {Y : Type} [Fintype Y]
    {c : Y → ℂ} {x : Y → n → 𝔸f (P.E s)} {M : ℂ} (hM : M ≠ 0)
    (h_sum : ∑ i : Y, c i * V.vacElem (finVec (x i)) = M) :
    intVacuum V = ∑ i : Y, (M⁻¹ * intVacuum V (finVec (x i))) • c i • V.vacElem := by
  have h_term (i : Y) : (M⁻¹ * intVacuum V (finVec (x i))) • c i • V.vacElem =
      (M⁻¹ * (c i * V.vacElem (finVec (x i)))) • intVacuum V := by
    simp only [intVacuum, Space.smul_apply]
    module
  simp only [h_term, ← Finset.sum_smul, ← Finset.mul_sum, h_sum, inv_mul_cancel₀ hM, one_smul]

variable {V : Space (E P s) n ε} [V.IsStd] [PadicPlace p]

omit [V.IsStd] in
/-- Let `V` be a hermitian space over `E = P.E s` with signs `ε`, and `F` a vector of its Weil model
`𝒮 V`. The operator `V.finHeisenbergOp x` takes the translate of `F` by `y` to a multiple of the
translate of `F` by `x + y`, and the scalar lies in the valuation ring `embValRing` of the embedding
`ιₚ` of `ℂ` in `ℂ_p`. -/
lemma exists_finHeisenbergOp_rho_eq_smul (x y : n → 𝔸f (P.E s)) (F : 𝒮 V) :
    ∃ c : embValRing, V.finHeisenbergOp x (V.ϱ (finVec y) F) = c • V.ϱ (finVec (x + y)) F := by
  let z : 𝔸f (P.E s) :=
    stdLattice.traceOneAdele * stdLattice.half * star x ⬝ᵥ x + stdLattice.half * star y ⬝ᵥ x
  refine ⟨⟨stdLattice.selfDualAddChar (P.E s) z, (norm_map_selfDualAddChar ιₚ z).le⟩, ?_⟩
  rw [finHeisenbergOp, stdLattice.semichar, _root_.smul_apply, rho_finVec_rho_finVec,
    smul_smul,
    ← AddChar.map_add_eq_mul, Subring.smul_def]

variable (V p) in
/-- An expansion of the integral vacuum of a standard space `V` (of rank `n`, with signs `ε` at the
infinite places) along a tight frame in `E = P.E s`. The frame `w` has length `b²` with `b` prime
to `p`. The integral vacuum is a combination, with `ιₚ`-integral coefficients `a j`, of the
translates of a vector `F` of the Weil model `𝒮 V` by the points `y j`. The vector `F` lies in the
finite part `V.finitePart`, spanned by the images of the vacuum under finite Heisenberg operators,
and the theta functions of its rational translates are products of translates of `θ` along the
frame. -/
structure IsVacuumExpansion (b : ℕ) {I : Type} [Fintype I] (w : I → P.E s) (F : 𝒮 V)
    {J : Type} [Fintype J] (y : J → n → 𝔸f (P.E s)) (a : J → embValRing) : Prop where
  /-- The number `b` is prime to `p`. -/
  coprime : p.Coprime b
  /-- The vectors `w i`, each taken once, are a tight frame of length `b²`. -/
  isTightFrame : IsTightFrame w 1 (b * b)
  /-- The vector `F` lies in the finite part of `𝒮 V`. -/
  mem_finitePart : F ∈ V.finitePart
  /-- The vectors `b y j` are integral. -/
  nsmul_mem_stdLattice (j : J) : b • y j ∈ stdLattice (P.E s) n
  /-- The integral vacuum is the sum of the translates of `F` by `y j` with coefficients `a j`. -/
  intVacuum_eq_sum : intVacuum V = ∑ j : J, a j • V.ϱ (finVec (y j)) F
  /-- For rational `γ` and complex `c`, the Taylor series of the theta function of the translate of
  `F` by `γ`, taken at `c (areaScale / cmPeriod) z` with `areaScale = √(2π / √d)` and `cmPeriod`
  the period `Ω₀` of `K = ℚ(√-d)`, is a product of twisted translates of the function `θ` of the
  curve `ℂ / Ω₀ 𝓞_K` along the forms `c u† z`, over the vectors `u` of
  `resolutionVectors w b`. -/
  jetSeries_eq_prod (γ : n → P.E s) (c : ℂ) :
    V.jetSeries (c * (P.areaScale / P.cmPeriod)) (V.ϱ (finVec (finiteImage γ)) F) =
      ∏ i : I × n, (taylorAtZero (P.cmCurve.twistedTranslate 1
        (-(P.cmPeriod / b * ∑ τ : InfinitePlace (P.E s), Φ τ (γ i.2) * conj (Φ τ (w i.1))))
        P.cmCurve.θ)).subst (linearSeries (c • dagger (resolutionVectors w b i)))

open scoped Pointwise in
/-- Let `V` be a standard space, `b` a number prime to `p`, and `F` a vector of its Weil model on
which the theta functional `V.θ` takes the value `1`. Suppose that `entireTheta F`, the theta
function of `F` in Fock's coordinates divided by the Gaussian, is entire and fixed by the signed
translations by the lattice `b 𝔞₀ⁿ`. Then `intVacuum V` is `∑ a j • V.ϱ (finVec (y j)) F`, with
coefficients `a j` in `embValRing` (integral under `ιₚ`) and points `y j` with `b y j` in the
standard lattice `Ô E ^ n`. -/
lemma exists_intVacuum_eq_sum_of_isThetaFunction {b : ℕ} (hb : p.Coprime b) {F : 𝒮 V}
    (hF_value : V.θ F = 1)
    (hF_theta : IsThetaFunction ((b : P.E s) • idealLattice (P.E s) n) (entireTheta F)) :
    ∃ (J : Type) (_ : Fintype J) (y : J → n → 𝔸f (P.E s)) (a : J → embValRing),
      (∀ j : J, b • y j ∈ stdLattice (P.E s) n) ∧
      intVacuum V = ∑ j : J, a j • V.ϱ (finVec (y j)) F := by
  have hbb_ne : b * b ≠ 0 := mul_self_ne_zero.2 (ne_zero_of_prime_coprime hb)
  -- Fourier inversion gives points `pt i` in `b⁻¹ 𝔞₀ⁿ`, periods `period j` and coefficients
  -- `coeff i`: each `coeff i • vacuum` is the sum over the periods of translates of `F` by `-pt i`,
  -- and `∑ coeff i • (translate of the vacuum by pt i)` is `M • F`, with `M` a power of `b * b`.
  obtain ⟨Y, Γ, _, _, pt, period, coeff, hpt, hperiod, -, h_average, h_inversion⟩ :=
    V.exists_fourier_coefficients (δ := (b : P.E s)) (by simp) hbb_ne (by simp)
      (by rwa [star_natCast])
  set M : ℂ := (b * b : ℕ) ^ card (InfinitePlace (P.E s) × n) with hM
  -- Apply the theta functional `V.θ` to `h_inversion`, then insert `h_average` in the vacuum.
  have h_values : ∑ i : Y, coeff i * V.vacElem (finVec (finiteImage (pt i))) = M := by
    simpa only [map_sum, map_smul, theta_rho, hF_value, smul_eq_mul, mul_one]
      using congrArg V.θ h_inversion
  -- The values of the integral vacuum are integral and `M` is a power of `b`, prime to `p`.
  have h_coeff (i : Y) : ‖ιₚ (M⁻¹ * intVacuum V (finVec (finiteImage (pt i))))‖ ≤ 1 := by
    simpa [hM, hb.norm_natCast_eq_one] using norm_intVacuum_le_one
  let a (i : Y) : embValRing := ⟨M⁻¹ * intVacuum V (finVec (finiteImage (pt i))), h_coeff i⟩
  have h_vacuum : intVacuum V = ∑ i : Y, a i •
      ∑ j : Γ, V.finHeisenbergOp (finiteImage (period j))
        (V.ϱ (finVec (finiteImage (-pt i))) F) := by
    rw [intVacuum_eq_sum_smul_vacElem (pow_ne_zero _ (Nat.cast_ne_zero.2 hbb_ne)) h_values]
    exact Finset.sum_congr rfl fun i _ ↦ congrArg (a i • ·) (h_average i)
  -- Each term of the inner sum is an integral multiple `r x` of a translate of `F`.
  choose r hr using fun x : Y × Γ ↦
    exists_finHeisenbergOp_rho_eq_smul (finiteImage (period x.2)) (finiteImage (-pt x.1)) F
  refine ⟨Y × Γ, inferInstance, fun x ↦ finiteImage (period x.2 - pt x.1), fun x ↦ a x.1 * r x,
    fun x ↦ ?_, ?_⟩
  · rw [← map_nsmul, ← mem_idealLattice, smul_sub, ← Nat.cast_smul_eq_nsmul (P.E s) b (pt x.1)]
    exact sub_mem (nsmul_mem (hperiod x.2) b) (hpt x.1)
  · simp only [h_vacuum, Fintype.sum_prod_type, Finset.smul_sum, mul_smul, sub_eq_add_neg, map_add]
    exact Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦ by rw [hr (i, j)]

end VacuumExpansion

open scoped Pointwise in
/-- The integral vacuum `intVacuum V` of a standard space `V` has an expansion along a tight frame,
`IsVacuumExpansion p V b w F y a`. There are vectors `w i` in `𝔞₀` whose matrix
`(∑ τ(w i) conj σ(w i))` is `b²` times the identity, with `b` prime to `p`. There is a vector `F` in
the finite part of `𝒮 V`, and there are points `y j` with `b y j` integral. The integral vacuum is a
combination, with coefficients `a j` in `embValRing`, of the translates of `F` by the `y j`. -/
lemma exists_isVacuumExpansion {P : Parameters} {s : ℕ} {n : Type} (p : ℕ) [Fact p.Prime]
    [Fintype n] [DecidableEq n] {ε : n → ℤˣ} (V : Space (E P s) n ε) [V.IsStd] [PadicPlace p] :
    ∃ (b : ℕ) (I : Type) (_ : Fintype I) (w : I → P.E s) (F : 𝒮 V)
      (J : Type) (_ : Fintype J) (y : J → n → 𝔸f (P.E s)) (a : J → embValRing),
      IsVacuumExpansion p V b w F y a := by
  obtain ⟨b, hb, I, _, w, hw⟩ : ∃ b : ℕ, p.Coprime b ∧
      ∃ (I : Type) (_ : Fintype I) (w : I → P.E s), IsTightFrame w 1 (b * b) :=
    exists_coprime_isTightFrame_sq P s p
  have hb_ne : b ≠ 0 := ne_zero_of_prime_coprime hb
  have h_area : P.cmCurve.area = ‖(P.cmPeriod : ℂ)‖ ^ 2 / (b * b : ℕ) * (b * b : ℕ) * √P.d / 2 := by
    simp [area_eq_of_eq_scaledIdeal latticeModule_cmCurve, hb_ne]
  have hb_norm : (b : 𝓞 P.K) * conj ((b : 𝓞 P.K) : ℂ) = (b * b : ℕ) := by simp
  -- All factors of `F` are `θ`, the monomial with exponents `(1, 0, 0)`.
  obtain ⟨F, hF, hF_theta⟩ : ∃ F : 𝒮 V,
      IsResolutionProduct V P.cmCurve (P.cmPeriod / conj ((b : 𝓞 P.K) : ℂ)) w 1
        (fun _ : I × n ↦ P.cmCurve.monomialSection (1, 0, 0)) F ∧
      IsThetaFunction ((b : P.E s) • idealLattice (P.E s) n) (entireTheta F) := by
    obtain ⟨F, hF, -, h_periods⟩ := exists_isResolutionProduct_of_isTightFrame V b
      (mul_ne_zero hb_ne hb_ne) hb_norm hw (fun _ ↦ (1, 0, 0)) (by simp)
      cmPeriod_mem_cmCurve_lattice h_area
    exact ⟨F, hF, by simpa using h_periods⟩
  have hF_value : V.θ F = 1 := by
    simpa [monomialSection, resolutionShift] using hF.theta_translate 0
  obtain ⟨J, _, y, a, hy, h_vacuum⟩ :
      ∃ (J : Type) (_ : Fintype J) (y : J → n → 𝔸f (P.E s)) (a : J → embValRing),
        (∀ j : J, b • y j ∈ stdLattice (P.E s) n) ∧
        intVacuum V = ∑ j : J, a j • V.ϱ (finVec (y j)) F :=
    exists_intVacuum_eq_sum_of_isThetaFunction hb hF_value hF_theta
  refine ⟨b, I, inferInstance, w, F, J, inferInstance, y, a,
    { coprime := hb, isTightFrame := hw, mem_finitePart := hF.mem_finitePart,
      nsmul_mem_stdLattice := hy, intVacuum_eq_sum := h_vacuum,
      jetSeries_eq_prod := fun γ c ↦ ?_ }⟩
  -- `F` is a product along the frame; it remains to match the linear forms and the shifts.
  refine (hF.jetSeries_translate γ _).trans (Finset.prod_congr rfl fun i _ ↦ ?_)
  have h_form : resolutionFormCoeff (P.cmPeriod / conj ((b : 𝓞 P.K) : ℂ) / P.areaScale *
      (c * (P.areaScale / P.cmPeriod))) w i = c • dagger (resolutionVectors w b i) := by
    ext x
    by_cases hx : x.2 = i.2 <;> simp [resolutionFormCoeff, dagger_resolutionVectors, hx, field]
  rw [h_form]
  simp [monomialSection, resolutionShift]

variable {P : Parameters} {s : ℕ} {n : Type} {p : ℕ} [Fact p.Prime] [Fintype n] [DecidableEq n]
  {ε : n → ℤˣ} {V : Space (E P s) n ε} [V.IsStd] [PadicPlace p]

variable (V) in
/-- Let `V` be a space of rank `n` over `E = P.E s` with signs `ε`, and `μ` a family of linear
forms. These are the vectors `g` of its Weil model `𝒮 V` such that the Taylor series of the theta
function of `g` at `c z`, read in `ℂ_p`, is `Θ` times an integral series in the parameters of the
curve `P.cmCurve`, which is `ℂ / cmPeriod 𝓞_K`, at the forms `μ` (an element of
`multiSeriesRing μ`). -/
def thetaMultiples {J : Type} [Fintype J] (μ : J → InfinitePlace (P.E s) × n → ℂ_[p]) (c : ℂ)
    (Θ : MvPowerSeries (InfinitePlace (P.E s) × n) ℂ_[p]) : Submodule embValRing (𝒮 V) where
  carrier := {g : 𝒮 V | ∃ H ∈ P.cmCurve.multiSeriesRing μ, (V.jetSeries c g).map ιₚ = Θ * H}
  zero_mem' := ⟨0, zero_mem (P.cmCurve.multiSeriesRing μ), by simp⟩
  add_mem' := by
    rintro g g' ⟨H, hH, hg⟩ ⟨H', hH', hg'⟩
    exact ⟨H + H', add_mem hH hH', by rw [map_add, map_add, hg, hg', mul_add]⟩
  smul_mem' := by
    rintro a g ⟨H, hH, hg⟩
    refine ⟨ιₚ a • H, P.cmCurve.smul_mem_multiSeriesRing a.property hH, ?_⟩
    rw [mul_smul_comm, ← hg]
    change MvPowerSeries.map ιₚ (V.jetSeries c ((a : ℂ) • g)) =
      ιₚ a • MvPowerSeries.map ιₚ (V.jetSeries c g)
    simp [MvPowerSeries.smul_eq_C_mul]

/-- For `k ≠ 0` the form `c̄ (w i / b)† z`, read in `ℂ_p`, is `k c̄` times the form
`(w i / (b k))† z`. -/
lemma map_linearSeries_smul_dagger_resolutionVectors {I : Type} (w : I → P.E s) (b : ℕ) {k : ℕ}
    (hk : k ≠ 0) (c : ℂ) (i : I × n) :
    (linearSeries (conj c • dagger (resolutionVectors w b i))).map ιₚ =
      linearSeries (ιₚ (conj (k * c)) • daggerForms (resolutionVectors w (b * k)) i) := by
  have h_coeff (z : InfinitePlace (P.E s) × n) :
    ιₚ ((conj c • dagger (resolutionVectors w b i)) z) =
      (ιₚ (conj (k * c)) • daggerForms (resolutionVectors w (b * k)) i) z := by
    by_cases hz : z.2 = i.2 <;> simp [daggerForms, dagger_resolutionVectors, hz, field]
  simp only [linearSeries, map_sum, MvPowerSeries.smul_eq_C_mul, map_mul, MvPowerSeries.map_C,
    MvPowerSeries.map_X, h_coeff]

omit [V.IsStd] in
/-- Let `δ ≠ 0` have norm `N`. Suppose the theta function of `g` at `c z` is a product of the
translates `twistedTranslate 1 (t i)` of `θ` along the forms `δ̄ u† z`. Here `u` runs over the
vectors `resolutionVectors w b i`, which for `i = (i', c')` have `w i' / b` in coordinate `c'` and
`0` elsewhere. If `k ≠ 0` and `k δ` takes the `t i` to periods, then `g` lies in `thetaMultiples`:
this product, read in `ℂ_p`, is `θ_u ^ N` times an integral series. Here `θ_u` is the product of the
`θ(u† z) ^ k²` over `u` in `resolutionVectors w (b k)`. -/
lemma mem_thetaMultiples_of_jetSeries_eq_prod {δ : 𝓞 P.K} {N : ℕ} (hδ_ne : δ ≠ 0)
    (hN : δ * conj (δ : ℂ) = N) {I : Type} [Fintype I] {w : I → P.E s} {b k : ℕ} (hk : k ≠ 0)
    {t : I × n → ℂ} (ht : ∀ i : I × n, (k * δ : ℂ) * t i ∈ P.cmCurve.Λ) {c : ℂ} {g : 𝒮 V}
    (hg : V.jetSeries c g =
      ∏ i : I × n, (taylorAtZero (P.cmCurve.twistedTranslate 1 (t i) P.cmCurve.θ)).subst
        (linearSeries (conj (δ : ℂ) • dagger (resolutionVectors w b i)))) :
    g ∈ thetaMultiples V (daggerForms (resolutionVectors w (b * k))) c
      (P.cmCurve.thetaProd (daggerForms (resolutionVectors w (b * k))) (fun _ : I × n ↦ k * k) ^
        N) := by
  set μ : I × n → InfinitePlace (P.E s) × n → ℂ_[p] := daggerForms (resolutionVectors w (b * k))
  have h_norm : (k * δ : ℂ) * conj (k * δ : ℂ) = (k * k * N : ℕ) := by
    simp [← hN, mul_mul_mul_comm]
  obtain ⟨H, hH, h_prod⟩ : ∃ H ∈ P.cmCurve.multiSeriesRing μ,
      ∏ i : I × n, (taylorVia ιₚ (P.cmCurve.twistedTranslate 1 (t i) P.cmCurve.θ)).subst
        (linearSeries (ιₚ (conj (k * δ : ℂ)) • μ i)) =
        P.cmCurve.thetaProd μ (fun _ ↦ k * k * N) * H :=
    P.cmCurve.exists_prod_twistedTranslate_eq_thetaProd_mul μ ⟨k * δ, by simp⟩ (by simp [hk, hδ_ne])
      h_norm ht
  have h_power : P.cmCurve.thetaProd μ (fun _ ↦ k * k) ^ N =
      P.cmCurve.thetaProd μ fun _ ↦ k * k * N := by simp [thetaProd, ← Finset.prod_pow, pow_mul]
  refine ⟨H, hH, ?_⟩
  rw [hg, h_power, ← h_prod, map_prod]
  refine Finset.prod_congr rfl fun i _ ↦ ?_
  rw [PowerSeries.map_subst (hasSubst_linearSeries _),
    map_linearSeries_smul_dagger_resolutionVectors w b hk]

/-- Let `f` be standard data of level `δ ≠ 0` on a standard space `V`, that is, an integral
combination of images of the integral vacuum under the finite Heisenberg operators of points that
`δ` makes integral above `p`, and let `N = δ δ̄`. There are vectors `u j` with multiplicities `m j`
forming a resolution of the identity (`IsResolution u m`), with each `finiteImage (u j)` integral at
the places above `p`. For these, the Taylor series of the theta function of `f` at
`δ̄ (areaScale / cmPeriod) z`, read in `ℂ_p` through `ιₚ`, is `(∏ θ(u_j† z) ^ m j) ^ N` times an
integral series in the parameters of the curve at the forms `u_j† z`. -/
lemma exists_jetSeries_map_eq_thetaProd_pow_mul {δ : 𝓞 P.K} {N : ℕ} (hδ_ne : δ ≠ 0)
    (hN : δ * conj (δ : ℂ) = N) {f : 𝒮 V} (hf : f ∈ standardData V δ) :
    ∃ (J : Type) (_ : Fintype J) (u : J → n → P.E s) (m : J → ℕ),
      IsResolution u m ∧
      (∀ j : J, finiteImage (u j) ∈
        integralAfter (1 : 𝓞 P.K) fun v : FinPlace (P.E s) ↦ ↑p ∈ v.asIdeal) ∧
      ∃ H ∈ P.cmCurve.multiSeriesRing (daggerForms u),
        (V.jetSeries (conj (δ : ℂ) * (P.areaScale / P.cmPeriod)) f).map ιₚ =
          P.cmCurve.thetaProd (daggerForms u) m ^ N * H := by
  obtain ⟨b, I, _, w, F, J, _, y, a, h_exp⟩ :
      ∃ (b : ℕ) (I : Type) (_ : Fintype I) (w : I → P.E s) (F : 𝒮 V) (J : Type) (_ : Fintype J)
        (y : J → n → 𝔸f (P.E s)) (a : J → embValRing), IsVacuumExpansion p V b w F y a :=
    exists_isVacuumExpansion p V
  have hb : p.Coprime b := h_exp.coprime
  have hw_int : ∀ i : I, finiteImage w i ∈ Ô (P.E s) := h_exp.isTightFrame.finiteImage_mem
  -- `M k` consists of the vectors for which the claim holds with the resolution `w / (b k)`.
  let μ (k : ℕ) : I × n → InfinitePlace (P.E s) × n → ℂ_[p] :=
    daggerForms (resolutionVectors w (b * k))
  let M (k : ℕ) : Submodule embValRing (𝒮 V) := thetaMultiples V (μ k)
    (conj (δ : ℂ) * (P.areaScale / P.cmPeriod)) (P.cmCurve.thetaProd (μ k) (fun _ ↦ k * k) ^ N)
  have hb_ne : b ≠ 0 := ne_zero_of_prime_coprime hb
  -- A translate of `F` by a point `x` with `δ x` integral above `p` is the translate by a rational
  -- `γ` with `m δ γ` in the lattice, so its series is a product of translates of `θ` by points
  -- that `m b δ` takes to periods. It lies in `M k` for the nonzero multiples `k` of `m b`.
  have h_translate (x : n → 𝔸f (P.E s)) (hx : x ∈ integralAfter δ fun u ↦ ↑p ∈ u.asIdeal) :
      ∃ m : ℕ, p.Coprime m ∧ ∀ k : ℕ, k ≠ 0 → m ∣ k → V.ϱ (finVec x) F ∈ M k := by
    obtain ⟨γ, m, h_eq, hm, hγ⟩ : ∃ (γ : n → P.E s) (m : ℕ),
        V.ϱ (finVec (finiteImage γ)) F = V.ϱ (finVec x) F ∧ p.Coprime m ∧
        ∀ c : n, finiteImage id (m * (algebraMap P.K (P.E s) δ * γ c)) ∈ Ô (P.E s) :=
      exists_rho_finiteImage_eq_and_coprime_mul_mem h_exp.mem_finitePart hx
    refine ⟨m * b, hm.mul_right hb, fun k hk h_dvd ↦ ?_⟩
    rw [← h_eq]
    exact mem_thetaMultiples_of_jetSeries_eq_prod hδ_ne hN hk
      (fun i ↦ mul_neg_sum_mul_conj_mem_cmCurve_lattice (hγ i.2) (hw_int i.1) hb_ne h_dvd)
      (h_exp.jetSeries_eq_prod γ (conj δ))
  obtain ⟨m, hm, hf_mem⟩ : ∃ m : ℕ, p.Coprime m ∧ ∀ k : ℕ, k ≠ 0 → m ∣ k → f ∈ M k := by
    induction hf using Submodule.span_induction with
    | mem _ hx =>
      obtain ⟨x, hx, rfl⟩ := hx
      -- A generator is a combination of the translates of `F` by the `x + y j`, and the `y j` are
      -- integral above `p`. Take the product over `j` of the numbers given by `h_translate`.
      choose m hm h_mem using fun j : J ↦ h_translate (x + y j)
        (add_mem hx (mem_integralAfter_of_nsmul_mem hb (h_exp.nsmul_mem_stdLattice j)))
      refine ⟨∏ j : J, m j, .prod_right fun j _ ↦ hm j, fun k hk h_dvd ↦ ?_⟩
      rw [h_exp.intVacuum_eq_sum, map_sum]
      refine sum_mem fun j _ ↦ ?_
      obtain ⟨c, hc⟩ : ∃ c : embValRing,
          V.finHeisenbergOp x (V.ϱ (finVec (y j)) F) = c • V.ϱ (finVec (x + y j)) F :=
        exists_finHeisenbergOp_rho_eq_smul x (y j) F
      rw [(V.finHeisenbergOp x).map_smul_of_tower, hc]
      exact (M k).smul_mem (a j) <| (M k).smul_mem c <|
        h_mem j k hk ((Finset.dvd_prod_of_mem m (Finset.mem_univ j)).trans h_dvd)
    | zero => exact ⟨1, by simp, fun k _ _ ↦ zero_mem (M k)⟩
    | add g g' _ _ hg hg' =>
      rcases hg, hg' with ⟨⟨m, hm, hg⟩, ⟨m', hm', hg'⟩⟩
      exact ⟨m * m', hm.mul_right hm', fun k hk h_dvd ↦ add_mem
        (hg k hk (dvd_of_mul_right_dvd h_dvd)) (hg' k hk (dvd_of_mul_left_dvd h_dvd))⟩
    | smul c g _ hg =>
      exact hg.imp fun m ⟨hm, hg⟩ ↦ ⟨hm, fun k hk h_dvd ↦ (M k).smul_mem c (hg k hk h_dvd)⟩
  have hm_ne : m ≠ 0 := ne_zero_of_prime_coprime hm
  -- Membership of `f` in `M m` is the asserted factorization for the resolution `w / (b m)`.
  exact ⟨I × n, inferInstance, resolutionVectors w (b * m), fun _ ↦ m * m,
    h_exp.isTightFrame.isResolution hb_ne hm_ne,
    finiteImage_resolutionVectors_mem hw_int (hb.mul_right hm), hf_mem m hm_ne dvd_rfl⟩

end Parameters

end New
end
end

section
/-!
# The scale of the Taylor series of a vector

* `New.Space.jet_jetSeries_of_isHomogeneous`: the derivative of the Taylor series along a
  homogeneous polynomial is a theta value times a power of the scale.
* `New.Parameters.norm_periodFactor_mul_daggerForms_le_one`: the scaled linear form of a vector `y`
  is integral at `p` if `α⁻¹ y` is integral above `p`.

The period scale is `jetScale` times an integer `π_M` of `K` of norm `M`. The statement with this
factor is `New.Data.norm_taylorScale_eq_one_of_not_dvd`.

The statements use these notions:
* `jetSeries a f`: the Taylor series of the theta function of `f`, with variables scaled by `a`;
  `jet R Q F` is the derivative at zero of the series `F` along the polynomial `Q`.
* `daggerForms u j`: the coefficients in `ℂ_p` of the linear form `z ↦ y† z` of the vector
  `y = u j`; at a pair `(v, i)` of an infinite place and a coordinate the coefficient is the image
  in `ℂ_p` of the complex conjugate of `Φ_v (y i)`, with `Φ_v` the embedding chosen at `v`.
* `periodFactor`: the complex number `vacuumRoot / chowlaSelbergUnit`, where `vacuumRoot` is a root
  of the inverse of the value `chiFin α` of a character at the idele `α` and the denominator is a
  unit at every `p`-adic place; `jetScale` is `periodFactor * √(2π / √d) / cmPeriod`, where
  `cmPeriod * 𝓞_K` is the lattice of the CM curve of the field `K = ℚ(i√d)`.

## Relation to the literature

The modulus of `jetScale` is computed from the formula of Chowla and Selberg,
`New.CMLattice.chowla_selberg`.
-/

@[expose] public section

open NumberField ComplexConjugate MvPolynomial

namespace New

/-- Scaling all variables of a power series `F` by `a` multiplies the derivative `jet R Q F` at
zero along a homogeneous polynomial `Q` of degree `l` by `a ^ l`. -/
lemma jet_rescale {R X : Type} [CommRing R] {Q : MvPolynomial X R} {l : ℕ}
    (hQ : Q.IsHomogeneous l) (a : R) (F : MvPowerSeries X R) :
    jet R Q (MvPowerSeries.rescale (fun (_ : X) ↦ a) F) = a ^ l * jet R Q F := by
  rw [jet_eq_sum, jet_eq_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun α hα ↦ ?_
  simp only [MvPowerSeries.coeff_rescale, Finsupp.prod, Finset.prod_pow_eq_pow_sum,
    ← hQ.degree_eq_sum_deg_support hα]
  ac_rfl

/-- Let `E` be a CM number field with a chosen CM type (`CMType`) and the data of its Weil
representation (`WeilData`). For a homogeneous polynomial `Q` of degree `l` and a vector `f` of
the Weil representation `𝒮 V` of the hermitian space `V` with signs `ε`, the derivative at zero
along `Q` of the series `V.jetSeries a f` is `a ^ l θ(v_Q ⊗ f)`. Here `θ` is the theta functional,
`realSigns E ε` gives each pair (infinite place, coordinate) the sign of the coordinate,
`v_Q = polyVector Q` is the Fock vector of `Q` for these signs, and `⊗` is `V.integrated`, the
bilinear map that integrates the action of the real Heisenberg group on `f` against `v_Q`. The
series `V.jetSeries a f` has one variable for each such pair; its coefficient at the monomial
`z ^ α` is `a ^ |α| / α! * θ(v_{z ^ α} ⊗ f)`. -/
lemma Space.jet_jetSeries_of_isHomogeneous {E n : Type} [Field E] [CMType E] [WeilData E]
    [Fintype n] [DecidableEq n] {ε : n → ℤˣ} (V : Space E n ε)
    {Q : MvPolynomial (InfinitePlace E × n) ℂ} {l : ℕ} (hQ : Q.IsHomogeneous l) (a : ℂ) (f : 𝒮 V) :
    jet ℂ Q (V.jetSeries a f) =
      a ^ l * V.θ (V.integrated (Fock.polyVector (realSigns E ε) Q) f) := by
  -- Write the scale as `a * 1`, take out `a ^ l` and use the formula at the scale `1`.
  rw [← mul_one a, jetSeries_mul_eq_rescale, jet_rescale hQ, jet_jetSeries_eq_theta, mul_one]
  simp only [one_smul, aeval_X_left_apply]

/-- Let `σ` be an embedding of the number field `E` into a `p`-adic field `F`, that is, a normed
algebra over `ℚ_p` that is a field, here ultrametric and not necessarily complete. The image of a
finite adele `x` under the extension of `σ` to finite adeles has norm at most one if and only if
the component of `x` at the place induced by `σ` is integral. -/
lemma norm_adeleExtension_le_one_iff {E F : Type} [Field E] [NumberField E] {p : ℕ} [Fact p.Prime]
    [NormedField F] [IsUltrametricDist F] [CharZero F] [PadicField F p] (σ : E →+* F)
    {x : 𝔸f E} : ‖adeleExtension σ x‖ ≤ 1 ↔ Valued.v (evalAt (placeOfEmb σ) x) ≤ 1 := by
  -- `adeleExtension σ` is by definition the component at the place, mapped by the extension of `σ`.
  change ‖placeOfEmbExtension σ (evalAt (placeOfEmb σ) x)‖ ≤ 1 ↔ _
  exact (valuation_comap_placeOfEmbExtension_isEquiv σ).le_one_iff_le_one

namespace Parameters

/-- Let `y = u j` be a vector over the field `E = P.E s` of the parameters at the index `s`, a
cyclotomic extension of `K = P.K = ℚ(i√d)`, and `α = P.α s` their idele. Let `ιₚ : ℂ → ℂ_p` be the
ring homomorphism chosen by `PadicPlace p`. For a pair `x = (v, i)` of an infinite place of `E` and
a coordinate, `daggerForms u j x` is the image under `ιₚ` of the complex conjugate of `Φ_v (y i)`,
with `Φ_v : E → ℂ` the embedding that the CM type chooses at `v`. If the finite adelic vector
`α⁻¹ y` (`finiteImage (u j)`) is integral at all places above `p` (`integralAfter 1`), then the
product of `ιₚ periodFactor` and this coefficient has norm at most one. -/
lemma norm_periodFactor_mul_daggerForms_le_one {P : Parameters} {s : ℕ} {n : Type} {p : ℕ}
    [Fact p.Prime] [PadicPlace p] {J : Type} {u : J → n → P.E s} {j : J}
    (h_integral :
      finiteImage (u j) ∈ integralAfter (1 : 𝓞 P.K) fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal)
    (x : InfinitePlace (P.E s) × n) :
    ‖ιₚ (P.periodFactor s) * daggerForms u j x‖ ≤ 1 := by
  -- The norm in question is that of the coordinate `x.2` of `α⁻¹ y` at the place given by `x.1`.
  let σ : P.E s →+* ℂ_[p] := weightEmbedding ιₚ x.1
  have h_int : ‖adeleExtension σ (finiteImage (u j) x.2)‖ ≤ 1 := by
    have h_val : Valued.v (evalAt (placeOfEmb σ)
        (algebraMap (P.E s) (𝔸f (P.E s)) (algebraMap P.K (P.E s) ((1 : 𝓞 P.K) : P.K)) *
          finiteImage (u j) x.2)) ≤ 1 := h_integral x.2 _ (natCast_mem_placeOfEmb σ)
    rw [RingOfIntegers.coe_eq_algebraMap, map_one, map_one, map_one, one_mul] at h_val
    exact (norm_adeleExtension_le_one_iff σ).2 h_val
  have h_image : finiteImage (u j) x.2 =
      ((P.α s)⁻¹).val * algebraMap (P.E s) (𝔸f (P.E s)) (u j x.2) := rfl
  have h_form : daggerForms u j x = σ (u j x.2) := by
    rw [daggerForms, dagger, RingHom.comp_apply, RingHom.comp_apply, starRingEnd_apply,
      starRingEnd_apply, map_star_complex]
  rw [h_image, map_mul, norm_mul, map_units_inv, norm_inv, adeleExtension_algebraMap] at h_int
  rwa [norm_mul, norm_iota_periodFactor x.1, h_form]

end Parameters

end New
end
end

/-!
# Integrality and divisibility of the derivatives of standard data

This file bounds the valuations of the derivatives of the Taylor series of standard data along
homogeneous integral polynomials.

* Standard data of level `δ` at `p` (`standardData`): the span over the `p`-integral complex numbers
  (`embValRing`) of the translates of the integral vacuum by the points `x` for which `δ * x` is
  integral above `p`.
* `V.jetSeries a f`: the Taylor series at `0` of the theta function of `f`, with the variables
  scaled by `a`; the scale `P.jetScale s` is `periodFactor * areaScale / cmPeriod`.
* `jet R Q F`: the derivative `Q(∂) F` at `0`.
* The normal form (`HasNormalForm`): after scaling the variables by `ϖ`, an integral series times
  the exponential of a multiple of the coupling series of the pairs of partner places.
* `ιₚ`: the embedding of `ℂ` into `ℂ_[p]` that comes with `PadicPlace p`.

## Main definitions and results

* `New.Parameters.norm_jet_jetSeries_le_pow`: a lower bound for the valuations of the derivatives of
  the Taylor series of standard data along homogeneous integral polynomials.
* `New.Parameters.exists_hasNormalForm_jetSeries`: at a non-split prime the Taylor series of
  standard data of level one has the normal form.
* `New.Parameters.norm_jet_minorProd_jetSeries_le`: so its derivatives along products of minors have
  the predicted divisibility up to a loss of `card (P.Φ s) * N ^ 3 * (1 + Real.logb p (max (boxes κ
  N) 1))`, where `N = card n'`.
* `New.Parameters.norm_schurJet_jetSeries_le_of_charges`: the bound with removed columns and charges
  for the derivatives along the entries of the Schur matrices.
-/

@[expose] public section

/-!
## Integrality of the derivatives of standard data at all primes

The theta function of standard data of level `δ`, taken at `conj δ * (areaScale / cmPeriod) * z`, is
a power of the product of copies of `θ` along a resolution of the identity times an integral series
in copies of the parameter.
-/

section JetIntegrality

open NumberField ComplexConjugate

namespace New.Parameters

/-- **Integrality of the derivatives.** Let `E = P.E s` be the cyclotomic extension at level `s` of
`K = P.K = ℚ(√-d)`, and `V` a hermitian space over `E` with all signs `+1` and the identity matrix
as adelic point (`IsStd`). Standard data of level `δ ≠ 0` at `p` (`standardData`) are the
combinations, with coefficients in the ring `embValRing` of complex numbers that are integral in
`ℂ_[p]`, of the translates of the integral vacuum in `𝒮 V` by the adelic points `x` such that
`δ * x` is integral above `p`. Let `f` be such data and let `F` be the Taylor series at `0` of the
theta function of `f` at `conj δ * d * jetScale * z`. For a polynomial `Q` with coefficients in
`embValRing`, in variables indexed by (infinite place of `E`, coordinate), the derivative `Q(∂) F`
at `0` (`jet`) has norm at most one in `ℂ_[p]`. -/
lemma norm_jet_jetSeries_le_one {P : Parameters} {s : ℕ} {n : Type} [Fintype n] [DecidableEq n]
    {ε : n → ℤˣ} {V : Space (E P s) n ε} [V.IsStd] {p : ℕ} [Fact p.Prime] [PadicPlace p]
    {δ : 𝓞 P.K} (hδ : δ ≠ 0) {f : 𝒮 V} (hf : f ∈ standardData V δ)
    (Q : MvPolynomial (InfinitePlace (P.E s) × n) embValRing) :
    ‖ιₚ (jet ℂ (Q.map embValRing.subtype)
      (V.jetSeries (star (δ : ℂ) * P.d * P.jetScale s) f))‖ ≤ 1 := by
  -- The theta function at `conj δ * (areaScale / cmPeriod) * z` is a power of the product of copies
  -- of `θ` along a resolution `u` times an integral series `H` in the parameters. Scaling `z` by
  -- `a = d * periodFactor` turns the forms `u† z` into `d` times integral forms `ν`. The exponent
  -- is `N = δ δ̄`, the degree of multiplication by `δ` on the curve.
  obtain ⟨N, -, h_area_mul⟩ := exists_isIsogeny_of_mul_mem_lattice
    (P.cmCurve.mul_mem_of_quadInt (a := δ) ⟨δ, rfl⟩)
  have hN : δ * conj (δ : ℂ) = N :=
    mul_right_cancel₀ (Complex.ofReal_ne_zero.2 (area_pos _).ne') h_area_mul
  obtain ⟨J, _, u, m, -, hu, H, hH, h_series⟩ := exists_jetSeries_map_eq_thetaProd_pow_mul hδ hN hf
  let a : ℂ := P.d * P.periodFactor s
  let ν : J → InfinitePlace (P.E s) × n → ℂ_[p] := ιₚ (P.periodFactor s) • daggerForms u
  let H' : MvPowerSeries (InfinitePlace (P.E s) × n) ℂ_[p] := H.rescale fun _ ↦ ιₚ a
  have hν (j : J) (x : InfinitePlace (P.E s) × n) : ‖ν j x‖ ≤ 1 :=
    norm_periodFactor_mul_daggerForms_le_one (hu j) x
  have h_forms : ιₚ a • daggerForms u = (P.d : ℂ_[p]) • ν := by rw [map_mul, map_natCast, mul_smul]
  have hH' : H' ∈ P.cmCurve.multiSeriesRing ((P.d : ℂ_[p]) • ν) := by
    simpa only [h_forms] using P.cmCurve.rescale_mem_multiSeriesRing (ιₚ a) hH
  have h_scale : star (δ : ℂ) * P.d * P.jetScale s =
      a * (conj (δ : ℂ) * (P.areaScale / P.cmPeriod)) := by
    simp only [a, jetScale, starRingEnd_apply]
    ring
  have h_scaled : (V.jetSeries (star (δ : ℂ) * P.d * P.jetScale s) f).map ιₚ =
      P.cmCurve.thetaProd ((P.d : ℂ_[p]) • ν) m ^ N * H' :=
    calc _ = (P.cmCurve.thetaProd (daggerForms u) m ^ N * H).rescale fun _ ↦ ιₚ a := by
          rw [h_scale, V.jetSeries_mul_eq_rescale, map_rescale, h_series]
      _ = _ := by rw [map_mul, map_pow, CMLattice.rescale_thetaProd, h_forms]
  rw [map_jet, h_scaled, MvPolynomial.map_map]
  exact P.cmCurve.norm_jet_thetaProd_pow_mul_le_one hν m N hH' (fun x : embValRing ↦ x.property) Q

/-- **Integrality at all primes.** Let `V` be a standard hermitian space over `E = P.E s`, and let
`f` be standard data of level `δ ≠ 0` at `p` on it (`standardData V δ`): a `p`-integral combination
of the translates of the integral vacuum by the points that `δ` makes integral above `p`. Let
`jetScale = periodFactor * √(2π / √d) / Ω₀`, where `P.K = ℚ(√-d)`, `Ω₀ 𝓞_K` is the lattice of its CM
curve and `periodFactor` is a normalising constant attached to `E`. Let `Q` be a homogeneous
polynomial of degree `l` with `p`-integral coefficients (in `embValRing`). Then the derivative
`Q(∂)` at `0` (`jet`) of the Taylor series (`jetSeries`) of the theta function of `f` at
`c * jetScale * z` has valuation in `ℂ_[p]` at least `l` times that of `c / (conj δ * d)`. -/
theorem norm_jet_jetSeries_le_pow {P : Parameters} {s : ℕ} {n : Type} [Fintype n] [DecidableEq n]
    {ε : n → ℤˣ} {V : Space (E P s) n ε} [V.IsStd] {p : ℕ} [Fact p.Prime] [PadicPlace p]
    {δ : 𝓞 P.K} (hδ : δ ≠ 0) {f : 𝒮 V} (hf : f ∈ standardData V δ) (c : ℂ)
    {Q : MvPolynomial (InfinitePlace (P.E s) × n) embValRing} {l : ℕ} (hQ : Q.IsHomogeneous l) :
    ‖ιₚ (jet ℂ (Q.map embValRing.subtype) (V.jetSeries (c * P.jetScale s) f))‖ ≤
      ‖ιₚ (c / (star (δ : ℂ) * P.d))‖ ^ l := by
  -- Scaling the variables by `c / (conj δ * d)` multiplies the derivative by the `l`-th power.
  have h_ne : star (δ : ℂ) * P.d ≠ 0 := mul_ne_zero (star_ne_zero.2 (mod_cast hδ)) (NeZero.ne _)
  have h_scale : c * P.jetScale s =
      c / (star (δ : ℂ) * P.d) * (star (δ : ℂ) * P.d * P.jetScale s) := by
    rw [← mul_assoc, div_mul_cancel₀ _ h_ne]
  rw [h_scale, V.jetSeries_mul_eq_rescale, jet_rescale (hQ.map _), map_mul, map_pow, norm_mul,
    norm_pow]
  exact mul_le_of_le_one_right (by positivity) (norm_jet_jetSeries_le_one hδ hf Q)

end New.Parameters

end JetIntegrality

/-!
## The normal form and the divisibility of standard data

At a non-split prime, which is automatically prime to `q₁`, the Taylor series of standard data of
level one is a product of copies of `θ` along a resolution of the identity that is integral above
the prime, times an integral series, so it has the normal form. Scaling by an integral number keeps
the normal form, and the count of the divisibility of series in normal form applies to it.
-/

section StandardDataNormalForm

open NumberField ComplexConjugate Finset Fintype

namespace New.Parameters
variable {P : Parameters} {s : ℕ} {n : Type} {p : ℕ} [Fact p.Prime]

/-- Let `α = P.α s` be the finite idele of `E = P.E s` that makes the integral adeles self-dual in
the construction of the Weil representation; the product of `α` and the integer `P.q₁ s` is integral
at every place. Let `p` be a prime that does not divide `P.q₁ s`, and `y` a vector over `E`. If all
coordinates of the adelic vector `finiteImage y = α⁻¹ y` are integral at the places above `p`, then
so are all coordinates of `y`. -/
lemma isIntegralAbove_of_finiteImage_mem (hp_not_dvd : ¬p ∣ P.q₁ s) {y : n → P.E s}
    (hy : finiteImage y ∈ integralAfter (1 : 𝓞 P.K) fun w : FinPlace (P.E s) ↦ ↑p ∈ w.asIdeal)
    (i : n) : IsIntegralAbove p (y i) := by
  intro w hw
  have h_unit : Valued.v (P.q₁ s : LocField w) = 1 := by
    simpa using v_algebraMap_eq_one (w.isPrime.notMem_of_isCoprime_of_mem
      ((Fact.out : p.Prime).coprime_iff_not_dvd.2 hp_not_dvd).cast hw)
  have hα : Valued.v ((P.α s).val w) ≤ 1 := by
    have h_int : Valued.v ((P.q₁ s : LocField w) * (P.α s).val w) ≤ 1 := mem_Ô.1 q₁_mul_alpha_mem w
    rwa [map_mul, h_unit, one_mul] at h_int
  have h_global : algebraMap (P.E s) (𝔸f (P.E s)) (y i) = (P.α s).val * finiteImage y i := by
    simp [finiteImage, WeilData.α]
  calc w.valuation (P.E s) (y i) = Valued.v ((P.α s).val w) * Valued.v (finiteImage y i w) := by
        simpa using congrArg (fun x : 𝔸f (P.E s) ↦ Valued.v (x w)) h_global
    _ ≤ 1 := mul_le_one' hα (by simpa using hy i w hw)

/-- **Normal form at a non-split prime.** Let `V` be a standard hermitian space over the cyclotomic
extension `E = P.E s` of `ℚ(√-d)` (`IsStd`: all signs are `+1` and the adelic point is the identity
matrix), and let `p` be non-split: the character `chiK` of `ℚ(√-d)` is not `1` at `p`. Let `f` be
standard data of level one, a `p`-integral combination of the translates of the integral vacuum by
points integral above `p`, and let `c` be `p`-integral. With
`jetScale = periodFactor * √(2π / √d) / Ω₀` (`Ω₀` the CM period, `periodFactor` a normalising
constant), let `F` be the Taylor series in `ℂ_[p]` of the theta function of `f` at
`c * jetScale * z`, in the variables `z_(τ,i)` (place, coordinate). Then `F` has the normal form
(`HasNormalForm`) `F(ϖ z) = W exp (ϖ ^ (p + 1) / p * ∑_e ∑_j l e j * Γ_e ^ p ^ j)`: the series `W`
has coefficients in the valuation ring `valRingCp p` of `ℂ_[p]`, as are all `l e j`. Here `e` runs
over `partnerExponents P.d p` (`e` odd, or any `e` if `p = d`), the coupling `Γ_e` is the sum of all
`z_(τ,i) ^ p ^ e * z_(τ',i)` with `τ' = P.partner s p e τ` the place `τ` moved by the class of
`-p ^ e`, and `ϖ` has valuation `varpiValuation P.d p`, which is `1 / (p² - 1)` if `p` is inert and
`1 / (2 p - 2)` if `p = d`. -/
theorem exists_hasNormalForm_jetSeries [Fintype n] [DecidableEq n] {ε : n → ℤˣ}
    {V : Space (E P s) n ε} [V.IsStd] [PadicPlace p] (hp_nonsplit : chiK P.d p ≠ 1) {f : 𝒮 V}
    (hf : f ∈ standardData V 1) {c : ℂ} (hc : ‖ιₚ c‖ ≤ 1) :
    ∃ (ϖ : ℂ_[p]) (l : ℕ → ℕ → valRingCp p), ‖ϖ‖ = p ^ (-varpiValuation P.d p) ∧
      HasNormalForm (partnerExponents P.d p) (P.partner s p) ϖ l
        ((V.jetSeries (c * P.jetScale s) f).map ιₚ) := by
  -- A resolution writes the series as a theta product times an integral series; such series have
  -- the normal form, and scaling by a `p`-integral number keeps it.
  have hp_not_dvd : ¬p ∣ P.q₁ s := fun h_dvd ↦
    hp_nonsplit (P.chiK_eq_one_of_dvd Fact.out h_dvd)
  obtain ⟨ϖ, l, hϖ, -, h_normalForm_thetaProd⟩ := P.exists_hasNormalForm s hp_nonsplit
  obtain ⟨J, _, u, m, h_resolution, hu, H, hH, h_theta⟩ :=
    exists_jetSeries_map_eq_thetaProd_pow_mul (N := 1) one_ne_zero (by simp) hf
  have h_integral (j : J) : ∀ i : n, IsIntegralAbove p (u j i) :=
    isIntegralAbove_of_finiteImage_mem hp_not_dvd (hu j)
  have h_series : (V.jetSeries (P.areaScale / P.cmPeriod) f).map ιₚ =
      P.cmCurve.thetaProd (daggerForms u) m * H := by simpa using h_theta
  have h_scale : ‖ιₚ (c * P.periodFactor s)‖ ≤ 1 := by
    rwa [map_mul, norm_mul, P.norm_iota_periodFactor_eq_one s hp_not_dvd, mul_one]
  have h_factor : c * P.jetScale s = c * P.periodFactor s * (P.areaScale / P.cmPeriod) := by
    rw [jetScale, mul_assoc, mul_div_assoc]
  rw [h_factor, V.jetSeries_mul_eq_rescale, map_rescale, h_series]
  exact ⟨ϖ, _, hϖ,
    (h_normalForm_thetaProd u m h_resolution h_integral H hH).rescale ⟨_, h_scale⟩⟩

variable [Fintype n] [DecidableEq n] [PadicPlace p] {n' : Type} [Fintype n'] [DecidableEq n']
  {κ : P.Φ s → ℕ → ℕ}

/-- **Divisibility at non-split primes.** Let `f` be standard data of level one on the space of
`n' × n` matrices (`hom` of the spaces `stdSpace`, whose forms are sums of norms of coordinates).
Let `c` be `p`-integral and `F` the Taylor series in `ℂ_[p]` of the theta function of `f` at
`c * jetScale * z`, where `jetScale = periodFactor * √(2π / √d) / Ω₀` (`Ω₀` the CM period,
`periodFactor` a normalising constant); its variable `(τ, b, a)` is the entry `(b, a)` of the matrix
`z_τ`. Let `κ τ h` be the number of columns of height `h` of a diagram at the place `τ`, let `i'` be
standard fillings of these diagrams by elements of `n'` (`WeylIndex`) and `y τ` integral matrices
with rows indexed by `n`. For a column of height `h < N = card n'`, take the minor of `z_τ y_τ` on
the rows that `i'` puts into the column and on the first `h` columns of `y_τ`; `minorProd i' y` is
the product of these minors. The derivative of `F` along it has valuation at least `D` less
`f₀ * N ^ 3 * (1 + log_p max (B, 1))`, where `f₀` is the number of infinite places and
`B = boxes κ N` the number of boxes in columns of height below `N`. Here `D = predictedDivisibility`
is `v ∑_e ∑_τ ((a_τ / p ^ e - a_τ' - a'_τ')⁺ + (l_τ / p ^ e - l_τ')⁺ - a'_τ / p ^ e)`: among the
heights below `N`, `a_τ` counts the columns of height one at `τ`, `a'_τ` the others and `l_τ` their
boxes; `τ'` is the place `-p ^ e τ`, `v = piPrimeValuation P.d p`, and `e` runs over the odd numbers
(all `e ≥ 1` if `p = d`). If `p = d`, half of `∑_τ (min (a_τ, a_τ' + a'_τ') + a'_τ + min (l_τ,
l_τ'))`, with `e = 0`, is subtracted from it. -/
theorem norm_jet_minorProd_jetSeries_le
    {f : 𝒮 ((stdSpace (E P s) n).hom (stdSpace (E P s) n'))} {c : ℂ} (hp_nonsplit : chiK P.d p ≠ 1)
    (hf : f ∈ standardData ((stdSpace (E P s) n).hom (stdSpace (E P s) n')) 1) (hc : ‖ιₚ c‖ ≤ 1)
    (i' : WeylIndex n' κ) (y : P.Φ s → n → ℕ → valRingCp p) :
    let N : ℕ := card n'
    ‖jet ℂ_[p] (minorProd i' fun (τ : P.Φ s) (a : n) (k : ℕ) ↦ (y τ a k : ℂ_[p]))
        ((((stdSpace (E P s) n).hom (stdSpace (E P s) n')).jetSeries
          (c * P.jetScale s) f).map ιₚ)‖ ≤
      p ^ (-(predictedDivisibility P.d p (P.partner s p) κ N -
        card (P.Φ s) * N ^ 3 * (1 + Real.logb p (max (boxes κ N) 1 : ℕ))) : ℝ) := by
  obtain ⟨ϖ, l, hϖ, h_form⟩ := exists_hasNormalForm_jetSeries hp_nonsplit hf hc
  exact P.norm_jet_minorProd_le_of_hasNormalForm s hp_nonsplit hϖ h_form i' y

/-- **Divisibility of Schur entries at a non-split prime `p`.** Let `f` be standard data of level
one on the space `Hom(stdSpace n, stdSpace n')` of `n' × n` matrices, and `c` a `p`-integral number.
Let `F` be the Taylor series of the theta function of `f` at `c * jetScale * z`, where
`jetScale = periodFactor * √(2π / √d) / Ω₀` (`Ω₀` the CM period, `periodFactor` a normalising
constant); its variable `(τ, b, a)` is the entry `(b, a)` of the matrix `z_τ`. The Schur matrix of
the diagrams `κ` is the matrix of the map of Weyl modules of shape `κ` that the family `z` induces,
in the bases of chosen standard fillings; `schurJet κ F i' i` is the derivative at `0` of `F` along
the polynomial at its entry `(i', i)`. Let `κ` fit the ranks.

Remove the columns of height one at the places of `erasedPlaces`, and give charges
`p ^ chargeExp τ h b` (place, height, row) such that, for each `e` in `partnerExponents P.d p` with
partner `τ' = -p ^ e τ` of `τ`, each row `b` and each height `h`: if `τ ∈ erasedPlaces`, or `h = 1`
and `τ' ∈ erasedPlaces`, then `chargeExp τ 1 b` or `chargeExp τ' h b` is nonzero
(`IsChargeExponent`). Let `N = card n'` and `B` the number of boxes of `κ` in columns of height
below `N`. Then the sum `fillingCharge chargeExp i'` of the exponents over the boxes of the filling
`i'`, plus the valuation of the derivative, is at least the predicted divisibility of the remaining
diagrams, plus the gain `gammaPrime P.d p` for each removed box among these `B`, less
`f₀ * N ^ 3 * (1 + log_p max (B, 1))`, where `f₀` is the number of infinite places. -/
theorem norm_schurJet_jetSeries_le_of_charges
    {f : 𝒮 ((stdSpace (E P s) n).hom (stdSpace (E P s) n'))} {c : ℂ}
    (hp_nonsplit : chiK P.d p ≠ 1) (hκ : FitsRanks (fun _ : P.Φ s ↦ n) (fun _ : P.Φ s ↦ n') κ)
    (hf : f ∈ standardData ((stdSpace (E P s) n).hom (stdSpace (E P s) n')) 1) (hc : ‖ιₚ c‖ ≤ 1)
    (erasedPlaces : Finset (P.Φ s)) (chargeExp : P.Φ s → ℕ → n' → ℕ)
    (h_charge : ∀ e ∈ partnerExponents P.d p,
      IsChargeExponent (P.partner s p e) erasedPlaces chargeExp)
    (i' : WeylIndex n' κ) (i : WeylIndex n κ) :
    let N : ℕ := card n'
    let B : ℕ := boxes κ N
    ‖ιₚ (schurJet κ (((stdSpace (E P s) n).hom (stdSpace (E P s) n')).jetSeries
        (c * P.jetScale s) f) i' i)‖ ≤
      p ^ (fillingCharge chargeExp i' -
        (predictedDivisibility P.d p (P.partner s p) (eraseHeightOne κ erasedPlaces) N +
          gammaPrime P.d p * (B - boxes (eraseHeightOne κ erasedPlaces) N) -
          card (P.Φ s) * N ^ 3 * (1 + Real.logb p (max B 1 : ℕ))) : ℝ) := by
  -- Bound the Schur entry by a derivative along a product of minors, then use the normal form.
  obtain ⟨ϖ, l, hϖ, h_form⟩ := exists_hasNormalForm_jetSeries hp_nonsplit hf hc
  set F : MvPowerSeries (P.Φ s × n' × n) ℂ :=
    ((stdSpace (E P s) n).hom (stdSpace (E P s) n')).jetSeries (c * P.jetScale s) f
  obtain ⟨y, h_le_minorProd⟩ :=
    exists_norm_schurJet_le_norm_jet_minorProd hκ (F.map ιₚ) i' i
  rw [show ιₚ (schurJet κ F i' i) = schurJet κ (F.map ιₚ) i' i by
    simp [schurJet, map_jet, map_schur hκ]]
  exact h_le_minorProd.trans (P.norm_jet_minorProd_le_of_charges s hp_nonsplit hϖ h_form
    erasedPlaces chargeExp (fun e he τ h b _ _ ↦ h_charge e he τ h b) i' y)

end New.Parameters

end StandardDataNormalForm
